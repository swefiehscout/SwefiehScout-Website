---
// Icon — a curated set of inline SVGs in a consistent stroke style
// (Phosphor-inspired). All icons inherit currentColor so we can place
// them on any background and color them via CSS just like text.

interface Props {
  name:
    | 'sparkle'
    | 'cross'
    | 'star'
    | 'heart'
    | 'flag'
    | 'music'
    | 'flower'
    | 'fleur'
    | 'arrow-right'
    | 'phone'
    | 'envelope'
    | 'pin'
    | 'bank'
    | 'cliq'
    | 'cash'
    | 'calendar'
    | 'compass'
    | 'plus'
    | 'diamond'
    | 'sun'
    | 'box'
    | 'megaphone'
    | 'lock';
  size?: number | string;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, strokeWidth = 1.75, class: className = '', label } = Astro.props;
const sw = strokeWidth;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`icon icon-${name} ${className}`}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  {name === 'sparkle' && (
    <>
      <path d="M12 3v4" />
      <path d="M12 17v4" />
      <path d="M3 12h4" />
      <path d="M17 12h4" />
      <path d="M5.6 5.6l2.8 2.8" />
      <path d="M15.6 15.6l2.8 2.8" />
      <path d="M5.6 18.4l2.8-2.8" />
      <path d="M15.6 8.4l2.8-2.8" />
    </>
  )}
  {name === 'cross' && (
    <>
      <path d="M12 2v20" />
      <path d="M5 8h14" />
    </>
  )}
  {name === 'star' && (
    <path d="M12 3l2.6 5.7 6.2.6-4.7 4.2 1.4 6.1L12 16.8l-5.5 2.8 1.4-6.1L3.2 9.3l6.2-.6L12 3z" />
  )}
  {name === 'heart' && (
    <path d="M20.4 4.6a5.5 5.5 0 0 0-7.8 0L12 5.1l-.6-.5a5.5 5.5 0 0 0-7.8 7.8l.6.6L12 21l7.8-8 .6-.6a5.5 5.5 0 0 0 0-7.8z" />
  )}
  {name === 'flag' && (
    <>
      <path d="M5 21V4" />
      <path d="M5 4h12l-2 4 2 4H5" />
    </>
  )}
  {name === 'music' && (
    <>
      <path d="M9 18V5l12-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="18" cy="16" r="3" />
    </>
  )}
  {name === 'flower' && (
    <>
      <circle cx="12" cy="12" r="2" />
      <path d="M12 4a3 3 0 0 1 3 3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1 3-3z" />
      <path d="M20 12a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1 3-3 3 3 0 0 1 3 3z" />
      <path d="M12 20a3 3 0 0 1-3-3 3 3 0 0 1 3-3 3 3 0 0 1 3 3 3 3 0 0 1-3 3z" />
      <path d="M4 12a3 3 0 0 1 3-3 3 3 0 0 1 3 3 3 3 0 0 1-3 3 3 3 0 0 1-3-3z" />
    </>
  )}
  {name === 'fleur' && (
    <>
      <path d="M12 3c-1.5 2-1.5 4 0 6 1.5-2 1.5-4 0-6z" />
      <path d="M12 3c-2 1-3 3-2 5 2-1 3-3 2-5z" />
      <path d="M12 3c2 1 3 3 2 5-2-1-3-3-2-5z" />
      <path d="M12 9v12" />
      <path d="M8 21h8" />
      <path d="M5 13c0 4 3 7 7 7s7-3 7-7" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <path d="M5 12h14" />
      <path d="M13 6l6 6-6 6" />
    </>
  )}
  {name === 'phone' && (
    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z" />
  )}
  {name === 'envelope' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M3 7l9 6 9-6" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 22s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {name === 'bank' && (
    <>
      <path d="M3 10l9-6 9 6" />
      <path d="M5 10v8" />
      <path d="M9 10v8" />
      <path d="M15 10v8" />
      <path d="M19 10v8" />
      <path d="M3 21h18" />
    </>
  )}
  {name === 'cliq' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M8 12h8" />
      <path d="M12 8v8" />
    </>
  )}
  {name === 'cash' && (
    <>
      <rect x="2.5" y="6" width="19" height="12" rx="2" />
      <circle cx="12" cy="12" r="2.5" />
      <path d="M6 9.5v.01" />
      <path d="M18 14.5v.01" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 9h18" />
      <path d="M8 3v4" />
      <path d="M16 3v4" />
    </>
  )}
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M15 9l-3 6-3-6 6 3-6 0z" />
    </>
  )}
  {name === 'plus' && (
    <>
      <path d="M12 5v14" />
      <path d="M5 12h14" />
    </>
  )}
  {name === 'diamond' && (
    <path d="M12 3l9 9-9 9-9-9 9-9z" />
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v3" />
      <path d="M12 19v3" />
      <path d="M2 12h3" />
      <path d="M19 12h3" />
      <path d="M4.9 4.9l2.1 2.1" />
      <path d="M17 17l2.1 2.1" />
      <path d="M4.9 19.1l2.1-2.1" />
      <path d="M17 7l2.1-2.1" />
    </>
  )}
  {name === 'box' && (
    <>
      <path d="M3 8l9-5 9 5-9 5-9-5z" />
      <path d="M3 8v8l9 5 9-5V8" />
      <path d="M12 13v8" />
    </>
  )}
  {name === 'megaphone' && (
    <>
      <path d="M3 10a2 2 0 0 1 2-2h1l11-5v14l-11-5H5a2 2 0 0 1-2-2z" />
      <path d="M8 14v4a2 2 0 0 0 2 2h1v-6" />
      <path d="M20 9a4 4 0 0 1 0 6" />
    </>
  )}
  {name === 'lock' && (
    <>
      <rect x="4" y="11" width="16" height="10" rx="2" />
      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
    </>
  )}
</svg>
