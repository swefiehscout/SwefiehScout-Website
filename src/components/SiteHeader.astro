---
import { getNav } from '../lib/nav.ts';

const { currentPath } = Astro.props as { currentPath: string };
const nav = await getNav();

function isActive(href: string) {
  if (href === '/' || href === '/index') return currentPath === '/' || currentPath === '/index';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/logo.png" alt="Greek Orthodox Scouts & Guides - Swefieh emblem" />
      <span class="brand-text">
        Greek Orthodox Scouts &amp; Guides - Swefieh
        <small>مجموعة كشافة ومرشدات الروم الأرثوذكس - الصويفية</small>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-controls="primary-nav"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav class="site-nav" id="primary-nav" aria-label="Primary" data-nav>
      <ul>
        {nav.map((item, idx) => (
          <li class={item.children.length ? 'has-children' : ''}>
            {item.children.length > 0 ? (
              <div class="nav-parent">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) || item.children.some((c) => isActive(c.href)) ? 'page' : undefined}
                  data-astro-reload={item.fullReload ? true : undefined}
                >{item.title}</a>
                <button
                  type="button"
                  class="submenu-toggle"
                  aria-controls={`submenu-${idx}`}
                  aria-expanded="false"
                  aria-label={`Toggle ${item.title} menu`}
                  data-submenu-toggle
                >
                  <span aria-hidden="true">▾</span>
                </button>
              </div>
            ) : (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-astro-reload={item.fullReload ? true : undefined}
              >{item.title}</a>
            )}
            {item.children.length > 0 && (
              <ul
                class="submenu"
                id={`submenu-${idx}`}
                data-submenu
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                      data-astro-reload={child.fullReload ? true : undefined}
                    >{child.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="nav-backdrop" data-nav-backdrop hidden></div>
</header>

<script is:inline>
  // Element lookups happen at call time: the header is swapped on every
  // view transition, so the global listeners below must act on the
  // current page's elements, not the ones from the first load.

  // Glass-on-scroll: the header switches to a translucent backdrop-blur
  // surface when the page has been scrolled past the very top.
  function syncSiteHeaderScrolled() {
    var header = document.querySelector('.site-header');
    if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
  }

  // Click-based submenu: a chevron button next to each parent link
  // toggles the submenu open/closed. The parent link itself still
  // navigates normally, separating the two interactions makes touch
  // and mouse both reliable. Click outside or press Escape closes.
  function closeAllSubmenus(except) {
    document.querySelectorAll('[data-submenu-toggle]').forEach(function (b) {
      if (b === except) return;
      b.setAttribute('aria-expanded', 'false');
      var id = b.getAttribute('aria-controls');
      var menu = id && document.getElementById(id);
      if (menu) menu.classList.remove('is-open');
    });
  }

  // Mobile drawer open/close.
  function setSiteNavOpen(open) {
    var btn = document.querySelector('[data-nav-toggle]');
    var nav = document.querySelector('[data-nav]');
    var backdrop = document.querySelector('[data-nav-backdrop]');
    if (!btn || !nav || !backdrop) return;
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav.classList.toggle('is-open', open);
    btn.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-locked', open);
    if (open) {
      backdrop.removeAttribute('hidden');
      // next frame so transition runs
      requestAnimationFrame(function () { backdrop.classList.add('is-visible'); });
    } else {
      backdrop.classList.remove('is-visible');
      setTimeout(function () { backdrop.setAttribute('hidden', ''); }, 220);
    }
  }

  // Per-page setup: binds to this page's header elements only.
  function setupSiteHeader() {
    syncSiteHeaderScrolled();

    document.querySelectorAll('[data-submenu-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('aria-controls');
        var menu = id && document.getElementById(id);
        var isOpen = btn.getAttribute('aria-expanded') === 'true';
        closeAllSubmenus(btn);
        if (!isOpen) {
          btn.setAttribute('aria-expanded', 'true');
          if (menu) menu.classList.add('is-open');
        } else {
          btn.setAttribute('aria-expanded', 'false');
          if (menu) menu.classList.remove('is-open');
        }
      });
    });

    var btn = document.querySelector('[data-nav-toggle]');
    var nav = document.querySelector('[data-nav]');
    var backdrop = document.querySelector('[data-nav-backdrop]');
    if (!btn || !nav || !backdrop) return;

    btn.addEventListener('click', function () {
      setSiteNavOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', function () { setSiteNavOpen(false); });
    // Tap a link → close drawer.
    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setSiteNavOpen(false); });
    });
  }

  // Global (window / document / matchMedia) listeners are bound once per
  // session, so they don't pile up with each view transition.
  if (!window.__siteHeaderGlobalsBound) {
    window.__siteHeaderGlobalsBound = true;
    window.addEventListener('scroll', syncSiteHeaderScrolled, { passive: true });
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('.has-children')) {
        closeAllSubmenus(null);
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      closeAllSubmenus(null);
      setSiteNavOpen(false);
    });
    // Close on resize back to desktop so state doesn't get stuck.
    var mq = window.matchMedia('(min-width: 880px)');
    (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(function (e) {
      if (e.matches) setSiteNavOpen(false);
    });

    // astro:page-load fires on initial page load AND after every view
    // transition, so a single listener covers both. Adding setup() as a
    // direct call too would double-bind the click handlers and make the
    // hamburger toggle open-then-close on a single tap.
    document.addEventListener('astro:page-load', setupSiteHeader);
  }
</script>
