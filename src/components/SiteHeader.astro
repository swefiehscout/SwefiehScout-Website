---
import { getNav } from '../lib/nav.ts';

const { currentPath } = Astro.props as { currentPath: string };
const nav = await getNav();

function isActive(href: string) {
  if (href === '/' || href === '/index') return currentPath === '/' || currentPath === '/index';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/logo.png" alt="Greek Orthodox Scouts & Guides - Swefieh emblem" />
      <span class="brand-text">
        Greek Orthodox Scouts &amp; Guides - Swefieh
        <small>مجموعة كشافة ومرشدات الروم الأرثوذكس - الصويفية</small>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-controls="primary-nav"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav class="site-nav" id="primary-nav" aria-label="Primary" data-nav>
      <ul>
        {nav.map((item, idx) => (
          <li class={item.children.length ? 'has-children' : ''}>
            {item.children.length > 0 ? (
              <div class="nav-parent">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >{item.title}</a>
                <button
                  type="button"
                  class="submenu-toggle"
                  aria-controls={`submenu-${idx}`}
                  aria-expanded="false"
                  aria-label={`Toggle ${item.title} menu`}
                  data-submenu-toggle
                >
                  <span aria-hidden="true">▾</span>
                </button>
              </div>
            ) : (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >{item.title}</a>
            )}
            {item.children.length > 0 && (
              <ul
                class="submenu"
                id={`submenu-${idx}`}
                data-submenu
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                    >{child.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="nav-backdrop" data-nav-backdrop hidden></div>
</header>

<script is:inline>
  function setupSiteHeader() {
    // Glass-on-scroll: the header switches to a translucent backdrop-blur
    // surface when the page has been scrolled past the very top.
    var header = document.querySelector('.site-header');
    if (header) {
      var sync = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      sync();
      window.addEventListener('scroll', sync, { passive: true });
    }

    // Click-based submenu: a chevron button next to each parent link
    // toggles the submenu open/closed. The parent link itself still
    // navigates normally — separating the two interactions makes touch
    // and mouse both reliable. Click outside or press Escape closes.
    var subToggles = document.querySelectorAll('[data-submenu-toggle]');
    function closeAllSubmenus(except) {
      subToggles.forEach(function (b) {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        var id = b.getAttribute('aria-controls');
        var menu = id && document.getElementById(id);
        if (menu) menu.classList.remove('is-open');
      });
    }
    subToggles.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('aria-controls');
        var menu = id && document.getElementById(id);
        var isOpen = btn.getAttribute('aria-expanded') === 'true';
        closeAllSubmenus(btn);
        if (!isOpen) {
          btn.setAttribute('aria-expanded', 'true');
          if (menu) menu.classList.add('is-open');
        } else {
          btn.setAttribute('aria-expanded', 'false');
          if (menu) menu.classList.remove('is-open');
        }
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('.has-children')) {
        closeAllSubmenus(null);
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAllSubmenus(null);
    });

    var btn = document.querySelector('[data-nav-toggle]');
    var nav = document.querySelector('[data-nav]');
    var backdrop = document.querySelector('[data-nav-backdrop]');
    if (!btn || !nav || !backdrop) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav.classList.toggle('is-open', open);
      btn.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-locked', open);
      if (open) {
        backdrop.removeAttribute('hidden');
        // next frame so transition runs
        requestAnimationFrame(function () { backdrop.classList.add('is-visible'); });
      } else {
        backdrop.classList.remove('is-visible');
        setTimeout(function () { backdrop.setAttribute('hidden', ''); }, 220);
      }
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
    // Tap a link → close drawer.
    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on resize back to desktop so state doesn't get stuck.
    var mq = window.matchMedia('(min-width: 880px)');
    (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(function (e) {
      if (e.matches) setOpen(false);
    });
  }
  // astro:page-load fires on initial page load AND after every view
  // transition, so a single listener covers both. Adding setup() as a
  // direct call too would double-bind the click handlers and make the
  // hamburger toggle open-then-close on a single tap.
  document.addEventListener('astro:page-load', setupSiteHeader);
</script>
