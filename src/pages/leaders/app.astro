    // ---------- Admin: approve leaders, assign groups --------------------
    async function loadAdmin() {
      const { data, error } = await db.from('profiles').select('*').order('created_at', { ascending: true });
      if (error) { console.error(error); showToast('Could not load leaders.'); return; }
      renderAdmin(data || []);
    }
    // Admins have access to every group by definition (see setupGroups())
    // — a per-admin group checklist would just be dead, confusing UI, so
    // it's swapped for a plain note whenever the selected role is Admin,
    // live as the dropdown changes and not only after a save.
    function adminGroupsCellHTML(groups: string[], isAdmin: boolean) {
      if (isAdmin) return '<p class="ws-admin-note">All groups (admin)</p>';
      return GROUPS.map((g) => `
        <label class="ws-group-check">
          <input type="checkbox" value="${g.key}" ${groups.includes(g.key) ? 'checked' : ''} />
          ${escapeHtml(g.en)}
        </label>
      `).join('');
    }
    function renderAdmin(profiles: any) {
      els.adminBody.innerHTML = profiles.map((p: any) => `
        <tr data-profile-id="${p.id}" class="${p.role === 'pending' ? 'ws-row--pending' : ''}">
          <td data-label="Name">${escapeHtml(p.name)}</td>
          <td data-label="Role">
            <select data-admin-role>
              <option value="pending" ${p.role === 'pending' ? 'selected' : ''}>Pending</option>
              <option value="leader" ${p.role === 'leader' ? 'selected' : ''}>Leader</option>
              <option value="admin" ${p.role === 'admin' ? 'selected' : ''}>Admin</option>
            </select>
          </td>
          <td class="ws-admin-groups" data-label="Groups" data-groups="${p.groups.join(',')}">
            ${adminGroupsCellHTML(p.groups, p.role === 'admin')}
          </td>
          <td class="ws-row-actions">
            <button type="button" class="btn-primary ws-admin-save" data-admin-save>Save</button>
            ${p.id !== state.session.user.id ? '<button type="button" class="ws-row-del" data-admin-remove title="Remove access">×</button>' : ''}
          </td>
        </tr>
      `).join('');

      els.adminBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.profileId;
        const name = row.querySelector('[data-label="Name"]').textContent;
        const groupsCell = row.querySelector('.ws-admin-groups');
        row.querySelector('[data-admin-role]').addEventListener('change', (e: any) => {
          const savedGroups = (groupsCell.dataset.groups || '').split(',').filter(Boolean);
          groupsCell.innerHTML = adminGroupsCellHTML(savedGroups, e.target.value === 'admin');
        });
        row.querySelector('[data-admin-save]').addEventListener('click', async () => {
          const role = row.querySelector('[data-admin-role]').value;
          const groups = role === 'admin'
            ? []
            : Array.from(row.querySelectorAll('.ws-group-check input:checked')).map((i: any) => i.value);
          const { error } = await db.from('profiles').update({ role, groups }).eq('id', id);
          if (error) { console.error(error); showToast('Could not save — ' + (error.message || 'unknown error') + '.'); return; }
          showToast('Saved.');
          if (id === state.session.user.id) { state.profile.role = role; state.profile.groups = groups; setupGroups(); }
        });
        // Soft-revoke: back to pending with no groups, so they lose all
        // access immediately (enforced by RLS, not just this screen) but
        // stay in the list — an admin can re-approve them later if this
        // was a mistake. This can't delete their actual login (that needs
        // the service-role key, which nothing in this app ever holds) —
        // for that, remove them from Supabase Dashboard → Authentication →
        // Users directly.
        row.querySelector('[data-admin-remove]')?.addEventListener('click', async () => {
          if (!confirm(`Remove ${name}'s access? They'll be signed out of every group and land back on the "waiting for approval" screen — you can re-approve them any time from here. This doesn't delete their account.`)) return;
          const { error } = await db.from('profiles').update({ role: 'pending', groups: [] }).eq('id', id);
          if (error) { console.error(error); showToast('Could not remove access — ' + (error.message || 'unknown error') + '.'); return; }
          showToast(`${name}'s access removed.`);
          await loadAdmin();
        });
      });
    }

