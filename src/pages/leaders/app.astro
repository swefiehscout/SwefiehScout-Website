    // Shared by the "this leader" and "all leaders" buttons — one
    // upfront fetch (attendance all-time, every assessment on file)
    // reused per leader rather than re-querying inside a loop.
    async function fetchLeaderReportBase() {
      await ensureAllLeadersLoaded();
      const [attRes, assessRes] = await Promise.all([
        db.from('leader_attendance').select('leader_id, date, meeting_type, present').eq('group_key', LEADERS_GROUP_KEY),
        db.from('leader_assessments').select('*').order('assessed_date', { ascending: false }),
      ]);
      const attRows = attRes.data || [];
      const totalMeetings = new Set(attRows.map((r: any) => `${r.meeting_type}|${r.date}`)).size;
      const assessByLeader = new Map<string, any[]>();
      (assessRes.data || []).forEach((r: any) => {
        if (!assessByLeader.has(r.leader_id)) assessByLeader.set(r.leader_id, []);
        assessByLeader.get(r.leader_id)!.push(r);
      });
      const namesById = new Map(state.allLeaders.map((p: any) => [p.id, p.name]));
      return { attRows, totalMeetings, assessByLeader, namesById };
    }
    function leaderAttendanceSummaryFor(leaderId: string, attRows: any[], totalMeetings: number) {
      const own = attRows.filter((r: any) => r.leader_id === leaderId && r.present);
      const attended = own.length;
      const last = own.reduce((acc: string | null, r: any) => (!acc || r.date > acc ? r.date : acc), null as string | null);
      const rate = totalMeetings ? Math.round((attended / totalMeetings) * 100) : null;
      return { attended, totalMeetings, last, rate };
    }
    // Draws one leader's whole section starting at a fresh pdfHeader()
    // (so a multi-leader PDF just needs doc.addPage() between calls) —
    // profile fields, all-time attendance, then the full ratings
    // history, retired-function names included as-is (function_name is
    // a snapshot, see leader_assessment_schema.sql).
    function drawLeaderAssessmentSection(doc: any, leader: any, base: any) {
      const y = pdfHeader(doc, 'Leader Assessment', leader.name, 'Leaders');
      const att = leaderAttendanceSummaryFor(leader.id, base.attRows, base.totalMeetings);
      pdfTable(doc, {
        startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
        head: [['Field', 'Value']],
        body: [
          ['Leader ID', leader.member_code || '—'],
          ['Role', leader.role === 'admin' ? 'Admin' : 'Leader'],
          ['Groups', leaderGroupsLabel(leader)],
          ['Phone', leader.phone || '—'],
          ['Email', leader.email || '—'],
          ['National ID', leader.national_id || '—'],
          ['DOB', leader.birth_date || '—'],
          ['Emergency contact', leader.emergency_contact_relation || leader.emergency_contact_phone ? `${leader.emergency_contact_relation || '—'}: ${leader.emergency_contact_phone || '—'}` : '—'],
          ['Allergies', leader.has_allergies ? (leader.allergy_detail || 'Yes') : '—'],
          ['Notes', leader.notes || '—'],
          ['Member since', leaderMemberSince(leader) || '—'],
          ['Attendance (all-time)', att.rate != null ? `${att.rate}% (${att.attended} / ${att.totalMeetings})` : 'No meetings logged yet'],
          ['Last attended', att.last || '—'],
        ],
      });
      let y2 = pdfNextY(doc, y);
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(11);
      doc.setTextColor(...PDF_ACCENT);
      doc.text('Function ratings', 14, y2);
      y2 += 4;
      const rows = base.assessByLeader.get(leader.id) || [];
      pdfTable(doc, {
        startY: y2, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9 },
        head: [['Date', 'Function', 'Rating', 'Notes', 'Assessed by']],
        body: rows.length ? rows.map((r: any) => [r.assessed_date, r.function_name, `${r.rating} / 5`, r.notes || '—', base.namesById.get(r.assessed_by) || '—']) : [['', 'No assessments logged yet', '', '', '']],
      });
    }
