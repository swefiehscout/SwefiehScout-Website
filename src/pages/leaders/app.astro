            <div class="ws-table-wrap">
              <table class="ws-table" data-lfunc-table>
                <thead><tr><th>Name</th><th>Description</th><th></th></tr></thead>
                <tbody data-lfunc-body></tbody>
              </table>
            </div>
          </div>
