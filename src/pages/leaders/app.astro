    // Shared Vendors: added once by an admin and ticked into one or more
    // groups (see shared_vendor_groups) — read-only here, managed from
    // the Admin console's own Vendors tab. Exact same shape as the
    // Library tab's own Documents/Shared Library split.
    async function loadSharedVendors() {
      if (!state.activeGroup) return;
      const { data, error } = await db.from('shared_vendor_groups').select('shared_vendors(*)').eq('group_key', state.activeGroup);
      if (error) { console.error(error); return; }
