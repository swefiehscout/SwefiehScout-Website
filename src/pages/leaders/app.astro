        const y = pdfHeader(doc, 'Social Media Finance Report', `${label}, Income ${income.toFixed(2)}, Expenses ${expense.toFixed(2)}, Net ${(income - expense).toFixed(2)}`);
        pdfTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9 },
          head: [['Date', 'Type', 'Category', 'Description', 'Amount', 'Added by']],
          body: rows.length ? rows.map((r: any) => [r.entry_date, r.entry_type === 'income' ? 'Income' : 'Expense', r.category || '—', r.description || '—', Number(r.amount).toFixed(2), r.created_by_name || '—']) : [['No entries this period', '', '', '', '', '']],
        });
        doc.save(pdfFilename('Social-Media-Finance', label));
      } catch (err) {
        console.error('social media finance report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    function bindReports() {
      populatePeriodSelects(els.reportMonth, els.reportYear, true);
      els.reportMonth.appendChild(new Option('Custom range…', 'RANGE'));
      populatePeriodSelects(els.reportFromMonth, els.reportFromYear);
      populatePeriodSelects(els.reportToMonth, els.reportToYear);
      els.reportMonth.addEventListener('change', () => {
        const isRange = els.reportMonth.value === 'RANGE';
        els.reportYearField.toggleAttribute('hidden', isRange);
        els.reportRangeRow.toggleAttribute('hidden', !isRange);
      });
      el('[data-report-finance]').addEventListener('click', downloadFinanceReport);
      el('[data-report-fees]').addEventListener('click', downloadFeesReport);
      el('[data-report-attendance]').addEventListener('click', downloadAttendanceReport);
      el('[data-report-curriculum]').addEventListener('click', downloadCurriculumReport);
      el('[data-report-roster]').addEventListener('click', downloadRosterReport);
      el('[data-report-vendors]').addEventListener('click', downloadVendorReport);
      el('[data-report-inventory]').addEventListener('click', downloadInventoryReport);
      el('[data-report-events]').addEventListener('click', downloadEventCalendarReport);
      el('[data-report-maintenance]').addEventListener('click', downloadMaintenanceReportCard);
      el('[data-report-music-finance]').addEventListener('click', downloadMusicFinanceReportCard);
      el('[data-report-sm-finance]').addEventListener('click', downloadSocialMediaFinanceReportCard);
      el('[data-report-content]').addEventListener('click', downloadContentReport);
      el('[data-report-credentials]').addEventListener('click', downloadCredentialsReport);
      el('[data-report-sponsors]').addEventListener('click', downloadSponsorsReport);
      el('[data-report-prcontacts]').addEventListener('click', downloadPrContactsReport);
    }

    // ---------- Curriculum (embedded, shared per group; month view only,
    // click-to-plan instead of drag-and-drop) ------------------------------
    function currComputeRange() {
      const first = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth(), 1);
      const last = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() + 1, 0);
      return { start: startOfWeek(first), end: addDays(startOfWeek(last), 6) };
    }
    async function currLoadMeetings() {
      const { start, end } = currComputeRange();
      const { data, error } = await db.from('curriculum_meetings').select('*')
        .eq('group_key', state.activeGroup).gte('date', toDateStr(start)).lte('date', toDateStr(end));
      if (error) { console.error(error); showToast('Could not load the curriculum.'); return; }
      state.curr.meetings = new Map((data || []).map((row: any) => [row.date, row]));
    }
    function currGetOrCreateMeeting(dateStr: string) {
      let m = state.curr.meetings.get(dateStr);
      if (!m) {
        m = { group_key: state.activeGroup, date: dateStr, theme: null, notes: null, materials_needed: null, activities: [], created_by: state.profile?.name || null };
        state.curr.meetings.set(dateStr, m);
      }
      return m;
    }
    async function currPersistMeeting(dateStr: string) {
      const m = state.curr.meetings.get(dateStr);
      if (!m) return;
      const isEmpty = (!m.activities || m.activities.length === 0) && !m.theme && !m.notes && !m.materials_needed && !m.attachment_path;
      try {
        if (isEmpty) {
          if (m.id) await db.from('curriculum_meetings').delete().eq('id', m.id);
          else await db.from('curriculum_meetings').delete().eq('group_key', state.activeGroup).eq('date', dateStr);
          state.curr.meetings.delete(dateStr);
          return;
        }
        const payload: any = {
          group_key: m.group_key, date: m.date, theme: m.theme || null, notes: m.notes || null,
          materials_needed: m.materials_needed || null,
          activities: m.activities, attachment_path: m.attachment_path || null, updated_by: state.profile?.name || null,
        };
        if (!m.id) payload.created_by = m.created_by || state.profile?.name || null;
        const { data, error } = await db.from('curriculum_meetings').upsert(payload, { onConflict: 'group_key,date' }).select().single();
        if (error) throw error;
        state.curr.meetings.set(dateStr, data);
        flashSaved();
      } catch (err) {
        console.error('curriculum save failed', err);
        showToast('Could not save, check your connection.');
      }
    }
    function currSubscribeRealtime(groupKey: string) {
      if (state.curr.channel) { db.removeChannel(state.curr.channel); state.curr.channel = null; }
      state.curr.channel = db.channel('curriculum-' + groupKey)
        .on('postgres_changes', {
          event: '*', schema: 'public', table: 'curriculum_meetings', filter: 'group_key=eq.' + groupKey,
        }, (payload: any) => {
          const row = payload.eventType === 'DELETE' ? payload.old : payload.new;
          if (!row || !row.date) return;
          if (payload.eventType === 'DELETE') state.curr.meetings.delete(row.date);
          else state.curr.meetings.set(row.date, row);
          currRefreshUI();
        })
        .subscribe();
    }
    function currRefreshUI() {
      currRenderMonth();
      if (state.curr.currentDay && els.currDayOverlay && !els.currDayOverlay.hidden) {
        currRenderActivityList(els.currDayList, state.curr.currentDay);
      }
    }
    function currActivityRowHTML(a: any) {
      return `
        <div class="curr-item" data-activity-id="${a.id}">
          <span class="curr-item-text"><span class="curr-item-en">${escapeHtml(a.en)}</span></span>
          <input type="number" min="0" step="5" class="curr-item-duration" placeholder="min"
                 value="${a.duration != null ? a.duration : ''}" data-duration="${a.id}" />
          <button type="button" class="curr-item-del" data-del="${a.id}" aria-label="Remove">×</button>
        </div>`;
    }
    function currRenderActivityList(container: any, dateStr: string) {
      if (!container) return;
      const m = state.curr.meetings.get(dateStr);
      const activities = m ? m.activities : [];
      container.innerHTML = activities.length
        ? activities.map(currActivityRowHTML).join('')
        : '<p class="curr-empty">No activities yet, pick one from the bank or add a custom one below.</p>';
      container.querySelectorAll('[data-del]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          mm.activities = mm.activities.filter((a: any) => a.id !== btn.dataset.del);
          currRefreshUI();
          currPersistMeeting(dateStr);
        });
      });
      container.querySelectorAll('[data-duration]').forEach((inp: any) => {
        inp.addEventListener('change', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          const act = mm.activities.find((a: any) => a.id === inp.dataset.duration);
          if (!act) return;
          act.duration = inp.value ? Number(inp.value) : null;
          currPersistMeeting(dateStr);
        });
      });
    }
    function currAddActivity(dateStr: string, en: string) {
      const activity = { id: cryptoRandomId(), en, duration: null };
      const m = currGetOrCreateMeeting(dateStr);
      m.activities.push(activity);
      currRefreshUI();
      currPersistMeeting(dateStr);
    }
    function currRenderMonth() {
      const anchor = state.curr.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) =>
        `<div class="curr-weekday">${w.en}</div>`
      ).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const meeting = state.curr.meetings.get(dateStr);
        const acts = meeting ? meeting.activities : [];
        const shown = acts.slice(0, 3);
        const extra = acts.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${acts.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          ${meeting && meeting.theme ? `<span class="curr-day-theme">${escapeHtml(meeting.theme)}</span>` : ''}
          <div class="curr-day-mini">
            ${shown.map((a: any) => `<span class="curr-mini-chip">${escapeHtml(a.en)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.currMonthGrid.innerHTML = html;
      els.currMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => currOpenDayPanel(cell.dataset.date));
      });
    }
    // Shows the current attachment (with a signed View link + Remove) if
    // the meeting has one, otherwise the upload form — never both at
    // once, same as everywhere else a single-slot attachment shows up.
    async function currRenderAttachment(m: any) {
      const path = m && m.attachment_path;
      els.currAttachmentUpload.toggleAttribute('hidden', !!path);
      els.currAttachmentFile.value = '';
      if (!path) { els.currAttachmentCurrent.setAttribute('hidden', ''); return; }
      els.currAttachmentCurrent.removeAttribute('hidden');
      const { data, error } = await db.storage.from('documents').createSignedUrl(path, 3600);
      els.currAttachmentLink.href = !error && data ? data.signedUrl : '#';
    }
    function currOpenDayPanel(dateStr: string) {
      state.curr.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      const m = state.curr.meetings.get(dateStr);
      els.currDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      els.currDayTheme.value = (m && m.theme) || '';
      els.currDayNotes.value = (m && m.notes) || '';
      els.currDayMaterials.value = (m && m.materials_needed) || '';
      currRenderActivityList(els.currDayList, dateStr);
      currRenderAttachment(m);
      els.currDayOverlay.removeAttribute('hidden');
      // Lock background scroll while the modal is open — otherwise the
      // page can scroll behind it and the sticky header/footer end up
      // looking like they're overlapping the popup.
      document.documentElement.style.overflow = 'hidden';
    }
    function currCloseDayPanel() {
      els.currDayOverlay.setAttribute('hidden', '');
      state.curr.currentDay = null;
      document.documentElement.style.overflow = '';
    }
    // Theme/Notes only commit when Save is pressed — activities (bank
    // picks, custom adds, removes) still save instantly, same as
    // everywhere else in the workspace.
    function currSaveDay() {
      if (!state.curr.currentDay) return;
      const m = currGetOrCreateMeeting(state.curr.currentDay);
      m.theme = els.currDayTheme.value.trim() || null;
      m.notes = els.currDayNotes.value.trim() || null;
      m.materials_needed = els.currDayMaterials.value.trim() || null;
      currPersistMeeting(state.curr.currentDay);
      currRenderMonth();
      currCloseDayPanel();
    }
    function currCancelDay() {
      currCloseDayPanel();
    }
    // Emptying theme/notes/activities/attachment is already what makes
    // currPersistMeeting() delete the row instead of upserting an
    // effectively-blank one (see its isEmpty check) — this button just
    // does that in one click instead of clearing every field by hand.
    function currClearDay() {
      const dateStr = state.curr.currentDay;
      if (!dateStr) return;
      const m = state.curr.meetings.get(dateStr);
      if (!m) { currCloseDayPanel(); return; }
      if (!confirm('Clear this day’s plan? Its theme, activities, and attachment are all removed.')) return;
      const oldAttachment = m.attachment_path;
      m.theme = null; m.notes = null; m.materials_needed = null; m.activities = []; m.attachment_path = null;
      currPersistMeeting(dateStr).then(() => {
        if (oldAttachment) db.storage.from('documents').remove([oldAttachment]);
      });
      currRenderMonth();
      currCloseDayPanel();
    }
    // Steps to the next/previous day, pulling in a different month's data
    // first if that date falls outside what's currently loaded.
    async function currStepDay(n: number) {
      if (!state.curr.currentDay) return;
      const next = addDays(parseDateStr(state.curr.currentDay), n);
      const nextStr = toDateStr(next);
      const { start, end } = currComputeRange();
      if (next < start || next > end) {
        state.curr.anchor = next;
        await currReload();
      }
      currOpenDayPanel(nextStr);
    }
    function currUpdateNavLabel() {
      const a = state.curr.anchor;
      els.currNavLabel.textContent = `${MONTHS[a.getMonth()].en} ${a.getFullYear()}`;
    }
    async function currReload() {
      currUpdateNavLabel();
      await currLoadMeetings();
      currRenderMonth();
      currRenderListView();
    }
    // Plain list of every meeting planned this month — the same rows
    // Export PDF produces, rendered on the page instead of downloaded.
    // Kept in sync alongside the calendar (not only when List is the
    // active view) so switching to it never shows stale data.
    function currRenderListView() {
      const { start, end } = currComputeRange();
      const rows: any[] = [];
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.curr.meetings.get(dateStr);
        if (m && ((m.activities && m.activities.length) || m.theme || m.notes || m.materials_needed)) {
          rows.push({
            dateLabel: `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}`,
            theme: m.theme,
            activities: m.activities || [],
            materials: m.materials_needed,
            notes: m.notes,
          });
        }
        d = addDays(d, 1);
      }
      els.currListBody.innerHTML = rows.length
        ? rows.map((r: any) => `
            <tr>
              <td data-label="Date">${escapeHtml(r.dateLabel)}</td>
              <td data-label="Theme">${escapeHtml(r.theme || '—')}</td>
              <td data-label="Activities">${r.activities.length
                ? r.activities.map((a: any) => escapeHtml(a.en) + (a.duration ? ` (${a.duration} min)` : '')).join('<br>')
                : '—'}</td>
              <td data-label="Materials Needed">${escapeHtml(r.materials || '—')}</td>
              <td data-label="Notes">${escapeHtml(r.notes || '—')}</td>
            </tr>
          `).join('')
        : '<tr><td colspan="5" class="ws-empty">Nothing planned yet this month.</td></tr>';
    }
    function currSetPlanView(view: string) {
      document.querySelectorAll('[data-plan-view]').forEach((b: any) => b.classList.toggle('curr-view-btn--active', b.dataset.planView === view));
      document.querySelectorAll('[data-curr-plan-view]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.currPlanView !== view));
    }
    function currNavPrev() {
      state.curr.anchor = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() - 1, 1);
      currReload();
    }
    function currNavNext() {
      state.curr.anchor = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() + 1, 1);
      currReload();
    }
    function currNavToday() { state.curr.anchor = new Date(); currReload(); }
    function currExportPDF() {
      const { start, end } = currComputeRange();
      const rows: any[] = [];
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.curr.meetings.get(dateStr);
        if (m && m.activities && m.activities.length) {
          const dateLabel = `${WEEKDAYS[d.getDay()].en} ${d.getDate()} ${MONTHS[d.getMonth()].en}`;
          const activitiesText = m.activities.map((a: any) => a.en + (a.duration ? ` (${a.duration} min)` : '')).join('\n');
          rows.push([dateLabel, m.theme || '—', activitiesText, m.notes || '—']);
        }
        d = addDays(d, 1);
      }
      const doc = new jsPDF();
      const y = pdfHeader(doc, 'Curriculum', els.currNavLabel.textContent);
      pdfTable(doc, {
        startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9, valign: 'top' },
        columnStyles: { 0: { cellWidth: 30 }, 1: { cellWidth: 32 } },
        head: [['Date', 'Theme', 'Activities', 'Notes']],
        body: rows.length ? rows : [['No meetings planned in this range yet.', '', '', '']],
      });
      doc.save(pdfFilename('Curriculum', els.currNavLabel.textContent));
    }

    // ---------- Activity Bank (per-group, editable) -----------------------
    // A dropdown rather than a wall of chips — chips stop being scannable
    // once a group has more than a handful of activities in their bank,
    // a <select> stays efficient no matter how long the list gets.
    function currRenderBankOptions() {
      const items = state.groupSettings?.activity_bank || [];
      if (!items.length) {
        els.currBankSelect.innerHTML = '<option value="">No activities yet, add some in the Activity Bank tab</option>';
        els.currBankSelect.disabled = true;
        return;
      }
      els.currBankSelect.disabled = false;
      els.currBankSelect.innerHTML = '<option value="">Choose an activity…</option>' +
        items.map((a: any) => `<option value="${escapeHtml(a.en)}">${escapeHtml(a.en)}</option>`).join('');
    }
    function currRenderBankList() {
      const items = state.groupSettings?.activity_bank || [];
      els.currBankList.innerHTML = items.length
        ? items.map((a: any) => `
            <span class="curr-bank-item">${escapeHtml(a.en)}<button type="button" data-remove-bank="${escapeHtml(a.id)}" aria-label="Remove">×</button></span>
          `).join('')
        : '<p class="ws-empty" style="padding:0.5rem 0">No activities in the bank yet, add one above.</p>';
      els.currBankList.querySelectorAll('[data-remove-bank]').forEach((btn: any) => {
        btn.addEventListener('click', () => currRemoveBankItem(btn.dataset.removeBank));
      });
    }
    async function currSaveBank(items: any[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, activity_bank: items }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save the activity bank.'); return; }
      state.groupSettings.activity_bank = items;
      currRenderBankOptions();
      currRenderBankList();
    }
    async function currAddBankItem(en: string) {
      if (!en.trim()) return;
      const current = state.groupSettings?.activity_bank || [];
      await currSaveBank([...current, { id: cryptoRandomId(), en: en.trim() }]);
    }
    async function currRemoveBankItem(id: string) {
      const current = state.groupSettings?.activity_bank || [];
      await currSaveBank(current.filter((a: any) => a.id !== id));
    }
    function currSetSubtab(name: string) {
      document.querySelectorAll('.curr-subtab').forEach((b: any) => b.classList.toggle('curr-subtab--active', b.dataset.subtab === name));
      document.querySelectorAll('[data-curr-subpanel]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.currSubpanel !== name));
    }

    function currBindStatics() {
      els.currPrev.addEventListener('click', currNavPrev);
      els.currNext.addEventListener('click', currNavNext);
      els.currToday.addEventListener('click', currNavToday);
      els.currExport.addEventListener('click', currExportPDF);
      document.querySelectorAll('[data-plan-view]').forEach((btn: any) => {
        btn.addEventListener('click', () => currSetPlanView(btn.dataset.planView));
      });
      els.currDaySave.addEventListener('click', currSaveDay);
      els.currDayClear.addEventListener('click', currClearDay);
      els.currDayCancel.addEventListener('click', currCancelDay);
      els.currAttachmentUploadBtn.addEventListener('click', async () => {
        const dateStr = state.curr.currentDay;
        if (!dateStr) return;
        const file = els.currAttachmentFile.files[0];
        if (!file) { showToast('Choose a file first.'); return; }
        els.currAttachmentUploadBtn.disabled = true;
        const path = `${state.activeGroup}/curriculum/${dateStr}-${Date.now()}-${file.name}`;
        const { error: upErr } = await db.storage.from('documents').upload(path, file);
        if (upErr) { console.error(upErr); showToast('Could not upload.'); els.currAttachmentUploadBtn.disabled = false; return; }
        const m = currGetOrCreateMeeting(dateStr);
        m.attachment_path = path;
        await currPersistMeeting(dateStr);
        await currRenderAttachment(state.curr.meetings.get(dateStr));
        els.currAttachmentUploadBtn.disabled = false;
      });
      els.currAttachmentRemove.addEventListener('click', async () => {
        const dateStr = state.curr.currentDay;
        const m = dateStr && state.curr.meetings.get(dateStr);
        if (!m || !m.attachment_path) return;
        const oldPath = m.attachment_path;
        m.attachment_path = null;
        await currPersistMeeting(dateStr);
        await db.storage.from('documents').remove([oldPath]);
        await currRenderAttachment(state.curr.meetings.get(dateStr) || null);
      });
      els.currDayPrev.addEventListener('click', () => currStepDay(-1));
      els.currDayNext.addEventListener('click', () => currStepDay(1));
      document.addEventListener('click', (e: any) => {
        if (els.currDayOverlay.hidden) return;
        if (e.target.closest('[data-curr-day-panel]')) return;
        if (e.target.closest('.curr-day-cell')) return;
        currCancelDay();
      });
      els.currBankSelectForm.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        const val = els.currBankSelect.value;
        if (!val || !state.curr.currentDay) return;
        currAddActivity(state.curr.currentDay, val);
        els.currBankSelect.value = '';
      });
      els.currCustomAddForm.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        const en = els.currCustomEn.value.trim();
        if (!en || !state.curr.currentDay) return;
        currAddActivity(state.curr.currentDay, en);
        els.currCustomEn.value = '';
      });
      document.querySelectorAll('.curr-subtab').forEach((btn: any) => {
        btn.addEventListener('click', () => currSetSubtab(btn.dataset.subtab));
      });
      els.currBankAddForm.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        currAddBankItem(els.currBankAddEn.value);
        els.currBankAddForm.reset();
      });
    }
    async function currStart() {
      await loadGroupSettings();
      currRenderBankOptions();
      currRenderBankList();
      currSubscribeRealtime(state.activeGroup);
      await currReload();
    }

    function showG2(focus = true) {
      els.g2Fields.hidden = false;
      els.g2Add.hidden = true;
      if (focus) els.mG2Rel.focus();
    }
    function hideG2() {
      els.g2Fields.hidden = true;
      els.g2Add.hidden = false;
      els.mG2Rel.value = '';
      els.mG2Phone.value = '';
    }
    function showAllergy(focus = true) {
      els.allergyFields.hidden = false;
      els.allergyAdd.hidden = true;
      if (focus) els.mAllergyDetail.focus();
    }
    function showEmail(focus = true) {
      els.emailFields.hidden = false;
      els.emailAdd.hidden = true;
      if (focus) els.mEmail.focus();
    }
    function hideEmail() {
      els.emailFields.hidden = true;
      els.emailAdd.hidden = false;
      els.mEmail.value = '';
    }
    function showNid(focus = true) {
      els.nidFields.hidden = false;
      els.nidAdd.hidden = true;
      if (focus) els.mNationalId.focus();
    }
    function hideNid() {
      els.nidFields.hidden = true;
      els.nidAdd.hidden = false;
      els.mNationalId.value = '';
    }
    function hideAllergy() {
      els.allergyFields.hidden = true;
      els.allergyAdd.hidden = false;
      els.mAllergyDetail.value = '';
    }
    function readMemberForm() {
      const name = els.mName.value.trim();
      if (!name) return null;
      const hasAllergies = !els.allergyFields.hidden;
      return {
        group_key: state.activeGroup,
        full_name: name,
        phone: els.mPhone.value.trim() || null,
        birth_date: els.mDob.value || null,
        guardian1_relation: els.mG1Rel.value || null,
        guardian1_phone: els.mG1Phone.value.trim() || null,
        guardian2_relation: !els.g2Fields.hidden ? (els.mG2Rel.value || null) : null,
        guardian2_phone: !els.g2Fields.hidden ? (els.mG2Phone.value.trim() || null) : null,
        has_allergies: hasAllergies,
        allergy_detail: hasAllergies ? els.mAllergyDetail.value.trim() || null : null,
        email: !els.emailFields.hidden ? (els.mEmail.value.trim() || null) : null,
        national_id: !els.nidFields.hidden ? (els.mNationalId.value.trim() || null) : null,
        notes: els.mNotes.value.trim() || null,
      };
    }
    function resetMemberForm() {
      els.rosterForm.reset();
      hideG2();
      hideAllergy();
      hideEmail();
      hideNid();
      state.editingMemberId = null;
      els.formTitle.textContent = 'Add a member';
      els.formSubmit.textContent = 'Add member';
      els.formCancel.hidden = true;
    }
    function startEditMember(id: string) {
      const m = state.members.find((x: any) => x.id === id);
      if (!m) return;
      if (state.activeTab !== 'roster') setTab('roster');
      state.editingMemberId = id;
      els.mName.value = m.full_name || '';
      els.mPhone.value = m.phone || '';
      els.mDob.value = m.birth_date || '';
      els.mG1Rel.value = m.guardian1_relation || '';
      els.mG1Phone.value = m.guardian1_phone || '';
      if (m.guardian2_relation || m.guardian2_phone) {
        showG2(false);
        els.mG2Rel.value = m.guardian2_relation || '';
        els.mG2Phone.value = m.guardian2_phone || '';
      } else {
        hideG2();
      }
      if (m.has_allergies) {
        showAllergy(false);
        els.mAllergyDetail.value = m.allergy_detail || '';
      } else {
        hideAllergy();
      }
      if (m.email) {
        showEmail(false);
        els.mEmail.value = m.email;
      } else {
        hideEmail();
      }
      if (m.national_id) {
        showNid(false);
        els.mNationalId.value = m.national_id;
      } else {
        hideNid();
      }
      els.mNotes.value = m.notes || '';
      els.formTitle.textContent = `Editing ${m.full_name}`;
      els.formSubmit.textContent = 'Save changes';
      els.formCancel.hidden = false;
      els.rosterForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function bindRosterForm() {
      bindTitleCase(els.mName);
      els.g2Add.addEventListener('click', () => showG2());
      els.g2Remove.addEventListener('click', () => hideG2());
      els.allergyAdd.addEventListener('click', () => showAllergy());
      els.allergyRemove.addEventListener('click', () => hideAllergy());
      els.emailAdd.addEventListener('click', () => showEmail());
      els.emailRemove.addEventListener('click', () => hideEmail());
      els.nidAdd.addEventListener('click', () => showNid());
      els.nidRemove.addEventListener('click', () => hideNid());
      els.formCancel.addEventListener('click', resetMemberForm);
      els.rosterForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const payload = readMemberForm();
        if (!payload) { showToast('Full name is required.'); return; }
        if (state.editingMemberId) {
          const { error } = await db.from('members').update(payload).eq('id', state.editingMemberId);
          if (error) { console.error(error); showToast('Could not save member.'); return; }
        } else {
          const { error } = await db.from('members').insert({ ...payload, created_by: state.session.user.id });
          if (error) { console.error(error); showToast('Could not add member.'); return; }
        }
        resetMemberForm();
        await loadRoster();
      });
    }

    // ---------- Dashboard ---------------------------------------------------
    function dashGreeting() {
      const h = new Date().getHours();
      const first = (state.profile?.name || '').trim().split(/\s+/)[0];
      const time = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
      return first ? `${time}, ${first}` : time;
    }
    function dashDeltaBadge(val: number | null, suffix = ''): string {
      if (val == null || Number.isNaN(val) || val === 0) {
        return `<span class="ws-dash-delta ws-dash-delta--flat">– steady</span>`;
      }
      const up = val > 0;
      return `<span class="ws-dash-delta ${up ? 'ws-dash-delta--up' : 'ws-dash-delta--down'}">${up ? '↑' : '↓'} ${Math.abs(val)}${suffix} vs last period</span>`;
    }
    async function loadDashboard() {
      if (!state.activeGroup) return;
      await ensureMembersLoaded();
      await loadGroupSettings();

      const g = GROUPS.find((x: any) => x.key === state.activeGroup);
      els.dashGreeting.textContent = dashGreeting();
      els.dashGroup.textContent = g ? `${g.en} workspace` : 'Your workspace';
      els.dashDate.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

      const active = state.members.filter((m: any) => m.active);
      const archivedCount = state.members.length - active.length;
      const allergyCount = active.filter((m: any) => m.has_allergies).length;

      const now = new Date();
      const day30 = toDateStr(addDays(now, -30));
      const day60 = toDateStr(addDays(now, -60));
      const day90 = toDateStr(addDays(now, -90));
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthEnd = `${period}-${String(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const prevMonthEnd = `${prevPeriod}-${String(new Date(prevD.getFullYear(), prevD.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      // Six calendar months ending this month, for the Income vs. expenses
      // chart — pulled in the same query as the KPI's this-month/last-
      // month comparison rather than a second round trip.
      const sixAgoD = new Date(now.getFullYear(), now.getMonth() - 5, 1);
      const sixStart = `${sixAgoD.getFullYear()}-${String(sixAgoD.getMonth() + 1).padStart(2, '0')}-01`;
      const monthKeys: string[] = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        monthKeys.push(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`);
      }

      const [attRes, curRes, feeRes, finRes, pendingRes] = await Promise.all([
        db.from('attendance').select('date, present').eq('group_key', state.activeGroup).gte('date', day90).order('date', { ascending: true }),
        db.from('curriculum_meetings').select('date, theme, activities').eq('group_key', state.activeGroup).gte('date', todayStr()).order('date', { ascending: true }).limit(1),
        db.from('fee_payments').select('paid, amount').eq('group_key', state.activeGroup).eq('period', period),
        db.from('finance_entries').select('entry_type, amount, entry_date, category, description').eq('group_key', state.activeGroup).gte('entry_date', sixStart).lte('entry_date', monthEnd).order('entry_date', { ascending: false }),
        db.from('join_requests').select('id', { count: 'exact', head: true }).eq('group_key', state.activeGroup).eq('status', 'pending'),
      ]);
      const attRows = attRes.data || [];
      const feeRows = feeRes.data || [];
      const finRows = finRes.data || [];
      const nextMeeting = (curRes.data || [])[0] || null;
      const pendingCount = pendingRes.count || 0;

      // Attendance: per-date rollup (chart) + 30-day rate vs the prior 30
      // days (KPI trend).
      const byDate = new Map<string, { present: number; total: number }>();
      attRows.forEach((r: any) => {
        const e = byDate.get(r.date) || { present: 0, total: 0 };
        e.total++; if (r.present) e.present++;
        byDate.set(r.date, e);
      });
      const lastDates = Array.from(byDate.keys()).sort().slice(-8);
      const rateOf = (rows: any[]) => rows.length ? Math.round((rows.filter((r: any) => r.present).length / rows.length) * 100) : null;
      const rate30 = rateOf(attRows.filter((r: any) => r.date >= day30));
      const ratePrev30 = rateOf(attRows.filter((r: any) => r.date >= day60 && r.date < day30));

      // Fees: this period's paid count/amount out of every active member.
      const paidCount = feeRows.filter((r: any) => r.paid).length;
      const collected = feeRows.reduce((s: number, r: any) => s + (r.paid ? Number(r.amount || 0) : 0), 0);
      const feePct = active.length ? Math.round((paidCount / active.length) * 100) : 0;

      // Finance: net income this month vs last month.
      const netFor = (start: string, end: string) => finRows
        .filter((r: any) => r.entry_date >= start && r.entry_date <= end)
        .reduce((s: number, r: any) => s + (r.entry_type === 'income' ? Number(r.amount) : -Number(r.amount)), 0);
      const netThis = netFor(`${period}-01`, monthEnd);
      const netPrev = netFor(`${prevPeriod}-01`, prevMonthEnd);

      // Same finRows, bucketed by month instead of summed — for the
      // Income vs. expenses chart.
      const byMonth = new Map<string, { income: number; expense: number }>();
      monthKeys.forEach((k) => byMonth.set(k, { income: 0, expense: 0 }));
      finRows.forEach((r: any) => {
        const bucket = byMonth.get(String(r.entry_date).slice(0, 7));
        if (!bucket) return;
        if (r.entry_type === 'income') bucket.income += Number(r.amount); else bucket.expense += Number(r.amount);
      });

      renderDashKpis({ activeCount: active.length, archivedCount, rate30, ratePrev30, feePct, paidCount, totalActive: active.length, collected, netThis, netPrev });
      renderDashFinanceChart(monthKeys, byMonth);
      renderDashAttendanceChart(lastDates, byDate);
      renderDashFeesDonut(feePct, paidCount, active.length, collected);
      renderDashNextMeeting(nextMeeting);
      renderDashRecentFinance(finRows.slice(0, 5));
      renderDashAttention({ pendingCount, allergyCount, unpaidCount: active.length - paidCount, hasActiveMembers: active.length > 0 });
    }
    // Eases a KPI number up from 0 to its real value instead of just
    // appearing — small thing, but it's what makes the dashboard feel
    // alive rather than a static readout.
    function animateCountUp(el: any, target: number, format: (v: number) => string, duration = 900) {
      if (!el) return;
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = format(target * eased);
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = format(target);
      }
      requestAnimationFrame(tick);
    }
    function renderDashKpis(d: any) {
      els.dashKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Active members</span></div>
          <span class="ws-dash-kpi-num" data-kpi="active">0</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${d.archivedCount} archived</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Attendance (30d)</span></div>
          <span class="ws-dash-kpi-num" data-kpi="rate">${d.rate30 != null ? '0%' : '—'}</span>
          ${d.rate30 != null ? dashDeltaBadge(d.ratePrev30 != null ? d.rate30 - d.ratePrev30 : null, 'pt') : '<span class="ws-dash-delta ws-dash-delta--flat">No sessions yet</span>'}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">$</span><span class="ws-dash-kpi-label">Fees collected</span></div>
          <span class="ws-dash-kpi-num" data-kpi="fees">0%</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${d.paidCount}/${d.totalActive} paid · ${d.collected.toFixed(0)}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">±</span><span class="ws-dash-kpi-label">Net income (mtd)</span></div>
          <span class="ws-dash-kpi-num" data-kpi="net">${d.netThis >= 0 ? '+0' : '−0'}</span>
          ${dashDeltaBadge(Math.round(d.netThis - d.netPrev))}
        </div>
      `;
      animateCountUp(els.dashKpis.querySelector('[data-kpi="active"]'), d.activeCount, (v) => String(Math.round(v)));
      if (d.rate30 != null) {
        animateCountUp(els.dashKpis.querySelector('[data-kpi="rate"]'), d.rate30, (v) => Math.round(v) + '%');
      }
      animateCountUp(els.dashKpis.querySelector('[data-kpi="fees"]'), d.feePct, (v) => Math.round(v) + '%');
      animateCountUp(els.dashKpis.querySelector('[data-kpi="net"]'), Math.abs(d.netThis), (v) => (d.netThis >= 0 ? '+' : '−') + Math.round(v));
    }
    function renderDashAttendanceChart(lastDates: string[], byDate: Map<string, { present: number; total: number }>) {
      if (!lastDates.length) {
        els.dashAttChart.innerHTML = '<p class="ws-dash-empty-mini">No attendance recorded in the last 90 days.</p>';
        els.dashAttSub.textContent = '';
        return;
      }
      els.dashAttSub.textContent = `Last ${lastDates.length} session${lastDates.length === 1 ? '' : 's'}`;
      els.dashAttChart.innerHTML = `
        <div class="ws-dash-bars">
          ${lastDates.map((dateStr) => {
            const e = byDate.get(dateStr)!;
            const pct = e.total ? Math.round((e.present / e.total) * 100) : 0;
            const d = parseDateStr(dateStr);
            const label = `${MONTHS[d.getMonth()].en.slice(0, 3)} ${d.getDate()}`;
            return `
              <div class="ws-dash-bar-col" title="${label}, ${pct}% present (${e.present}/${e.total})">
                <span class="ws-dash-bar-pct">${pct}%</span>
                <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style="height:${Math.max(pct, 4)}%"></div></div>
                <span class="ws-dash-bar-label">${label}</span>
              </div>`;
          }).join('')}
        </div>
      `;
    }
    function renderDashFinanceChart(monthKeys: string[], byMonth: Map<string, { income: number; expense: number }>) {
      const totalIncome = monthKeys.reduce((s, k) => s + byMonth.get(k)!.income, 0);
      const totalExpense = monthKeys.reduce((s, k) => s + byMonth.get(k)!.expense, 0);
      const net = totalIncome - totalExpense;
      els.dashFinSub.textContent = `Last 6 months · Net ${net >= 0 ? '+' : '−'}${Math.abs(net).toFixed(0)}`;
      if (!totalIncome && !totalExpense) {
        els.dashFinChart.innerHTML = '<p class="ws-dash-empty-mini">No Finance entries in the last 6 months.</p>';
        return;
      }
      const maxVal = Math.max(1, ...monthKeys.map((k) => Math.max(byMonth.get(k)!.income, byMonth.get(k)!.expense)));
      els.dashFinChart.innerHTML = `
        <div class="ws-dash-fin-bars">
          ${monthKeys.map((k) => {
            const b = byMonth.get(k)!;
            const d = new Date(Number(k.slice(0, 4)), Number(k.slice(5, 7)) - 1, 1);
            const label = MONTHS[d.getMonth()].en.slice(0, 3);
            const incPct = Math.round((b.income / maxVal) * 100);
            const expPct = Math.round((b.expense / maxVal) * 100);
            return `
              <div class="ws-dash-fin-col" title="${MONTHS[d.getMonth()].en} ${d.getFullYear()}, Income ${b.income.toFixed(2)}, Expenses ${b.expense.toFixed(2)}">
                <div class="ws-dash-fin-pair">
                  <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--income" style="height:${b.income ? Math.max(incPct, 3) : 0}%"></div></div>
                  <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--expense" style="height:${b.expense ? Math.max(expPct, 3) : 0}%"></div></div>
                </div>
                <span class="ws-dash-fin-label">${label}</span>
              </div>`;
          }).join('')}
        </div>
        <div class="ws-dash-fin-legend">
          <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--income"></i>Income</span>
          <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--expense"></i>Expenses</span>
        </div>
      `;
    }
    function renderDashFeesDonut(pct: number, paidCount: number, total: number, collected: number) {
      if (!total) {
        els.dashFeesDonut.innerHTML = '<p class="ws-dash-empty-mini">No active members yet.</p>';
        return;
      }
      els.dashFeesDonut.innerHTML = `
        <div class="ws-dash-donut" style="--pct:${pct}%">
          <div class="ws-dash-donut-center">
            <span class="ws-dash-donut-num">${pct}%</span>
            <span class="ws-dash-donut-label">Collected</span>
          </div>
        </div>
        <p class="ws-dash-donut-foot">${paidCount} of ${total} paid · ${collected.toFixed(2)} in</p>
      `;
    }
    function renderDashNextMeeting(meeting: any) {
      if (!meeting) {
        els.dashNextMeeting.innerHTML = `
          <p class="ws-dash-empty-mini">Nothing planned yet.</p>
          <button type="button" class="ws-dash-mini-link" data-goto-tab="curriculum">Plan a meeting →</button>
        `;
        return;
      }
      const d = parseDateStr(meeting.date);
      const dateLabel = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}`;
