          <div data-subpanel="content:settings" hidden>
            <div class="ws-form-grid">
              <div class="ws-member-form">
                <div class="ws-member-form-bar" aria-hidden="true"></div>
                <p class="ws-member-form-title">Platforms</p>
                <div class="ws-category-add">
                  <input type="text" data-content-platform-cat-input placeholder="e.g. Instagram" />
                  <button type="button" class="btn-primary" data-content-platform-cat-add>Add</button>
                </div>
                <div class="ws-category-list" data-content-platform-cat-list></div>
              </div>
              <div class="ws-member-form">
                <div class="ws-member-form-bar" aria-hidden="true"></div>
                <p class="ws-member-form-title">Content types</p>
                <div class="ws-category-add">
                  <input type="text" data-content-type-cat-input placeholder="e.g. Reel" />
                  <button type="button" class="btn-primary" data-content-type-cat-add>Add</button>
                </div>
                <div class="ws-category-list" data-content-type-cat-list></div>
              </div>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="credentials" hidden>
          <p class="ws-att-hint">Login info for the org's own social media accounts. Visible in plain text to anyone with access to this group — passwords are masked by default, click Reveal to view one.</p>
          <form class="ws-member-form" data-cred-form>
            <div class="ws-member-form-bar" aria-hidden="true"></div>
            <p class="ws-member-form-title" data-cred-form-title>Add a login</p>
            <div class="ws-form-grid ws-form-grid--4">
              <label class="ws-field">
                <span>Service *</span>
                <input type="text" data-cred-service placeholder="e.g. Instagram" required />
              </label>
              <label class="ws-field">
                <span>Username / Email</span>
                <input type="text" data-cred-username />
              </label>
              <label class="ws-field">
                <span>Password</span>
                <input type="text" data-cred-password />
              </label>
              <label class="ws-field">
                <span>Login URL</span>
                <input type="text" data-cred-url placeholder="https://…" />
              </label>
            </div>
            <label class="ws-field ws-field--full">
              <span>Notes</span>
              <input type="text" data-cred-notes />
            </label>
            <div class="ws-form-actions">
              <button type="submit" class="btn-primary" data-cred-submit>Add login</button>
              <button type="button" class="ws-form-cancel" data-cred-cancel hidden>Cancel edit</button>
            </div>
          </form>

          <input type="search" class="ws-search" data-cred-search placeholder="Search logins…" />

          <div class="ws-table-wrap">
            <table class="ws-table" data-cred-table>
              <thead>
                <tr><th>Service</th><th>Username</th><th>Password</th><th>URL</th><th>Notes</th><th>Added</th><th>Updated by</th><th></th></tr>
              </thead>
              <tbody data-cred-body></tbody>
            </table>
          </div>
        </section>

        <section class="ws-panel" data-panel="library" hidden>
          <div class="ws-subtabs">
            <button type="button" class="ws-subtab ws-subtab--active" data-subtabs="library" data-subtab="documents">Documents</button>
            <button type="button" class="ws-subtab" data-subtabs="library" data-subtab="shared">Shared Library</button>
            <button type="button" class="ws-subtab" data-subtabs="library" data-subtab="lessons" data-troop-only>Lessons</button>
          </div>

          <div data-subpanel="library:documents">
            <div class="ws-member-form ws-library-upload">
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Upload a document</p>
              <div class="ws-form-grid">
                <label class="ws-field">
                  <span>File *</span>
                  <input type="file" data-lib-file />
                </label>
                <label class="ws-field">
                  <span>Title (optional)</span>
                  <input type="text" data-lib-title placeholder="Defaults to the file name" />
                </label>
              </div>
              <div class="ws-form-actions">
                <button type="button" class="btn-primary" data-lib-upload>Upload</button>
              </div>
            </div>
            <div class="ws-table-wrap">
              <table class="ws-table" data-lib-table>
                <thead>
                  <tr><th>Title</th><th>Type</th><th>Uploaded</th><th>Uploaded by</th><th></th></tr>
                </thead>
                <tbody data-lib-body></tbody>
              </table>
            </div>
          </div>

          <div data-subpanel="library:shared" hidden>
            <p class="ws-att-hint">Uploaded once by an admin, for one or more groups at once — manage or remove these from the Admin console's own Library.</p>
            <div class="ws-table-wrap">
              <table class="ws-table" data-lib-shared-table>
                <thead>
                  <tr><th>Title</th><th>Type</th><th>Uploaded</th><th>Uploaded by</th><th></th></tr>
                </thead>
                <tbody data-lib-shared-body></tbody>
              </table>
            </div>
          </div>

          <div data-subpanel="library:lessons" hidden>
            <div class="ws-table-wrap">
              <table class="ws-table" data-lessons-table>
                <thead><tr><th>Resource</th><th></th></tr></thead>
                <tbody>
                  {LESSON_LINKS.map((l) => (
                    <tr>
                      <td data-label="Resource">{l.label}</td>
                      <td class="ws-row-actions">
                        {l.url
                          ? <a class="ws-edit-btn" href={l.url} target="_blank" rel="noopener">Open →</a>
                          : <span class="ws-empty" style="padding:0">Not linked yet</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="reports" hidden>
          <div class="ws-toolbar-row">
            <label class="ws-field ws-field--inline">
              <span>Month</span>
              <select data-report-month></select>
            </label>
            <label class="ws-field ws-field--inline" data-report-year-field>
              <span>Year</span>
              <select data-report-year></select>
            </label>
          </div>
          <div class="ws-toolbar-row" data-report-range-row hidden>
            <label class="ws-field ws-field--inline"><span>From</span><select data-report-from-month></select></label>
            <label class="ws-field ws-field--inline"><span>&nbsp;</span><select data-report-from-year></select></label>
            <label class="ws-field ws-field--inline"><span>To</span><select data-report-to-month></select></label>
            <label class="ws-field ws-field--inline"><span>&nbsp;</span><select data-report-to-year></select></label>
          </div>
          <div class="ws-report-grid">
            <div class="ws-report-card" data-generic-finance>
              <h3 class="ws-admin-h3">Income Statement</h3>
              <p class="ws-report-desc">Income and expenses by category, with totals and net income.</p>
              <button type="button" class="btn-primary" data-report-finance>Download PDF</button>
            </div>
            <div class="ws-report-card" data-music-only hidden>
              <h3 class="ws-admin-h3">Music Finance Report</h3>
              <p class="ws-report-desc">Music's own income/expense ledger for the period, income vs. Band Payouts, Transport, and every other category.</p>
              <button type="button" class="btn-primary" data-report-music-finance>Download PDF</button>
            </div>
            <div class="ws-report-card" data-social-only hidden>
              <h3 class="ws-admin-h3">Social Media Finance Report</h3>
              <p class="ws-report-desc">Social Media's own income/expense ledger for the period, by category, with totals and net income.</p>
              <button type="button" class="btn-primary" data-report-sm-finance>Download PDF</button>
            </div>
            <div class="ws-report-card" data-troop-only>
              <h3 class="ws-admin-h3">Monthly Fees</h3>
              <p class="ws-report-desc">Every active member's paid status and amount for the period.</p>
              <button type="button" class="btn-primary" data-report-fees>Download PDF</button>
            </div>
            <div class="ws-report-card" data-troop-only>
              <h3 class="ws-admin-h3">Attendance</h3>
              <p class="ws-report-desc">Every active member's attendance count and rate for the period.</p>
              <button type="button" class="btn-primary" data-report-attendance>Download PDF</button>
            </div>
            <div class="ws-report-card" data-troop-only>
              <h3 class="ws-admin-h3">Curriculum</h3>
              <p class="ws-report-desc">The meeting plan, theme, notes, and activities for each date in the period.</p>
              <button type="button" class="btn-primary" data-report-curriculum>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Roster</h3>
              <p class="ws-report-desc">Every active member in this group, with full contact and emergency-contact info. Not period-dependent.</p>
              <button type="button" class="btn-primary" data-report-roster>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Vendors</h3>
              <p class="ws-report-desc">This group's own vendors, plus any shared vendors visible to it. Not period-dependent.</p>
              <button type="button" class="btn-primary" data-report-vendors>Download PDF</button>
            </div>
            <div class="ws-report-card" data-music-only hidden>
              <h3 class="ws-admin-h3">Inventory</h3>
              <p class="ws-report-desc">Every item this group owns, with category, quantity, condition, and who it's assigned to. Not period-dependent.</p>
              <button type="button" class="btn-primary" data-report-inventory>Download PDF</button>
            </div>
            <div class="ws-report-card" data-music-only hidden>
              <h3 class="ws-admin-h3">Music Event Report</h3>
              <p class="ws-report-desc">Every booking in the period — client, type, attendees, amount received, payouts, and net.</p>
              <button type="button" class="btn-primary" data-report-events>Download PDF</button>
            </div>
            <div class="ws-report-card" data-music-only hidden>
              <h3 class="ws-admin-h3">Maintenance</h3>
              <p class="ws-report-desc">Every maintenance record logged in the period — item, vendor, cost, and who logged it.</p>
              <button type="button" class="btn-primary" data-report-maintenance>Download PDF</button>
            </div>
            <div class="ws-report-card" data-social-only hidden>
              <h3 class="ws-admin-h3">Content Calendar</h3>
              <p class="ws-report-desc">Every content item scheduled for the period, with platform, type, status, and who it's assigned to.</p>
              <button type="button" class="btn-primary" data-report-content>Download PDF</button>
            </div>
            <div class="ws-report-card" data-social-only hidden>
              <h3 class="ws-admin-h3">Credentials</h3>
              <p class="ws-report-desc">Every login stored in the Credentials tab, in full. Not period-dependent.</p>
              <button type="button" class="btn-primary" data-report-credentials>Download PDF</button>
            </div>
            <div class="ws-report-card" data-general-only hidden>
              <h3 class="ws-admin-h3">Sponsors</h3>
              <p class="ws-report-desc">Every sponsor and prospective sponsor, with contact info, type, and status. Not period-dependent.</p>
              <button type="button" class="btn-primary" data-report-sponsors>Download PDF</button>
            </div>
            <div class="ws-report-card" data-general-only hidden>
              <h3 class="ws-admin-h3">Community &amp; Church Contacts</h3>
              <p class="ws-report-desc">Every clergy, organization, school, media, and government contact on file. Not period-dependent.</p>
              <button type="button" class="btn-primary" data-report-prcontacts>Download PDF</button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Curriculum day planner — centered popup, opened by clicking a date -->
  <div class="curr-day-overlay" data-curr-day-overlay hidden>
    <div class="curr-day-panel" data-curr-day-panel>
      <div class="curr-day-banner">
        <button type="button" class="curr-day-nav-btn" data-curr-day-prev aria-label="Previous day">‹</button>
        <span class="curr-day-banner-text">
          <span class="curr-day-banner-label">Planning for</span>
          <p class="curr-day-banner-value" data-curr-day-header></p>
        </span>
        <button type="button" class="curr-day-nav-btn" data-curr-day-next aria-label="Next day">›</button>
      </div>

      <div class="curr-day-field-row">
        <label class="curr-day-field">
          <span>Theme</span>
          <input type="text" data-day-theme placeholder="e.g. First Aid Badge" />
        </label>
        <label class="curr-day-field">
          <span>Notes</span>
          <textarea data-day-notes rows="2" placeholder="Anything to remember for this meeting…"></textarea>
        </label>
      </div>

      <label class="curr-day-field">
        <span>Materials needed</span>
        <textarea data-day-materials rows="2" placeholder="e.g. rope, first aid kit, cones…"></textarea>
      </label>

      <p class="curr-day-section-label">Attachment</p>
      <div class="curr-day-attachment" data-curr-attachment-current hidden>
        <a class="ws-edit-btn" data-curr-attachment-link target="_blank" rel="noopener">View attachment →</a>
        <button type="button" class="ws-row-del" data-curr-attachment-remove title="Remove">×</button>
      </div>
      <div class="curr-day-custom-add curr-day-custom-add--tight" data-curr-attachment-upload>
        <input type="file" accept="image/*,.pdf,.doc,.docx" data-curr-attachment-file />
        <button type="button" class="btn-primary" data-curr-attachment-upload-btn>Upload</button>
      </div>

      <p class="curr-day-section-label">Add an activity</p>
      <form class="curr-day-custom-add" data-curr-bank-select-form>
        <select data-curr-bank-select>
          <option value="">Choose from the activity bank…</option>
        </select>
        <button type="submit" class="btn-primary">Add</button>
      </form>
      <form class="curr-day-custom-add curr-day-custom-add--tight" data-curr-custom-add-form>
        <input type="text" data-custom-en placeholder="…or type a custom one" />
        <button type="submit" class="btn-primary">Add</button>
      </form>

      <p class="curr-day-section-label">This meeting</p>
      <div class="curr-day-list" data-curr-day-list></div>

      <div class="curr-day-actions">
        <button type="button" class="ws-edit-btn" data-curr-day-clear>Clear day</button>
        <button type="button" class="ws-form-cancel" data-curr-day-close-cancel>Cancel</button>
        <button type="button" class="btn-primary" data-curr-day-save>Save &amp; close</button>
      </div>
    </div>
  </div>

  <!-- Event Calendar's day view — an agenda of that day's bookings, and
       the add/edit form for one of them at a time (never both shown at
       once). Reuses Curriculum's curr-day-overlay/curr-day-panel shell
       for a consistent look, but is otherwise its own component since a
       day can hold several bookings instead of Curriculum's one. -->
  <div class="curr-day-overlay" data-evt-day-overlay hidden>
    <div class="curr-day-panel" data-evt-day-panel>
      <div class="curr-day-banner">
        <span class="curr-day-banner-text">
          <span class="curr-day-banner-label">Events for</span>
          <p class="curr-day-banner-value" data-evt-day-header></p>
        </span>
      </div>

      <div data-evt-day-list-view>
        <div class="curr-day-list" data-evt-day-list></div>
        <div class="curr-day-actions">
          <button type="button" class="ws-form-cancel" data-evt-day-close>Close</button>
          <button type="button" class="btn-primary" data-evt-day-add>+ Add event</button>
        </div>
      </div>

      <form data-evt-form-view hidden>
        <p class="curr-day-section-label" data-evt-form-title>New event</p>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>First name *</span>
            <input type="text" data-evt-first-name required />
          </label>
          <label class="curr-day-field">
            <span>Last name *</span>
            <input type="text" data-evt-last-name required />
          </label>
        </div>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>Phone *</span>
            <input type="tel" data-evt-phone required />
          </label>
          <label class="curr-day-field">
            <span>Email (optional)</span>
            <input type="email" data-evt-email />
          </label>
        </div>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>Date *</span>
            <input type="date" data-evt-date required />
          </label>
          <label class="curr-day-field">
            <span>Time</span>
            <input type="time" data-evt-time />
          </label>
        </div>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>Event type *</span>
            <select data-evt-type required></select>
          </label>
          <label class="curr-day-field">
            <span>Location</span>
            <select data-evt-location></select>
          </label>
        </div>
        <div class="curr-day-field-row" data-evt-location-custom-row hidden>
          <label class="curr-day-field">
            <span>Custom location</span>
            <input type="text" data-evt-location-custom placeholder="Enter a location" />
          </label>
        </div>
        <label class="curr-day-field">
          <span>Notes</span>
          <textarea data-evt-notes rows="2"></textarea>
        </label>

        <p class="curr-day-section-label">Band members playing</p>
        <div class="ws-evt-attendees" data-evt-attendees></div>

        <p class="curr-day-section-label">Financial completion — fill in once the event has happened</p>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>Amount received</span>
            <input type="number" step="0.01" min="0" data-evt-amount />
          </label>
          <label class="curr-day-field">
            <span>Received via</span>
            <select data-evt-payment-method>
              <option value="">— Select —</option>
              <option>Cliq</option>
              <option>Cash</option>
              <option>Check</option>
              <option>Other</option>
            </select>
          </label>
        </div>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>Pay per member</span>
            <input type="number" step="0.01" min="0" data-evt-pay-rate />
          </label>
        </div>
        <div class="curr-day-field-row" data-evt-transport-row hidden>
          <label class="curr-day-field">
            <span>Transport pay per member</span>
            <input type="number" step="0.01" min="0" data-evt-transport-rate />
          </label>
          <p class="curr-day-field" data-evt-payout-summary></p>
        </div>

        <div data-evt-costs-section hidden>
          <p class="curr-day-section-label">Extra costs</p>
          <div class="ws-form-grid ws-form-grid--4">
            <label class="ws-field">
              <span>Category</span>
              <select data-evt-cost-category></select>
            </label>
            <label class="ws-field">
              <span>Amount</span>
              <input type="number" step="0.01" min="0" data-evt-cost-amount />
            </label>
            <label class="ws-field">
              <span>Description</span>
              <input type="text" data-evt-cost-desc />
            </label>
            <label class="ws-field">
              <span>Date</span>
              <input type="date" data-evt-cost-date />
            </label>
          </div>
          <div class="ws-form-actions">
            <button type="button" class="btn-primary" data-evt-cost-add>Add cost</button>
          </div>
          <div class="ws-table-wrap">
            <table class="ws-table" data-evt-cost-table>
              <thead><tr><th>Date</th><th>Category</th><th>Description</th><th>Amount</th><th>Added by</th><th></th></tr></thead>
              <tbody data-evt-cost-body></tbody>
            </table>
          </div>
        </div>

        <div class="curr-day-actions">
          <button type="button" class="ws-edit-btn" data-evt-delete hidden>Delete event</button>
          <button type="button" class="ws-form-cancel" data-evt-form-back>Back to list</button>
          <button type="submit" class="btn-primary" data-evt-save>Save event</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Content Calendar's day view — same list+form shell as Event
       Calendar's own overlay, with its own accent (curr-day-panel--content
       in global.css) so it doesn't just look like a reskinned booking form. -->
  <div class="curr-day-overlay" data-content-day-overlay hidden>
    <div class="curr-day-panel curr-day-panel--content" data-content-day-panel>
      <div class="curr-day-banner">
        <span class="curr-day-banner-text">
          <span class="curr-day-banner-label">Content for</span>
          <p class="curr-day-banner-value" data-content-day-header></p>
        </span>
      </div>

      <div data-content-day-list-view>
        <div class="curr-day-list" data-content-day-list></div>
        <div class="curr-day-actions">
          <button type="button" class="ws-form-cancel" data-content-day-close>Close</button>
          <button type="button" class="btn-primary" data-content-day-add>+ Add content</button>
        </div>
      </div>

      <form data-content-form-view hidden>
        <p class="curr-day-section-label" data-content-form-title>New content</p>
        <div class="curr-day-field-row">
          <label class="curr-day-field">
            <span>Title *</span>
            <input type="text" data-content-title required />
          </label>
          <label class="curr-day-field">
            <span>Status</span>
            <select data-content-status>
              <option value="idea">Idea</option>
              <option value="drafting">Drafting</option>
              <option value="scheduled">Scheduled</option>
              <option value="posted">Posted</option>
