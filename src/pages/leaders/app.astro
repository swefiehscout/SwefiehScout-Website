      await loadApprovals();
      await refreshApprovalsBadge();
    }

    // ---------- Shared date helpers --------------------------------------
    function todayStr() {
      return toDateStr(new Date());
    }
    function toDateStr(d: Date) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function parseDateStr(s: string) {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function addDays(d: Date, n: number) {
      const c = new Date(d);
      c.setDate(c.getDate() + n);
      return c;
    }
    function startOfWeek(d: Date) {
      const c = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      c.setDate(c.getDate() - c.getDay());
      return c;
    }
    // Month/Year dropdown pair used by both Fees and Finance instead of a
    // native <input type="month">.
    function populatePeriodSelects(monthSel: any, yearSel: any, withYearOption = false) {
      if (monthSel.options.length) return; // already populated
      let opts = MONTHS.map((m, i) => `<option value="${String(i + 1).padStart(2, '0')}">${m.en}</option>`).join('');
      if (withYearOption) opts = `<option value="ALL">Whole Year</option>` + opts;
      monthSel.innerHTML = opts;
      const nowYear = new Date().getFullYear();
      const years: number[] = [];
      for (let y = nowYear - 3; y <= nowYear + 1; y++) years.push(y);
      yearSel.innerHTML = years.map((y) => `<option value="${y}">${y}</option>`).join('');
      const now = new Date();
      monthSel.value = String(now.getMonth() + 1).padStart(2, '0');
      yearSel.value = String(now.getFullYear());
    }
    function getPeriod(monthSel: any, yearSel: any) {
      return `${yearSel.value}-${monthSel.value}`;
    }
    // Shared by Finance and Reports: resolves a month+year select pair
    // (where the month select may have a "Whole Year" option) into a
    // concrete date range plus a display label.
    // 'RANGE' is only ever a value on the Reports tab's own month select
    // (els.reportMonth) — a custom month-to-month span, read straight
    // from its 4 From/To selects rather than monthSel/yearSel.
    function periodRange(monthSel: any, yearSel: any) {
      if (monthSel.value === 'RANGE') {
        const fromYear = Number(els.reportFromYear.value), fromMonth = els.reportFromMonth.value;
        const toYear = Number(els.reportToYear.value), toMonth = els.reportToMonth.value;
        const lastDay = new Date(toYear, Number(toMonth), 0).getDate();
        const fromLabel = `${els.reportFromMonth.selectedOptions[0]?.textContent} ${fromYear}`;
        const toLabel = `${els.reportToMonth.selectedOptions[0]?.textContent} ${toYear}`;
        return {
          start: `${fromYear}-${fromMonth}-01`,
          end: `${toYear}-${toMonth}-${String(lastDay).padStart(2, '0')}`,
          label: fromLabel === toLabel ? fromLabel : `${fromLabel} – ${toLabel}`,
          isYear: false,
          isRange: true,
          periodFrom: `${fromYear}-${fromMonth}`,
          periodTo: `${toYear}-${toMonth}`,
          period: `${fromYear}-${fromMonth}_${toYear}-${toMonth}`,
        };
      }
      const year = Number(yearSel.value);
      if (monthSel.value === 'ALL') {
        return { start: `${year}-01-01`, end: `${year}-12-31`, label: String(year), isYear: true, period: String(year) };
      }
      const month = monthSel.value;
      const period = `${year}-${month}`;
      const lastDay = new Date(year, Number(month), 0).getDate();
      const label = `${monthSel.selectedOptions[0]?.textContent} ${year}`;
      return { start: `${period}-01`, end: `${period}-${String(lastDay).padStart(2, '0')}`, label, isYear: false, period };
    }

    // ---------- Attendance (calendar date-picker) ---------------------------
    async function loadAttendance() {
      if (!state.activeGroup) return;
      if (!els.attWeekdayRow.children.length) {
        els.attWeekdayRow.innerHTML = WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('');
      }
      const first = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth(), 1);
      const last = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth() + 1, 0);
      const gridStart = startOfWeek(first);
      const gridEnd = addDays(startOfWeek(last), 6);
      const { data, error } = await db.from('attendance').select('date, present')
        .eq('group_key', state.activeGroup).gte('date', toDateStr(gridStart)).lte('date', toDateStr(gridEnd));
      if (error) { console.error(error); showToast('Could not load attendance.'); return; }
      state.attDatesWithRecords = new Set((data || []).map((r: any) => r.date));
      renderAttCalendar();
      await loadAttDay();
    }
    function renderAttCalendar() {
      const anchor = state.attAnchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      els.attMonthLabel.textContent = `${MONTHS[mo].en} ${y}`;

      let html = '';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const cls = [
          'curr-day-cell',
          !inMonth && 'curr-day-cell--out',
          dateStr === today && 'curr-day-cell--today',
          dateStr === state.attSelected && 'curr-day-cell--selected',
          state.attDatesWithRecords?.has(dateStr) && 'curr-day-cell--has',
        ].filter(Boolean).join(' ');
        const hasRecords = state.attDatesWithRecords?.has(dateStr);
        html += `<div class="${cls}" data-date="${dateStr}" style="min-height:auto;cursor:pointer;">
          <span class="curr-day-num">${d.getDate()}</span>
          ${hasRecords ? '<span class="ws-att-dot" aria-hidden="true"></span>' : ''}
        </div>`;
        d = addDays(d, 1);
      }
      els.attCalendar.innerHTML = html;
      els.attCalendar.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => {
          state.attSelected = cell.dataset.date;
          renderAttCalendar();
          loadAttDay();
        });
      });
    }
    async function loadAttDay() {
      const date = state.attSelected;
      const d = parseDateStr(date);
      els.attDateLabel.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      const active = state.members.filter((m: any) => m.active);
      const { data, error } = await db.from('attendance').select('*').eq('group_key', state.activeGroup).eq('date', date);
      if (error) { console.error(error); showToast('Could not load attendance.'); return; }
      const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
      renderAttendance(active, map, date);
    }
    function renderAttendance(active: any[], map: Map<string, any>, date: string) {
      if (!active.length) {
        els.attBody.innerHTML = '<tr><td colspan="2" class="ws-empty">No active members in this group yet.</td></tr>';
        els.attSummary.textContent = '';
        return;
      }
      let presentCount = 0;
      els.attBody.innerHTML = active.map((m: any) => {
        const rec: any = map.get(m.id);
        if (rec && rec.present) presentCount++;
        return `
          <tr data-member-id="${m.id}">
            <td data-label="Name">${escapeHtml(m.full_name)}</td>
            <td data-label="Present"><input type="checkbox" data-att-present ${rec && rec.present ? 'checked' : ''} /></td>
          </tr>`;
      }).join('');
      els.attSummary.textContent = `${presentCount} of ${active.length} present`;

      // Ticking the box saves immediately — no separate save step.
      els.attBody.querySelectorAll('tr').forEach((row: any) => {
        const memberId = row.dataset.memberId;
        row.querySelector('[data-att-present]').addEventListener('change', () => {
          saveAttendance(memberId, date, row.querySelector('[data-att-present]').checked);
        });
      });
    }
    // note isn't left in the payload here (not just set to null) so any
    // note recorded before the Notes column was removed from this table
    // stays intact in the database instead of getting silently wiped.
    // Unchecked means "no record" — same as a member whose box was never
    // touched at all (leaders only tick who's present; nobody ticks the
    // absent ones). So unticking deletes the row rather than storing
    // present:false — otherwise a tick-then-untick (a misclick, say)
    // would leave a phantom row behind that still counts that date as a
    // real session everywhere attendance is summarized (Dashboard trend,
    // Reports), even though nothing was actually recorded.
    async function saveAttendance(memberId: string, date: string, present: boolean) {
      const error = present
        ? (await db.from('attendance').upsert({
            group_key: state.activeGroup, date, member_id: memberId, present,
            updated_by: state.session.user.id,
          }, { onConflict: 'group_key,date,member_id' })).error
        : (await db.from('attendance').delete()
            .eq('group_key', state.activeGroup).eq('date', date).eq('member_id', memberId)).error;
      if (error) { console.error(error); showToast('Could not save attendance.'); return; }
      if (!state.attDatesWithRecords) state.attDatesWithRecords = new Set();
      // Whether this date still "has records" now depends on whether
      // anyone else in the currently-rendered list is still checked —
      // deleting the last checked row for a date un-marks it entirely.
      const stillHasRecords = els.attBody.querySelectorAll('[data-att-present]:checked').length > 0;
      if (stillHasRecords) state.attDatesWithRecords.add(date); else state.attDatesWithRecords.delete(date);
      renderAttCalendar();
      // Deliberately not a full loadAttDay() reload+rerender here — the
      // checkbox the user just toggled already reflects what was saved;
      // re-fetching would just rebuild the table from the server again,
      // and if two toggles land close together (check, then quickly
      // uncheck) the first save's reload can resolve *after* the
      // second save and repaint the row back to the stale, wrong state.
      // The summary count is the only thing that needs refreshing, and
      // it's cheap to get straight from the DOM.
      const total = els.attBody.querySelectorAll('[data-att-present]').length;
      const presentNow = els.attBody.querySelectorAll('[data-att-present]:checked').length;
      els.attSummary.textContent = `${presentNow} of ${total} present`;
    }
    function bindAttendance() {
      els.attPrev.addEventListener('click', () => {
        state.attAnchor = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth() - 1, 1);
        loadAttendance();
      });
      els.attNext.addEventListener('click', () => {
        state.attAnchor = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth() + 1, 1);
        loadAttendance();
      });
      const stepDay = (n: number) => {
        const next = addDays(parseDateStr(state.attSelected), n);
        state.attSelected = toDateStr(next);
        // Crossing into a different visible month reloads the whole
        // calendar; staying within it just re-renders in place.
        if (next.getMonth() !== state.attAnchor.getMonth() || next.getFullYear() !== state.attAnchor.getFullYear()) {
          state.attAnchor = new Date(next.getFullYear(), next.getMonth(), 1);
          loadAttendance();
        } else {
          renderAttCalendar();
          loadAttDay();
        }
      };
      els.attDayPrev.addEventListener('click', () => stepDay(-1));
      els.attDayNext.addEventListener('click', () => stepDay(1));
    }

    // ---------- Fees ---------------------------------------------------
    const DEFAULT_EXPENSE_CATEGORIES = [
      'Supplies', 'Uniforms', 'Badges & Awards', 'Camping & Trips', 'Food & Refreshments',
      'Transportation', 'Equipment', 'Events & Ceremonies', 'Printing & Materials', 'Maintenance', 'Other',
    ];
    const DEFAULT_INCOME_CATEGORIES = [
      'Monthly Fees', 'Donations', 'Fundraising', 'Event Tickets', 'Sponsorships', 'Troop Store Sales', 'Other',
    ];
    // Music and General aren't scouting troops, so the troop-flavored
    // defaults above (Uniforms, Badges & Awards, Monthly Fees, …) don't
    // fit — each gets its own starter list instead.
    // Inventory's own editable category list (Items subtab dropdown +
    // its own Categories subtab) — Music-only, so there's just one
    // starter list rather than a per-group map like expense/income above.
    const DEFAULT_INVENTORY_CATEGORIES = ['Bagpipes', 'Drums', 'Uniforms', 'Sound Equipment', 'Sheet Music', 'Other'];
    const GROUP_DEFAULT_CATEGORIES: Record<string, { expense: string[]; income: string[] }> = {
      [MUSIC_GROUP_KEY]: {
        expense: ['Band Payouts', 'Equipment', 'Transport', 'Repairs', 'Refreshments', 'Miscellaneous'],
        income: ['Wedding', 'Event', 'Donation', 'Miscellaneous'],
      },
      [GENERAL_GROUP_KEY]: {
        expense: ['Venue Maintenance', 'Furniture & Equipment', 'Utilities', 'Repairs', 'Supplies', 'Other'],
        income: ['Donations', 'Fundraising', 'Other'],
      },
      [SOCIAL_MEDIA_GROUP_KEY]: {
        expense: ['Content Production', 'Advertising & Boosting', 'Software & Subscriptions', 'Equipment', 'Miscellaneous'],
        income: ['Sponsored Content', 'Donations', 'Miscellaneous'],
      },
    };
    async function loadGroupSettings() {
      if (!state.activeGroup) return;
      const { data } = await db.from('group_settings').select('*').eq('group_key', state.activeGroup).maybeSingle();
      state.groupSettings = data || {
        group_key: state.activeGroup, monthly_fee_defaults: {}, expense_categories: [], income_categories: [],
        inventory_categories: [], event_type_categories: [], event_cost_categories: [], event_location_categories: [],
        sponsor_type_categories: [], pr_contact_categories: [], pr_library_categories: [],
        content_platform_categories: [], content_type_categories: [], activity_bank: [],
      };
      const defaults = GROUP_DEFAULT_CATEGORIES[state.activeGroup] || { expense: DEFAULT_EXPENSE_CATEGORIES, income: DEFAULT_INCOME_CATEGORIES };
      // Every group starts with sensible defaults for its kind — a leader
      // editing the list (add/remove) is what actually persists a custom
      // one; until then this just fills the dropdown usefully.
      if (!state.groupSettings.expense_categories?.length) state.groupSettings.expense_categories = [...defaults.expense];
      if (!state.groupSettings.income_categories?.length) state.groupSettings.income_categories = [...defaults.income];
      if (!state.groupSettings.inventory_categories?.length) state.groupSettings.inventory_categories = [...DEFAULT_INVENTORY_CATEGORIES];
      if (!state.groupSettings.event_type_categories?.length) state.groupSettings.event_type_categories = [...DEFAULT_EVENT_TYPE_CATEGORIES];
      if (!state.groupSettings.event_cost_categories?.length) state.groupSettings.event_cost_categories = [...DEFAULT_EVENT_COST_CATEGORIES];
      if (!state.groupSettings.event_location_categories?.length) state.groupSettings.event_location_categories = [...DEFAULT_EVENT_LOCATION_CATEGORIES];
      if (!state.groupSettings.sponsor_type_categories?.length) state.groupSettings.sponsor_type_categories = [...DEFAULT_SPONSOR_TYPE_CATEGORIES];
      if (!state.groupSettings.pr_contact_categories?.length) state.groupSettings.pr_contact_categories = [...DEFAULT_PR_CONTACT_CATEGORIES];
      if (!state.groupSettings.pr_library_categories?.length) state.groupSettings.pr_library_categories = [...DEFAULT_PR_LIBRARY_CATEGORIES];
      if (!state.groupSettings.content_platform_categories?.length) state.groupSettings.content_platform_categories = [...DEFAULT_CONTENT_PLATFORM_CATEGORIES];
      if (!state.groupSettings.content_type_categories?.length) state.groupSettings.content_type_categories = [...DEFAULT_CONTENT_TYPE_CATEGORIES];
      if (!state.groupSettings.activity_bank?.length) {
        state.groupSettings.activity_bank = ACTIVITY_BANK.map((a) => ({ id: a.type, en: a.en }));
      }
    }
    async function loadFees() {
      if (!state.activeGroup) return;
      populatePeriodSelects(els.feeMonth, els.feeYear);
      const period = getPeriod(els.feeMonth, els.feeYear);
      await loadGroupSettings();
      const defaults = state.groupSettings.monthly_fee_defaults || {};
      els.feeDefault.value = defaults[period] != null ? defaults[period] : '';

      const active = state.members.filter((m: any) => m.active);
      const { data, error } = await db.from('fee_payments').select('*').eq('group_key', state.activeGroup).eq('period', period);
      if (error) { console.error(error); showToast('Could not load fees.'); return; }
      const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
      renderFees(active, map, period);
    }
    function renderFees(active: any[], map: Map<string, any>, period: string) {
      const defaultAmount = els.feeDefault.value ? Number(els.feeDefault.value) : null;
      if (!active.length) {
        els.feeBody.innerHTML = '<tr><td colspan="4" class="ws-empty">No active members in this group yet.</td></tr>';
        els.feeSummary.textContent = '';
        return;
      }
      let paidCount = 0, collected = 0;
      els.feeBody.innerHTML = active.map((m: any) => {
        const rec: any = map.get(m.id);
        if (rec && rec.paid) { paidCount++; collected += Number(rec.amount || 0); }
        const amount = rec && rec.amount != null ? rec.amount : (defaultAmount != null ? defaultAmount : '');
        const paidOn = rec && rec.paid_on ? rec.paid_on : '';
        return `
          <tr data-member-id="${m.id}" data-paid-on="${paidOn}">
            <td data-label="Name">${escapeHtml(m.full_name)}</td>
            <td data-label="Paid"><input type="checkbox" data-fee-paid ${rec && rec.paid ? 'checked' : ''} /></td>
            <td data-label="Amount"><input type="number" step="0.01" min="0" class="ws-inline-amount" data-fee-amount value="${amount}" /></td>
            <td data-label="Paid on">${paidOn ? escapeHtml(paidOn) : '—'}</td>
          </tr>`;
      }).join('');
      els.feeSummary.textContent = `${paidCount} of ${active.length} paid, ${collected.toFixed(2)} collected`;

      // "Paid on" isn't an editable field — with a whole group usually
      // paying on the same day, picking a date per row was pure repetition.
      // It's just stamped with today's date the moment a member is first
      // marked paid, and cleared if unmarked; re-saving an already-paid
      // row (e.g. fixing the amount) keeps whatever date it already has.
      els.feeBody.querySelectorAll('tr').forEach((row: any) => {
        const memberId = row.dataset.memberId;
        const commit = () => {
          const paid = row.querySelector('[data-fee-paid]').checked;
          const amountVal = row.querySelector('[data-fee-amount]').value;
          let paidOn = row.dataset.paidOn || '';
          if (paid && !paidOn) paidOn = todayStr();
          saveFee(memberId, period, paid, amountVal ? Number(amountVal) : null, paid ? paidOn : null);
        };
        row.querySelector('[data-fee-paid]').addEventListener('change', commit);
        row.querySelector('[data-fee-amount]').addEventListener('blur', commit);
      });
    }
    // Same reasoning as Attendance's saveAttendance(): unpaid means no
    // record, same as a member whose Paid box was never touched — so
    // unmarking deletes the row instead of storing paid:false. Any
    // custom amount typed in before unmarking is lost along with it
    // (accepted tradeoff — a stray check-then-uncheck otherwise leaves a
    // phantom "unpaid" row, and its synced Finance entry, behind).
    async function saveFee(memberId: string, period: string, paid: boolean, amount: number | null, paidOn: string | null) {
      let feeRow: any;
      if (paid) {
        const { data, error } = await db.from('fee_payments').upsert({
          group_key: state.activeGroup, member_id: memberId, period, paid, amount, paid_on: paidOn,
          updated_by: state.session.user.id,
        }, { onConflict: 'group_key,member_id,period' }).select().single();
        if (error) { console.error(error); showToast('Could not save.'); return; }
        feeRow = data;
      } else {
        const { data, error } = await db.from('fee_payments').delete()
          .eq('group_key', state.activeGroup).eq('member_id', memberId).eq('period', period)
          .select().maybeSingle();
        if (error) { console.error(error); showToast('Could not save.'); return; }
        feeRow = data; // null if there was nothing to delete (e.g. checked then unchecked without ever having saved)
      }
      if (feeRow) await syncFeeToFinance({ ...feeRow, paid });
      // Deliberately not a full loadFees() reload+rerender here — same
      // reasoning as saveAttendance(): the row already reflects what was
      // just saved, and a reload racing a rapid check/uncheck pair can
      // repaint it back to a stale state. Patch just this row's "Paid
      // on" cell and cache from what the upsert actually returned, then
      // recompute the summary from the DOM.
      const row = els.feeBody.querySelector(`tr[data-member-id="${memberId}"]`);
      if (row) {
        row.dataset.paidOn = feeRow?.paid_on || '';
        const paidOnCell = row.querySelector('[data-label="Paid on"]');
        if (paidOnCell) paidOnCell.textContent = feeRow?.paid_on ? feeRow.paid_on : '—';
      }
      const paidCheckboxes: any[] = Array.from(els.feeBody.querySelectorAll('[data-fee-paid]'));
      const total = paidCheckboxes.length;
      let paidCount = 0, collected = 0;
      paidCheckboxes.forEach((cb: any) => {
        if (!cb.checked) return;
        paidCount++;
        const amt = Number(cb.closest('tr').querySelector('[data-fee-amount]').value || 0);
        collected += amt;
      });
      els.feeSummary.textContent = `${paidCount} of ${total} paid, ${collected.toFixed(2)} collected`;
    }
    // Keeps a fee payment mirrored into the Finance ledger as an income
    // line — created/updated while paid, removed the moment it's unmarked
    // — so leaders never have to log the same collection twice.
    async function syncFeeToFinance(feeRow: any) {
      if (feeRow.paid && feeRow.amount) {
        const member = state.members.find((m: any) => m.id === feeRow.member_id);
        const payload = {
          group_key: state.activeGroup, entry_type: 'income', category: 'Monthly Fees',
          amount: feeRow.amount, entry_date: feeRow.paid_on || (feeRow.period + '-01'),
          description: `${member ? member.full_name : 'Member'}, ${feeRow.period}`,
          fee_payment_id: feeRow.id, created_by: state.session.user.id,
          created_by_name: state.profile?.name || null,
        };
        const { data: existing } = await db.from('finance_entries').select('id').eq('fee_payment_id', feeRow.id).maybeSingle();
        if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
        else await db.from('finance_entries').insert(payload);
      } else {
        await db.from('finance_entries').delete().eq('fee_payment_id', feeRow.id);
      }
      if (state.activeTab === 'finance') await loadFinance();
    }
    async function saveDefaultFee() {
      if (!state.activeGroup) return;
      const period = getPeriod(els.feeMonth, els.feeYear);
      const current = state.groupSettings.monthly_fee_defaults || {};
      const val = els.feeDefault.value ? Number(els.feeDefault.value) : null;
      const updated = { ...current, [period]: val };
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, monthly_fee_defaults: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save default fee.'); return; }
      await loadFees();
    }

    // ---------- Settings (per-group config: Finance category lists) ------
    async function loadSettings() {
      if (!state.activeGroup) return;
      await loadGroupSettings();
      renderSettings();
    }
    function renderSettings() {
      renderCategoryList(els.settingsExpenseList, state.groupSettings.expense_categories || [], 'expense_categories');
      renderCategoryList(els.settingsIncomeList, state.groupSettings.income_categories || [], 'income_categories');
    }
    // saveFn defaults to Finance's own group_settings upsert (saveCategoryList
    // below) — Inventory's Categories subtab passes its own instead, so a
    // chip's × still writes to (and reloads) the right list.
    function renderCategoryList(container: any, list: string[], field: string, saveFn: (field: string, updated: string[]) => Promise<void> = saveCategoryList) {
      container.innerHTML = list.length
        ? list.map((c) => `<span class="ws-category-chip">${escapeHtml(c)}<button type="button" data-remove-cat="${escapeHtml(c)}">×</button></span>`).join('')
        : '<p class="ws-empty" style="padding:0.5rem 0">None yet</p>';
      container.querySelectorAll('[data-remove-cat]').forEach((btn: any) => {
        btn.addEventListener('click', () => saveFn(field, list.filter((c) => c !== btn.dataset.removeCat)));
      });
    }
    async function saveCategoryList(field: string, updated: string[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, [field]: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save.'); return; }
      await loadSettings();
    }
    function bindSettings() {
      els.settingsExpenseAdd.addEventListener('click', () => {
        const val = els.settingsExpenseInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.expense_categories || [];
        if (current.includes(val)) { els.settingsExpenseInput.value = ''; return; }
        saveCategoryList('expense_categories', [...current, val]);
        els.settingsExpenseInput.value = '';
      });
      els.settingsIncomeAdd.addEventListener('click', () => {
        const val = els.settingsIncomeInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.income_categories || [];
        if (current.includes(val)) { els.settingsIncomeInput.value = ''; return; }
        saveCategoryList('income_categories', [...current, val]);
        els.settingsIncomeInput.value = '';
      });
    }

    // ---------- Finance ---------------------------------------------------
    async function loadFinance() {
      if (!state.activeGroup) return;
      populatePeriodSelects(els.finMonth, els.finYear, true);
      await loadGroupSettings();
      updateFinCategoryOptions();
      renderSettings();
      const { start, end, label } = periodRange(els.finMonth, els.finYear);
      state.finLabel = label;
      const { data, error } = await db.from('finance_entries').select('*')
        .eq('group_key', state.activeGroup).gte('entry_date', start).lte('entry_date', end)
        .order('entry_date', { ascending: false });
      if (error) { console.error(error); showToast('Could not load finance entries.'); return; }
      state.finEntries = data || [];
      renderFinance();
    }
    function categoryTotals(type: string) {
      const map = new Map<string, number>();
      state.finEntries.filter((e: any) => e.entry_type === type).forEach((e: any) => {
        const cat = e.category || 'Uncategorized';
        map.set(cat, (map.get(cat) || 0) + Number(e.amount));
      });
      return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
    }
    function renderFinance() {
      const incomeRows = categoryTotals('income');
      const expenseRows = categoryTotals('expense');
      const income = incomeRows.reduce((s, [, v]) => s + v, 0);
      const expense = expenseRows.reduce((s, [, v]) => s + v, 0);

      els.finStats.innerHTML = `
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">↑</span><span class="ws-stat-text"><span class="ws-stat-num">${income.toFixed(2)}</span><span class="ws-stat-label">Income</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">↓</span><span class="ws-stat-text"><span class="ws-stat-num">${expense.toFixed(2)}</span><span class="ws-stat-label">Expenses</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">=</span><span class="ws-stat-text"><span class="ws-stat-num">${(income - expense).toFixed(2)}</span><span class="ws-stat-label">Net</span></span></div>
      `;

      const rowsHtml = (rows: [string, number][]) => rows.length
        ? rows.map(([cat, amt]) => `<tr><td>${escapeHtml(cat)}</td><td>${amt.toFixed(2)}</td></tr>`).join('')
        : '<tr><td class="ws-empty" colspan="2">None</td></tr>';
      els.finStatement.innerHTML = `
        <h3 class="ws-admin-h3">Income Statement, ${escapeHtml(state.finLabel)}</h3>
        <table class="ws-statement-table">
          <tbody>
            <tr class="ws-statement-section"><td colspan="2">Income</td></tr>
            ${rowsHtml(incomeRows)}
            <tr class="ws-statement-total"><td>Total Income</td><td>${income.toFixed(2)}</td></tr>
            <tr class="ws-statement-section"><td colspan="2">Expenses</td></tr>
            ${rowsHtml(expenseRows)}
            <tr class="ws-statement-total"><td>Total Expenses</td><td>${expense.toFixed(2)}</td></tr>
            <tr class="ws-statement-net"><td>Net Income</td><td>${(income - expense).toFixed(2)}</td></tr>
          </tbody>
        </table>
      `;

      if (!state.finEntries.length) {
        els.finBody.innerHTML = '<tr><td colspan="7" class="ws-empty">No entries this month.</td></tr>';
        return;
      }
      els.finBody.innerHTML = state.finEntries.map((e: any) => `
        <tr data-entry-id="${e.id}" data-receipt-path="${escapeHtml(e.receipt_path || '')}">
          <td data-label="Date">${e.entry_date}</td>
          <td data-label="Type">${e.entry_type === 'income' ? 'Income' : 'Expense'}</td>
          <td data-label="Category">${escapeHtml(e.category || '—')}${e.fee_payment_id ? ' <span class="ws-allergy-badge" title="Synced from the Fees tab, unmark it paid there to remove this">Auto</span>' : ''}${e.maintenance_log_id ? ' <span class="ws-allergy-badge" title="Synced from the Inventory tab\'s Maintenance Log, delete it there to remove this">Auto</span>' : ''}</td>
          <td data-label="Description">${escapeHtml(e.description || '—')}</td>
          <td data-label="Amount">${Number(e.amount).toFixed(2)}</td>
          <td data-label="Added by">${escapeHtml(e.created_by_name || '—')}</td>
          <td data-label="Receipt">${e.receipt_path ? '<button type="button" class="ws-edit-btn" data-fin-receipt-view>View</button>' : '—'}</td>
          <td class="ws-row-actions">${(e.fee_payment_id || e.maintenance_log_id) ? '' : '<button type="button" class="ws-edit-btn" data-fin-edit>Edit</button> <button type="button" class="ws-row-del" data-fin-del>×</button>'}</td>
        </tr>
      `).join('');
      els.finBody.querySelectorAll('[data-fin-receipt-view]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const path = btn.closest('tr').dataset.receiptPath;
          const { data, error } = await db.storage.from('documents').createSignedUrl(path, 60);
          if (error || !data) { showToast('Could not open receipt.'); return; }
          window.open(data.signedUrl, '_blank');
        });
      });
      els.finBody.querySelectorAll('[data-fin-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => startEditFinEntry(btn.closest('tr').dataset.entryId));
      });
      els.finBody.querySelectorAll('[data-fin-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const row = btn.closest('tr');
          const id = row.dataset.entryId;
          if (!confirm('Delete this entry?')) return;
          const { error } = await db.from('finance_entries').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingFinEntryId === id) resetFinanceForm();
          await loadFinance();
        });
      });
    }
    function resetFinanceForm() {
      state.editingFinEntryId = null;
      els.finForm.reset();
      updateFinCategoryOptions();
      els.finFormTitle.textContent = 'Add an entry';
      els.finSubmit.textContent = 'Add entry';
      els.finCancel.hidden = true;
    }
    // Same reusable-form pattern as Roster/Inventory's edit — repopulate
    // the add-entry form rather than a separate dialog. Auto-synced rows
    // (fee_payment_id/maintenance_log_id) never reach here since their
    // Edit button is never rendered in the first place.
    function startEditFinEntry(id: string) {
      const entry = state.finEntries.find((x: any) => x.id === id);
      if (!entry) return;
      state.editingFinEntryId = id;
      els.finType.value = entry.entry_type;
      updateFinCategoryOptions();
      els.finCategory.value = entry.category || '';
      el('[data-fin-amount]').value = entry.amount;
      el('[data-fin-date]').value = entry.entry_date;
      el('[data-fin-description]').value = entry.description || '';
      els.finReceipt.value = '';
      els.finFormTitle.textContent = 'Editing entry';
      els.finSubmit.textContent = 'Save changes';
      els.finCancel.hidden = false;
      els.finForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function updateFinCategoryOptions() {
      const list = els.finType.value === 'income'
        ? (state.groupSettings?.income_categories || [])
        : (state.groupSettings?.expense_categories || []);
      els.finCategory.innerHTML = list.length
        ? list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : '<option value="">No categories yet, add some in the Categories tab</option>';
    }
    function bindFinanceForm() {
      els.finDownload.addEventListener('click', () => {
        // downloadFinanceReport() reads the Reports tab's own period
        // selects (always populated — see bindReports()) — sync them to
        // Finance's current period first so the PDF matches what's on
        // screen here, since Music's Reports tab (which normally owns
        // that picker) is hidden — see updateTabVisibility().
        els.reportMonth.value = els.finMonth.value;
        els.reportYear.value = els.finYear.value;
        downloadFinanceReport();
      });
      els.finType.addEventListener('change', updateFinCategoryOptions);
      els.finCancel.addEventListener('click', resetFinanceForm);
      els.finForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const type = els.finType.value;
        const category = els.finCategory.value.trim();
        const amount = el('[data-fin-amount]').value;
        const date = el('[data-fin-date]').value;
        const description = el('[data-fin-description]').value.trim();
        if (!category || !amount || !date || !description) { showToast('Everything except the receipt is required.'); return; }
        els.finSubmit.disabled = true;

        // undefined (rather than null) on an edit with no new file chosen
        // means the receipt_path key is left out of the payload entirely,
        // below, so an update keeps whatever receipt the entry already had
        // instead of wiping it out.
        let receiptPath: string | null | undefined = state.editingFinEntryId ? undefined : null;
        const file = els.finReceipt.files[0];
        if (file) {
          const path = `${state.activeGroup}/receipts/${Date.now()}-${file.name}`;
          const { error: upErr } = await db.storage.from('documents').upload(path, file);
          if (upErr) { console.error(upErr); showToast('Could not upload receipt.'); els.finSubmit.disabled = false; return; }
          receiptPath = path;
        }

        const payload: any = { entry_type: type, category: category || null, amount: Number(amount), entry_date: date, description: description || null };
        if (receiptPath !== undefined) payload.receipt_path = receiptPath;

        let error;
        if (state.editingFinEntryId) {
          ({ error } = await db.from('finance_entries').update(payload).eq('id', state.editingFinEntryId));
        } else {
          payload.group_key = state.activeGroup;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ error } = await db.from('finance_entries').insert(payload));
        }
        els.finSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not save entry.'); return; }
        resetFinanceForm();
        await loadFinance();
      });
    }

    // ---------- Inventory (Music only: instruments/equipment + upkeep) ----
    const CONDITION_LABELS: Record<string, string> = {
      excellent: 'Excellent', good: 'Good', fair: 'Fair', poor: 'Poor', needs_repair: 'Needs Repair',
    };
    const CONDITION_BADGE_CLASS: Record<string, string> = {
      excellent: 'ws-badge--good', good: 'ws-badge--good', fair: 'ws-badge--fair', poor: 'ws-badge--poor', needs_repair: 'ws-badge--poor',
    };
    function conditionBadge(condition: string) {
      const cls = CONDITION_BADGE_CLASS[condition] || 'ws-badge--fair';
      return `<span class="ws-badge ${cls}">${escapeHtml(CONDITION_LABELS[condition] || condition)}</span>`;
    }
    async function loadInventory() {
      if (!state.activeGroup) return;
      await loadGroupSettings();
      await loadInventoryCategories();
      await ensureMembersLoaded();
      await ensureVendorsLoaded();
      updateInvAssignedOptions();
      updateInvVendorOptions();
      const [itemsRes, logsRes] = await Promise.all([
        db.from('inventory_items').select('*').eq('group_key', state.activeGroup).order('name', { ascending: true }),
        db.from('inventory_maintenance').select('*').eq('group_key', state.activeGroup).order('performed_on', { ascending: false }),
      ]);
      if (itemsRes.error || logsRes.error) { console.error(itemsRes.error || logsRes.error); showToast('Could not load inventory.'); return; }
      state.inventoryItems = itemsRes.data || [];
      state.maintenanceLog = logsRes.data || [];
      updateInvItemOptions();
      renderInventoryItems();
      renderMaintenanceLog();
    }
    function updateInvAssignedOptions() {
      const active = state.members.filter((m: any) => m.active);
      els.invAssigned.innerHTML = '<option value="">Unassigned</option>'
        + active.map((m: any) => `<option value="${m.id}">${escapeHtml(m.full_name)}</option>`).join('');
    }
    // Own vendors (linkable via vendor_id) plus shared ones visible to
    // this group (name-autofill only — see the schema note on
    // inventory_maintenance.vendor_id for why those aren't linked).
    function updateInvVendorOptions() {
      if (!els.invMaintVendor) return;
      const ownOpts = state.vendors.map((v: any) => `<option value="${v.id}">${escapeHtml(v.name)}</option>`).join('');
      const sharedOpts = state.sharedVendors.map((v: any) => `<option value="shared:${v.id}">${escapeHtml(v.name)} (shared)</option>`).join('');
      els.invMaintVendor.innerHTML = '<option value="">— None / self —</option>' + ownOpts + sharedOpts;
    }
    // "Last Maintenance" is never stored on the item itself — it's just
    // the newest performed_on across that item's own log rows, so it can
    // never drift out of sync with the log the way a cached column could.
    function lastMaintenanceByItem() {
      const map = new Map<string, string>();
      state.maintenanceLog.forEach((log: any) => {
        const cur = map.get(log.item_id);
        if (!cur || log.performed_on > cur) map.set(log.item_id, log.performed_on);
      });
      return map;
    }
    function renderInventoryItems() {
      if (!state.inventoryItems.length) {
        els.invBody.innerHTML = '<tr><td colspan="9" class="ws-empty">No items yet.</td></tr>';
        return;
      }
      const lastMaint = lastMaintenanceByItem();
      els.invBody.innerHTML = state.inventoryItems.map((item: any) => {
        const assigned = item.assigned_to ? state.members.find((m: any) => m.id === item.assigned_to) : null;
        const last = lastMaint.get(item.id);
        return `
          <tr data-item-id="${item.id}">
            <td data-label="Name">${escapeHtml(item.name)}</td>
            <td data-label="Category">${escapeHtml(item.category || '—')}</td>
            <td data-label="Qty">${item.quantity}</td>
            <td data-label="Condition">${conditionBadge(item.condition)}</td>
            <td data-label="Assigned to">${assigned ? escapeHtml(assigned.full_name) : '<span class="ws-empty" style="padding:0">Unassigned</span>'}</td>
            <td data-label="Last Maintenance">${last ? escapeHtml(last) : '—'}</td>
            <td data-label="Notes">${escapeHtml(item.notes || '—')}</td>
            <td data-label="Added by">${escapeHtml(item.created_by_name || '—')}</td>
            <td class="ws-row-actions">
              <button type="button" class="ws-edit-btn" data-inv-edit>Edit</button>
              <button type="button" class="ws-row-del" data-inv-del>×</button>
            </td>
          </tr>
        `;
      }).join('');
      els.invBody.querySelectorAll('[data-inv-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => startEditInventoryItem(btn.closest('tr').dataset.itemId));
      });
      els.invBody.querySelectorAll('[data-inv-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.closest('tr').dataset.itemId;
          if (!confirm('Delete this item? Its maintenance history goes with it.')) return;
          const { error } = await db.from('inventory_items').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingInventoryItemId === id) resetInventoryForm();
          await loadInventory();
        });
      });
    }
    function resetInventoryForm() {
      state.editingInventoryItemId = null;
      els.invForm.reset();
      els.invFormTitle.textContent = 'Add an item';
      els.invSubmit.textContent = 'Add item';
      els.invCancel.hidden = true;
    }
    // Same pattern as startEditMember() on the Roster tab — repopulate the
    // add-item form in place rather than a separate edit dialog, so
    // updating a quantity or reassigning an item doesn't mean deleting
    // and recreating the row (which would also orphan its maintenance log).
    function startEditInventoryItem(id: string) {
      const item = state.inventoryItems.find((i: any) => i.id === id);
      if (!item) return;
      state.editingInventoryItemId = id;
      els.invName.value = item.name;
      els.invCategory.value = item.category || '';
      els.invQuantity.value = item.quantity;
      els.invCondition.value = item.condition;
      els.invAssigned.value = item.assigned_to || '';
      els.invNotes.value = item.notes || '';
      els.invFormTitle.textContent = `Editing ${item.name}`;
      els.invSubmit.textContent = 'Save changes';
      els.invCancel.hidden = false;
      els.invForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function bindInventoryForm() {
      els.invCancel.addEventListener('click', resetInventoryForm);
      els.invForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const name = els.invName.value.trim();
        const category = els.invCategory.value;
        const quantity = els.invQuantity.value;
        const condition = els.invCondition.value;
        const assignedTo = els.invAssigned.value || null;
        const notes = els.invNotes.value.trim();
        if (!name || !category || quantity === '' || !condition) { showToast('Name, category, quantity, and condition are required.'); return; }
        els.invSubmit.disabled = true;
        const payload: any = {
          group_key: state.activeGroup, name, category, quantity: Number(quantity), condition,
          assigned_to: assignedTo, notes: notes || null,
        };
        let error;
        if (state.editingInventoryItemId) {
          payload.updated_at = new Date().toISOString();
          ({ error } = await db.from('inventory_items').update(payload).eq('id', state.editingInventoryItemId));
        } else {
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ error } = await db.from('inventory_items').insert(payload));
        }
        els.invSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not save item.'); return; }
        resetInventoryForm();
        await loadInventory();
      });
    }
    // Inventory's own category list — same idea as Finance's expense/income
    // ones (an editable group_settings array), just a 3rd field on the same
    // table. renderCategoryList()'s chip-remove wiring is shared; only the
    // save+reload step below is Inventory-specific.
    async function loadInventoryCategories() {
      renderInventoryCategories();
      updateInvCategoryOptions();
    }
    function renderInventoryCategories() {
      renderCategoryList(els.invCatList, state.groupSettings.inventory_categories || [], 'inventory_categories', saveInventoryCategoryList);
    }
    async function saveInventoryCategoryList(field: string, updated: string[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, [field]: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save.'); return; }
      state.groupSettings[field] = updated;
      await loadInventoryCategories();
    }
    function updateInvCategoryOptions() {
      const list = state.groupSettings?.inventory_categories || [];
      els.invCategory.innerHTML = list.length
        ? list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : '<option value="">No categories yet, add some below</option>';
    }
    function bindInventoryCategories() {
      els.invCatAdd.addEventListener('click', () => {
        const val = els.invCatInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.inventory_categories || [];
        if (current.includes(val)) { els.invCatInput.value = ''; return; }
        saveInventoryCategoryList('inventory_categories', [...current, val]);
        els.invCatInput.value = '';
      });
    }
    function updateInvItemOptions() {
      const opts = state.inventoryItems.map((i: any) => `<option value="${i.id}">${escapeHtml(i.name)}</option>`).join('');
      els.invMaintItem.innerHTML = opts || '<option value="">Add an item first</option>';
      const filterVal = els.invMaintFilter.value;
      els.invMaintFilter.innerHTML = '<option value="">All items</option>' + opts;
      els.invMaintFilter.value = filterVal;
    }
    function renderMaintenanceLog() {
      const filterId = els.invMaintFilter.value;
      const rows = filterId ? state.maintenanceLog.filter((l: any) => l.item_id === filterId) : state.maintenanceLog;
      if (!rows.length) {
        els.invMaintBody.innerHTML = '<tr><td colspan="8" class="ws-empty">No maintenance logged yet.</td></tr>';
        return;
      }
      els.invMaintBody.innerHTML = rows.map((log: any) => {
        const item = state.inventoryItems.find((i: any) => i.id === log.item_id);
        return `
          <tr data-log-id="${log.id}">
            <td data-label="Date">${log.performed_on}</td>
            <td data-label="Item">${escapeHtml(item ? item.name : 'Deleted item')}</td>
            <td data-label="Performed by">${escapeHtml(log.performed_by)}</td>
            <td data-label="Description">${escapeHtml(log.description)}</td>
            <td data-label="Cost">${log.cost != null ? Number(log.cost).toFixed(2) : '—'}</td>
            <td data-label="Notes">${escapeHtml(log.notes || '—')}</td>
            <td data-label="Added by">${escapeHtml(log.created_by_name || '—')}</td>
            <td class="ws-row-actions">
              <button type="button" class="ws-edit-btn" data-inv-maint-edit>Edit</button>
              <button type="button" class="ws-row-del" data-inv-maint-del>×</button>
            </td>
          </tr>
        `;
      }).join('');
      els.invMaintBody.querySelectorAll('[data-inv-maint-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => startEditMaintenanceLog(btn.closest('tr').dataset.logId));
      });
      els.invMaintBody.querySelectorAll('[data-inv-maint-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.closest('tr').dataset.logId;
          if (!confirm('Delete this maintenance record? Any cost it posted to Finance is removed with it.')) return;
          const { error } = await db.from('inventory_maintenance').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingMaintenanceLogId === id) resetMaintenanceForm();
          await loadInventory();
          if (state.activeTab === 'finance') await loadFinance();
        });
      });
    }
    function resetMaintenanceForm() {
      state.editingMaintenanceLogId = null;
      els.invMaintForm.reset();
      els.invMaintFormTitle.textContent = 'Log maintenance';
      els.invMaintSubmit.textContent = 'Log maintenance';
      els.invMaintCancel.hidden = true;
      hideMaintVendorNew();
    }
    function hideMaintVendorNew() {
      els.invMaintVendorNew.hidden = true;
      els.invMaintVendorAdd.hidden = false;
      els.invMaintVendorName.value = '';
      els.invMaintVendorPhone.value = '';
    }
    // Same reusable-form edit pattern as Finance/Inventory Items.
    function startEditMaintenanceLog(id: string) {
      const log = state.maintenanceLog.find((l: any) => l.id === id);
      if (!log) return;
      state.editingMaintenanceLogId = id;
      els.invMaintItem.value = log.item_id;
      els.invMaintDate.value = log.performed_on;
      els.invMaintVendor.value = log.vendor_id || '';
      els.invMaintBy.value = log.performed_by;
      els.invMaintCost.value = log.cost != null ? log.cost : '';
      els.invMaintDesc.value = log.description;
      els.invMaintNotes.value = log.notes || '';
      els.invMaintFormTitle.textContent = 'Editing maintenance record';
      els.invMaintSubmit.textContent = 'Save changes';
      els.invMaintCancel.hidden = false;
      els.invMaintForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    // Mirrors syncFeeToFinance() on the Fees tab: a logged cost posts as a
    // normal expense (category "Repairs", already Music's own
    // expense-category default) tagged with maintenance_log_id — created,
    // updated in place, or removed here as the cost is added, changed, or
    // cleared. Deleting the maintenance row itself instead cascades the
    // delete to this entry at the database level, so no matching cleanup
    // code is needed for that path.
    async function syncMaintenanceToFinance(logRow: any) {
      if (logRow.cost) {
        const item = state.inventoryItems.find((i: any) => i.id === logRow.item_id);
        const payload = {
          group_key: state.activeGroup, entry_type: 'expense', category: 'Repairs',
          amount: logRow.cost, entry_date: logRow.performed_on,
          description: `${item ? item.name : 'Item'} — ${logRow.description}`,
          maintenance_log_id: logRow.id, created_by: state.session.user.id,
          created_by_name: state.profile?.name || null,
        };
        const { data: existing } = await db.from('finance_entries').select('id').eq('maintenance_log_id', logRow.id).maybeSingle();
        if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
        else await db.from('finance_entries').insert(payload);
      } else {
        await db.from('finance_entries').delete().eq('maintenance_log_id', logRow.id);
      }
      if (state.activeTab === 'finance') await loadFinance();
    }
    function bindMaintenanceForm() {
      els.invMaintFilter.addEventListener('change', renderMaintenanceLog);
      els.invMaintCancel.addEventListener('click', resetMaintenanceForm);
      // Picking a vendor is just a convenience autofill for "Performed
      // by" — still a plain editable text field afterward, so a one-off
      // person not worth adding as a vendor still works fine.
      els.invMaintVendor.addEventListener('change', () => {
        const val = els.invMaintVendor.value;
        const vendor = val.startsWith('shared:')
          ? state.sharedVendors.find((v: any) => v.id === val.slice(7))
          : state.vendors.find((v: any) => v.id === val);
        if (vendor) els.invMaintBy.value = vendor.name;
      });
      // Quick-add a vendor right here — any leader can add one (though
      // only General can edit/remove one afterward, from its own
      // Vendors tab) — so Music never has to leave Maintenance for a
      // vendor that isn't on file yet.
      els.invMaintVendorAdd.addEventListener('click', () => {
        els.invMaintVendorNew.hidden = false;
        els.invMaintVendorAdd.hidden = true;
        els.invMaintVendorName.focus();
      });
      els.invMaintVendorCancel.addEventListener('click', hideMaintVendorNew);
      els.invMaintVendorSave.addEventListener('click', async () => {
        const name = els.invMaintVendorName.value.trim();
        const phone = els.invMaintVendorPhone.value.trim();
        if (!name || !phone) { showToast('Vendor name and phone are required.'); return; }
        els.invMaintVendorSave.disabled = true;
        const { data: vendor, error } = await db.from('vendors').insert({
          group_key: state.activeGroup, name, phone,
          created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        }).select().single();
        els.invMaintVendorSave.disabled = false;
        if (error) { console.error(error); showToast('Could not add vendor.'); return; }
        state.vendors.push(vendor);
        state.vendors.sort((a: any, b: any) => a.name.localeCompare(b.name));
        updateInvVendorOptions();
        els.invMaintVendor.value = vendor.id;
        els.invMaintBy.value = vendor.name;
        hideMaintVendorNew();
        showToast(`${vendor.name} added to Vendors.`);
      });
      els.invMaintForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const itemId = els.invMaintItem.value;
        const date = els.invMaintDate.value;
        const vendorSel = els.invMaintVendor.value;
        const vendorId = vendorSel && !vendorSel.startsWith('shared:') ? vendorSel : null;
        const performedBy = els.invMaintBy.value.trim();
        const description = els.invMaintDesc.value.trim();
        const costRaw = els.invMaintCost.value;
        const notes = els.invMaintNotes.value.trim();
        if (!itemId || !date || !performedBy || !description) { showToast('Item, date, performed by, and description are required.'); return; }
        els.invMaintSubmit.disabled = true;
        const payload: any = { item_id: itemId, performed_on: date, vendor_id: vendorId, performed_by: performedBy, description, cost: costRaw ? Number(costRaw) : null, notes: notes || null };
        let logRow, error;
        if (state.editingMaintenanceLogId) {
          ({ data: logRow, error } = await db.from('inventory_maintenance').update(payload).eq('id', state.editingMaintenanceLogId).select().single());
        } else {
          payload.group_key = state.activeGroup;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ data: logRow, error } = await db.from('inventory_maintenance').insert(payload).select().single());
        }
        if (error) { console.error(error); showToast('Could not save maintenance record.'); els.invMaintSubmit.disabled = false; return; }
        await syncMaintenanceToFinance(logRow);
        els.invMaintSubmit.disabled = false;
        resetMaintenanceForm();
        await loadInventory();
      });
    }

    // ---------- Event Calendar (Music only: bookings, payouts, Finance sync)
    const DEFAULT_EVENT_TYPE_CATEGORIES = ['Wedding', 'Engagement', 'Baptism', 'Church Event', 'Private Event', 'Other'];
    const DEFAULT_EVENT_COST_CATEGORIES = ['Transportation', 'Water & Refreshments', 'Decorations', 'Miscellaneous'];
    const DEFAULT_EVENT_LOCATION_CATEGORIES = ['Presentation of the Lord Cathedral'];
    // The dropdown always carries this option on top of whatever
    // Settings has configured — picking it reveals a free-text field
    // instead, for a one-off venue that's not worth adding permanently.
    const EVENT_LOCATION_CUSTOM = '__custom__';
    const EVENT_STATUS_LABELS: Record<string, string> = { completed: 'Completed', pending: 'Needs completion', upcoming: 'Upcoming' };
    const EVENT_STATUS_BADGE_CLASS: Record<string, string> = { completed: 'ws-badge--good', pending: 'ws-badge--poor', upcoming: 'ws-badge--fair' };
    // Status is never stored — always derived from amount_received/date,
    // same reasoning as Inventory's "Last Maintenance": one less thing
    // that can drift out of sync with the data it's summarizing.
    // No time on file means "sometime that day" — treated as passed only
    // once the whole day is over, so a same-day booking doesn't flip to
    // "pending" while it's still hours away.
    function eventDateTimeHasPassed(dateStr: string, timeStr: string | null) {
      const eventDT = timeStr ? new Date(`${dateStr}T${timeStr}`) : new Date(`${dateStr}T23:59:59`);
      return eventDT.getTime() < Date.now();
    }
    function eventStatus(ev: any) {
      if (ev.amount_received != null) return 'completed';
      if (eventDateTimeHasPassed(ev.event_date, ev.event_time)) return 'pending';
      return 'upcoming';
    }
    function eventStatusBadge(ev: any) {
      const s = eventStatus(ev);
      return `<span class="ws-badge ${EVENT_STATUS_BADGE_CLASS[s]}">${EVENT_STATUS_LABELS[s]}</span>`;
    }
    function eventClientName(ev: any) { return `${ev.first_name} ${ev.last_name}`; }
    function formatTimeStr(t: string) {
      if (!t) return '';
      const [h, m] = t.split(':').map(Number);
      const period = h >= 12 ? 'PM' : 'AM';
      const h12 = h % 12 || 12;
      return `${h12}:${String(m).padStart(2, '0')} ${period}`;
    }
    function eventDateTimeLabel(ev: any) {
      const d = parseDateStr(ev.event_date);
      const label = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      return ev.event_time ? `${label} · ${formatTimeStr(ev.event_time)}` : label;
    }
    // Base pay (rate × everyone who played) plus transport pay (a 2nd
    // rate × only the members who took a car) — the two components the
    // Members question asked for, kept separate since they post to
    // Finance as 2 different expense categories (Band Payouts/Transport).
    function eventPayoutTotals(ev: any) {
      const attendees = ev.attendees || [];
      const carCount = attendees.filter((a: any) => a.took_car).length;
      const wages = Number(ev.pay_rate_per_member || 0) * attendees.length;
      const transport = Number(ev.transport_rate_per_member || 0) * carCount;
      return { attendees, carCount, wages, transport };
    }
    function eventCostsTotal(eventId: string) {
      return state.eventCosts.filter((c: any) => c.event_id === eventId).reduce((s: number, c: any) => s + Number(c.amount), 0);
    }
    function eventNetIncome(ev: any) {
      const { wages, transport } = eventPayoutTotals(ev);
      return Number(ev.amount_received || 0) - wages - transport - eventCostsTotal(ev.id);
    }
    async function loadEvents() {
      if (!state.activeGroup) return;
      await loadGroupSettings();
      await ensureMembersLoaded();
      renderEventCategories();
      const [bookingsRes, costsRes] = await Promise.all([
        db.from('event_bookings').select('*').eq('group_key', state.activeGroup).order('event_date', { ascending: true }),
        db.from('event_costs').select('*').eq('group_key', state.activeGroup).order('cost_date', { ascending: false }),
      ]);
      if (bookingsRes.error || costsRes.error) { console.error(bookingsRes.error || costsRes.error); showToast('Could not load events.'); return; }
      state.events = bookingsRes.data || [];
      state.eventCosts = costsRes.data || [];
      await refreshEventsBadge();
      renderEventsDashboard();
      evtRenderMonth();
    }
    // Its own lightweight head-count query (same idea as
    // refreshApprovalsBadge) — called at group-switch/init too, so the
    // "needs completion" alert shows up on the tab itself without
    // requiring the Events tab to have ever been opened this session.
    async function refreshEventsBadge() {
      if (!state.activeGroup) return;
      const { count, error } = await db.from('event_bookings')
        .select('id', { count: 'exact', head: true })
        .eq('group_key', state.activeGroup).lt('event_date', todayStr()).is('amount_received', null);
      if (error) { console.error(error); return; }
      if (count && count > 0) {
        els.eventsBadge.textContent = String(count);
        els.eventsBadge.removeAttribute('hidden');
      } else {
        els.eventsBadge.setAttribute('hidden', '');
      }
    }

    // ---- Settings subtab: event types + extra-cost categories ----
    function renderEventCategories() {
      renderCategoryList(els.evtTypeCatList, state.groupSettings.event_type_categories || [], 'event_type_categories', saveEventCategoryList);
      renderCategoryList(els.evtLocationCatList, state.groupSettings.event_location_categories || [], 'event_location_categories', saveEventCategoryList);
      renderCategoryList(els.evtCostCatList, state.groupSettings.event_cost_categories || [], 'event_cost_categories', saveEventCategoryList);
      updateEvtTypeOptions();
      updateEvtLocationOptions();
      updateEvtCostCategoryOptions();
    }
    async function saveEventCategoryList(field: string, updated: string[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, [field]: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save.'); return; }
      state.groupSettings[field] = updated;
      renderEventCategories();
    }
    // No option is ever pre-selected — the leader has to actively pick a
    // type (or a location) rather than the form silently defaulting to
    // whatever happens to be first in Settings.
    function updateEvtTypeOptions() {
      const list = state.groupSettings?.event_type_categories || [];
      const current = els.evtType.value;
      const placeholder = '<option value="" disabled selected>Select a type…</option>';
      els.evtType.innerHTML = list.length
        ? placeholder + list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : '<option value="">No event types yet, add some in Settings</option>';
      if (list.includes(current)) els.evtType.value = current;
    }
    function updateEvtLocationOptions() {
      const list = state.groupSettings?.event_location_categories || [];
      const current = els.evtLocation.value;
      const placeholder = '<option value="" disabled selected>Select a location…</option>';
      const customOpt = `<option value="${EVENT_LOCATION_CUSTOM}">Custom…</option>`;
      els.evtLocation.innerHTML = placeholder + list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('') + customOpt;
      if (list.includes(current) || current === EVENT_LOCATION_CUSTOM) els.evtLocation.value = current;
    }
    function evtToggleLocationCustom() {
      const isCustom = els.evtLocation.value === EVENT_LOCATION_CUSTOM;
      els.evtLocationCustomRow.toggleAttribute('hidden', !isCustom);
      if (!isCustom) els.evtLocationCustom.value = '';
    }
    function updateEvtCostCategoryOptions() {
      const list = state.groupSettings?.event_cost_categories || [];
      els.evtCostCategory.innerHTML = list.length
        ? list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : '<option value="">No cost categories yet, add some in Settings</option>';
    }
    function bindEventCategories() {
      els.evtTypeCatAdd.addEventListener('click', () => {
        const val = els.evtTypeCatInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.event_type_categories || [];
        if (current.includes(val)) { els.evtTypeCatInput.value = ''; return; }
        saveEventCategoryList('event_type_categories', [...current, val]);
        els.evtTypeCatInput.value = '';
      });
      els.evtLocationCatAdd.addEventListener('click', () => {
        const val = els.evtLocationCatInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.event_location_categories || [];
        if (current.includes(val)) { els.evtLocationCatInput.value = ''; return; }
        saveEventCategoryList('event_location_categories', [...current, val]);
        els.evtLocationCatInput.value = '';
      });
      els.evtCostCatAdd.addEventListener('click', () => {
        const val = els.evtCostCatInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.event_cost_categories || [];
        if (current.includes(val)) { els.evtCostCatInput.value = ''; return; }
        saveEventCategoryList('event_cost_categories', [...current, val]);
        els.evtCostCatInput.value = '';
      });
    }

    // ---- Dashboard subtab ----
    // Ranked by how many bookings each member's attendees list appears
    // in, across every event regardless of status — reflects overall
    // participation, not just paid gigs.
    function computeTopMembers(limit = 5) {
      const counts = new Map<string, number>();
      state.events.forEach((e: any) => {
        (e.attendees || []).forEach((a: any) => counts.set(a.member_id, (counts.get(a.member_id) || 0) + 1));
      });
      return Array.from(counts.entries())
        .map(([memberId, count]) => ({ member: state.members.find((m: any) => m.id === memberId), count }))
        .filter((x) => x.member)
        .sort((a, b) => b.count - a.count)
        .slice(0, limit);
    }
    function computeTypeBreakdown() {
      const counts = new Map<string, number>();
      state.events.forEach((e: any) => counts.set(e.event_type, (counts.get(e.event_type) || 0) + 1));
      return Array.from(counts.entries()).sort((a: any, b: any) => b[1] - a[1]);
    }
    // Same bar-chart shape as the main Dashboard's Income vs. Expenses
    // (reuses its ws-dash-fin-* CSS) — income (gross) vs. everything
    // deducted from it (payouts + extra costs), by month, completed
    // events only since that's the only side with real numbers.
    function renderEventsChart(completed: any[]) {
      const now = new Date();
      const monthKeys: string[] = [];
      const byMonth = new Map<string, { income: number; expense: number }>();
      for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        monthKeys.push(key);
        byMonth.set(key, { income: 0, expense: 0 });
      }
      completed.forEach((e: any) => {
        const key = e.event_date.slice(0, 7);
        const b = byMonth.get(key);
        if (!b) return;
        const { wages, transport } = eventPayoutTotals(e);
        b.income += Number(e.amount_received || 0);
        b.expense += wages + transport + eventCostsTotal(e.id);
      });
      const totalIncome = monthKeys.reduce((s, k) => s + byMonth.get(k)!.income, 0);
      const totalExpense = monthKeys.reduce((s, k) => s + byMonth.get(k)!.expense, 0);
      if (!totalIncome && !totalExpense) {
        els.evtChart.innerHTML = '<p class="ws-dash-empty-mini">No completed events in the last 6 months.</p>';
        return;
      }
      const maxVal = Math.max(1, ...monthKeys.map((k) => Math.max(byMonth.get(k)!.income, byMonth.get(k)!.expense)));
      els.evtChart.innerHTML = `
        <div class="ws-dash-fin-bars">
          ${monthKeys.map((k) => {
            const b = byMonth.get(k)!;
            const d = new Date(Number(k.slice(0, 4)), Number(k.slice(5, 7)) - 1, 1);
            const label = MONTHS[d.getMonth()].en.slice(0, 3);
            const incPct = Math.round((b.income / maxVal) * 100);
            const expPct = Math.round((b.expense / maxVal) * 100);
            return `
              <div class="ws-dash-fin-col" title="${MONTHS[d.getMonth()].en} ${d.getFullYear()}, Income ${b.income.toFixed(2)}, Payouts+costs ${b.expense.toFixed(2)}">
                <div class="ws-dash-fin-pair">
                  <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--income" style="height:${b.income ? Math.max(incPct, 3) : 0}%"></div></div>
                  <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--expense" style="height:${b.expense ? Math.max(expPct, 3) : 0}%"></div></div>
                </div>
                <span class="ws-dash-fin-label">${label}</span>
              </div>`;
          }).join('')}
        </div>
        <div class="ws-dash-fin-legend">
          <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--income"></i>Income</span>
          <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--expense"></i>Payouts + costs</span>
        </div>
      `;
    }
    function renderEventsDashboard() {
      const todo = state.events.filter((e: any) => eventStatus(e) === 'pending');
      const upcoming = state.events.filter((e: any) => eventStatus(e) === 'upcoming');
      const completed = state.events.filter((e: any) => eventStatus(e) === 'completed');
      const grossIncome = completed.reduce((s: number, e: any) => s + Number(e.amount_received || 0), 0);
      const totalPayouts = completed.reduce((s: number, e: any) => {
        const { wages, transport } = eventPayoutTotals(e);
        return s + wages + transport;
      }, 0);
      const netIncome = completed.reduce((sum: number, e: any) => sum + eventNetIncome(e), 0);
      const thisYear = state.events.filter((e: any) => e.event_date.slice(0, 4) === String(new Date().getFullYear()));
      const avgNet = completed.length ? netIncome / completed.length : 0;
      els.evtDashStats.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">↑</span><span class="ws-dash-kpi-label">Upcoming</span></div>
          <span class="ws-dash-kpi-num">${upcoming.length}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">!</span><span class="ws-dash-kpi-label">Needs completion</span></div>
          <span class="ws-dash-kpi-num">${todo.length}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Completed (all-time)</span></div>
          <span class="ws-dash-kpi-num">${completed.length}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Bookings this year</span></div>
          <span class="ws-dash-kpi-num">${thisYear.length}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">$</span><span class="ws-dash-kpi-label">Gross income</span></div>
          <span class="ws-dash-kpi-num">${grossIncome.toFixed(2)}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">↓</span><span class="ws-dash-kpi-label">Member payouts</span></div>
          <span class="ws-dash-kpi-num">${totalPayouts.toFixed(2)}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">=</span><span class="ws-dash-kpi-label">Net income</span></div>
          <span class="ws-dash-kpi-num">${netIncome.toFixed(2)}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">≈</span><span class="ws-dash-kpi-label">Avg net / event</span></div>
          <span class="ws-dash-kpi-num">${avgNet.toFixed(2)}</span>
        </div>
      `;
      renderEventsChart(completed);
      const topMembers = computeTopMembers();
      els.evtTopMembers.innerHTML = topMembers.length ? topMembers.map((x: any, i: number) => `
        <div class="ws-dash-feed-row">
          <span class="ws-dash-feed-text"><span class="ws-dash-feed-title">${i + 1}. ${escapeHtml(x.member.full_name)}</span></span>
          <span class="ws-dash-feed-amount">${x.count} event${x.count === 1 ? '' : 's'}</span>
        </div>
      `).join('') : '<p class="ws-dash-empty-mini">No bookings with band members assigned yet.</p>';
      const typeBreakdown = computeTypeBreakdown();
      els.evtTypeBreakdown.innerHTML = typeBreakdown.length ? typeBreakdown.map(([type, count]: [string, number]) => `
        <div class="ws-dash-feed-row">
          <span class="ws-dash-feed-text"><span class="ws-dash-feed-title">${escapeHtml(type)}</span></span>
          <span class="ws-dash-feed-amount">${count} booking${count === 1 ? '' : 's'}</span>
        </div>
      `).join('') : '<p class="ws-dash-empty-mini">No events booked yet.</p>';
      const rowHtml = (e: any) => `
        <tr data-event-id="${e.id}">
          <td data-label="Date">${escapeHtml(eventDateTimeLabel(e))}</td>
          <td data-label="Client">${escapeHtml(eventClientName(e))}</td>
          <td data-label="Type">${escapeHtml(e.event_type)}</td>
          <td data-label="Location">${escapeHtml(e.location || '—')}</td>
          <td class="ws-row-actions"><button type="button" class="ws-edit-btn" data-evt-dash-open>Open</button></td>
        </tr>
      `;
      els.evtTodoBody.innerHTML = todo.length ? todo.map(rowHtml).join('') : '<tr><td colspan="5" class="ws-empty">Nothing pending.</td></tr>';
      els.evtUpcomingBody.innerHTML = upcoming.length ? upcoming.map(rowHtml).join('') : '<tr><td colspan="5" class="ws-empty">Nothing booked yet.</td></tr>';
      [els.evtTodoBody, els.evtUpcomingBody].forEach((body: any) => {
        body.querySelectorAll('[data-evt-dash-open]').forEach((btn: any) => {
          btn.addEventListener('click', () => {
            const id = btn.closest('tr').dataset.eventId;
            const ev = state.events.find((x: any) => x.id === id);
            if (!ev) return;
            setSubtab('events', 'calendar');
            evtGoToDate(ev.event_date);
            evtOpenDay(ev.event_date, id);
          });
        });
      });
    }

    // ---- Calendar subtab: month grid, same shape as Curriculum's own
    // (reuses its curr-weekday-row/curr-month-cells/curr-day-cell CSS),
    // except a day can hold several bookings instead of just one meeting.
    function evtGoToDate(dateStr: string) {
      const d = parseDateStr(dateStr);
      state.evt.anchor = new Date(d.getFullYear(), d.getMonth(), 1);
      evtRenderMonth();
    }
    function evtStepMonth(delta: number) {
      state.evt.anchor = new Date(state.evt.anchor.getFullYear(), state.evt.anchor.getMonth() + delta, 1);
      evtRenderMonth();
    }
    function evtRenderMonth() {
      const anchor = state.evt.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      els.evtNavLabel.textContent = `${MONTHS[mo].en} ${y}`;
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const dayEvents = state.events.filter((e: any) => e.event_date === dateStr)
          .sort((a: any, b: any) => (a.event_time || '') < (b.event_time || '') ? -1 : 1);
        const shown = dayEvents.slice(0, 3);
        const extra = dayEvents.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${dayEvents.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          <div class="curr-day-mini">
            ${shown.map((e: any) => `<span class="curr-mini-chip curr-mini-chip--${eventStatus(e)}">${escapeHtml((e.event_time ? formatTimeStr(e.event_time) + ' ' : '') + e.last_name)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.evtMonthGrid.innerHTML = html;
      els.evtMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => evtOpenDay(cell.dataset.date));
      });
    }

    // ---- Day overlay: that day's agenda, plus the add/edit form for one
    // booking at a time (never both views shown together).
    function evtOpenDay(dateStr: string, focusEventId?: string) {
      state.evt.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      els.evtDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      evtRenderDayList(dateStr);
      els.evtDayOverlay.removeAttribute('hidden');
      document.documentElement.style.overflow = 'hidden';
      if (focusEventId) evtStartEdit(focusEventId);
      else evtShowList();
    }
    function evtCloseDay() {
      els.evtDayOverlay.setAttribute('hidden', '');
      state.evt.currentDay = null;
      document.documentElement.style.overflow = '';
    }
    function evtShowList() {
      els.evtDayListView.removeAttribute('hidden');
      els.evtFormView.setAttribute('hidden', '');
    }
    function evtShowForm() {
      els.evtDayListView.setAttribute('hidden', '');
      els.evtFormView.removeAttribute('hidden');
    }
    function evtRenderDayList(dateStr: string) {
      const dayEvents = state.events.filter((e: any) => e.event_date === dateStr)
        .sort((a: any, b: any) => (a.event_time || '') < (b.event_time || '') ? -1 : 1);
      els.evtDayList.innerHTML = dayEvents.length ? dayEvents.map((e: any) => `
        <div class="ws-evt-day-item" data-event-id="${e.id}">
          <div class="ws-evt-day-item-main">
            <span class="ws-evt-day-item-title">${escapeHtml(eventClientName(e))}${e.event_time ? ' · ' + escapeHtml(formatTimeStr(e.event_time)) : ''}</span>
            <span class="ws-evt-day-item-sub">${escapeHtml(e.event_type)}${e.location ? ' · ' + escapeHtml(e.location) : ''}</span>
          </div>
          ${eventStatusBadge(e)}
          <div class="ws-evt-day-item-actions">
            <button type="button" class="ws-edit-btn" data-evt-day-edit>Edit</button>
          </div>
        </div>
      `).join('') : '<p class="ws-empty" style="padding:1rem 0">Nothing booked this day yet.</p>';
      els.evtDayList.querySelectorAll('[data-evt-day-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => evtStartEdit(btn.closest('[data-event-id]').dataset.eventId));
      });
    }
    function evtResetForm() {
      state.editingEventId = null;
      els.evtFormView.reset();
      updateEvtTypeOptions();
      els.evtType.value = '';
      els.evtDate.value = state.evt.currentDay || todayStr();
      updateEvtLocationOptions();
      els.evtLocation.value = '';
      evtToggleLocationCustom();
      els.evtFormTitle.textContent = 'New event';
      els.evtDelete.hidden = true;
      els.evtCostsSection.hidden = true;
      els.evtTransportRow.hidden = true;
      evtRenderAttendeePicker([]);
      resetEventCostForm();
    }
    function evtStartNew() {
      evtResetForm();
      evtShowForm();
    }
    function evtStartEdit(id: string) {
      const ev = state.events.find((x: any) => x.id === id);
      if (!ev) return;
      state.editingEventId = id;
      els.evtFirstName.value = ev.first_name;
      els.evtLastName.value = ev.last_name;
      els.evtPhone.value = ev.phone;
      els.evtEmail.value = ev.email || '';
      els.evtDate.value = ev.event_date;
      els.evtTime.value = ev.event_time || '';
      updateEvtTypeOptions();
      els.evtType.value = ev.event_type;
      updateEvtLocationOptions();
      const locationList = state.groupSettings?.event_location_categories || [];
      if (ev.location && locationList.includes(ev.location)) {
        els.evtLocation.value = ev.location;
      } else if (ev.location) {
        els.evtLocation.value = EVENT_LOCATION_CUSTOM;
        els.evtLocationCustom.value = ev.location;
      } else {
        els.evtLocation.value = '';
      }
      evtToggleLocationCustom();
      els.evtNotes.value = ev.notes || '';
      evtRenderAttendeePicker(ev.attendees || []);
      els.evtAmount.value = ev.amount_received != null ? ev.amount_received : '';
      els.evtPaymentMethod.value = ev.payment_method || '';
      els.evtPayRate.value = ev.pay_rate_per_member != null ? ev.pay_rate_per_member : '';
      els.evtTransportRate.value = ev.transport_rate_per_member != null ? ev.transport_rate_per_member : '';
      evtUpdateTransportVisibility();
      els.evtFormTitle.textContent = `Editing ${eventClientName(ev)}`;
      els.evtDelete.hidden = false;
      els.evtCostsSection.hidden = false;
      resetEventCostForm();
      evtRenderCosts(id);
      evtShowForm();
    }
    // A previously-checked member who's since been archived still shows
    // up (so re-saving the event doesn't silently drop them) — everyone
    // else is the group's currently active roster.
    function evtRenderAttendeePicker(attendees: any[]) {
      const checkedIds = new Set(attendees.map((a: any) => a.member_id));
      const carIds = new Set(attendees.filter((a: any) => a.took_car).map((a: any) => a.member_id));
      const pool = state.members.filter((m: any) => m.active || checkedIds.has(m.id));
      els.evtAttendees.innerHTML = pool.length ? pool.map((m: any) => `
        <div class="ws-evt-attendee-row" data-member-id="${m.id}">
          <label>
            <input type="checkbox" data-evt-attendee-check ${checkedIds.has(m.id) ? 'checked' : ''} />
            <span>${escapeHtml(m.full_name)}</span>
          </label>
          <label class="ws-evt-attendee-car">
            <input type="checkbox" data-evt-attendee-car ${carIds.has(m.id) ? 'checked' : ''} ${checkedIds.has(m.id) ? '' : 'disabled'} />
            Took a car
          </label>
        </div>
      `).join('') : '<p class="ws-empty" style="padding:0.5rem 0">No band members in the roster yet.</p>';
      els.evtAttendees.querySelectorAll('[data-evt-attendee-check]').forEach((cb: any) => {
        cb.addEventListener('change', () => {
          const row = cb.closest('.ws-evt-attendee-row');
          const carCb = row.querySelector('[data-evt-attendee-car]');
          carCb.disabled = !cb.checked;
          if (!cb.checked) carCb.checked = false;
          evtUpdateTransportVisibility();
        });
      });
      els.evtAttendees.querySelectorAll('[data-evt-attendee-car]').forEach((cb: any) => {
        cb.addEventListener('change', evtUpdateTransportVisibility);
      });
    }
    function evtGetAttendeesFromForm(): { member_id: string; took_car: boolean }[] {
      return Array.from(els.evtAttendees.querySelectorAll('.ws-evt-attendee-row')).flatMap((row: any) => {
        if (!row.querySelector('[data-evt-attendee-check]').checked) return [];
        return [{ member_id: row.dataset.memberId, took_car: row.querySelector('[data-evt-attendee-car]').checked }];
      });
    }
    // Transport pay only ever applies to members who took a car — the
    // rate field (and this live total) only surface once at least one
    // attendee is marked as having taken one.
    function evtUpdateTransportVisibility() {
      const attendees = evtGetAttendeesFromForm();
      const carCount = attendees.filter((a) => a.took_car).length;
      els.evtTransportRow.toggleAttribute('hidden', carCount === 0);
      const payRate = Number(els.evtPayRate.value) || 0;
      const transportRate = Number(els.evtTransportRate.value) || 0;
      const wages = payRate * attendees.length;
      const transport = transportRate * carCount;
      els.evtPayoutSummary.textContent = carCount
        ? `${attendees.length} member(s) × ${payRate.toFixed(2)} + ${carCount} car(s) × ${transportRate.toFixed(2)} = ${(wages + transport).toFixed(2)} total payout`
        : '';
    }

    // ---- Extra costs (repeatable line items per event) ----
