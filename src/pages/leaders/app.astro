    async function loadApprovals() {
      if (!state.activeGroup) return;
      const { data, error } = await db
        .from('join_requests')
        .select('*')
        .eq('group_key', state.activeGroup)
        .eq('status', 'pending')
        .order('created_at', { ascending: true });
