    }
    function scNavLabelFor(): string {
      const a = state.sc.anchor;
      if (state.sc.view === 'day') {
        const d = new Date(a);
        return `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      }
      if (state.sc.view === 'week') {
        const start = startOfWeek(a);
        const end = addDays(start, 6);
        return start.getMonth() === end.getMonth()
          ? `${MONTHS[start.getMonth()].en} ${start.getDate()}–${end.getDate()}, ${end.getFullYear()}`
          : `${MONTHS[start.getMonth()].en} ${start.getDate()} – ${MONTHS[end.getMonth()].en} ${end.getDate()}, ${end.getFullYear()}`;
      }
      if (state.sc.view === 'year') return String(a.getFullYear());
      return `${MONTHS[a.getMonth()].en} ${a.getFullYear()}`;
    }
    function scRenderView() {
      els.scNavLabel.textContent = scNavLabelFor();
      document.querySelectorAll('[data-sc-view-pane]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.scViewPane !== state.sc.view));
      document.querySelectorAll('[data-sc-view]').forEach((btn: any) => btn.classList.toggle('curr-view-btn--active', btn.dataset.scView === state.sc.view));
      if (state.sc.view === 'day') scRenderDay();
      else if (state.sc.view === 'week') scRenderWeek();
      else if (state.sc.view === 'year') scRenderYear();
      else scRenderMonth();
    }
    // "17:00" -> "5 PM", "17:30" -> "5:30 PM"
    function scFormatTime12(t: string): { label: string; period: string } {
      const [h, m] = t.split(':').map(Number);
      const period = h < 12 ? 'AM' : 'PM';
      const h12 = h % 12 === 0 ? 12 : h % 12;
      return { label: m ? `${h12}:${String(m).padStart(2, '0')}` : String(h12), period };
    }
    // Same-period ranges compact like Google's own ("5–7 PM" instead of
    // "5 PM – 7 PM"); different periods spell both out.
    function scTimeRangeLabel(item: any): string {
      if (!item.event_time) return 'All day';
      const start = scFormatTime12(item.event_time);
      if (!item.event_end_time) return `${start.label} ${start.period}`;
      const end = scFormatTime12(item.event_end_time);
      return start.period === end.period ? `${start.label}–${end.label} ${end.period}` : `${start.label} ${start.period} – ${end.label} ${end.period}`;
    }
    function scDayItemRowHTML(item: any) {
      if (item.kind === 'music') {
        return `
          <div class="ws-evt-day-item ws-evt-day-item--readonly">
            <div class="ws-evt-day-item-main">
              <span class="ws-evt-day-item-title">${escapeHtml(item.title)}</span>
              <span class="ws-evt-day-item-sub">${scTimeRangeLabel(item)} · Music Event Calendar</span>
            </div>
            <span class="ws-badge ws-badge--fair">View only</span>
          </div>`;
      }
      const canManage = scCanManage(item);
      return `
        <div class="ws-evt-day-item" style="--sc-item-color:${scEventColorValue(item.color)}" data-sc-event-id="${item.id}" data-sc-occurrence-date="${item.occurrence_date || item.event_date}">
          <div class="ws-evt-day-item-main">
            <span class="ws-evt-day-item-title">${escapeHtml(item.title)}${item.recurrence_unit ? ' <span class="ws-sc-repeat-mark" title="Repeats">↻</span>' : ''}</span>
            <span class="ws-evt-day-item-sub">${scTimeRangeLabel(item)}${item.notes ? ' · ' + escapeHtml(item.notes) : ''} · Added by ${escapeHtml(item.created_by_name || '—')}</span>
          </div>
          <div class="ws-evt-day-item-actions">
            ${canManage
              ? '<button type="button" class="ws-edit-btn" data-sc-day-edit>Edit</button><button type="button" class="ws-row-del" data-sc-day-delete title="Delete">×</button>'
              : canEditSharedCal()
                ? '<button type="button" class="ws-edit-btn" data-sc-day-request>Request a change</button>'
                : '<span class="ws-badge ws-badge--fair">View only</span>'}
          </div>
        </div>`;
    }
    function bindScDayItemActions(container: any) {
      container.querySelectorAll('[data-sc-day-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('[data-sc-event-id]');
          scStartEdit(row.dataset.scEventId, row.dataset.scOccurrenceDate);
        });
      });
      container.querySelectorAll('[data-sc-day-request]').forEach((btn: any) => {
        btn.addEventListener('click', () => scRequestChange(btn.closest('[data-sc-event-id]').dataset.scEventId));
      });
      container.querySelectorAll('[data-sc-day-delete]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('[data-sc-event-id]');
          scDeleteFlow(row.dataset.scEventId, row.dataset.scOccurrenceDate);
        });
      });
    }
    function scHourLabel(h: number): string {
      if (h === 0) return '12 AM';
      if (h === 12) return '12 PM';
      return h < 12 ? `${h} AM` : `${h - 12} PM`;
    }
    const SC_ROW_H = 3; // rem per hour — kept in sync with --sc-row-h below
    function scTimeToHours(t: string): number {
      const [h, m] = t.split(':').map(Number);
      return h + m / 60;
    }
    // Shared by Day (1 day) and Week (7 days) — a 24-hour grid, always
    // fully drawn even with nothing on it (an empty day should still
    // look like a calendar, not a blank box). Timed events are
    // absolutely positioned by their actual start/end time (a 2-hour
    // block visibly spans 2 hours), not just dropped into whichever
    // hour they start in.
    function scRenderTimelineGrid(container: any, days: Date[]) {
      const dateStrs = days.map(toDateStr);
      const idx = scBuildOccurrenceIndex(days[0], days[days.length - 1]);
      const today = todayStr();
      const multiDay = days.length > 1;
      container.style.setProperty('--sc-days', String(days.length));
      container.style.setProperty('--sc-row-h', `${SC_ROW_H}rem`);

      let html = '';
      if (multiDay) {
        html += '<div class="ws-sc-tl-head-row"><div class="ws-sc-tl-head-spacer"></div>';
        days.forEach((d, i) => {
          html += `<div class="ws-sc-tl-head-day${dateStrs[i] === today ? ' ws-sc-tl-head-day--today' : ''}">
            <span class="ws-sc-tl-head-name">${WEEKDAYS[d.getDay()].en.slice(0, 3)}</span>
            <span class="ws-sc-tl-head-num">${d.getDate()}</span>
          </div>`;
        });
        html += '</div>';
      }
      const anyAllDay = dateStrs.some((ds) => (idx.get(ds) || []).some((it: any) => !it.event_time));
      if (anyAllDay) {
        html += '<div class="ws-sc-tl-allday-row"><div class="ws-sc-tl-head-spacer"></div>';
        dateStrs.forEach((ds) => {
          const items = (idx.get(ds) || []).filter((it: any) => !it.event_time);
          html += `<div class="ws-sc-tl-allday-cell" data-date="${ds}">${items.map((it: any) => scTimelineChipHTML(it, false)).join('')}</div>`;
        });
        html += '</div>';
      }
      html += '<div class="ws-sc-tl-hourgrid"><div class="ws-sc-tl-hourlabelcol">';
      for (let h = 0; h < 24; h++) {
        html += `<div class="ws-sc-tl-hourlabel" style="top:${h * SC_ROW_H}rem">${scHourLabel(h)}</div>`;
      }
      html += '</div>';
      const nowInView = dateStrs.includes(today);
      const nowTop = (new Date().getHours() + new Date().getMinutes() / 60) * SC_ROW_H;
      dateStrs.forEach((ds) => {
        const items = (idx.get(ds) || []).filter((it: any) => it.event_time);
        const nowLine = nowInView && ds === today ? `<div class="ws-sc-tl-now-line" style="top:${nowTop}rem"></div>` : '';
        html += `<div class="ws-sc-tl-daycol" data-date="${ds}">${items.map((it: any) => scTimelineChipHTML(it, true)).join('')}${nowLine}</div>`;
      });
      html += '</div>';
      container.innerHTML = html;
      // Center on now (or a reasonable default when today isn't in
      // view) so opening the timeline never starts scrolled to
      // midnight — every hour is still one scroll away either way.
      // The day-header row is sticky and covers the top of the
      // viewport, so the centering has to leave room for it — otherwise
      // a dead-center target can land right behind the header instead
      // of visibly below it. Using getBoundingClientRect() rather than
      // offsetTop here on purpose: .ws-sc-tl-wrap has no `position` set,
      // so it isn't hourGridEl's offsetParent — offsetTop would measure
      // from whatever positioned ancestor is further up the page, not
      // from the scroll container itself.
      const hourGridEl = container.querySelector('.ws-sc-tl-hourgrid');
      if (hourGridEl) {
        const remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const targetTopRem = nowInView ? nowTop : 8 * SC_ROW_H;
        const headerEl = container.querySelector('.ws-sc-tl-head-row');
        const headerH = headerEl ? headerEl.getBoundingClientRect().height : 0;
        const gridOffsetInContainer = hourGridEl.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop;
        const contentY = gridOffsetInContainer + targetTopRem * remPx;
        container.scrollTop = Math.max(0, contentY - container.clientHeight / 2 - headerH / 2);
      }
      container.querySelectorAll('[data-date]').forEach((cell: any) => {
        cell.addEventListener('click', (e: Event) => {
          if ((e.target as any).closest('[data-sc-chip-id]')) return; // handled below
          scOpenDay(cell.dataset.date);
        });
      });
      container.querySelectorAll('[data-sc-chip-id]').forEach((chip: any) => {
        chip.addEventListener('click', (e: Event) => {
          e.stopPropagation();
          scOpenDay(chip.closest('[data-date]').dataset.date);
        });
      });
    }
    // positioned=true places the chip absolutely by start/end time
    // (the hour grid); false is the plain flow layout used for the
    // all-day strip, which has no time axis to position against.
    function scTimelineChipHTML(item: any, positioned: boolean): string {
      const label = item.event_time ? `${scTimeRangeLabel(item)} ${item.title}` : item.title;
      // Music's own bookings keep their plain muted look (--music) —
      // they have no `color` of their own to apply, and an inline
      // background would win over that class's anyway.
      const cls = `ws-sc-tl-event${item.kind === 'music' ? ' ws-sc-tl-event--music' : ''}`;
      const colorStyle = item.kind === 'music' ? '' : `background:${scEventColorValue(item.color)};`;
      if (!positioned || !item.event_time) {
        return `<div class="${cls}" style="position:static;${colorStyle}" data-sc-chip-id="${item.id}" title="${escapeHtml(label)}">${escapeHtml(label)}</div>`;
      }
      const startH = scTimeToHours(item.event_time);
      const endH = item.event_end_time ? Math.max(startH + 0.25, scTimeToHours(item.event_end_time)) : startH + 0.75;
      const top = startH * SC_ROW_H;
      const height = (endH - startH) * SC_ROW_H;
      return `<div class="${cls}" style="top:${top}rem;height:${height}rem;${colorStyle}" data-sc-chip-id="${item.id}" title="${escapeHtml(label)}">${escapeHtml(label)}</div>`;
    }
    function scRenderDay() {
      scRenderTimelineGrid(els.scDayAgenda, [state.sc.anchor]);
    }
    function scRenderWeek() {
      const start = startOfWeek(state.sc.anchor);
      scRenderTimelineGrid(els.scWeekGrid, Array.from({ length: 7 }, (_, i) => addDays(start, i)));
    }
    function scRenderMonth() {
      const anchor = state.sc.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      const idx = scBuildOccurrenceIndex(start, end);
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const items = idx.get(dateStr) || [];
        const shown = items.slice(0, 3);
        const extra = items.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${items.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          <div class="curr-day-mini">
            ${shown.map((it: any) => `<span class="ws-sc-month-chip${it.kind === 'music' ? ' ws-sc-month-chip--music' : ''}"${it.kind === 'music' ? '' : ` style="background:${scEventColorValue(it.color)}"`}>${escapeHtml(it.title)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.scMonthGrid.innerHTML = html;
      els.scMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => scOpenDay(cell.dataset.date));
      });
    }
    function scRenderYear() {
      const year = state.sc.anchor.getFullYear();
      const today = todayStr();
      const idx = scBuildOccurrenceIndex(new Date(year, 0, 1), new Date(year, 11, 31));
      let html = '';
      for (let mo = 0; mo < 12; mo++) {
        const first = new Date(year, mo, 1);
        const start = startOfWeek(first);
        let cellsHtml = '';
        let d = new Date(start);
        // Always exactly 6 rows (42 cells) so every month card lines up.
        for (let i = 0; i < 42; i++) {
          const dateStr = toDateStr(d);
          const inMonth = d.getMonth() === mo;
          const has = inMonth && (idx.get(dateStr) || []).length > 0;
          cellsHtml += `<div class="ws-sc-year-cell${inMonth ? '' : ' ws-sc-year-cell--out'}${dateStr === today ? ' ws-sc-year-cell--today' : ''}${has ? ' ws-sc-year-cell--has' : ''}" data-date="${dateStr}">${inMonth ? d.getDate() : ''}</div>`;
          d = addDays(d, 1);
        }
        html += `<div class="ws-sc-year-month"><p class="ws-sc-year-month-head">${MONTHS[mo].en}</p><div class="ws-sc-year-cells">${cellsHtml}</div></div>`;
      }
      els.scYearGrid.innerHTML = html;
      els.scYearGrid.querySelectorAll('.ws-sc-year-cell:not(.ws-sc-year-cell--out)').forEach((cell: any) => {
        cell.addEventListener('click', () => scOpenDay(cell.dataset.date));
      });
    }
    function scSetView(view: string) {
      state.sc.view = view;
      document.querySelectorAll('[data-sc-view]').forEach((btn: any) => btn.classList.toggle('curr-view-btn--active', btn.dataset.scView === view));
      scRenderView();
    }
    function scStep(delta: number) {
      const a = state.sc.anchor;
      if (state.sc.view === 'day') state.sc.anchor = addDays(a, delta);
      else if (state.sc.view === 'week') state.sc.anchor = addDays(a, delta * 7);
      else if (state.sc.view === 'year') state.sc.anchor = new Date(a.getFullYear() + delta, a.getMonth(), 1);
      else state.sc.anchor = new Date(a.getFullYear(), a.getMonth() + delta, 1);
      scRenderView();
    }
    function scShowForm() { els.scDayListView.hidden = true; els.scFormView.hidden = false; }
    function scShowList() { els.scFormView.hidden = true; els.scDayListView.hidden = false; scRenderDayList(state.sc.currentDay); }
    // The weekday toggle (S M T W T F S) only appears for a Custom
    // weekly repeat — its selection lives here rather than as a
    // multi-select form field, and gets read/written alongside the
    // rest of the form.
    function scSetWeekdaySelection(days: number[]) {
      els.scWeekdayToggle.querySelectorAll('button').forEach((btn: any) => {
        btn.classList.toggle('ws-sc-weekday--active', days.includes(Number(btn.dataset.day)));
      });
    }
    function scGetWeekdaySelection(): number[] {
      return Array.from(els.scWeekdayToggle.querySelectorAll('button.ws-sc-weekday--active')).map((btn: any) => Number(btn.dataset.day));
    }
    function scGetEndType(): string {
      const checked = els.scCustomPanel.querySelector('input[name="sc-end"]:checked');
      return checked ? checked.value : 'never';
    }
    function scSetEndType(type: string) {
      const radio = els.scCustomPanel.querySelector(`input[name="sc-end"][value="${type}"]`);
      if (radio) radio.checked = true;
    }
    // Reverse of the preset→fields mapping below, for loading an
    // existing series back into the popup/select.
    function scRepeatPresetFor(item: any): string {
      if (!item.recurrence_unit) return 'none';
      const days = item.recurrence_days || [];
      if (item.recurrence_interval === 1 && item.recurrence_unit === 'week' && days.length === 5 && [1, 2, 3, 4, 5].every((x) => days.includes(x))) return 'weekdays';
      if (item.recurrence_interval === 1 && (item.recurrence_unit !== 'week' || days.length <= 1)) return item.recurrence_unit;
      return 'custom';
    }
    // Fills the Custom recurrence popup's own fields — called both when
    // opening it for an existing custom series, and with sensible
    // defaults the first time someone picks "Custom…" on a fresh entry.
    function scFillCustomPopup(item: any) {
      const isCustomSeries = item.recurrence_unit && scRepeatPresetFor(item) === 'custom';
      els.scRepeatUnit.value = isCustomSeries ? item.recurrence_unit : 'week';
      els.scRepeatInterval.value = isCustomSeries ? String(item.recurrence_interval || 1) : '1';
      scSetWeekdaySelection(isCustomSeries ? (item.recurrence_days || []) : [parseDateStr(els.scDate.value).getDay()]);
      scSetEndType(item.recurrence_end_type || 'never');
      els.scRepeatEndDate.value = item.recurrence_end_date || '';
      els.scRepeatEndCount.value = String(item.recurrence_end_count || 13);
      els.scRepeatDays.toggleAttribute('hidden', els.scRepeatUnit.value !== 'week');
    }
    function scApplyRepeatToForm(item: any) {
      els.scRepeat.value = scRepeatPresetFor(item);
      scFillCustomPopup(item);
    }
    // The "Repeat" select is a handful of friendly presets — this maps
    // whichever one is chosen (plus whatever the Custom recurrence
    // popup was last filled with) to the plain fields actually stored
    // on the row.
    function scRepeatFieldsFromForm(): any {
      const preset = els.scRepeat.value;
      if (preset === 'none') {
        return { recurrence_unit: null, recurrence_interval: 1, recurrence_days: null, recurrence_end_type: 'never', recurrence_end_date: null, recurrence_end_count: null };
      }
      let unit: string, interval = 1, days: number[] | null = null;
      if (preset === 'custom') {
        unit = els.scRepeatUnit.value;
        interval = Math.max(1, Number(els.scRepeatInterval.value) || 1);
        if (unit === 'week') days = scGetWeekdaySelection();
      } else if (preset === 'weekdays') {
        unit = 'week'; days = [1, 2, 3, 4, 5];
      } else {
        unit = preset;
        if (unit === 'week') days = [parseDateStr(els.scDate.value).getDay()];
      }
      const endType = preset === 'custom' ? scGetEndType() : 'never';
      return {
        recurrence_unit: unit, recurrence_interval: interval, recurrence_days: days && days.length ? days : null,
        recurrence_end_type: endType,
        recurrence_end_date: endType === 'on_date' ? (els.scRepeatEndDate.value || null) : null,
        recurrence_end_count: endType === 'after_count' ? (Number(els.scRepeatEndCount.value) || null) : null,
      };
    }
    // Fixed palette (SC_EVENT_COLORS, constants.ts), not a free-form
    // picker — swatches are built once from that list; picking one just
    // moves which button carries --sc-color-swatch--active, tracked in
    // state.scSelectedColor rather than re-rendering the whole picker.
    function scColorSwatchesHTML(): string {
      return SC_EVENT_COLORS.map((c) => `<button type="button" class="ws-sc-color-swatch" data-sc-color="${c.key}" style="--swatch:${c.value}" title="${escapeHtml(c.label)}" aria-label="${escapeHtml(c.label)}"></button>`).join('');
    }
    function scSetColorPicker(key: string | null | undefined) {
      state.scSelectedColor = key || 'brand';
      els.scColorPicker.querySelectorAll('[data-sc-color]').forEach((b: any) => b.classList.toggle('ws-sc-color-swatch--active', b.dataset.scColor === state.scSelectedColor));
    }
    function bindScColorPicker() {
      els.scColorPicker.innerHTML = scColorSwatchesHTML();
      els.scColorPicker.addEventListener('click', (e: any) => {
        const btn = e.target.closest('[data-sc-color]');
        if (btn) scSetColorPicker(btn.dataset.scColor);
      });
    }
    function scResetForm() {
      state.editingScId = null;
      state.editingScOccurrenceDate = null;
      els.scFormView.reset();
      els.scDate.value = state.sc.currentDay || todayStr();
      els.scFormTitle.textContent = 'New calendar entry';
      els.scDelete.hidden = true;
      scApplyRepeatToForm({});
      scSetColorPicker(null);
    }
    function scStartNew() { scResetForm(); scShowForm(); }
    function scStartEdit(id: string, occurrenceDate?: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return;
      state.editingScId = id;
      state.editingScOccurrenceDate = occurrenceDate || item.event_date;
      els.scTitle.value = item.title;
      // The date field shows the OCCURRENCE that was clicked, not always
      // the series' original start — needed so "This event"/"This and
      // following events" (scOpenScopeChoice()) split at the right spot,
      // and so rescheduling a single occurrence actually shows its own
      // date rather than the series anchor's.
      els.scDate.value = state.editingScOccurrenceDate;
      els.scTime.value = item.event_time || '';
      els.scTimeEnd.value = item.event_end_time || '';
      els.scNotes.value = item.notes || '';
      els.scFormTitle.textContent = 'Editing entry';
      els.scDelete.hidden = false;
      scApplyRepeatToForm(item);
      scSetColorPicker(item.color);
      scShowForm();
    }
    function scRenderDayList(dateStr: string) {
      const items = scItemsForDate(dateStr);
      els.scDayList.innerHTML = items.length ? items.map(scDayItemRowHTML).join('') : '<p class="ws-empty" style="padding:1rem 0">Nothing on the calendar this day.</p>';
      bindScDayItemActions(els.scDayList);
    }
    function scOpenDay(dateStr: string) {
      state.sc.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      els.scDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      scShowList();
      els.scDayOverlay.removeAttribute('hidden');
    }
    function scCloseDay() {
      els.scDayOverlay.setAttribute('hidden', '');
      state.sc.currentDay = null;
    }
    function scOpenCustomPopup() {
      scFillCustomPopup(state.editingScId ? (state.scEvents.find((x: any) => x.id === state.editingScId) || {}) : {});
      els.scCustomOverlay.removeAttribute('hidden');
    }
    async function scDeleteSeries(id: string) {
      const { error } = await db.from('shared_calendar_events').delete().eq('id', id);
      if (error) { console.error(error); showToast('Could not delete.'); return false; }
      return true;
    }
    async function scDeleteOccurrence(id: string, dateStr: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return false;
      const exceptions = Array.from(new Set([...(item.recurrence_exceptions || []), dateStr]));
      const { error } = await db.from('shared_calendar_events').update({ recurrence_exceptions: exceptions }).eq('id', id);
      if (error) { console.error(error); showToast('Could not delete.'); return false; }
      return true;
    }
    // Cuts the series off the day before dateStr and drops any of its
    // own exceptions from that point on (they belong to whatever comes
    // after, which this doesn't create — there's nothing to edit into
    // it, unlike scSaveFollowing below). Deleting "and following" from
    // the very first occurrence is just deleting the whole thing.
    async function scDeleteFollowing(id: string, dateStr: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return false;
      if (dateStr <= item.event_date) return scDeleteSeries(id);
      const dayBefore = toDateStr(addDays(parseDateStr(dateStr), -1));
      const exceptions = (item.recurrence_exceptions || []).filter((d: string) => d < dateStr);
      const { error } = await db.from('shared_calendar_events')
        .update({ recurrence_end_type: 'on_date', recurrence_end_date: dayBefore, recurrence_exceptions: exceptions })
        .eq('id', id);
      if (error) { console.error(error); showToast('Could not delete.'); return false; }
      return true;
    }
    // The whole row IS the series (see shared_calendar_schema.sql), so
    // "All events" is mostly a plain update in place — except the date
    // field shows whichever OCCURRENCE was clicked (scStartEdit), not
    // the series' own anchor date, so payload.event_date can't just be
    // written straight through: on a later occurrence, that would drag
    // the whole series' start forward and silently drop every earlier
    // occurrence. Shift the stored anchor by the same day delta the
    // date field actually changed by instead (0 if it wasn't touched)
    // — the series moves exactly as far as the user moved it, weekday/
    // day-of-month offset and all, same as dragging one instance of a
    // recurring Google Calendar event with "All events" selected.
    async function scSaveAll(id: string, payload: any) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (item && state.editingScOccurrenceDate) {
        const deltaDays = Math.round((parseDateStr(payload.event_date).getTime() - parseDateStr(state.editingScOccurrenceDate).getTime()) / 86400000);
        payload = { ...payload, event_date: toDateStr(addDays(parseDateStr(item.event_date), deltaDays)) };
      }
      const { error } = await db.from('shared_calendar_events')
        .update({ ...payload, updated_at: new Date().toISOString() }).eq('id', id);
      if (error) { console.error(error); showToast('Could not save.'); return false; }
      return true;
    }
    // "This event": the series skips occurrenceDate from now on (same
    // exceptions mechanism as a single delete), and the edited fields
    // land in a brand-new plain, non-repeating row standing in for just
    // that one date — recurrence fields are always reset even if the
    // form still shows a repeat pattern, since a lone override never
    // repeats itself. payload.event_date is whatever the form's date
    // field holds, so rescheduling just this occurrence works too.
    async function scSaveThisOccurrence(id: string, occurrenceDate: string, payload: any) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return false;
      const exceptions = Array.from(new Set([...(item.recurrence_exceptions || []), occurrenceDate]));
      const { error: exErr } = await db.from('shared_calendar_events')
        .update({ recurrence_exceptions: exceptions }).eq('id', id);
      if (exErr) { console.error(exErr); showToast('Could not save.'); return false; }
      const { error } = await db.from('shared_calendar_events').insert({
        ...payload,
        recurrence_unit: null, recurrence_interval: 1, recurrence_days: null,
        recurrence_end_type: 'never', recurrence_end_date: null, recurrence_end_count: null, recurrence_exceptions: [],
        created_by: state.session.user.id, created_by_name: state.profile?.name || null,
      });
      if (error) { console.error(error); showToast('Could not save.'); return false; }
      return true;
    }
    // "This and following events": splits the series in two at
    // occurrenceDate — the existing row is truncated to end the day
    // before (keeping only its earlier exceptions), and a second row
    // picks up from occurrenceDate carrying the edited fields (title,
    // time, recurrence pattern, whichever changed) plus whichever of
    // the old exceptions fall on/after the split. Editing "and
    // following" from the series' very first occurrence has nothing
    // earlier to keep, so it's just editing the whole series in place.
    async function scSaveFollowing(id: string, occurrenceDate: string, payload: any) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return false;
      if (occurrenceDate <= item.event_date) return scSaveAll(id, payload);
      const dayBefore = toDateStr(addDays(parseDateStr(occurrenceDate), -1));
      const beforeExceptions = (item.recurrence_exceptions || []).filter((d: string) => d < occurrenceDate);
      const afterExceptions = (item.recurrence_exceptions || []).filter((d: string) => d >= occurrenceDate);
      const { error: truncErr } = await db.from('shared_calendar_events')
        .update({ recurrence_end_type: 'on_date', recurrence_end_date: dayBefore, recurrence_exceptions: beforeExceptions })
        .eq('id', id);
      if (truncErr) { console.error(truncErr); showToast('Could not save.'); return false; }
      const { error } = await db.from('shared_calendar_events').insert({
        ...payload, recurrence_exceptions: afterExceptions,
        created_by: state.session.user.id, created_by_name: state.profile?.name || null,
      });
      if (error) { console.error(error); showToast('Could not save.'); return false; }
      return true;
    }
    // Shared by the edit form's Save and the list view's own Delete —
    // both need the same This event/This and following events/All
    // events choice on a recurring entry, so they funnel through the
    // same popup (scOpenScopeChoice()) rather than each having their own.
    function scOpenScopeChoice(action: 'save' | 'delete', titleText: string) {
      state.scScopeAction = action;
      els.scScopeTitle.textContent = titleText;
      els.scScopePanel.querySelectorAll('input[name="sc-scope"]').forEach((r: any) => { r.checked = r.value === 'this'; });
      els.scScopeOverlay.removeAttribute('hidden');
    }
    function scDeleteFlow(id: string, occurrenceDate: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return;
      state.editingScId = id;
      state.editingScOccurrenceDate = occurrenceDate;
      if (item.recurrence_unit) {
        scOpenScopeChoice('delete', 'Delete recurring event');
      } else if (confirm('Delete this calendar entry?')) {
        scDeleteSeries(id).then((ok) => { if (ok) { loadSharedCal(); scShowList(); } });
      }
    }
    function bindSharedCalForm() {
      bindScColorPicker();
      els.scPrev.addEventListener('click', () => scStep(-1));
      els.scNext.addEventListener('click', () => scStep(1));
      els.scToday.addEventListener('click', () => { state.sc.anchor = new Date(); scRenderView(); });
      document.querySelectorAll('[data-sc-view]').forEach((btn: any) => {
        btn.addEventListener('click', () => scSetView(btn.dataset.scView));
      });
      els.scAddBtn.addEventListener('click', () => scOpenDay(todayStr()));
      els.scDayClose.addEventListener('click', scCloseDay);
      els.scDayAdd.addEventListener('click', scStartNew);
      els.scFormBack.addEventListener('click', scShowList);

      // "Custom…" opens its own popup instead of revealing inline
      // fields — Cancel reverts the select to whatever it was before.
      let scRepeatPrevValue = 'none';
      els.scRepeat.addEventListener('focus', () => { scRepeatPrevValue = els.scRepeat.value; });
      els.scRepeat.addEventListener('change', () => {
        if (els.scRepeat.value === 'custom') scOpenCustomPopup();
      });
      els.scWeekdayToggle.querySelectorAll('button').forEach((btn: any) => {
        btn.addEventListener('click', () => btn.classList.toggle('ws-sc-weekday--active'));
      });
      els.scRepeatUnit.addEventListener('change', () => {
        els.scRepeatDays.toggleAttribute('hidden', els.scRepeatUnit.value !== 'week');
      });
      els.scCustomCancel.addEventListener('click', () => {
        els.scRepeat.value = scRepeatPrevValue;
        els.scCustomOverlay.setAttribute('hidden', '');
      });
      els.scCustomDone.addEventListener('click', () => {
        els.scRepeat.value = 'custom';
        els.scCustomOverlay.setAttribute('hidden', '');
      });

      els.scFormView.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const title = els.scTitle.value.trim();
        const date = els.scDate.value;
        if (!title || !date) { showToast('Title and date are required.'); return; }
        const payload: any = {
          title, event_date: date, event_time: els.scTime.value || null, event_end_time: els.scTimeEnd.value || null,
          notes: els.scNotes.value.trim() || null, color: state.scSelectedColor === 'brand' ? null : state.scSelectedColor,
          ...scRepeatFieldsFromForm(),
        };
        if (state.editingScId) {
          // Editing a recurring entry needs to know which occurrences the
          // change applies to before it can be saved at all — everything
          // else (a new entry, or editing a plain one-off) just saves.
          const editing = state.scEvents.find((x: any) => x.id === state.editingScId);
          if (editing?.recurrence_unit) {
            state.scScopePayload = payload;
            scOpenScopeChoice('save', 'Save recurring event');
            return;
          }
          const { error } = await db.from('shared_calendar_events')
            .update({ ...payload, updated_at: new Date().toISOString() }).eq('id', state.editingScId);
          if (error) { console.error(error); showToast('Could not save.'); return; }
        } else {
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          const { error } = await db.from('shared_calendar_events').insert(payload);
          if (error) { console.error(error); showToast('Could not save.'); return; }
        }
        await loadSharedCal();
        scShowList();
      });
      els.scDelete.addEventListener('click', () => {
        if (!state.editingScId) return;
        scDeleteFlow(state.editingScId, state.editingScOccurrenceDate || els.scDate.value);
      });
      els.scScopeCancel.addEventListener('click', () => {
        els.scScopeOverlay.setAttribute('hidden', '');
        state.scScopeAction = null;
        state.scScopePayload = null;
      });
      els.scScopeOk.addEventListener('click', async () => {
        const scope = els.scScopePanel.querySelector('input[name="sc-scope"]:checked')?.value || 'this';
        const action = state.scScopeAction;
        const payload = state.scScopePayload;
        els.scScopeOverlay.setAttribute('hidden', '');
        state.scScopeAction = null;
        state.scScopePayload = null;
        const id = state.editingScId;
        const occurrenceDate = state.editingScOccurrenceDate || els.scDate.value;
        let ok = false;
        if (action === 'delete') {
          ok = scope === 'all' ? await scDeleteSeries(id)
            : scope === 'following' ? await scDeleteFollowing(id, occurrenceDate)
            : await scDeleteOccurrence(id, occurrenceDate);
        } else if (action === 'save') {
          ok = scope === 'all' ? await scSaveAll(id, payload)
            : scope === 'following' ? await scSaveFollowing(id, occurrenceDate, payload)
            : await scSaveThisOccurrence(id, occurrenceDate, payload);
        }
        if (ok) { await loadSharedCal(); scShowList(); }
      });
    }

    // ---------- Curriculum (embedded, shared per group; month view only,
    // click-to-plan instead of drag-and-drop) ------------------------------
    function currComputeRange() {
      const first = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth(), 1);
      const last = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() + 1, 0);
      return { start: startOfWeek(first), end: addDays(startOfWeek(last), 6) };
    }
    async function currLoadMeetings() {
      const { start, end } = currComputeRange();
      const { data, error } = await db.from('curriculum_meetings').select('*')
        .eq('group_key', state.activeGroup).gte('date', toDateStr(start)).lte('date', toDateStr(end));
      if (error) { console.error(error); showToast('Could not load the curriculum.'); return; }
      state.curr.meetings = new Map((data || []).map((row: any) => [row.date, row]));
    }
    function currGetOrCreateMeeting(dateStr: string) {
      let m = state.curr.meetings.get(dateStr);
      if (!m) {
        m = { group_key: state.activeGroup, date: dateStr, theme: null, notes: null, materials_needed: null, activities: [], actual_notes: null, created_by: state.profile?.name || null };
        state.curr.meetings.set(dateStr, m);
      }
      return m;
    }
    async function currPersistMeeting(dateStr: string) {
      const m = state.curr.meetings.get(dateStr);
      if (!m) return;
      const isEmpty = (!m.activities || m.activities.length === 0) && !m.theme && !m.notes && !m.materials_needed && !m.attachment_path && !m.actual_notes;
      try {
        if (isEmpty) {
          if (m.id) await db.from('curriculum_meetings').delete().eq('id', m.id);
          else await db.from('curriculum_meetings').delete().eq('group_key', state.activeGroup).eq('date', dateStr);
          state.curr.meetings.delete(dateStr);
          return;
        }
        const payload: any = {
          group_key: m.group_key, date: m.date, theme: m.theme || null, notes: m.notes || null,
          materials_needed: m.materials_needed || null,
          activities: m.activities, attachment_path: m.attachment_path || null, actual_notes: m.actual_notes || null,
          updated_by: state.profile?.name || null,
        };
        if (!m.id) payload.created_by = m.created_by || state.profile?.name || null;
        const { data, error } = await db.from('curriculum_meetings').upsert(payload, { onConflict: 'group_key,date' }).select().single();
        if (error) throw error;
        state.curr.meetings.set(dateStr, data);
        flashSaved();
      } catch (err) {
        console.error('curriculum save failed', err);
        showToast('Could not save, check your connection.');
      }
    }
    function currSubscribeRealtime(groupKey: string) {
      if (state.curr.channel) { db.removeChannel(state.curr.channel); state.curr.channel = null; }
      state.curr.channel = db.channel('curriculum-' + groupKey)
        .on('postgres_changes', {
          event: '*', schema: 'public', table: 'curriculum_meetings', filter: 'group_key=eq.' + groupKey,
        }, (payload: any) => {
          const row = payload.eventType === 'DELETE' ? payload.old : payload.new;
          if (!row || !row.date) return;
          if (payload.eventType === 'DELETE') state.curr.meetings.delete(row.date);
          else state.curr.meetings.set(row.date, row);
          currRefreshUI();
        })
        .subscribe();
    }
    function currRefreshUI() {
      currRenderMonth();
      if (state.curr.currentDay && els.currDayOverlay && !els.currDayOverlay.hidden) {
        currRenderActivityList(els.currDayList, state.curr.currentDay);
      }
    }
    // showDone: only meaningful once the meeting date has passed — you
    // can't have actually done a future activity yet, so the checkbox
    // (and its strike-through styling) only shows up for today/past
    // days. See currRenderActivityList()'s caller for the date check.
    function currActivityRowHTML(a: any, showDone: boolean) {
      return `
        <div class="curr-item${a.done ? ' curr-item--done' : ''}" data-activity-id="${a.id}">
          ${showDone ? `<input type="checkbox" class="curr-item-done" data-done="${a.id}" ${a.done ? 'checked' : ''} title="Mark as actually done" />` : ''}
          <span class="curr-item-text"><span class="curr-item-en">${escapeHtml(a.en)}</span></span>
          <input type="number" min="0" step="5" class="curr-item-duration" placeholder="min"
                 value="${a.duration != null ? a.duration : ''}" data-duration="${a.id}" />
          <button type="button" class="curr-item-del" data-del="${a.id}" aria-label="Remove">×</button>
        </div>`;
    }
    function currRenderActivityList(container: any, dateStr: string) {
      if (!container) return;
      const m = state.curr.meetings.get(dateStr);
      const activities = m ? m.activities : [];
      const showDone = dateStr <= todayStr();
      container.innerHTML = activities.length
        ? activities.map((a: any) => currActivityRowHTML(a, showDone)).join('')
        : '<p class="curr-empty">No activities yet, pick one from the bank or add a custom one below.</p>';
      container.querySelectorAll('[data-del]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          mm.activities = mm.activities.filter((a: any) => a.id !== btn.dataset.del);
          currRefreshUI();
          currPersistMeeting(dateStr);
        });
      });
      container.querySelectorAll('[data-duration]').forEach((inp: any) => {
        inp.addEventListener('change', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          const act = mm.activities.find((a: any) => a.id === inp.dataset.duration);
          if (!act) return;
          act.duration = inp.value ? Number(inp.value) : null;
          currPersistMeeting(dateStr);
        });
      });
      container.querySelectorAll('[data-done]').forEach((cb: any) => {
        cb.addEventListener('change', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          const act = mm.activities.find((a: any) => a.id === cb.dataset.done);
          if (!act) return;
          act.done = cb.checked;
          currRefreshUI();
          currPersistMeeting(dateStr);
        });
      });
    }
    function currAddActivity(dateStr: string, en: string) {
      const activity = { id: cryptoRandomId(), en, duration: null };
      const m = currGetOrCreateMeeting(dateStr);
      m.activities.push(activity);
      currRefreshUI();
      currPersistMeeting(dateStr);
    }
    function currRenderMonth() {
      const anchor = state.curr.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) =>
        `<div class="curr-weekday">${w.en}</div>`
      ).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const meeting = state.curr.meetings.get(dateStr);
        const acts = meeting ? meeting.activities : [];
        const shown = acts.slice(0, 3);
        const extra = acts.length - shown.length;
        // Once a day has passed, show how much of the plan actually got
        // done at a glance — a green chip if everything was ticked off,
        // amber otherwise — so admins don't have to open every past day
        // to see what was actually achieved.
        const isPast = acts.length > 0 && dateStr <= today;
        const doneCount = isPast ? acts.filter((a: any) => a.done).length : 0;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${acts.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          ${meeting && meeting.theme ? `<span class="curr-day-theme">${escapeHtml(meeting.theme)}</span>` : ''}
          <div class="curr-day-mini">
            ${shown.map((a: any) => `<span class="curr-mini-chip">${escapeHtml(a.en)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
          ${isPast ? `<span class="curr-mini-chip curr-mini-chip--${doneCount === acts.length ? 'completed' : 'upcoming'}">${doneCount}/${acts.length} done</span>` : ''}
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.currMonthGrid.innerHTML = html;
      els.currMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => currOpenDayPanel(cell.dataset.date));
      });
    }
    // Shows the current attachment (with a signed View link + Remove) if
    // the meeting has one, otherwise the upload form — never both at
    // once, same as everywhere else a single-slot attachment shows up.
    async function currRenderAttachment(m: any) {
      const path = m && m.attachment_path;
      els.currAttachmentUpload.toggleAttribute('hidden', !!path);
      els.currAttachmentFile.value = '';
      if (!path) { els.currAttachmentCurrent.setAttribute('hidden', ''); return; }
      els.currAttachmentCurrent.removeAttribute('hidden');
      const { data, error } = await db.storage.from('documents').createSignedUrl(path, 3600);
      els.currAttachmentLink.href = !error && data ? data.signedUrl : '#';
    }
    function currOpenDayPanel(dateStr: string) {
      state.curr.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      const m = state.curr.meetings.get(dateStr);
      els.currDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      els.currDayTheme.value = (m && m.theme) || '';
      els.currDayNotes.value = (m && m.notes) || '';
      els.currDayMaterials.value = (m && m.materials_needed) || '';
      els.currDayActualNotes.value = (m && m.actual_notes) || '';
      els.currActualBlock.toggleAttribute('hidden', dateStr > todayStr());
      currRenderActivityList(els.currDayList, dateStr);
      currRenderAttachment(m);
      els.currDayOverlay.removeAttribute('hidden');
      // Lock background scroll while the modal is open — otherwise the
      // page can scroll behind it and the sticky header/footer end up
      // looking like they're overlapping the popup.
      document.documentElement.style.overflow = 'hidden';
    }
    function currCloseDayPanel() {
      els.currDayOverlay.setAttribute('hidden', '');
      state.curr.currentDay = null;
      document.documentElement.style.overflow = '';
    }
    // Theme/Notes only commit when Save is pressed — activities (bank
    // picks, custom adds, removes) still save instantly, same as
    // everywhere else in the workspace.
    function currSaveDay() {
      if (!state.curr.currentDay) return;
      const m = currGetOrCreateMeeting(state.curr.currentDay);
      m.theme = els.currDayTheme.value.trim() || null;
      m.notes = els.currDayNotes.value.trim() || null;
      m.materials_needed = els.currDayMaterials.value.trim() || null;
      if (!els.currActualBlock.hidden) m.actual_notes = els.currDayActualNotes.value.trim() || null;
      currPersistMeeting(state.curr.currentDay);
      currRenderMonth();
      currCloseDayPanel();
    }
    function currCancelDay() {
      currCloseDayPanel();
    }
    // Emptying theme/notes/activities/attachment is already what makes
    // currPersistMeeting() delete the row instead of upserting an
    // effectively-blank one (see its isEmpty check) — this button just
    // does that in one click instead of clearing every field by hand.
    function currClearDay() {
      const dateStr = state.curr.currentDay;
      if (!dateStr) return;
      const m = state.curr.meetings.get(dateStr);
      if (!m) { currCloseDayPanel(); return; }
      if (!confirm('Clear this day’s plan? Its theme, activities, and attachment are all removed.')) return;
      const oldAttachment = m.attachment_path;
      m.theme = null; m.notes = null; m.materials_needed = null; m.activities = []; m.attachment_path = null; m.actual_notes = null;
      currPersistMeeting(dateStr).then(() => {
        if (oldAttachment) db.storage.from('documents').remove([oldAttachment]);
      });
      currRenderMonth();
      currCloseDayPanel();
    }
    // Steps to the next/previous day, pulling in a different month's data
    // first if that date falls outside what's currently loaded.
    async function currStepDay(n: number) {
      if (!state.curr.currentDay) return;
      const next = addDays(parseDateStr(state.curr.currentDay), n);
      const nextStr = toDateStr(next);
      const { start, end } = currComputeRange();
      if (next < start || next > end) {
        state.curr.anchor = next;
        await currReload();
      }
      currOpenDayPanel(nextStr);
    }
    function currUpdateNavLabel() {
      const a = state.curr.anchor;
      els.currNavLabel.textContent = `${MONTHS[a.getMonth()].en} ${a.getFullYear()}`;
    }
    async function currReload() {
      currUpdateNavLabel();
      await currLoadMeetings();
      currRenderMonth();
      currRenderListView();
    }
    // Plain list of every meeting planned this month — the same rows
    // Export PDF produces, rendered on the page instead of downloaded.
    // Kept in sync alongside the calendar (not only when List is the
    // active view) so switching to it never shows stale data.
    function currRenderListView() {
      const { start, end } = currComputeRange();
      const rows: any[] = [];
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.curr.meetings.get(dateStr);
        if (m && ((m.activities && m.activities.length) || m.theme || m.notes || m.materials_needed)) {
          rows.push({
            dateLabel: `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}`,
            theme: m.theme,
            activities: m.activities || [],
            materials: m.materials_needed,
            notes: m.notes,
          });
        }
        d = addDays(d, 1);
      }
      els.currListBody.innerHTML = rows.length
        ? rows.map((r: any) => `
            <tr>
              <td data-label="Date">${escapeHtml(r.dateLabel)}</td>
              <td data-label="Theme">${escapeHtml(r.theme || '—')}</td>
              <td data-label="Activities">${r.activities.length
                ? r.activities.map((a: any) => escapeHtml(a.en) + (a.duration ? ` (${a.duration} min)` : '')).join('<br>')
                : '—'}</td>
              <td data-label="Materials Needed">${escapeHtml(r.materials || '—')}</td>
              <td data-label="Notes">${escapeHtml(r.notes || '—')}</td>
            </tr>
          `).join('')
        : '<tr><td colspan="6" class="ws-empty">Nothing planned yet this month.</td></tr>';
    }
    function currSetPlanView(view: string) {
      document.querySelectorAll('[data-plan-view]').forEach((b: any) => b.classList.toggle('curr-view-btn--active', b.dataset.planView === view));
      document.querySelectorAll('[data-curr-plan-view]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.currPlanView !== view));
    }
    function currNavPrev() {
      state.curr.anchor = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() - 1, 1);
      currReload();
    }
    function currNavNext() {
      state.curr.anchor = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() + 1, 1);
      currReload();
    }
    function currNavToday() { state.curr.anchor = new Date(); currReload(); }
    function currExportPDF() {
      const { start, end } = currComputeRange();
      const rows: any[] = [];
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.curr.meetings.get(dateStr);
        if (m && m.activities && m.activities.length) {
          const dateLabel = `${WEEKDAYS[d.getDay()].en} ${d.getDate()} ${MONTHS[d.getMonth()].en}`;
          const activitiesText = m.activities.map((a: any) => a.en + (a.duration ? ` (${a.duration} min)` : '')).join('\n');
          rows.push([dateLabel, m.theme || '—', activitiesText, m.notes || '—']);
        }
        d = addDays(d, 1);
      }
      const doc = new jsPDF();
      const y = pdfHeader(doc, 'Curriculum', els.currNavLabel.textContent);
      pdfTable(doc, {
