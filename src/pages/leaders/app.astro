      }
      animateCountUp(els.dashKpis.querySelector('[data-kpi="fees"]'), d.feePct, (v) => Math.round(v) + '%');
      animateCountUp(els.dashKpis.querySelector('[data-kpi="net"]'), Math.abs(d.netThis), (v) => (d.netThis >= 0 ? '+' : '−') + Math.round(v));
    }
    function renderDashAttendanceChart(lastDates: string[], byDate: Map<string, { present: number; total: number }>) {
      if (!lastDates.length) {
        els.dashAttChart.innerHTML = '<p class="ws-dash-empty-mini">No attendance recorded in the last 90 days.</p>';
        els.dashAttSub.textContent = '';
