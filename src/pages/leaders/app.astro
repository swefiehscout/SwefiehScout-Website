             rated anywhere else in the app. ==================== -->
        <section class="ws-panel" data-panel="leaderassessment" hidden>
          <div class="ws-subtabs">
            <button type="button" class="ws-subtab ws-subtab--active" data-subtabs="leaderassessment" data-subtab="rate">Rate</button>
            <button type="button" class="ws-subtab" data-subtabs="leaderassessment" data-subtab="settings">Settings</button>
          </div>

          <div data-subpanel="leaderassessment:rate">
            <div class="ws-dash">
              <div class="ws-dash-hero">
