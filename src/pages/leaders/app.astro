      <p class="curr-day-section-label">This meeting</p>
      <div class="curr-day-list" data-curr-day-list></div>

      <!-- Only shown once the date has passed — checking off a future
           meeting's activities as "done" makes no sense. Toggled in
           currOpenDayPanel(). -->
      <div data-curr-actual-block hidden>
        <p class="curr-day-section-label">How it actually went <span class="curr-day-section-hint">(fill in after the meeting)</span></p>
        <label class="curr-day-field">
          <textarea data-day-actual-notes rows="2" placeholder="What actually happened, any changes from the plan…"></textarea>
        </label>
      </div>

      <div class="curr-day-actions">
