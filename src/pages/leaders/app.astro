    // ---------- Roster ---------------------------------------------------
    async function loadRoster() {
      if (!state.activeGroup) return;
      const { data, error } = await db
        .from('members').select('*')
        .eq('group_key', state.activeGroup)
        .order('full_name', { ascending: true });
      if (error) { console.error(error); showToast('Could not load the roster.'); return; }
      state.members = data || [];
      await autoArchiveInactive();
      renderRoster();
      renderArchive();
      if (NON_TROOP_GROUP_KEYS.includes(state.activeGroup)) await loadCopyPicker();
    }
    // Music and General only — most of their people (band members, board
    // members) are already scouts/leaders in one of the 5 troops, so offer
    // to bulk-copy their name/phone across instead of retyping each one
    // (see the ws-copy-member-block markup). Anyone already copied over
    // into THIS group (tracked via members.source_member_id) drops off the
    // list so there's no way to accidentally duplicate someone.
    async function loadCopyPicker() {
      const [troopRes, targetRes] = await Promise.all([
        db.from('members').select('id, full_name, phone, group_key')
          .neq('group_key', MUSIC_GROUP_KEY).neq('group_key', GENERAL_GROUP_KEY).neq('group_key', SOCIAL_MEDIA_GROUP_KEY).eq('active', true)
          .order('full_name', { ascending: true }),
        db.from('members').select('source_member_id').eq('group_key', state.activeGroup).not('source_member_id', 'is', null),
      ]);
      if (troopRes.error) { console.error(troopRes.error); return; }
      const alreadyCopied = new Set((targetRes.data || []).map((m: any) => m.source_member_id));
      state.copyPickerMembers = (troopRes.data || []).filter((m: any) => !alreadyCopied.has(m.id));
      state.copySelected = new Set<string>();
      renderCopyPickerList();
    }
    function renderCopyPickerList() {
      const term = (els.copyMemberSearch.value || '').trim().toLowerCase();
      const rows = state.copyPickerMembers.filter((m: any) => !term || m.full_name.toLowerCase().includes(term));
      if (!rows.length) {
        els.copyMemberList.innerHTML = `<p class="ws-pick-empty">${state.copyPickerMembers.length ? 'No matches.' : 'Everyone active elsewhere is already on this roster.'}</p>`;
      } else {
        els.copyMemberList.innerHTML = rows.map((m: any) => {
          const g = GROUPS.find((x) => x.key === m.group_key);
          return `
            <label class="ws-pick-row">
              <input type="checkbox" value="${m.id}" ${state.copySelected.has(m.id) ? 'checked' : ''} />
              <span class="ws-pick-row-name">${escapeHtml(m.full_name)}</span>
              <span class="ws-pick-row-group">${escapeHtml(g ? g.en : m.group_key)}</span>
            </label>`;
        }).join('');
        els.copyMemberList.querySelectorAll('input[type="checkbox"]').forEach((cb: any) => {
          cb.addEventListener('change', () => {
            if (cb.checked) state.copySelected.add(cb.value); else state.copySelected.delete(cb.value);
            updateCopyPickerCount();
          });
        });
      }
      updateCopyPickerCount();
    }
    function updateCopyPickerCount() {
      const n = state.copySelected.size;
      els.copyMemberCount.textContent = n ? `${n} selected` : '';
      els.copyMemberBtn.disabled = n === 0;
    }
    function bindCopyPicker() {
      els.copyMemberSearch.addEventListener('input', renderCopyPickerList);
      els.copyMemberBtn.addEventListener('click', async () => {
        const sources = state.copyPickerMembers.filter((m: any) => state.copySelected.has(m.id));
        if (!sources.length) return;
        els.copyMemberBtn.disabled = true;
        const { error } = await db.from('members').insert(sources.map((source: any) => ({
          group_key: state.activeGroup, full_name: source.full_name, phone: source.phone || null,
          email: source.email || null, source_member_id: source.id, created_by: state.session.user.id,
        })));
        if (error) { console.error(error); showToast('Could not add, ' + (error.message || 'unknown error') + '.'); els.copyMemberBtn.disabled = false; return; }
        const g = GROUPS.find((x: any) => x.key === state.activeGroup);
        showToast(`${sources.length} member${sources.length === 1 ? '' : 's'} added to the ${g ? g.en : ''} roster.`);
        els.copyMemberSearch.value = '';
        await loadRoster();
      });
    }
    function memberRowHTML(m: any, actionsHTML: string) {
      // data-label feeds the phone card-view (::before shows it as the
      // field name) — inert on desktop, where the real <th> is used.
      return `
        <tr data-member-id="${m.id}">
          <td data-label="Name">${escapeHtml(m.full_name)}${m.archived_reason === 'inactive' ? ' <span class="ws-allergy-badge" title="Auto-archived: no attendance recorded in 3+ months">Auto-archived</span>' : ''}</td>
          <td data-label="Phone">${escapeHtml(m.phone || '—')}</td>
          <td data-label="Email">${escapeHtml(m.email || '—')}</td>
          <td data-label="National ID">${escapeHtml(m.national_id || '—')}</td>
          <td data-label="DOB">${escapeHtml(m.birth_date || '—')}</td>
          <td data-label="Emergency Contact 1">${m.guardian1_relation ? `${escapeHtml(m.guardian1_relation)}: ${escapeHtml(m.guardian1_phone || '—')}` : '—'}</td>
          <td data-label="Emergency Contact 2">${m.guardian2_relation ? `${escapeHtml(m.guardian2_relation)}: ${escapeHtml(m.guardian2_phone || '—')}` : '—'}</td>
          <td data-label="Allergies">${m.has_allergies
              ? `<span class="ws-allergy-badge">${m.allergy_detail ? escapeHtml(m.allergy_detail) : 'Yes'}</span>`
              : '—'}</td>
          <td data-label="Notes">${escapeHtml(m.notes || '—')}</td>
          <td class="ws-row-actions">${actionsHTML}</td>
        </tr>`;
