  <script>
    import {
      supabase, supabaseConfigured, getSession, getProfile, signOut, signOutEverywhere, isSessionExpired, msUntilSessionExpiry,
      registerDeviceSession, listMyDeviceSessions, currentDeviceSessionId, signOutDevice, signOutOtherDevices,
      checkThisDeviceStillActive, formatRelativeTime,
    } from '../../lib/workspace/auth';
    import jsPDF from 'jspdf';
    import autoTable from 'jspdf-autotable';
    import { GROUPS, TROOP_GROUPS, JOINABLE_GROUPS, MONTHS, WEEKDAYS, ACTIVITY_BANK, MUSIC_GROUP_KEY, GENERAL_GROUP_KEY, SOCIAL_MEDIA_GROUP_KEY, LEADERS_GROUP_KEY, LEADER_MEETING_TYPES, SC_EVENT_COLORS, scEventColorValue } from '../../lib/curriculum/constants';
    import { initRowNumbering, initCollapsibleRows } from '../../lib/workspace/row-numbers';
    import { fetchLeaderActivity, formatActivityWhen, type LeaderActivityItem } from '../../lib/leader-activity';

    // Loose alias for actual query calls below — supabaseConfigured is
    // checked once in init() before any of this runs, so by the time these
    // are called it's never actually null; this just avoids sprinkling
    // non-null assertions through every single query call.
    const db: any = supabase;

    const state: any = {
      session: null, profile: null, availableGroups: [], activeGroup: null, activeTab: 'dashboard',
      members: [], approvals: [], finEntries: [], docs: [], ovMembers: [], editingMemberId: null,
      inventoryItems: [], maintenanceLog: [], inventoryAdjustments: [], editingInventoryItemId: null,
      editingFinEntryId: null, editingMaintenanceLogId: null,
      events: [], eventCosts: [], editingEventId: null, editingEventCostId: null,
      vendors: [], sharedVendors: [], editingVendorId: null,
      sponsors: [], editingSponsorId: null, prContacts: [], editingPrContactId: null, prDocs: [],
      contentItems: [], editingContentId: null, credentials: [], editingCredentialId: null,
      meetingNotes: [], editingMeetingNoteId: null,
      evt: { anchor: new Date(), currentDay: null },
      content: { anchor: new Date(), currentDay: null, view: 'calendar' },
      attAnchor: new Date(), attSelected: todayStr(), attDatesWithRecords: null,
      allLeaders: [],
      lattAnchor: new Date(), lattSelected: todayStr(), lattType: LEADER_MEETING_TYPES[0], lattDatesWithRecords: null,
      lprofLeaderId: null, editingLeaderId: null,
      leaderFunctions: [], leaderFunctionsLoaded: false, editingFunctionId: null,
      lassessLeaderId: null, lassessRating: 0,
      curr: { anchor: new Date(), meetings: new Map(), currentDay: null, channel: null },
      sc: { view: 'month', anchor: new Date(), currentDay: null },
      scEvents: [], scMusicEvents: [], editingScId: null, editingScOccurrenceDate: null,
      scScopeAction: null, scScopePayload: null, scRequests: [],
    };
    const els: any = {};

    function el(sel: string): any { return document.querySelector(sel); }
    function escapeHtml(s: any) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]
      ));
    }
    // Renders the "Signed in on" device list inside the account menu, and
    // wires each row's Sign out button (delegation, since the rows get
    // rebuilt every time this runs). Called when the menu opens rather
    // than on a timer — it's a DB read, no reason to poll it.
    async function renderDevices() {
      const mine = currentDeviceSessionId();
      const sessions = await listMyDeviceSessions();
      if (!sessions.length) {
        els.devices.innerHTML = '<p class="ws-devices-empty">This device only.</p>';
        return;
      }
      els.devices.innerHTML = sessions.map((d: any) => `
        <div class="ws-device-row" data-device-id="${d.id}">
          <div class="ws-device-info">
            <div class="ws-device-label">${escapeHtml(d.device_label)}</div>
            <div class="ws-device-meta">${formatRelativeTime(d.last_seen_at)}</div>
            ${d.id === mine ? '<span class="ws-device-badge">This device</span>' : ''}
          </div>
          <button type="button" class="ws-device-kick" data-kick-device="${d.id}">Sign out</button>
        </div>
      `).join('');
    }
    function bindDeviceKicks() {
      els.devices.addEventListener('click', async (e: any) => {
        const btn = e.target.closest('[data-kick-device]');
        if (!btn) return;
        const id = btn.dataset.kickDevice;
        const wasThisDevice = id === currentDeviceSessionId();
        btn.disabled = true;
        btn.textContent = '…';
        await signOutDevice(id);
        if (wasThisDevice) { window.location.replace('/leaders'); return; }
        await renderDevices();
      });
    }

    let toastTimer: any;
    function showToast(msg: any) {
      let t = document.querySelector('.curr-toast');
      if (!t) { t = document.createElement('div'); t.className = 'curr-toast'; document.body.appendChild(t); }
      t.textContent = msg;
      t.classList.add('curr-toast--show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.remove('curr-toast--show'), 3500);
    }
    // Generic client-side row filter — matches the search term against a
    // row's full text, so it works unchanged across every table shape.
    function bindTableSearch(input: any, tbody: any) {
      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        tbody.querySelectorAll('tr').forEach((row: any) => {
          row.hidden = !!term && !row.textContent.toLowerCase().includes(term);
        });
      });
    }
    // Every popup in the workspace (Curriculum, Event Calendar, Content
    // Calendar, Shared Calendar's day view/Custom recurrence/Delete
    // choice) is built from the same .curr-day-overlay shell, opened
    // and closed by toggling its `hidden` attribute — so a single
    // MutationObserver watching all of them covers every popup without
    // each one's own open/close code needing to know about scroll
    // locking. Without this the background page scrolls freely behind
    // an open popup and the footer ends up visible mid-scroll.
    function bindOverlayScrollLock() {
      const overlays = Array.from(document.querySelectorAll('.curr-day-overlay'));
      const update = () => {
        document.body.classList.toggle('ws-scroll-locked', overlays.some((el: any) => !el.hasAttribute('hidden')));
      };
      const observer = new MutationObserver(update);
      overlays.forEach((el) => observer.observe(el, { attributes: true, attributeFilter: ['hidden'] }));
      update();
    }
    function cryptoRandomId() {
      return (typeof crypto !== 'undefined' && crypto.randomUUID)
        ? crypto.randomUUID()
        : 'a' + Math.random().toString(36).slice(2) + Date.now();
    }
    // "joy blah" / "JOY BLAH" → "Joy Blah" — applied on blur to every
    // Name/Title-style field tagged data-titlecase, so leaders don't
    // have to think about capitalization while typing. Capitalizes
    // after spaces, hyphens, and apostrophes too, so hyphenated/O'-style
    // names still come out right; a no-op on Arabic (no case to change)
    // so it's harmless to also tag Shared Calendar's Title. One
    // delegated listener (capture phase — blur doesn't bubble) instead
    // of wiring each field, same pattern as bindEnglishOnlyInputs().
    function titleCase(s: string) {
      return s.trim().replace(/\s+/g, ' ').toLowerCase().replace(/(^|[\s'-])\p{L}/gu, (c) => c.toUpperCase());
    }
    function bindTitleCaseInputs() {
      document.addEventListener('blur', (e: any) => {
        const t = e.target;
        if (!(t instanceof HTMLInputElement) || !t.hasAttribute('data-titlecase')) return;
        if (t.value.trim()) t.value = titleCase(t.value);
      }, true);
    }
    // English-only, everywhere in the workspace — Arabic (or any other
    // non-Latin script) typed into a Notes/Description-style field is
    // exactly what was turning into mojibake in PDF exports (jsPDF's
    // built-in fonts can't draw it at all — see pdfSafe()); stripping it
    // at entry time keeps the stored data itself consistent too, not
    // just what a report happens to show. One delegated listener catches
    // every text input/textarea already on the page or added later
    // (dynamically-rendered rows included), rather than wiring each one.
    // data-allow-non-latin opts a field out — currently just Shared
    // Calendar's Title/Description, which never go into a PDF report.
    function bindEnglishOnlyInputs() {
      document.addEventListener('input', (e: any) => {
        const t = e.target;
        if (!(t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)) return;
        if (t instanceof HTMLInputElement && !['text', 'search', 'tel', 'email', 'url', ''].includes(t.type)) return;
        if (t.hasAttribute('data-allow-non-latin')) return;
        const filtered = t.value.replace(/[^\x00-\x7F]/g, '');
        if (filtered === t.value) return;
        const pos = t.selectionStart ?? t.value.length;
        const posInFiltered = t.value.slice(0, pos).replace(/[^\x00-\x7F]/g, '').length;
        t.value = filtered;
        t.setSelectionRange(posInFiltered, posInFiltered);
      });
    }
    // A brief "Saved ✓" flash next to the curriculum toolbar's export
    // button — visible confirmation that autosave actually happened,
    // since most curriculum edits save immediately with no explicit
    // Save button.
    let saveIndicatorTimer: any;
    function flashSaved() {
      if (!els.currSaveIndicator) return;
      els.currSaveIndicator.removeAttribute('hidden');
      clearTimeout(saveIndicatorTimer);
      saveIndicatorTimer = setTimeout(() => els.currSaveIndicator.setAttribute('hidden', ''), 1500);
    }

