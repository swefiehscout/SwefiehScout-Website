    // ---------- Shared Calendar (org-wide — not scoped to
    // state.activeGroup at all, every group + Admin see the exact same
    // rows). Music's own Event Calendar bookings are pulled in
    // read-only via shared_calendar_music_events(), a SECURITY DEFINER
    // function (see shared_calendar_schema.sql) since event_bookings'
    // own RLS would otherwise hide it from anyone outside Music. -------
    function scCanManage(item: any) {
      return item.created_by === state.session.user.id || state.profile?.role === 'admin';
    }
    // Support Leader (an approved leader with no group at all) gets
    // view-only Shared Calendar — matches can_edit_shared_calendar() in
    // support_leader_calendar_readonly_schema.sql, which is the real
    // enforcement; this just keeps the UI from offering a button RLS
    // would reject anyway.
    function canEditSharedCal(): boolean {
      return state.profile?.role === 'admin' || !!(state.profile?.groups && state.profile.groups.length);
    }
    // Recurrence is never materialized as rows — one event row is the
    // whole series, and occurrences are computed on the fly for
    // whatever range is currently on screen. 'never'/'on_date' end
    // conditions are answered analytically (O(1)); 'after_count' is the
    // one case that needs an actual occurrence count, so it walks
    // day-by-day from the series' own start (not from today, and only
    // for that one end-type) — see scOccurrenceCountUpTo.
    function scDateMatchesRecurrence(event: any, dateStr: string): boolean {
      if (!event.recurrence_unit) return dateStr === event.event_date;
      if (event.recurrence_exceptions && event.recurrence_exceptions.includes(dateStr)) return false;
      const startDate = parseDateStr(event.event_date);
      const d = parseDateStr(dateStr);
      if (d < startDate) return false;
      if (event.recurrence_end_type === 'on_date' && event.recurrence_end_date && dateStr > event.recurrence_end_date) return false;
      const interval = Math.max(1, event.recurrence_interval || 1);
      const days = (event.recurrence_days && event.recurrence_days.length) ? event.recurrence_days : [startDate.getDay()];
      let periodIndex: number, matchesShape: boolean;
      if (event.recurrence_unit === 'day') {
        periodIndex = Math.round((d.getTime() - startDate.getTime()) / 86400000);
        matchesShape = true;
      } else if (event.recurrence_unit === 'week') {
        periodIndex = Math.floor((startOfWeek(d).getTime() - startOfWeek(startDate).getTime()) / (7 * 86400000));
        matchesShape = days.includes(d.getDay());
      } else if (event.recurrence_unit === 'month') {
        periodIndex = (d.getFullYear() - startDate.getFullYear()) * 12 + (d.getMonth() - startDate.getMonth());
        matchesShape = d.getDate() === startDate.getDate();
      } else {
        periodIndex = d.getFullYear() - startDate.getFullYear();
        matchesShape = d.getMonth() === startDate.getMonth() && d.getDate() === startDate.getDate();
      }
      if (!matchesShape || periodIndex < 0 || periodIndex % interval !== 0) return false;
      if (event.recurrence_end_type === 'after_count' && event.recurrence_end_count) {
        if (scOccurrenceCountUpTo(event, d) > event.recurrence_end_count) return false;
      }
      return true;
    }
    function scOccurrenceCountUpTo(event: any, d: Date): number {
      const startDate = parseDateStr(event.event_date);
      const interval = Math.max(1, event.recurrence_interval || 1);
      const days = (event.recurrence_days && event.recurrence_days.length) ? event.recurrence_days : [startDate.getDay()];
      let cursor = new Date(startDate);
      let count = 0, guard = 0;
      while (cursor <= d && guard < 5000) {
        guard++;
        let occurs = false;
        if (event.recurrence_unit === 'day') {
          occurs = Math.round((cursor.getTime() - startDate.getTime()) / 86400000) % interval === 0;
        } else if (event.recurrence_unit === 'week') {
          const weeksSince = Math.floor((startOfWeek(cursor).getTime() - startOfWeek(startDate).getTime()) / (7 * 86400000));
          occurs = weeksSince % interval === 0 && days.includes(cursor.getDay());
        } else if (event.recurrence_unit === 'month') {
          const monthsSince = (cursor.getFullYear() - startDate.getFullYear()) * 12 + (cursor.getMonth() - startDate.getMonth());
          occurs = monthsSince % interval === 0 && cursor.getDate() === startDate.getDate();
        } else {
          const yearsSince = cursor.getFullYear() - startDate.getFullYear();
          occurs = yearsSince % interval === 0 && cursor.getMonth() === startDate.getMonth() && cursor.getDate() === startDate.getDate();
        }
        if (occurs) count++;
        cursor = addDays(cursor, 1);
      }
      return count;
    }
    function scOccurrenceDatesInRange(event: any, rangeStart: Date, rangeEnd: Date): string[] {
      const results: string[] = [];
      let d = new Date(rangeStart);
      while (d <= rangeEnd) {
        const dateStr = toDateStr(d);
        if (scDateMatchesRecurrence(event, dateStr)) results.push(dateStr);
        d = addDays(d, 1);
      }
      return results;
    }
    // One pass over every event for the whole visible range, instead of
    // re-checking every event for every single day — the difference
    // between O(events) and O(events × days) once Year view (365+ days
    // × every month card) is in the mix.
    function scBuildOccurrenceIndex(rangeStart: Date, rangeEnd: Date): Map<string, any[]> {
      const map = new Map<string, any[]>();
      const add = (dateStr: string, item: any) => {
        if (!map.has(dateStr)) map.set(dateStr, []);
        map.get(dateStr)!.push(item);
      };
      state.scEvents.forEach((e: any) => {
        scOccurrenceDatesInRange(e, rangeStart, rangeEnd).forEach((dateStr) => add(dateStr, { ...e, kind: 'own', occurrence_date: dateStr }));
      });
      const rangeStartStr = toDateStr(rangeStart), rangeEndStr = toDateStr(rangeEnd);
      state.scMusicEvents.forEach((e: any) => {
        if (e.event_date >= rangeStartStr && e.event_date <= rangeEndStr) {
          add(e.event_date, { ...e, kind: 'music', title: e.event_type ? `${e.event_type} — ${e.client_name}` : e.client_name });
        }
      });
      map.forEach((items) => items.sort((a, b) => (a.event_time || '99:99').localeCompare(b.event_time || '99:99')));
      return map;
    }
    function scItemsForDate(dateStr: string): any[] {
      const d = parseDateStr(dateStr);
      return scBuildOccurrenceIndex(d, d).get(dateStr) || [];
    }
    async function loadSharedCal() {
      // Render the grid regardless of how the fetch goes — otherwise a
      // failed/slow load leaves the tab looking entirely blank until
      // something else (like clicking Today) happens to call
      // scRenderView() on its own.
      try {
        const [ownRes, musicRes] = await Promise.all([
          db.from('shared_calendar_events').select('*').order('event_date', { ascending: true }),
          db.rpc('shared_calendar_music_events'),
        ]);
        if (ownRes.error) { console.error(ownRes.error); showToast('Could not load the Shared Calendar.'); }
        else state.scEvents = ownRes.data || [];
        if (musicRes.error) console.error(musicRes.error);
        else state.scMusicEvents = musicRes.data || [];
        await loadScRequests();
      } catch (err) {
        console.error('shared calendar load failed', err);
        showToast('Could not load the Shared Calendar.');
      }
      scRenderView();
    }
    async function loadScRequests() {
      const { data, error } = await db.from('shared_calendar_change_requests')
        .select('*, shared_calendar_events(title, event_date)').order('created_at', { ascending: false });
      if (error) { console.error(error); return; }
