    // ---- Calendar subtab: month grid, same shape as Curriculum's own
    // (reuses its curr-weekday-row/curr-month-cells/curr-day-cell CSS),
    // except a day can hold several bookings instead of just one meeting.
    function evtGoToDate(dateStr: string) {
      const d = parseDateStr(dateStr);
      state.evt.anchor = new Date(d.getFullYear(), d.getMonth(), 1);
      evtRenderMonth();
    }
    function evtStepMonth(delta: number) {
      state.evt.anchor = new Date(state.evt.anchor.getFullYear(), state.evt.anchor.getMonth() + delta, 1);
      evtRenderMonth();
    }
    function evtRenderMonth() {
      const anchor = state.evt.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      els.evtNavLabel.textContent = `${MONTHS[mo].en} ${y}`;
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const dayEvents = state.events.filter((e: any) => e.event_date === dateStr)
          .sort((a: any, b: any) => (a.event_time || '') < (b.event_time || '') ? -1 : 1);
        const shown = dayEvents.slice(0, 3);
        const extra = dayEvents.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${dayEvents.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          <div class="curr-day-mini">
            ${shown.map((e: any) => `<span class="curr-mini-chip curr-mini-chip--${eventStatus(e)}">${escapeHtml((e.event_time ? formatTimeStr(e.event_time) + ' ' : '') + e.last_name)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.evtMonthGrid.innerHTML = html;
      els.evtMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => evtOpenDay(cell.dataset.date));
      });
    }

    // ---- Day overlay: that day's agenda, plus the add/edit form for one
    // booking at a time (never both views shown together).
    function evtOpenDay(dateStr: string, focusEventId?: string) {
      state.evt.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      els.evtDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      evtRenderDayList(dateStr);
      els.evtDayOverlay.removeAttribute('hidden');
      document.documentElement.style.overflow = 'hidden';
      if (focusEventId) evtStartEdit(focusEventId);
      else evtShowList();
    }
    function evtCloseDay() {
      els.evtDayOverlay.setAttribute('hidden', '');
      state.evt.currentDay = null;
      document.documentElement.style.overflow = '';
    }
    function evtShowList() {
      els.evtDayListView.removeAttribute('hidden');
      els.evtFormView.setAttribute('hidden', '');
    }
    function evtShowForm() {
      els.evtDayListView.setAttribute('hidden', '');
      els.evtFormView.removeAttribute('hidden');
    }
    function evtRenderDayList(dateStr: string) {
      const dayEvents = state.events.filter((e: any) => e.event_date === dateStr)
        .sort((a: any, b: any) => (a.event_time || '') < (b.event_time || '') ? -1 : 1);
      els.evtDayList.innerHTML = dayEvents.length ? dayEvents.map((e: any) => `
        <div class="ws-evt-day-item" data-event-id="${e.id}">
          <div class="ws-evt-day-item-main">
            <span class="ws-evt-day-item-title">${escapeHtml(eventClientName(e))}${e.event_time ? ' · ' + escapeHtml(formatTimeStr(e.event_time)) : ''}</span>
            <span class="ws-evt-day-item-sub">${escapeHtml(e.event_type)}${e.location ? ' · ' + escapeHtml(e.location) : ''}</span>
          </div>
          ${eventStatusBadge(e)}
          <div class="ws-evt-day-item-actions">
            <button type="button" class="ws-edit-btn" data-evt-day-edit>Edit</button>
          </div>
        </div>
      `).join('') : '<p class="ws-empty" style="padding:1rem 0">Nothing booked this day yet.</p>';
      els.evtDayList.querySelectorAll('[data-evt-day-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => evtStartEdit(btn.closest('[data-event-id]').dataset.eventId));
      });
    }
    function evtResetForm() {
      state.editingEventId = null;
      els.evtFormView.reset();
      updateEvtTypeOptions();
      els.evtType.value = '';
      els.evtDate.value = state.evt.currentDay || todayStr();
      updateEvtLocationOptions();
      els.evtLocation.value = '';
      evtToggleLocationCustom();
      els.evtFormTitle.textContent = 'New event';
      els.evtDelete.hidden = true;
      els.evtCostsSection.hidden = true;
      els.evtTransportRow.hidden = true;
      evtRenderAttendeePicker([]);
      resetEventCostForm();
    }
    function evtStartNew() {
      evtResetForm();
      evtShowForm();
    }
    function evtStartEdit(id: string) {
      const ev = state.events.find((x: any) => x.id === id);
      if (!ev) return;
      state.editingEventId = id;
      els.evtFirstName.value = ev.first_name;
      els.evtLastName.value = ev.last_name;
      els.evtPhone.value = ev.phone;
      els.evtEmail.value = ev.email || '';
      els.evtDate.value = ev.event_date;
      els.evtTime.value = ev.event_time || '';
      updateEvtTypeOptions();
      els.evtType.value = ev.event_type;
      updateEvtLocationOptions();
      const locationList = state.groupSettings?.event_location_categories || [];
      if (ev.location && locationList.includes(ev.location)) {
        els.evtLocation.value = ev.location;
      } else if (ev.location) {
        els.evtLocation.value = EVENT_LOCATION_CUSTOM;
        els.evtLocationCustom.value = ev.location;
      } else {
        els.evtLocation.value = '';
      }
      evtToggleLocationCustom();
      els.evtNotes.value = ev.notes || '';
      evtRenderAttendeePicker(ev.attendees || []);
      els.evtAmount.value = ev.amount_received != null ? ev.amount_received : '';
      els.evtPaymentMethod.value = ev.payment_method || '';
      els.evtPayRate.value = ev.pay_rate_per_member != null ? ev.pay_rate_per_member : '';
      els.evtTransportRate.value = ev.transport_rate_per_member != null ? ev.transport_rate_per_member : '';
      evtUpdateTransportVisibility();
      els.evtFormTitle.textContent = `Editing ${eventClientName(ev)}`;
      els.evtDelete.hidden = false;
      els.evtCostsSection.hidden = false;
      resetEventCostForm();
      evtRenderCosts(id);
      evtShowForm();
    }
    // A previously-checked member who's since been archived still shows
    // up (so re-saving the event doesn't silently drop them) — everyone
    // else is the group's currently active roster.
    function evtRenderAttendeePicker(attendees: any[]) {
      const checkedIds = new Set(attendees.map((a: any) => a.member_id));
      const carIds = new Set(attendees.filter((a: any) => a.took_car).map((a: any) => a.member_id));
      const pool = state.members.filter((m: any) => m.active || checkedIds.has(m.id));
      els.evtAttendees.innerHTML = pool.length ? pool.map((m: any) => `
        <div class="ws-evt-attendee-row" data-member-id="${m.id}">
          <label>
            <input type="checkbox" data-evt-attendee-check ${checkedIds.has(m.id) ? 'checked' : ''} />
            <span>${escapeHtml(m.full_name)}</span>
          </label>
          <label class="ws-evt-attendee-car">
            <input type="checkbox" data-evt-attendee-car ${carIds.has(m.id) ? 'checked' : ''} ${checkedIds.has(m.id) ? '' : 'disabled'} />
            Took a car
          </label>
        </div>
      `).join('') : '<p class="ws-empty" style="padding:0.5rem 0">No band members in the roster yet.</p>';
      els.evtAttendees.querySelectorAll('[data-evt-attendee-check]').forEach((cb: any) => {
        cb.addEventListener('change', () => {
          const row = cb.closest('.ws-evt-attendee-row');
          const carCb = row.querySelector('[data-evt-attendee-car]');
          carCb.disabled = !cb.checked;
          if (!cb.checked) carCb.checked = false;
          evtUpdateTransportVisibility();
        });
      });
      els.evtAttendees.querySelectorAll('[data-evt-attendee-car]').forEach((cb: any) => {
        cb.addEventListener('change', evtUpdateTransportVisibility);
      });
    }
    function evtGetAttendeesFromForm(): { member_id: string; took_car: boolean }[] {
      return Array.from(els.evtAttendees.querySelectorAll('.ws-evt-attendee-row')).flatMap((row: any) => {
        if (!row.querySelector('[data-evt-attendee-check]').checked) return [];
        return [{ member_id: row.dataset.memberId, took_car: row.querySelector('[data-evt-attendee-car]').checked }];
      });
    }
    // Transport pay only ever applies to members who took a car — the
    // rate field (and this live total) only surface once at least one
    // attendee is marked as having taken one.
    function evtUpdateTransportVisibility() {
      const attendees = evtGetAttendeesFromForm();
      const carCount = attendees.filter((a) => a.took_car).length;
      els.evtTransportRow.toggleAttribute('hidden', carCount === 0);
      const payRate = Number(els.evtPayRate.value) || 0;
      const transportRate = Number(els.evtTransportRate.value) || 0;
      const wages = payRate * attendees.length;
      const transport = transportRate * carCount;
      els.evtPayoutSummary.textContent = carCount
        ? `${attendees.length} member(s) × ${payRate.toFixed(2)} + ${carCount} car(s) × ${transportRate.toFixed(2)} = ${(wages + transport).toFixed(2)} total payout`
        : '';
    }

    // ---- Extra costs (repeatable line items per event) ----
    function resetEventCostForm() {
      state.editingEventCostId = null;
      if (state.groupSettings?.event_cost_categories?.length) els.evtCostCategory.selectedIndex = 0;
      els.evtCostAmount.value = '';
      els.evtCostDesc.value = '';
      els.evtCostDate.value = state.evt.currentDay || todayStr();
      els.evtCostAdd.textContent = 'Add cost';
    }
    function startEditEventCost(id: string) {
      const cost = state.eventCosts.find((c: any) => c.id === id);
      if (!cost) return;
      state.editingEventCostId = id;
      els.evtCostCategory.value = cost.category;
      els.evtCostAmount.value = cost.amount;
      els.evtCostDesc.value = cost.description || '';
      els.evtCostDate.value = cost.cost_date;
      els.evtCostAdd.textContent = 'Save changes';
    }
    function evtRenderCosts(eventId: string) {
      const costs = state.eventCosts.filter((c: any) => c.event_id === eventId);
      els.evtCostBody.innerHTML = costs.length ? costs.map((c: any) => `
        <tr data-cost-id="${c.id}">
          <td data-label="Date">${c.cost_date}</td>
          <td data-label="Category">${escapeHtml(c.category)}</td>
          <td data-label="Description">${escapeHtml(c.description || '—')}</td>
          <td data-label="Amount">${Number(c.amount).toFixed(2)}</td>
          <td data-label="Added by">${escapeHtml(c.created_by_name || '—')}</td>
          <td class="ws-row-actions">
            <button type="button" class="ws-edit-btn" data-evt-cost-edit>Edit</button>
            <button type="button" class="ws-row-del" data-evt-cost-del>×</button>
          </td>
        </tr>
      `).join('') : '<tr><td colspan="7" class="ws-empty">No extra costs logged.</td></tr>';
      els.evtCostBody.querySelectorAll('[data-evt-cost-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => startEditEventCost(btn.closest('tr').dataset.costId));
      });
      els.evtCostBody.querySelectorAll('[data-evt-cost-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.closest('tr').dataset.costId;
          if (!confirm('Delete this cost? It’s removed from Finance too.')) return;
          const { error } = await db.from('event_costs').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingEventCostId === id) resetEventCostForm();
          await loadEvents();
          evtRenderCosts(eventId);
          if (state.activeTab === 'finance') await loadFinance();
        });
      });
    }
    // One event_costs row always mirrors exactly one finance_entries row
    // (event_cost_id is 1:1, same as maintenance_log_id) — created here,
    // kept in sync on edit, removed by the database cascade on delete.
    async function syncEventCostToFinance(cost: any) {
      const ev = state.events.find((e: any) => e.id === cost.event_id);
      const payload = {
        group_key: state.activeGroup, entry_type: 'expense', category: cost.category,
        amount: Number(cost.amount), entry_date: cost.cost_date,
        description: `${ev ? eventClientName(ev) : 'Event'} — ${cost.description || cost.category}`,
        event_cost_id: cost.id, created_by: state.session.user.id, created_by_name: state.profile?.name || null,
      };
      const { data: existing } = await db.from('finance_entries').select('id').eq('event_cost_id', cost.id).maybeSingle();
      if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
      else await db.from('finance_entries').insert(payload);
    }

    // Up to 3 rows per event (income / wages / transport), told apart by
    // event_entry_kind since — unlike fee_payment_id/maintenance_log_id/
    // event_cost_id — event_id alone isn't a 1:1 key here. Whichever of
    // the 3 no longer applies (e.g. amount cleared, or no one took a
    // car anymore) gets its row removed; the rest are upserted in place.
    async function syncEventToFinance(ev: any) {
      const { wages, transport } = eventPayoutTotals(ev);
      const client = eventClientName(ev);
      const kinds: { kind: string; type: string; category: string; amount: number; description: string }[] = [];
      if (ev.amount_received) kinds.push({ kind: 'income', type: 'income', category: ev.event_type, amount: Number(ev.amount_received), description: `${client}, ${ev.event_date}${ev.payment_method ? ` (${ev.payment_method})` : ''}` });
      if (wages) kinds.push({ kind: 'wages', type: 'expense', category: 'Band Payouts', amount: wages, description: `Band payouts — ${client}, ${ev.event_date}` });
      if (transport) kinds.push({ kind: 'transport', type: 'expense', category: 'Transport', amount: transport, description: `Transport — ${client}, ${ev.event_date}` });
      const activeKinds = new Set(kinds.map((k) => k.kind));
      for (const kind of ['income', 'wages', 'transport']) {
        if (!activeKinds.has(kind)) await db.from('finance_entries').delete().eq('event_id', ev.id).eq('event_entry_kind', kind);
      }
      for (const k of kinds) {
        const payload = {
          group_key: state.activeGroup, entry_type: k.type, category: k.category, amount: k.amount,
          entry_date: ev.event_date, description: k.description, event_id: ev.id, event_entry_kind: k.kind,
          created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        };
        const { data: existing } = await db.from('finance_entries').select('id').eq('event_id', ev.id).eq('event_entry_kind', k.kind).maybeSingle();
        if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
        else await db.from('finance_entries').insert(payload);
      }
      if (state.activeTab === 'finance') await loadFinance();
    }
    function bindEventForm() {
      els.evtPrev.addEventListener('click', () => evtStepMonth(-1));
      els.evtNext.addEventListener('click', () => evtStepMonth(1));
      els.evtToday.addEventListener('click', () => { state.evt.anchor = new Date(); evtRenderMonth(); });
      els.evtAddBtn.addEventListener('click', () => evtOpenDay(todayStr()));
      els.evtDayClose.addEventListener('click', evtCloseDay);
      els.evtDayAdd.addEventListener('click', evtStartNew);
      els.evtFormBack.addEventListener('click', evtShowList);
      els.evtLocation.addEventListener('change', evtToggleLocationCustom);
      els.evtPayRate.addEventListener('input', evtUpdateTransportVisibility);
      els.evtTransportRate.addEventListener('input', evtUpdateTransportVisibility);
      els.evtDelete.addEventListener('click', async () => {
        if (!state.editingEventId) return;
        if (!confirm('Delete this event? Its costs and everything it posted to Finance are removed too.')) return;
        const { error } = await db.from('event_bookings').delete().eq('id', state.editingEventId);
        if (error) { showToast('Could not delete.'); return; }
        const dateStr = state.evt.currentDay;
        await loadEvents();
        evtRenderDayList(dateStr);
        evtShowList();
        if (state.activeTab === 'finance') await loadFinance();
      });
      els.evtCostAdd.addEventListener('click', async () => {
        if (!state.editingEventId) return;
        const category = els.evtCostCategory.value;
        const amount = els.evtCostAmount.value;
        const description = els.evtCostDesc.value.trim();
        const costDate = els.evtCostDate.value || state.evt.currentDay;
        if (!category || !amount) { showToast('Category and amount are required.'); return; }
        const payload: any = { category, amount: Number(amount), description: description || null, cost_date: costDate };
        let cost, error;
        if (state.editingEventCostId) {
          ({ data: cost, error } = await db.from('event_costs').update(payload).eq('id', state.editingEventCostId).select().single());
        } else {
          payload.group_key = state.activeGroup;
          payload.event_id = state.editingEventId;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ data: cost, error } = await db.from('event_costs').insert(payload).select().single());
        }
        if (error) { console.error(error); showToast('Could not save cost.'); return; }
        await syncEventCostToFinance(cost);
        resetEventCostForm();
        await loadEvents();
        evtRenderCosts(state.editingEventId);
        if (state.activeTab === 'finance') await loadFinance();
      });
      els.evtFormView.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const firstName = els.evtFirstName.value.trim();
        const lastName = els.evtLastName.value.trim();
        const phone = els.evtPhone.value.trim();
        const email = els.evtEmail.value.trim();
        const date = els.evtDate.value;
        const time = els.evtTime.value;
        const type = els.evtType.value;
        const location = els.evtLocation.value === EVENT_LOCATION_CUSTOM ? els.evtLocationCustom.value.trim() : els.evtLocation.value;
        const notes = els.evtNotes.value.trim();
        const attendees = evtGetAttendeesFromForm();
        if (!firstName || !lastName || !phone || !date || !type) { showToast('First/last name, phone, date, and event type are required.'); return; }
        const amountRaw = els.evtAmount.value;
        const payRateRaw = els.evtPayRate.value;
        const transportRateRaw = els.evtTransportRate.value;
        // Once the event's own date/time is behind us, it can't be saved
        // in limbo any longer — the amount received has to be filled in
        // (closing it out) before any other change to it is accepted.
        if (!amountRaw && eventDateTimeHasPassed(date, time)) {
          showToast('This event has already happened — enter the amount received to close it out before saving.');
          return;
        }
        const payload: any = {
          event_type: type, first_name: firstName, last_name: lastName, phone, email: email || null,
          event_date: date, event_time: time || null, location: location || null, notes: notes || null,
          attendees, amount_received: amountRaw ? Number(amountRaw) : null,
          payment_method: els.evtPaymentMethod.value || null,
          pay_rate_per_member: payRateRaw ? Number(payRateRaw) : null,
          transport_rate_per_member: transportRateRaw ? Number(transportRateRaw) : null,
        };
        // "Completed by/at" is only ever stamped the moment an amount is
        // actually entered for the first time — editing booking details
        // alone shouldn't claim credit for completing it, and clearing
        // the amount back out un-stamps it.
        const priorEvent = state.editingEventId ? state.events.find((x: any) => x.id === state.editingEventId) : null;
        if (payload.amount_received != null && !priorEvent?.amount_received) {
          payload.completed_by = state.session.user.id;
          payload.completed_by_name = state.profile?.name || null;
          payload.completed_at = new Date().toISOString();
        } else if (payload.amount_received == null) {
          payload.completed_by = null; payload.completed_by_name = null; payload.completed_at = null;
        }
        let savedEvent: any, error;
        if (state.editingEventId) {
          payload.updated_at = new Date().toISOString();
          ({ data: savedEvent, error } = await db.from('event_bookings').update(payload).eq('id', state.editingEventId).select().single());
        } else {
          payload.group_key = state.activeGroup;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ data: savedEvent, error } = await db.from('event_bookings').insert(payload).select().single());
        }
        if (error) { console.error(error); showToast('Could not save event.'); return; }
        await syncEventToFinance(savedEvent);
        await loadEvents();
        evtRenderDayList(savedEvent.event_date);
        evtShowList();
      });
    }

