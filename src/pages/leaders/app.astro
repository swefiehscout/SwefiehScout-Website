      els.ovBody.innerHTML = groups.map((g) => {
        const rate = g.attTotal30 ? Math.round((g.attPresent30 / g.attTotal30) * 100) : null;
        const share = totalActive ? Math.round((g.activeMembers / totalActive) * 100) : 0;
        const feeRate = g.activeMembers ? Math.round((g.feePaid / g.activeMembers) * 100) : 0;
        return `
          <tr>
            <td data-label="Group">${escapeHtml(g.en)}</td>
            <td data-label="Active">${g.activeMembers}</td>
            <td data-label="% of Troop">${share}%</td>
            <td data-label="Attendance (30d)">${rate != null ? rate + '%' : '—'}</td>
            <td data-label="Fees Collected">${feeRate}% · ${g.feeCollected.toFixed(0)}</td>
            <td data-label="Net Income">${g.netThis >= 0 ? '+' : '−'}${Math.abs(g.netThis).toFixed(0)}</td>
          </tr>`;
      }).join('');
    }
    // Every group's finance_entries for one period, in a single unfiltered
    // query (same reasoning as loadOverview()) — grouped into a per-group
    // summary table plus the full transaction list with a Group column.
    async function loadOverviewFinance() {
      populatePeriodSelects(els.ovFinMonth, els.ovFinYear, true);
      const { start, end } = periodRange(els.ovFinMonth, els.ovFinYear);
      const { data, error } = await db.from('finance_entries').select('group_key, entry_type, category, amount, entry_date, description')
        .gte('entry_date', start).lte('entry_date', end).order('entry_date', { ascending: false });
      if (error) { console.error(error); showToast('Could not load finance.'); return; }
      renderOverviewFinance(data || []);
    }
    function renderOverviewFinance(rows: any[]) {
      const income = rows.filter((r) => r.entry_type === 'income').reduce((s, r) => s + Number(r.amount), 0);
      const expense = rows.filter((r) => r.entry_type === 'expense').reduce((s, r) => s + Number(r.amount), 0);
      els.ovFinStats.innerHTML = `
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">↑</span><span class="ws-stat-text"><span class="ws-stat-num">${income.toFixed(2)}</span><span class="ws-stat-label">Income</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">↓</span><span class="ws-stat-text"><span class="ws-stat-num">${expense.toFixed(2)}</span><span class="ws-stat-label">Expenses</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">=</span><span class="ws-stat-text"><span class="ws-stat-num">${(income - expense).toFixed(2)}</span><span class="ws-stat-label">Net</span></span></div>
      `;

      const byGroup = new Map<string, { income: number; expense: number }>();
      GROUPS.forEach((g) => byGroup.set(g.key, { income: 0, expense: 0 }));
      rows.forEach((r) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.entry_type === 'income') b.income += Number(r.amount); else b.expense += Number(r.amount);
      });
      els.ovFinGroupBody.innerHTML = GROUPS.map((g) => {
        const b = byGroup.get(g.key)!;
        return `
          <tr>
            <td data-label="Group">${escapeHtml(g.en)}</td>
            <td data-label="Income">${b.income.toFixed(2)}</td>
            <td data-label="Expenses">${b.expense.toFixed(2)}</td>
            <td data-label="Net">${(b.income - b.expense).toFixed(2)}</td>
          </tr>`;
      }).join('');

      els.ovFinBody.innerHTML = rows.length
        ? rows.map((r) => {
            const g = GROUPS.find((x) => x.key === r.group_key);
            return `
              <tr>
                <td data-label="Date">${r.entry_date}</td>
                <td data-label="Group">${escapeHtml(g ? g.en : r.group_key)}</td>
                <td data-label="Type">${r.entry_type === 'income' ? 'Income' : 'Expense'}</td>
                <td data-label="Category">${escapeHtml(r.category || '—')}</td>
                <td data-label="Description">${escapeHtml(r.description || '—')}</td>
                <td data-label="Amount">${Number(r.amount).toFixed(2)}</td>
              </tr>`;
          }).join('')
        : '<tr><td colspan="6" class="ws-empty">No entries this period.</td></tr>';
    }

    // Same three reports as the per-group Reports tab, except every query
    // drops the group_key filter and the PDFs get a Group column (Fees/
    // Attendance) or a per-group breakdown (Income Statement) instead.
    async function downloadOverviewFinanceReport() {
      try {
        const { start, end, label } = periodRange(els.ovReportMonth, els.ovReportYear);
        const { data, error } = await db.from('finance_entries').select('group_key, entry_type, amount').gte('entry_date', start).lte('entry_date', end);
        if (error) throw error;
        const rows = data || [];
        const byGroup = new Map<string, { income: number; expense: number }>();
        GROUPS.forEach((g) => byGroup.set(g.key, { income: 0, expense: 0 }));
        rows.forEach((r: any) => {
          const b = byGroup.get(r.group_key); if (!b) return;
          if (r.entry_type === 'income') b.income += Number(r.amount); else b.expense += Number(r.amount);
        });
        const totalIncome = rows.filter((r: any) => r.entry_type === 'income').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const totalExpense = rows.filter((r: any) => r.entry_type === 'expense').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const bodyRows = GROUPS.map((g) => {
          const b = byGroup.get(g.key)!;
          return [g.en, b.income.toFixed(2), b.expense.toFixed(2), (b.income - b.expense).toFixed(2)];
        });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Income Statement', label, 'All Groups');
        autoTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          footStyles: { fillColor: PDF_FOOT_BG, textColor: PDF_BRAND, fontStyle: 'bold' },
          columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
          head: [['Group', 'Income', 'Expenses', 'Net']],
          body: rows.length ? bodyRows : [['No data available', '', '', '']],
          foot: [['Troop Total', totalIncome.toFixed(2), totalExpense.toFixed(2), (totalIncome - totalExpense).toFixed(2)]],
        });
        doc.save(pdfFilename('Income-Statement', label, 'All-Groups'));
      } catch (err) {
        console.error('overview finance report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    async function downloadOverviewFeesReport() {
      try {
        const { period, label } = periodRange(els.ovReportMonth, els.ovReportYear);
        const [membersRes, feeRes] = await Promise.all([
          db.from('members').select('id, full_name, group_key').eq('active', true),
          db.from('fee_payments').select('member_id, paid, amount').eq('period', period),
        ]);
        const members = membersRes.data || [];
        const map: Map<string, any> = new Map((feeRes.data || []).map((r: any) => [r.member_id, r]));
        let paidCount = 0, collected = 0;
        const rows = members.map((m: any) => {
          const rec = map.get(m.id);
          const g = GROUPS.find((x) => x.key === m.group_key);
          if (rec && rec.paid) { paidCount++; collected += Number(rec.amount || 0); }
          return [m.full_name, g ? g.en : m.group_key, rec && rec.paid ? 'Paid' : 'Unpaid', rec && rec.amount != null ? Number(rec.amount).toFixed(2) : '—'];
        });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Monthly Fees', `${label} — ${paidCount} of ${members.length} paid, ${collected.toFixed(2)} collected`, 'All Groups');
        autoTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          head: [['Member', 'Group', 'Status', 'Amount']], body: rows.length ? rows : [['No data available', '', '', '']],
        });
        doc.save(pdfFilename('Monthly-Fees', label, 'All-Groups'));
      } catch (err) {
        console.error('overview fees report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    async function downloadOverviewAttendanceReport() {
      try {
        const { start, end, label } = periodRange(els.ovReportMonth, els.ovReportYear);
        const [membersRes, attRes] = await Promise.all([
          db.from('members').select('id, full_name, group_key').eq('active', true),
          db.from('attendance').select('member_id, group_key, present, date').gte('date', start).lte('date', end),
        ]);
        const members = membersRes.data || [];
        const rows = attRes.data || [];
        // Rate is against that member's own group's session count, not a
        // global date count — two groups meeting on different days of the
        // same week are separate sessions, not one.
        const byGroupSessions = new Map<string, Set<string>>();
        GROUPS.forEach((g) => byGroupSessions.set(g.key, new Set()));
        const presentByMember = new Map<string, number>();
        rows.forEach((r: any) => {
          const set = byGroupSessions.get(r.group_key);
          if (set) set.add(r.date);
          if (r.present) presentByMember.set(r.member_id, (presentByMember.get(r.member_id) || 0) + 1);
        });
        const totalSessions = Array.from(byGroupSessions.values()).reduce((s, set) => s + set.size, 0);
        const bodyRows = members.map((m: any) => {
          const g = GROUPS.find((x) => x.key === m.group_key);
          const sessions = byGroupSessions.get(m.group_key)?.size || 0;
          const present = presentByMember.get(m.id) || 0;
          const rate = sessions ? Math.round((present / sessions) * 100) : 0;
          return [m.full_name, g ? g.en : m.group_key, `${present} / ${sessions}`, `${rate}%`];
        });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Attendance', `${label} — ${totalSessions} meeting${totalSessions === 1 ? '' : 's'} held across all groups`, 'All Groups');
        autoTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          head: [['Member', 'Group', 'Present', 'Rate']], body: bodyRows.length ? bodyRows : [['No data available', '', '', '']],
        });
        doc.save(pdfFilename('Attendance', label, 'All-Groups'));
      } catch (err) {
        console.error('overview attendance report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    function bindOverviewReports() {
      populatePeriodSelects(els.ovReportMonth, els.ovReportYear);
      el('[data-ov-report-finance]').addEventListener('click', downloadOverviewFinanceReport);
      el('[data-ov-report-fees]').addEventListener('click', downloadOverviewFeesReport);
      el('[data-ov-report-attendance]').addEventListener('click', downloadOverviewAttendanceReport);
    }

