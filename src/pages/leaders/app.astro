    // own Library tab writes to; General never had a Library tab
    // before, so this is its first use of it.
    function renderPRLibrary() {
      if (!state.prDocs.length) {
        els.prlibBody.innerHTML = '<tr><td colspan="7" class="ws-empty">No documents yet.</td></tr>';
        return;
      }
      els.prlibBody.innerHTML = state.prDocs.map((d: any) => `
        <tr data-doc-id="${d.id}" data-doc-path="${escapeHtml(d.file_path)}">
          <td data-label="Title">${escapeHtml(d.title)}</td>
          <td data-label="Category">${escapeHtml(d.category && d.category !== 'general' ? d.category : '—')}</td>
          <td data-label="Type">${escapeHtml(d.file_type || '—')}</td>
          <td data-label="Uploaded">${new Date(d.uploaded_at).toLocaleDateString(undefined, { timeZone: 'Asia/Amman' })}</td>
          <td data-label="Uploaded by">${escapeHtml(d.uploaded_by_name || '—')}</td>
          <td class="ws-row-actions">
            <button type="button" class="ws-edit-btn" data-doc-rename>Rename</button>
            <button type="button" class="ws-edit-btn" data-doc-download>Download</button>
            <button type="button" class="ws-row-del" data-doc-del>×</button>
          </td>
        </tr>
      `).join('');
      els.prlibBody.querySelectorAll('tr').forEach((row: any) => {
        const path = row.dataset.docPath;
        const id = row.dataset.docId;
        row.querySelector('[data-doc-download]').addEventListener('click', async () => {
          const { data, error } = await db.storage.from('documents').createSignedUrl(path, 60);
          if (error || !data) { showToast('Could not open file.'); return; }
          window.open(data.signedUrl, '_blank');
        });
        row.querySelector('[data-doc-del]').addEventListener('click', async () => {
          if (!confirm('Delete this document?')) return;
          await db.storage.from('documents').remove([path]);
          const { error } = await db.from('documents').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          await loadPR();
        });
        row.querySelector('[data-doc-rename]').addEventListener('click', () => startRenamePrDoc(row, id));
      });
    }
    function startRenamePrDoc(row: any, id: string) {
      const titleCell = row.querySelector('[data-label="Title"]');
      const current = titleCell.textContent;
      titleCell.innerHTML = `<input type="text" class="ws-inline-amount" value="${escapeHtml(current)}" data-doc-rename-input data-titlecase />`;
      const input = titleCell.querySelector('[data-doc-rename-input]');
      input.focus();
      input.select();
      const actionsCell = row.querySelector('.ws-row-actions');
      actionsCell.innerHTML = `
        <button type="button" class="ws-edit-btn" data-doc-rename-save>Save</button>
        <button type="button" class="ws-edit-btn" data-doc-rename-cancel>Cancel</button>
      `;
      actionsCell.querySelector('[data-doc-rename-cancel]').addEventListener('click', renderPRLibrary);
      actionsCell.querySelector('[data-doc-rename-save]').addEventListener('click', async () => {
        const title = input.value.trim();
        if (!title) { showToast('Title is required.'); return; }
        const { error } = await db.from('documents').update({ title }).eq('id', id);
        if (error) { console.error(error); showToast('Could not rename.'); return; }
        await loadPR();
      });
    }
    function bindPRLibraryUpload() {
      els.prlibUpload.addEventListener('click', async () => {
        const file = els.prlibFile.files[0];
        if (!file) { showToast('Choose a file first.'); return; }
        els.prlibUpload.disabled = true;
        const path = `${state.activeGroup}/${Date.now()}-${file.name}`;
        const { error: upErr } = await db.storage.from('documents').upload(path, file);
        if (upErr) { console.error(upErr); showToast('Could not upload.'); els.prlibUpload.disabled = false; return; }
        const title = els.prlibTitle.value.trim() || file.name;
        const { error } = await db.from('documents').insert({
          group_key: state.activeGroup, category: els.prlibCategory.value || 'general', title, file_path: path,
          file_type: file.type || null, size_bytes: file.size, uploaded_by: state.session.user.id,
          uploaded_by_name: state.profile?.name || null,
        });
        els.prlibUpload.disabled = false;
        if (error) { console.error(error); showToast('Could not save document.'); return; }
        els.prlibFile.value = '';
        els.prlibTitle.value = '';
        await loadPR();
      });
    }

    // ---------- Meeting Notes (General only): what the board actually
    // discussed and decided at a meeting — date, title, free-text notes.
    // Separate from Shared Calendar (which only schedules a meeting) and
    // from Curriculum's own "actual notes" (troops only, tied to a
    // planned activity list General doesn't have).
    async function loadMeetingNotes() {
      if (!state.activeGroup) return;
      const { data, error } = await db.from('meeting_notes').select('*').eq('group_key', state.activeGroup).order('meeting_date', { ascending: false });
      if (error) { console.error(error); showToast('Could not load meeting notes.'); return; }
      state.meetingNotes = data || [];
      renderMeetingNotes();
    }
    function resetMeetingNoteForm() {
      state.editingMeetingNoteId = null;
      els.mnForm.reset();
      els.mnFormTitle.textContent = 'Add meeting notes';
      els.mnSubmit.textContent = 'Add notes';
      els.mnCancel.hidden = true;
    }
    function startEditMeetingNote(id: string) {
      const n = state.meetingNotes.find((x: any) => x.id === id);
      if (!n) return;
      state.editingMeetingNoteId = id;
      els.mnDate.value = n.meeting_date;
      els.mnTitle.value = n.title;
      els.mnNotes.value = n.notes;
      els.mnFormTitle.textContent = `Editing ${n.title}`;
      els.mnSubmit.textContent = 'Save changes';
      els.mnCancel.hidden = false;
      els.mnForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function renderMeetingNotes() {
      if (!state.meetingNotes.length) {
        els.mnBody.innerHTML = '<tr><td colspan="5" class="ws-empty">No meeting notes yet.</td></tr>';
        return;
      }
      els.mnBody.innerHTML = state.meetingNotes.map((n: any) => `
        <tr data-mn-id="${n.id}">
          <td data-label="Date">${n.meeting_date}</td>
          <td data-label="Title">${escapeHtml(n.title)}</td>
          <td data-label="Notes" class="ws-cell-wrap">${escapeHtml(n.notes)}</td>
          <td data-label="Added by">${escapeHtml(n.created_by_name || '—')}</td>
          <td class="ws-row-actions">
            <button type="button" class="ws-edit-btn" data-mn-edit>Edit</button>
            <button type="button" class="ws-row-del" data-mn-del>×</button>
          </td>
        </tr>
      `).join('');
      els.mnBody.querySelectorAll('[data-mn-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => startEditMeetingNote(btn.closest('tr').dataset.mnId));
      });
      els.mnBody.querySelectorAll('[data-mn-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.closest('tr').dataset.mnId;
          if (!confirm('Delete these meeting notes?')) return;
          const { error } = await db.from('meeting_notes').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingMeetingNoteId === id) resetMeetingNoteForm();
          await loadMeetingNotes();
        });
      });
    }
    function bindMeetingNoteForm() {
      els.mnCancel.addEventListener('click', resetMeetingNoteForm);
      els.mnForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const date = els.mnDate.value;
        const title = els.mnTitle.value.trim();
        const notes = els.mnNotes.value.trim();
        if (!date || !title || !notes) { showToast('Date, title, and notes are all required.'); return; }
        els.mnSubmit.disabled = true;
        const payload: any = { meeting_date: date, title, notes };
        let error;
        if (state.editingMeetingNoteId) {
          payload.updated_at = new Date().toISOString();
          ({ error } = await db.from('meeting_notes').update(payload).eq('id', state.editingMeetingNoteId));
        } else {
          payload.group_key = state.activeGroup;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ error } = await db.from('meeting_notes').insert(payload));
        }
        els.mnSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not save meeting notes.'); return; }
        resetMeetingNoteForm();
        await loadMeetingNotes();
      });
    }

    // ---------- Leaders (admin-only — see LEADERS_GROUP_KEY): every
    // approved leader's account, org-wide, not scoped to any one group.
    // fetchAllLeaders() always returns everyone regardless of `active`
    // (same as members — see loadRoster()'s own comment) so callers that
    // need the full picture (Roster+Archive's own render split, and
    // Assessment's "Assessed by" name lookups, which have to resolve a
    // name even for someone since archived) still can; activeLeaders()
    // below is what every other consumer (Dashboard, Attendance,
    // Leader Profile/Assessment pickers, Support Overview) should read
    // instead, so an archived leader drops out of all of those at once.
    async function fetchAllLeaders() {
      const { data, error } = await db.from('profiles').select('*').in('role', ['leader', 'admin']).order('name', { ascending: true });
      if (error) { console.error(error); showToast('Could not load leaders.'); return []; }
      return data || [];
    }
    // Lazy-cached the same way ensureVendorsLoaded() is — Attendance and
    // the Dashboard both need the list but don't need to force a fresh
    // fetch every time the way Roster's own load does.
    async function ensureAllLeadersLoaded() {
      if (state.allLeaders.length) return;
      state.allLeaders = await fetchAllLeaders();
    }
    function activeLeaders(): any[] {
      return state.allLeaders.filter((p: any) => p.active !== false);
    }

    // ---- Roster + Archive: editable personal-info fields (see
    // leader_profile_fields_schema.sql) plus Archive/Restore, same
    // pattern as a troop's own Roster/Archive (archiveMember()/
    // restoreMember() above) — role and group access still only ever
    // change from Admin → People, this form never touches either. ----
    async function loadLeaderRoster() {
      state.allLeaders = await fetchAllLeaders();
      renderLeaderRoster();
      renderLeaderArchive();
    }
    function leaderGroupsLabel(p: any) {
      if (p.role === 'admin') return 'All groups (admin)';
      if (!p.groups || !p.groups.length) return '—';
      return p.groups.map((k: string) => GROUPS.find((g: any) => g.key === k)?.en || k).join(', ');
    }
    // profiles.created_at is when their login was created, not
    // necessarily when they actually joined as a leader — member_since
    // is a separate, admin-editable date for that (see the Leaders
    // Roster edit form), falling back to the account date until someone
    // sets the real one.
    function leaderMemberSince(p: any): string | null {
      return p.member_since || (p.created_at ? String(p.created_at).slice(0, 10) : null);
    }
    function leaderRowHTML(p: any, actionsHTML: string) {
      return `
        <tr data-leader-id="${p.id}">
          <td data-label="Leader ID">${escapeHtml(p.member_code || '—')}</td>
          <td data-label="Name">${escapeHtml(p.name)}</td>
          <td data-label="Role">${p.role === 'admin' ? 'Admin' : 'Leader'}</td>
          <td data-label="Groups">${escapeHtml(leaderGroupsLabel(p))}</td>
          <td data-label="Phone">${escapeHtml(p.phone || '—')}</td>
          <td data-label="Email">${escapeHtml(p.email || '—')}</td>
          <td data-label="National ID">${escapeHtml(p.national_id || '—')}</td>
          <td data-label="DOB">${escapeHtml(p.birth_date || '—')}</td>
          <td data-label="Emergency Contact">${p.emergency_contact_relation || p.emergency_contact_phone ? `${escapeHtml(p.emergency_contact_relation || '—')}: ${escapeHtml(p.emergency_contact_phone || '—')}` : '—'}</td>
          <td data-label="Allergies">${p.has_allergies ? `<span class="ws-allergy-badge">${p.allergy_detail ? escapeHtml(p.allergy_detail) : 'Yes'}</span>` : '—'}</td>
          <td data-label="Notes">${escapeHtml(p.notes || '—')}</td>
          <td data-label="Member since">${leaderMemberSince(p) || '—'}</td>
          <td class="ws-row-actions">${actionsHTML}</td>
        </tr>`;
    }
    function renderLeaderRoster() {
      const active = activeLeaders();
      if (!active.length) {
        els.lrosterBody.innerHTML = '<tr><td colspan="13" class="ws-empty">No approved leaders yet.</td></tr>';
        return;
      }
      els.lrosterBody.innerHTML = active.map((p: any) => leaderRowHTML(p, `
        <button type="button" class="ws-edit-btn" data-lm-edit>Edit</button>
        <button type="button" class="ws-edit-btn" data-lm-archive>Archive</button>
        <button type="button" class="ws-row-del" data-lm-remove title="Remove access">×</button>
      `)).join('');
      els.lrosterBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.leaderId;
        row.querySelector('[data-lm-edit]').addEventListener('click', () => startEditLeaderRoster(id));
        row.querySelector('[data-lm-archive]').addEventListener('click', () => archiveLeader(id));
        row.querySelector('[data-lm-remove]').addEventListener('click', () => removeLeaderAccess(id));
      });
    }
    function renderLeaderArchive() {
      const archived = state.allLeaders.filter((p: any) => p.active === false);
      if (!archived.length) {
        els.larchiveBody.innerHTML = '<tr><td colspan="13" class="ws-empty">No archived leaders.</td></tr>';
        return;
      }
      els.larchiveBody.innerHTML = archived.map((p: any) => leaderRowHTML(p, `
        <button type="button" class="ws-edit-btn" data-lm-edit>Edit</button>
        <button type="button" class="ws-edit-btn" data-lm-restore>Restore</button>
        <button type="button" class="ws-row-del" data-lm-remove title="Remove access">×</button>
      `)).join('');
      els.larchiveBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.leaderId;
        row.querySelector('[data-lm-edit]').addEventListener('click', () => startEditLeaderRoster(id));
        row.querySelector('[data-lm-restore]').addEventListener('click', () => restoreLeader(id));
        row.querySelector('[data-lm-remove]').addEventListener('click', () => removeLeaderAccess(id));
      });
    }
    function showLmAllergy(focus = true) {
      els.lmAllergyFields.hidden = false;
      els.lmAllergyAdd.hidden = true;
      if (focus) els.lmAllergyDetail.focus();
    }
    function hideLmAllergy() {
      els.lmAllergyFields.hidden = true;
      els.lmAllergyAdd.hidden = false;
      els.lmAllergyDetail.value = '';
    }
    function resetLeaderRosterForm() {
      state.editingLeaderId = null;
      els.lmForm.reset();
      hideLmAllergy();
      els.lmForm.hidden = true;
    }
    function startEditLeaderRoster(id: string) {
      const p = state.allLeaders.find((x: any) => x.id === id);
      if (!p) return;
      state.editingLeaderId = id;
      els.lmName.value = p.name || '';
      els.lmPhone.value = p.phone || '';
      els.lmEmail.value = p.email || '';
      els.lmDob.value = p.birth_date || '';
      els.lmNid.value = p.national_id || '';
      els.lmEcRel.value = p.emergency_contact_relation || '';
      els.lmEcPhone.value = p.emergency_contact_phone || '';
      els.lmMemberSince.value = leaderMemberSince(p) || '';
      if (p.has_allergies) { showLmAllergy(false); els.lmAllergyDetail.value = p.allergy_detail || ''; } else { hideLmAllergy(); }
      els.lmNotes.value = p.notes || '';
      els.lmFormTitle.textContent = `Editing ${p.name}`;
      els.lmForm.hidden = false;
      els.lmForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    async function archiveLeader(id: string) {
      const p = state.allLeaders.find((x: any) => x.id === id);
      if (!confirm(`Archive ${p ? p.name : 'this leader'}? They'll drop off the Dashboard, Leader Profile, Assessment, and Overview going forward — their role and login access aren't touched, and you can restore them any time from here.`)) return;
      const { error } = await db.from('profiles').update({ active: false }).eq('id', id);
      if (error) { console.error(error); showToast('Could not archive.'); return; }
      if (state.editingLeaderId === id) resetLeaderRosterForm();
      await loadLeaderRoster();
    }
    async function restoreLeader(id: string) {
      const { error } = await db.from('profiles').update({ active: true }).eq('id', id);
      if (error) { console.error(error); showToast('Could not restore.'); return; }
      await loadLeaderRoster();
    }
    // Same action as /admin's People tab "Remove access" button
    // (peopleGroupsCellHTML's row) — sets role back to 'pending' and
    // clears groups. Not a delete: their profiles row and login stay
    // intact, they just land back on the "waiting for approval" screen
    // until re-approved. A true account deletion isn't something this
    // client-only app can safely do at all (would need Supabase's Admin
    // API / a service-role key to remove the underlying auth.users row,
    // not just profiles).
    async function removeLeaderAccess(id: string) {
      const p = state.allLeaders.find((x: any) => x.id === id);
      if (!confirm(`Remove ${p ? p.name : 'this leader'}'s access? They'll be signed out of every group and land back on the "waiting for approval" screen — you can re-approve them any time from Admin → People. This doesn't delete their account.`)) return;
      const { error } = await db.from('profiles').update({ role: 'pending', groups: [] }).eq('id', id);
      if (error) { console.error(error); showToast('Could not remove access, ' + (error.message || 'unknown error') + '.'); return; }
      if (state.editingLeaderId === id) resetLeaderRosterForm();
      showToast(`${p ? p.name + "'s" : "Their"} access removed.`);
      await loadLeaderRoster();
    }
    function bindLeaderRosterForm() {
      els.lmAllergyAdd.addEventListener('click', () => showLmAllergy());
      els.lmAllergyRemove.addEventListener('click', () => hideLmAllergy());
      els.lmCancel.addEventListener('click', resetLeaderRosterForm);
      els.lmForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        if (!state.editingLeaderId) return;
        const name = els.lmName.value.trim();
        if (!name) { showToast('Full name is required.'); return; }
        const hasAllergies = !els.lmAllergyFields.hidden;
        const payload = {
          name,
          phone: els.lmPhone.value.trim() || null,
          // Email isn't in this payload on purpose — it's read-only,
          // auto-filled from auth.users.email at signup (see
          // leader_email_from_auth_schema.sql), not something this
          // form can change.
          birth_date: els.lmDob.value || null,
          national_id: els.lmNid.value.trim() || null,
          emergency_contact_relation: els.lmEcRel.value.trim() || null,
          emergency_contact_phone: els.lmEcPhone.value.trim() || null,
          member_since: els.lmMemberSince.value || null,
          has_allergies: hasAllergies,
          allergy_detail: hasAllergies ? els.lmAllergyDetail.value.trim() || null : null,
          notes: els.lmNotes.value.trim() || null,
        };
        els.lmSubmit.disabled = true;
        const { error } = await db.from('profiles').update(payload).eq('id', state.editingLeaderId);
        els.lmSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not save.'); return; }
        resetLeaderRosterForm();
        await loadLeaderRoster();
      });
    }

    // ---- Attendance — same calendar + tick-to-mark-present pattern as
    // the troops' own Attendance tab (see loadAttendance()), keyed by
    // (meeting_type, date) instead of just (group_key, date) so more
    // than one kind of meeting can be logged on the same day — pick
    // "Leaders Meeting" for a general leadership meeting, or one of the
    // 5 troop names to mark whether that troop's own leader showed up to
    // run it. See LEADER_MEETING_TYPES. ----
    async function loadLeaderAttendance() {
      await ensureAllLeadersLoaded();
      if (!els.lattType.children.length) {
        els.lattType.innerHTML = LEADER_MEETING_TYPES.map((t) => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
      }
      els.lattType.value = state.lattType;
      if (!els.lattWeekdayRow.children.length) {
        els.lattWeekdayRow.innerHTML = WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('');
      }
      const first = new Date(state.lattAnchor.getFullYear(), state.lattAnchor.getMonth(), 1);
      const last = new Date(state.lattAnchor.getFullYear(), state.lattAnchor.getMonth() + 1, 0);
      const gridStart = startOfWeek(first);
      const gridEnd = addDays(startOfWeek(last), 6);
      const { data, error } = await db.from('leader_attendance').select('date').eq('group_key', LEADERS_GROUP_KEY).eq('meeting_type', state.lattType)
        .gte('date', toDateStr(gridStart)).lte('date', toDateStr(gridEnd));
      if (error) { console.error(error); showToast('Could not load attendance.'); return; }
      state.lattDatesWithRecords = new Set((data || []).map((r: any) => r.date));
      renderLattCalendar();
      await loadLattDay();
    }
    function renderLattCalendar() {
      const anchor = state.lattAnchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      els.lattMonthLabel.textContent = `${MONTHS[mo].en} ${y}`;
      let html = '';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const cls = [
          'curr-day-cell',
          !inMonth && 'curr-day-cell--out',
          dateStr === today && 'curr-day-cell--today',
          dateStr === state.lattSelected && 'curr-day-cell--selected',
          state.lattDatesWithRecords?.has(dateStr) && 'curr-day-cell--has',
        ].filter(Boolean).join(' ');
        const hasRecords = state.lattDatesWithRecords?.has(dateStr);
        html += `<div class="${cls}" data-date="${dateStr}" style="min-height:auto;cursor:pointer;">
          <span class="curr-day-num">${d.getDate()}</span>
          ${hasRecords ? '<span class="ws-att-dot" aria-hidden="true"></span>' : ''}
        </div>`;
        d = addDays(d, 1);
      }
      els.lattCalendar.innerHTML = html;
      els.lattCalendar.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => {
          state.lattSelected = cell.dataset.date;
          renderLattCalendar();
          loadLattDay();
        });
      });
    }
    async function loadLattDay() {
      const date = state.lattSelected;
      const d = parseDateStr(date);
      els.lattDateLabel.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      const { data, error } = await db.from('leader_attendance').select('*').eq('group_key', LEADERS_GROUP_KEY).eq('meeting_type', state.lattType).eq('date', date);
      if (error) { console.error(error); showToast('Could not load attendance.'); return; }
      const map: Map<string, any> = new Map((data || []).map((r: any) => [r.leader_id, r]));
      renderLattList(map, date);
    }
    function renderLattList(map: Map<string, any>, date: string) {
      const leaders = activeLeaders();
      if (!leaders.length) {
        els.lattBody.innerHTML = '<tr><td colspan="4" class="ws-empty">No approved leaders yet.</td></tr>';
        els.lattSummary.textContent = '';
        return;
      }
      let presentCount = 0;
      els.lattBody.innerHTML = leaders.map((p: any) => {
        const rec: any = map.get(p.id);
        if (rec && rec.present) presentCount++;
        return `
          <tr data-leader-id="${p.id}">
            <td data-label="Leader ID">${escapeHtml(p.member_code || '—')}</td>
            <td data-label="Name">${escapeHtml(p.name)}</td>
            <td data-label="Role">${p.role === 'admin' ? 'Admin' : 'Leader'}</td>
            <td data-label="Present"><input type="checkbox" data-latt-present ${rec && rec.present ? 'checked' : ''} /></td>
          </tr>`;
      }).join('');
      els.lattSummary.textContent = `${presentCount} of ${leaders.length} present`;
      els.lattBody.querySelectorAll('tr').forEach((row: any) => {
        const leaderId = row.dataset.leaderId;
        row.querySelector('[data-latt-present]').addEventListener('change', () => {
          saveLeaderAttendance(leaderId, date, row.querySelector('[data-latt-present]').checked);
        });
      });
    }
    // Same unchecked-means-no-record convention as saveAttendance() —
    // see its own comment for why (no phantom present:false rows).
    async function saveLeaderAttendance(leaderId: string, date: string, present: boolean) {
      const meetingType = state.lattType;
      const error = present
        ? (await db.from('leader_attendance').upsert({
            group_key: LEADERS_GROUP_KEY, meeting_type: meetingType, date, leader_id: leaderId, present,
            updated_by: state.session.user.id,
          }, { onConflict: 'group_key,meeting_type,date,leader_id' })).error
        : (await db.from('leader_attendance').delete()
            .eq('group_key', LEADERS_GROUP_KEY).eq('meeting_type', meetingType).eq('date', date).eq('leader_id', leaderId)).error;
      if (error) { console.error(error); showToast('Could not save attendance.'); return; }
      if (!state.lattDatesWithRecords) state.lattDatesWithRecords = new Set();
      const stillHasRecords = els.lattBody.querySelectorAll('[data-latt-present]:checked').length > 0;
      if (stillHasRecords) state.lattDatesWithRecords.add(date); else state.lattDatesWithRecords.delete(date);
      renderLattCalendar();
      const total = els.lattBody.querySelectorAll('[data-latt-present]').length;
      const presentNow = els.lattBody.querySelectorAll('[data-latt-present]:checked').length;
      els.lattSummary.textContent = `${presentNow} of ${total} present`;
    }
    function bindLeaderAttendance() {
      els.lattPrev.addEventListener('click', () => {
        state.lattAnchor = new Date(state.lattAnchor.getFullYear(), state.lattAnchor.getMonth() - 1, 1);
        loadLeaderAttendance();
      });
      els.lattNext.addEventListener('click', () => {
        state.lattAnchor = new Date(state.lattAnchor.getFullYear(), state.lattAnchor.getMonth() + 1, 1);
        loadLeaderAttendance();
      });
      const stepDay = (n: number) => {
        const next = addDays(parseDateStr(state.lattSelected), n);
        state.lattSelected = toDateStr(next);
        if (next.getMonth() !== state.lattAnchor.getMonth() || next.getFullYear() !== state.lattAnchor.getFullYear()) {
          state.lattAnchor = new Date(next.getFullYear(), next.getMonth(), 1);
          loadLeaderAttendance();
        } else {
          renderLattCalendar();
          loadLattDay();
        }
      };
      els.lattDayPrev.addEventListener('click', () => stepDay(-1));
      els.lattDayNext.addEventListener('click', () => stepDay(1));
      els.lattType.addEventListener('change', () => {
        state.lattType = els.lattType.value;
        loadLeaderAttendance();
      });
    }

    // ---- Dashboard — "assess their performance": each leader's own
    // attendance rate against every meeting logged in leader_attendance
    // within the From/To range above the KPIs (defaults to the last 90
    // days, see bindLeaderDashboardRange()). Only present rows are ever
    // stored (see saveLeaderAttendance()), so a meeting's own total
    // attendee count isn't recoverable from a single leader's rows —
    // totalMeetings is the count of distinct (date, meeting_type) pairs
    // in range instead, i.e. "how many meetings has anyone been logged
    // at in this window". A leader who joined partway through the range
    // just has a lower count to work with, same as a troop member who
    // joined mid-year on the org-wide Overview's own attendance rate. ----
    function leaderAttendanceRateBadgeClass(rate: number | null) {
      if (rate == null) return 'ws-badge--fair';
      if (rate >= 90) return 'ws-badge--good';
      if (rate >= 70) return 'ws-badge--fair';
      return 'ws-badge--poor';
    }
    function ldashRange(): { from: string; to: string; label: string } {
      const from = els.ldashFrom.value || toDateStr(addDays(new Date(), -90));
      const to = els.ldashTo.value || todayStr();
      return { from, to, label: `${from} to ${to}` };
    }
    async function computeLeaderDashboardData() {
      await ensureAllLeadersLoaded();
      const { from, to, label } = ldashRange();
      const { data, error } = await db.from('leader_attendance').select('leader_id, date, meeting_type, present')
        .eq('group_key', LEADERS_GROUP_KEY).gte('date', from).lte('date', to);
      if (error) { console.error(error); showToast('Could not load the dashboard.'); return null; }
      const rows = data || [];
      const totalMeetings = new Set(rows.map((r: any) => `${r.meeting_type}|${r.date}`)).size;
      const byLeader = new Map<string, { attended: number; last: string | null }>();
      rows.forEach((r: any) => {
        if (!r.present) return;
        const cur = byLeader.get(r.leader_id) || { attended: 0, last: null };
        cur.attended += 1;
        if (!cur.last || r.date > cur.last) cur.last = r.date;
        byLeader.set(r.leader_id, cur);
      });
      const leaders = activeLeaders();
      const withRates = leaders.map((p: any) => {
        const rec = byLeader.get(p.id) || { attended: 0, last: null };
        const rate = totalMeetings ? Math.round((rec.attended / totalMeetings) * 100) : null;
        return { p, attended: rec.attended, last: rec.last, rate };
      });
      withRates.sort((a: any, b: any) => (a.rate ?? -1) - (b.rate ?? -1));
      const admins = leaders.filter((p: any) => p.role === 'admin').length;
      const newInRange = leaders.filter((p: any) => p.created_at && String(p.created_at).slice(0, 10) >= from && String(p.created_at).slice(0, 10) <= to).length;
      return { totalMeetings, withRates, label, admins, newInRange, leaderCount: leaders.length };
    }
    async function loadLeaderDashboard() {
      const data = await computeLeaderDashboardData();
      if (data) renderLeaderDashboard(data.totalMeetings, data.withRates, data.label, data.admins, data.newInRange, data.leaderCount);
    }
    function renderLeaderDashboard(totalMeetings: number, withRates: any[], rangeLabel: string, admins: number, newInRange: number, leaderCount: number) {
      const withHistory = withRates.filter((r: any) => r.rate != null);
      const avgRate = withHistory.length ? Math.round(withHistory.reduce((s: number, r: any) => s + r.rate, 0) / withHistory.length) : null;
      const belowThreshold = withHistory.filter((r: any) => r.rate < 70).length;
      const perfect = withHistory.filter((r: any) => r.rate === 100 && r.attended > 0).length;
      const noShows = withHistory.filter((r: any) => r.rate === 0).length;
      els.ldashKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Approved leaders</span></div>
          <span class="ws-dash-kpi-num">${leaderCount}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">☰</span><span class="ws-dash-kpi-label">Meetings logged</span></div>
          <span class="ws-dash-kpi-num">${totalMeetings}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⟳</span><span class="ws-dash-kpi-label">Avg. attendance rate</span></div>
          <span class="ws-dash-kpi-num">${avgRate != null ? avgRate + '%' : '—'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">!</span><span class="ws-dash-kpi-label">Below 70%</span></div>
          <span class="ws-dash-kpi-num">${belowThreshold}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Perfect attendance</span></div>
          <span class="ws-dash-kpi-num">${perfect}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✕</span><span class="ws-dash-kpi-label">No-shows this range</span></div>
          <span class="ws-dash-kpi-num">${noShows}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">◆</span><span class="ws-dash-kpi-label">Admins</span></div>
          <span class="ws-dash-kpi-num">${admins}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">+</span><span class="ws-dash-kpi-label">New leaders this range</span></div>
          <span class="ws-dash-kpi-num">${newInRange}</span>
        </div>
      `;
      if (els.ldashTableSub) els.ldashTableSub.textContent = `${rangeLabel} · Sorted worst-first`;
      if (!withRates.length) {
        els.ldashBody.innerHTML = '<tr><td colspan="6" class="ws-empty">No approved leaders yet.</td></tr>';
        els.ldashAttention.innerHTML = '<p class="ws-dash-empty-mini">No approved leaders yet.</p>';
        return;
      }
      els.ldashBody.innerHTML = withRates.map((r: any) => `
        <tr>
          <td data-label="Leader ID">${escapeHtml(r.p.member_code || '—')}</td>
          <td data-label="Name">${escapeHtml(r.p.name)}</td>
          <td data-label="Role">${r.p.role === 'admin' ? 'Admin' : 'Leader'}</td>
          <td data-label="Attended">${r.attended} / ${totalMeetings}</td>
          <td data-label="Rate"><span class="ws-badge ${leaderAttendanceRateBadgeClass(r.rate)}">${r.rate != null ? r.rate + '%' : '—'}</span></td>
          <td data-label="Last attended">${r.last || '—'}</td>
        </tr>
      `).join('');
      // Already sorted worst-first above — this is just the below-70%
      // prefix of that same list, so it stays in sync for free.
      const attention = withRates.filter((r: any) => r.rate != null && r.rate < 70);
      els.ldashAttention.innerHTML = attention.length
        ? attention.map((r: any) => `<div class="ws-dash-attn-row">${escapeHtml(r.p.name)} <span>${r.rate}%</span></div>`).join('')
        : `<p class="ws-dash-empty-mini">${totalMeetings ? 'Everyone is at 70% or above.' : 'Nothing logged yet.'}</p>`;
    }
    async function downloadLeaderDashboardPdf() {
      try {
        const data = await computeLeaderDashboardData();
        if (!data) return;
        const { totalMeetings, withRates, label } = data;
        const withHistory = withRates.filter((r: any) => r.rate != null);
        const avgRate = withHistory.length ? Math.round(withHistory.reduce((s: number, r: any) => s + r.rate, 0) / withHistory.length) : null;
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Attendance', `${label}, ${totalMeetings} meeting${totalMeetings === 1 ? '' : 's'} logged, avg rate ${avgRate != null ? avgRate + '%' : '—'}`);
        pdfTable(doc, { startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          head: [['Leader ID', 'Name', 'Role', 'Attended', 'Rate', 'Last attended']],
          body: withRates.length ? withRates.map((r: any) => [r.p.member_code || '—', r.p.name, r.p.role === 'admin' ? 'Admin' : 'Leader', `${r.attended} / ${totalMeetings}`, r.rate != null ? `${r.rate}%` : '—', r.last || '—']) : [['', 'No data available', '', '', '', '']] });
        doc.save(pdfFilename('Attendance', label));
      } catch (err) {
        console.error('leaders attendance report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    function bindLeaderDashboardRange() {
      els.ldashTableSub = el('[data-ldash-table-sub]');
      if (!els.ldashFrom.value) els.ldashFrom.value = toDateStr(addDays(new Date(), -90));
      if (!els.ldashTo.value) els.ldashTo.value = todayStr();
      els.ldashFrom.addEventListener('change', loadLeaderDashboard);
      els.ldashTo.addEventListener('change', loadLeaderDashboard);
      els.ldashExport.addEventListener('click', downloadLeaderDashboardPdf);
    }

    // ---- Leader Profile: pick one leader and see their own KPIs plus a
    // real activity feed of what they've done (see fetchLeaderActivity()
    // in src/lib/leader-activity.ts for exactly what that does and does
    // not cover). Attendance rate here is genuinely all-time (unlike the
    // ranged Dashboard above), same all-time convention the original
    // Leader Dashboard used before the range picker was added.
    function populateLeaderSelect(selectEl: any, leaders: any[]) {
      const cur = selectEl.value;
      selectEl.innerHTML = '<option value="">Choose a leader…</option>' + leaders.map((p: any) => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
      if (cur) selectEl.value = cur;
    }
    async function loadLeaderProfileTab() {
      await ensureAllLeadersLoaded();
      populateLeaderSelect(els.lprofSelect, activeLeaders());
      if (state.lprofLeaderId) {
        els.lprofSelect.value = state.lprofLeaderId;
        await renderLeaderProfile(state.lprofLeaderId);
      }
    }
    function renderLeaderActivity(container: any, sub: any, items: LeaderActivityItem[]) {
      if (sub) sub.textContent = items.length ? `${items.length} recent action${items.length === 1 ? '' : 's'}` : '';
      if (!items.length) { container.innerHTML = '<p class="ws-dash-empty-mini">Nothing logged for this leader yet.</p>'; return; }
      container.innerHTML = items.slice(0, 40).map((it) => `
        <div class="ws-dash-feed-row">
          <span class="ws-dash-feed-dot ws-dash-feed-dot--${it.type}"></span>
          <span class="ws-dash-feed-text">
            <span class="ws-dash-feed-title">${escapeHtml(it.text)}</span>
            <span class="ws-dash-feed-date">${escapeHtml(formatActivityWhen(it.date).slice(0, 10))}</span>
          </span>
        </div>
      `).join('');
    }
    async function renderLeaderProfile(leaderId: string) {
      const leader = state.allLeaders.find((p: any) => p.id === leaderId);
      if (!leader) return;
      els.lprofEmpty.hidden = true;
      els.lprofRoot.hidden = false;
      els.lprofKpis.innerHTML = '<p class="ws-dash-empty-mini">Loading…</p>';
      els.lprofActivity.innerHTML = '';
      const { data: attRows, error } = await db.from('leader_attendance').select('leader_id, date, meeting_type, present').eq('group_key', LEADERS_GROUP_KEY);
      if (error) { console.error(error); showToast('Could not load this leader.'); return; }
      const rows = attRows || [];
      const totalMeetings = new Set(rows.map((r: any) => `${r.meeting_type}|${r.date}`)).size;
      const own = rows.filter((r: any) => r.leader_id === leaderId && r.present);
      const attended = own.length;
      const last = own.reduce((acc: string | null, r: any) => (!acc || r.date > acc ? r.date : acc), null as string | null);
      const rate = totalMeetings ? Math.round((attended / totalMeetings) * 100) : null;
      els.lprofKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⟳</span><span class="ws-dash-kpi-label">Attendance rate (all-time)</span></div>
          <span class="ws-dash-kpi-num">${rate != null ? rate + '%' : '—'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">☰</span><span class="ws-dash-kpi-label">Meetings attended</span></div>
          <span class="ws-dash-kpi-num">${attended} / ${totalMeetings}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Last attended</span></div>
          <span class="ws-dash-kpi-num" style="font-size:1.3rem">${last || '—'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Member since</span></div>
          <span class="ws-dash-kpi-num" style="font-size:1.3rem">${leaderMemberSince(leader) || '—'}</span>
        </div>
      `;
      const items = await fetchLeaderActivity(db, { leaderId, leaderName: leader.name, limitPerType: 25 });
      renderLeaderActivity(els.lprofActivity, els.lprofActivitySub, items);
    }
    function bindLeaderProfile() {
      els.lprofSelect.addEventListener('change', async () => {
        state.lprofLeaderId = els.lprofSelect.value || null;
        if (!state.lprofLeaderId) { els.lprofRoot.hidden = true; els.lprofEmpty.hidden = false; return; }
        await renderLeaderProfile(state.lprofLeaderId);
      });
    }

    // ---- Assessment: rate one leader against every function on file,
    // 1-5 stars, one dated row per rating (leader_assessments) rather
    // than a single overwritten value — see leader_assessment_schema.sql.
    // Functions themselves are managed from the Settings tab below.
    async function ensureLeaderFunctionsLoaded() {
      if (state.leaderFunctionsLoaded) return;
      const { data, error } = await db.from('leader_functions').select('*').order('created_at', { ascending: true });
      if (error) { console.error(error); showToast('Could not load functions.'); return; }
      state.leaderFunctions = data || [];
      state.leaderFunctionsLoaded = true;
    }
    function renderStarInputControl() {
      els.lassessStars.innerHTML = [1, 2, 3, 4, 5].map((n) => `<button type="button" data-star="${n}" aria-label="${n} star${n === 1 ? '' : 's'}">★</button>`).join('');
      els.lassessStars.querySelectorAll('button').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          state.lassessRating = Number(btn.dataset.star);
          paintStarInput();
        });
      });
    }
    function paintStarInput() {
      els.lassessStars.querySelectorAll('button').forEach((btn: any) => {
        btn.classList.toggle('ws-star-input--active', Number(btn.dataset.star) <= state.lassessRating);
      });
    }
    function starDisplay(rating: number): string {
      return '<span class="ws-star-display">' + [1, 2, 3, 4, 5].map((n) => `<span class="${n <= rating ? '' : 'ws-star-display--empty'}">★</span>`).join('') + '</span>';
    }
    // Keeps the Rate subtab's own function dropdown/disabled-state in
    // sync with whatever the Settings subtab last saved — called on tab
    // load and again after every function add/edit/delete, since both
    // subtabs share one panel and can be switched between without a
    // full tab reload.
    function syncAssessmentFunctionOptions() {
      const cur = els.lassessFunction.value;
      els.lassessFunction.innerHTML = state.leaderFunctions.map((f: any) => `<option value="${f.id}">${escapeHtml(f.name)}</option>`).join('');
      if (cur) els.lassessFunction.value = cur;
      els.lassessNoFunctions.toggleAttribute('hidden', state.leaderFunctions.length > 0);
      els.lassessForm.querySelectorAll('input, select, textarea, button[type="submit"]').forEach((elm: any) => { elm.disabled = !state.leaderFunctions.length; });
    }
    async function loadLeaderAssessmentTab() {
      await ensureAllLeadersLoaded();
      // Settings is a subtab of this same panel now (both loaded
      // eagerly together, same as Finance's own subtabs) — this both
      // refreshes state.leaderFunctions and renders its list.
      await loadLeaderFunctionsSettings();
      populateLeaderSelect(els.lassessSelect, activeLeaders());
      syncAssessmentFunctionOptions();
      if (!els.lassessDate.value) els.lassessDate.value = todayStr();
      if (state.lassessLeaderId) {
        els.lassessSelect.value = state.lassessLeaderId;
        await renderLeaderAssessment(state.lassessLeaderId);
      }
    }
    async function renderLeaderAssessment(leaderId: string) {
      els.lassessEmpty.hidden = true;
      els.lassessRoot.hidden = false;
      const namesById = new Map(state.allLeaders.map((p: any) => [p.id, p.name]));
      const { data, error } = await db.from('leader_assessments').select('*').eq('leader_id', leaderId).order('assessed_date', { ascending: false }).order('created_at', { ascending: false });
      if (error) { console.error(error); showToast('Could not load assessments.'); return; }
      const rows = data || [];
      // Latest row per function_id — the current rubric's own summary
      // cards below only cover functions still on file; retired ones
      // (function_id null after a Settings delete) still show up in the
      // history table further down, just not summarized here.
      const latestByFunction = new Map<string, any>();
      rows.forEach((r: any) => { if (r.function_id && !latestByFunction.has(r.function_id)) latestByFunction.set(r.function_id, r); });
      const ratedCount = state.leaderFunctions.filter((f: any) => latestByFunction.has(f.id)).length;
      const overallAvg = latestByFunction.size
        ? Math.round((Array.from(latestByFunction.values()).reduce((s: number, r: any) => s + r.rating, 0) / latestByFunction.size) * 10) / 10
        : null;
      const lastAssessed = rows.length ? rows[0].assessed_date : null;
      els.lassessKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">☰</span><span class="ws-dash-kpi-label">Functions rated</span></div>
          <span class="ws-dash-kpi-num">${ratedCount} / ${state.leaderFunctions.length}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Overall average</span></div>
          <span class="ws-dash-kpi-num">${overallAvg != null ? overallAvg + ' / 5' : '—'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Last assessed</span></div>
          <span class="ws-dash-kpi-num" style="font-size:1.3rem">${lastAssessed || '—'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⟳</span><span class="ws-dash-kpi-label">Assessments logged</span></div>
          <span class="ws-dash-kpi-num">${rows.length}</span>
        </div>
      `;
      els.lassessSummary.innerHTML = state.leaderFunctions.length
        ? state.leaderFunctions.map((f: any) => {
            const r = latestByFunction.get(f.id);
            return `
              <div class="ws-dash-attn-row" style="cursor:default">
                <span>${escapeHtml(f.name)}</span>
                <span>${r ? starDisplay(r.rating) : '<span class="ws-dash-empty-mini">Not yet rated</span>'}</span>
              </div>`;
          }).join('')
        : '<p class="ws-dash-empty-mini">No functions on file yet — add some from the Settings tab.</p>';
      els.lassessBody.innerHTML = rows.length
        ? rows.map((r: any) => `
            <tr data-assessment-id="${r.id}">
              <td data-label="Date">${r.assessed_date}</td>
              <td data-label="Function">${escapeHtml(r.function_name)}</td>
              <td data-label="Rating">${starDisplay(r.rating)}</td>
              <td data-label="Notes">${escapeHtml(r.notes || '—')}</td>
              <td data-label="Assessed by">${escapeHtml(namesById.get(r.assessed_by) || '—')}</td>
              <td class="ws-row-actions"><button type="button" class="ws-row-del" data-lassess-del>×</button></td>
            </tr>
          `).join('')
        : '<tr><td colspan="6" class="ws-empty">No assessments logged yet.</td></tr>';
      els.lassessBody.querySelectorAll('[data-lassess-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this assessment entry?')) return;
          const id = btn.closest('tr').dataset.assessmentId;
          const { error: delError } = await db.from('leader_assessments').delete().eq('id', id);
          if (delError) { showToast('Could not delete.'); return; }
          await renderLeaderAssessment(leaderId);
        });
      });
    }
    function bindLeaderAssessment() {
      renderStarInputControl();
      els.lassessSelect.addEventListener('change', async () => {
        state.lassessLeaderId = els.lassessSelect.value || null;
        state.lassessRating = 0;
        paintStarInput();
        els.lassessForm.reset();
        if (els.lassessDate) els.lassessDate.value = todayStr();
        if (!state.lassessLeaderId) { els.lassessRoot.hidden = true; els.lassessEmpty.hidden = false; return; }
        await renderLeaderAssessment(state.lassessLeaderId);
      });
      els.lassessForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        if (!state.lassessLeaderId) return;
        const functionId = els.lassessFunction.value;
        const fn = state.leaderFunctions.find((f: any) => f.id === functionId);
        if (!fn) { showToast('Choose a function.'); return; }
        if (!state.lassessRating) { showToast('Pick a star rating.'); return; }
        els.lassessSubmit.disabled = true;
        const { error } = await db.from('leader_assessments').insert({
          leader_id: state.lassessLeaderId, function_id: fn.id, function_name: fn.name,
          rating: state.lassessRating, notes: els.lassessNotes.value.trim() || null,
          assessed_date: els.lassessDate.value || todayStr(), assessed_by: state.session.user.id,
        });
        els.lassessSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not save assessment.'); return; }
        state.lassessRating = 0;
        paintStarInput();
        els.lassessNotes.value = '';
        await renderLeaderAssessment(state.lassessLeaderId);
      });
    }

    // ---- Leaders Settings: the function rubric Assessment rates
    // leaders against — CRUD over leader_functions, same add/edit form +
    // table pattern as PR Contacts (startEditPrContact() etc.).
    function resetLeaderFunctionForm() {
      state.editingFunctionId = null;
      els.lfuncForm.reset();
      els.lfuncFormTitle.textContent = 'Add a function';
      els.lfuncSubmit.textContent = 'Add function';
      els.lfuncCancel.hidden = true;
    }
    function startEditLeaderFunction(id: string) {
      const f = state.leaderFunctions.find((x: any) => x.id === id);
      if (!f) return;
      state.editingFunctionId = id;
      els.lfuncName.value = f.name;
      els.lfuncDesc.value = f.description || '';
      els.lfuncFormTitle.textContent = `Editing ${f.name}`;
      els.lfuncSubmit.textContent = 'Save changes';
      els.lfuncCancel.hidden = false;
      els.lfuncForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function renderLeaderFunctionsList() {
      els.lfuncBody.innerHTML = state.leaderFunctions.length
        ? state.leaderFunctions.map((f: any) => `
            <tr data-function-id="${f.id}">
              <td data-label="Name">${escapeHtml(f.name)}</td>
              <td data-label="Description">${escapeHtml(f.description || '—')}</td>
              <td class="ws-row-actions">
                <button type="button" class="ws-edit-btn" data-lfunc-edit>Edit</button>
                <button type="button" class="ws-row-del" data-lfunc-del>×</button>
              </td>
            </tr>
          `).join('')
        : '<tr><td colspan="3" class="ws-empty">No functions yet — add the first one above.</td></tr>';
      els.lfuncBody.querySelectorAll('[data-lfunc-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => startEditLeaderFunction(btn.closest('tr').dataset.functionId));
      });
      els.lfuncBody.querySelectorAll('[data-lfunc-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this function? Ratings already logged against it stay on record.')) return;
          const id = btn.closest('tr').dataset.functionId;
          const { error } = await db.from('leader_functions').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingFunctionId === id) resetLeaderFunctionForm();
          await loadLeaderFunctionsSettings();
          syncAssessmentFunctionOptions();
          if (state.lassessLeaderId) await renderLeaderAssessment(state.lassessLeaderId);
        });
      });
    }
    async function loadLeaderFunctionsSettings() {
      state.leaderFunctionsLoaded = false;
      await ensureLeaderFunctionsLoaded();
      renderLeaderFunctionsList();
    }
    function bindLeaderFunctionForm() {
      els.lfuncCancel.addEventListener('click', resetLeaderFunctionForm);
      els.lfuncForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const name = els.lfuncName.value.trim();
        if (!name) { showToast('Name is required.'); return; }
        els.lfuncSubmit.disabled = true;
        const payload: any = { name, description: els.lfuncDesc.value.trim() || null };
        let error;
        if (state.editingFunctionId) {
          ({ error } = await db.from('leader_functions').update(payload).eq('id', state.editingFunctionId));
        } else {
          payload.created_by = state.session.user.id;
          ({ error } = await db.from('leader_functions').insert(payload));
        }
        els.lfuncSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not save function.'); return; }
        resetLeaderFunctionForm();
        await loadLeaderFunctionsSettings();
        syncAssessmentFunctionOptions();
        if (state.lassessLeaderId) await renderLeaderAssessment(state.lassessLeaderId);
      });
    }

    // ---------- Support Leader Overview + Next Meetings: an approved
    // leader with no group at all (activeGroup null) used to land on
    // Shared Calendar with nothing else to look at — these 2 tabs give
    // them a real read-only look at the org instead (Overview's own
    // per-group directory doubles as a Leaders Roster, so there's no
    // separate tab for that). No member counts or financials anywhere
    // here — `members` stays behind each group's own
    // has_group_access(), only org_next_meetings() and profiles/
    // shared_calendar are read (see support_leader_overview_schema.sql
    // for exactly what that opened up and why it's safe: profiles has
    // no PII beyond name/role/groups, and the meetings function returns
    // date + theme only).
    const OVERVIEW_GROUPS = GROUPS.filter((g: any) => g.key !== LEADERS_GROUP_KEY);
    async function loadSupportOverview() {
      await ensureAllLeadersLoaded();
      els.sovDate.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
      els.sovGreeting.textContent = dashGreeting();
      const [meetingsRes, calRes] = await Promise.all([
        db.rpc('org_next_meetings'),
        // Raw event_date only — a recurring series' true next occurrence
        // needs the same client-side expansion the Shared Calendar tab
        // itself does (scDateMatchesRecurrence()), too heavy for a
        // glance card; this is "what's on the books soon", the Shared
        // Calendar tab (linked below) is the authoritative full schedule.
        db.from('shared_calendar_events').select('id, title, event_date, event_time, event_end_time')
          .gte('event_date', todayStr()).order('event_date', { ascending: true }).limit(6),
      ]);
      if (meetingsRes.error) console.error(meetingsRes.error);
      if (calRes.error) console.error(calRes.error);
      const meetings = meetingsRes.data || [];
      const calEvents = calRes.data || [];
      const weekOut = toDateStr(addDays(new Date(), 7));
      const thisWeek = meetings.filter((m: any) => m.date <= weekOut).length;
      const troopCount = TROOP_GROUPS.length;
      const committeeCount = OVERVIEW_GROUPS.length - troopCount;
      const leaders = activeLeaders();
      els.sovKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Approved leaders</span></div>
          <span class="ws-dash-kpi-num">${leaders.length}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⛺</span><span class="ws-dash-kpi-label">Troops</span></div>
          <span class="ws-dash-kpi-num">${troopCount}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">◆</span><span class="ws-dash-kpi-label">Committees</span></div>
          <span class="ws-dash-kpi-num">${committeeCount}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">☰</span><span class="ws-dash-kpi-label">Meetings this week</span></div>
          <span class="ws-dash-kpi-num">${thisWeek}</span>
        </div>
      `;
      els.sovGroups.innerHTML = OVERVIEW_GROUPS.map((g: any) => {
        const groupLeaders = leaders.filter((p: any) => p.role === 'leader' && (p.groups || []).includes(g.key));
        return `
          <div class="ws-dash-card">
            <div class="ws-dash-card-head"><h3>${escapeHtml(g.en)}</h3></div>
            <p class="ws-dash-empty-mini">${groupLeaders.length ? escapeHtml(groupLeaders.map((p: any) => p.name).join(', ')) : 'No leader assigned yet.'}</p>
          </div>`;
      }).join('');
      const soonest = meetings.length ? meetings.reduce((a: any, b: any) => (a.date <= b.date ? a : b)) : null;
      if (soonest) {
        const d = parseDateStr(soonest.date);
        const g = GROUPS.find((x: any) => x.key === soonest.group_key);
        els.sovNext.innerHTML = `
          <p class="ws-dash-mini-date">${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}</p>
          <p class="ws-dash-mini-theme">${escapeHtml(g ? g.en : soonest.group_key)}</p>
          <p class="ws-dash-mini-sub">${escapeHtml(soonest.theme || 'Theme not set yet')}</p>
        `;
      } else {
        els.sovNext.innerHTML = '<p class="ws-dash-empty-mini">Nothing planned yet.</p>';
      }
      els.sovCalSub.textContent = calEvents.length ? `Next ${calEvents.length}` : '';
      els.sovCalendar.innerHTML = calEvents.length
        ? calEvents.map((ev: any) => {
            const d = parseDateStr(ev.event_date);
            const dateLabel = `${MONTHS[d.getMonth()].en.slice(0, 3)} ${d.getDate()}`;
            const timeLabel = ev.event_time ? scTimeRangeLabel(ev) : 'All day';
            return `
              <div class="ws-dash-feed-row">
                <span class="ws-dash-feed-dot ws-dash-feed-dot--curriculum"></span>
                <span class="ws-dash-feed-text">
                  <span class="ws-dash-feed-title">${escapeHtml(ev.title)}</span>
                  <span class="ws-dash-feed-date">${dateLabel} · ${timeLabel}</span>
                </span>
              </div>`;
          }).join('')
        : '<p class="ws-dash-empty-mini">Nothing on the calendar yet.</p>';
    }
    function bindSupportOverview() {
      els.sovGotoCalendar.addEventListener('click', () => setTab('sharedcal'));
    }
    async function loadNextMeetings() {
      const { data, error } = await db.rpc('org_next_meetings');
      if (error) { console.error(error); showToast('Could not load next meetings.'); return; }
      const byGroup = new Map((data || []).map((m: any) => [m.group_key, m]));
      // Troops only — Music/General/Social Media never get curriculum_
      // meetings rows at all (no Curriculum tab for them, see
      // NON_TROOP_TAB_VISIBILITY), so they'd only ever show "Nothing
      // planned yet" here, forever.
      const rows = TROOP_GROUPS.map((g: any) => ({ group: g, m: byGroup.get(g.key) || null }));
      // Soonest-first; groups with nothing planned sink to the bottom.
      rows.sort((a: any, b: any) => {
        if (a.m && b.m) return a.m.date < b.m.date ? -1 : a.m.date > b.m.date ? 1 : 0;
        if (a.m) return -1;
        if (b.m) return 1;
        return 0;
      });
      els.nmBody.innerHTML = rows.map(({ group, m }: any) => `
        <tr>
          <td data-label="Group">${escapeHtml(group.en)}</td>
          <td data-label="Date">${m ? m.date : '—'}</td>
          <td data-label="Theme">${m ? escapeHtml(m.theme || 'Theme not set yet') : 'Nothing planned yet'}</td>
        </tr>
      `).join('');
    }

    // ---------- Content Calendar (Social Media only): a calendar + board
    // view over the same content_items, plus its own category Settings --
    const DEFAULT_CONTENT_PLATFORM_CATEGORIES = ['Instagram', 'Facebook', 'TikTok', 'X (Twitter)', 'YouTube', 'Other'];
    const DEFAULT_CONTENT_TYPE_CATEGORIES = ['Photo Post', 'Reel / Video', 'Story', 'Carousel', 'Live', 'Other'];
    const CONTENT_STATUS_LABELS: Record<string, string> = { idea: 'Idea', drafting: 'Drafting', scheduled: 'Scheduled', posted: 'Posted' };
    const CONTENT_STATUS_BADGE_CLASS: Record<string, string> = { idea: 'ws-badge--fair', drafting: 'ws-badge--fair', scheduled: 'ws-badge--fair', posted: 'ws-badge--good' };
    function contentStatusBadge(item: any) {
      return `<span class="ws-badge ${CONTENT_STATUS_BADGE_CLASS[item.status]}">${CONTENT_STATUS_LABELS[item.status]}</span>`;
    }
    async function loadContent() {
      if (!state.activeGroup) return;
      await loadGroupSettings();
      await ensureMembersLoaded();
      renderContentCategories();
      updateContentAssignedOptions();
      const { data, error } = await db.from('content_items').select('*').eq('group_key', state.activeGroup).order('scheduled_date', { ascending: true });
      if (error) { console.error(error); showToast('Could not load content.'); return; }
      state.contentItems = data || [];
      contentRenderMonth();
      contentRenderBoard();
    }
    // ---- Settings subtab: 2 category lists, same shared pattern as
    // every other Settings subtab in the app.
    function renderContentCategories() {
      renderCategoryList(els.contentPlatformCatList, state.groupSettings.content_platform_categories || [], 'content_platform_categories', saveContentCategoryList);
      renderCategoryList(els.contentTypeCatList, state.groupSettings.content_type_categories || [], 'content_type_categories', saveContentCategoryList);
      updateContentPlatformOptions();
      updateContentTypeOptions();
    }
    async function saveContentCategoryList(field: string, updated: string[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, [field]: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save.'); return; }
      state.groupSettings[field] = updated;
      renderContentCategories();
    }
    function updateContentPlatformOptions() {
      const list = state.groupSettings?.content_platform_categories || [];
      const current = els.contentPlatform.value;
      els.contentPlatform.innerHTML = '<option value="">— None —</option>' + list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
      if (list.includes(current)) els.contentPlatform.value = current;
    }
    function updateContentTypeOptions() {
      const list = state.groupSettings?.content_type_categories || [];
      const current = els.contentType.value;
      els.contentType.innerHTML = '<option value="">— None —</option>' + list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
      if (list.includes(current)) els.contentType.value = current;
    }
    function updateContentAssignedOptions() {
      const active = state.members.filter((m: any) => m.active);
      els.contentAssigned.innerHTML = '<option value="">Unassigned</option>' + active.map((m: any) => `<option value="${m.id}">${escapeHtml(m.full_name)}</option>`).join('');
    }
    function bindContentCategories() {
      els.contentPlatformCatAdd.addEventListener('click', () => {
        const val = els.contentPlatformCatInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.content_platform_categories || [];
        if (current.includes(val)) { els.contentPlatformCatInput.value = ''; return; }
        saveContentCategoryList('content_platform_categories', [...current, val]);
        els.contentPlatformCatInput.value = '';
      });
      els.contentTypeCatAdd.addEventListener('click', () => {
        const val = els.contentTypeCatInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.content_type_categories || [];
        if (current.includes(val)) { els.contentTypeCatInput.value = ''; return; }
        saveContentCategoryList('content_type_categories', [...current, val]);
        els.contentTypeCatInput.value = '';
      });
    }

    // ---- Calendar view — same shape as Event Calendar's own month grid.
    function contentGoToDate(dateStr: string) {
      const d = parseDateStr(dateStr);
      state.content.anchor = new Date(d.getFullYear(), d.getMonth(), 1);
      contentRenderMonth();
    }
    function contentStepMonth(delta: number) {
      state.content.anchor = new Date(state.content.anchor.getFullYear(), state.content.anchor.getMonth() + delta, 1);
      contentRenderMonth();
    }
    function contentRenderMonth() {
      const anchor = state.content.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      els.contentNavLabel.textContent = `${MONTHS[mo].en} ${y}`;
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const dayItems = state.contentItems.filter((c: any) => c.scheduled_date === dateStr);
        const shown = dayItems.slice(0, 3);
        const extra = dayItems.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${dayItems.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          <div class="curr-day-mini">
            ${shown.map((c: any) => `<span class="curr-mini-chip">${escapeHtml(c.title)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.contentMonthGrid.innerHTML = html;
      els.contentMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => contentOpenDay(cell.dataset.date));
      });
    }

    // ---- Board view — the same content_items grouped by status, one
    // column each. Moving a card between statuses is a dropdown rather
    // than drag-and-drop, so it can't silently fail on a fumbled drop.
    const CONTENT_STATUSES = ['idea', 'drafting', 'scheduled', 'posted'];
    function contentRenderBoard() {
      els.contentBoard.innerHTML = CONTENT_STATUSES.map((status) => {
        const items = state.contentItems.filter((c: any) => c.status === status);
        return `
          <div class="ws-content-column">
            <div class="ws-content-column-head">
              <span>${CONTENT_STATUS_LABELS[status]}</span>
              <span class="ws-content-column-count">${items.length}</span>
            </div>
            ${items.map((c: any) => `
              <div class="ws-content-card" data-content-card-id="${c.id}">
                <div class="ws-content-card-title">${escapeHtml(c.title)}</div>
                <div class="ws-content-card-meta">
                  ${c.platform ? `<span>${escapeHtml(c.platform)}</span>` : ''}
                  ${c.scheduled_date ? `<span>${c.scheduled_date}</span>` : ''}
                  ${c.created_by_name ? `<span>Added by ${escapeHtml(c.created_by_name)}</span>` : ''}
                </div>
                <div class="ws-content-card-move">
                  <select data-content-move-select data-content-move-id="${c.id}">
                    ${CONTENT_STATUSES.map((s) => `<option value="${s}" ${s === status ? 'selected' : ''}>${CONTENT_STATUS_LABELS[s]}</option>`).join('')}
                  </select>
                </div>
              </div>
            `).join('')}
          </div>
        `;
      }).join('');
      els.contentBoard.querySelectorAll('[data-content-card-id]').forEach((card: any) => {
        card.addEventListener('click', (e: Event) => {
          if ((e.target as any).closest('[data-content-move-select]')) return;
          const item = state.contentItems.find((c: any) => c.id === card.dataset.contentCardId);
          if (item) contentOpenDay(item.scheduled_date || todayStr(), item.id);
        });
      });
      els.contentBoard.querySelectorAll('[data-content-move-select]').forEach((sel: any) => {
        sel.addEventListener('click', (e: Event) => e.stopPropagation());
        sel.addEventListener('change', async () => {
          const { error } = await db.from('content_items').update({ status: sel.value, updated_at: new Date().toISOString() }).eq('id', sel.dataset.contentMoveId);
          if (error) { showToast('Could not update status.'); return; }
          await loadContent();
        });
      });
    }
    function contentSetView(view: string) {
      state.content.view = view;
      document.querySelectorAll('[data-content-view]').forEach((b: any) => b.classList.toggle('curr-view-btn--active', b.dataset.contentView === view));
      document.querySelectorAll('[data-content-view-pane]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.contentViewPane !== view));
    }

    // ---- Day overlay: that day's agenda, plus the add/edit form for one
    // piece of content at a time — same shell as Event Calendar's own.
    function contentOpenDay(dateStr: string, focusItemId?: string) {
      state.content.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      els.contentDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      contentRenderDayList(dateStr);
      els.contentDayOverlay.removeAttribute('hidden');
      document.documentElement.style.overflow = 'hidden';
      if (focusItemId) contentStartEdit(focusItemId);
      else contentShowList();
    }
    function contentCloseDay() {
      els.contentDayOverlay.setAttribute('hidden', '');
      state.content.currentDay = null;
      document.documentElement.style.overflow = '';
    }
    function contentShowList() {
      els.contentDayListView.removeAttribute('hidden');
      els.contentFormView.setAttribute('hidden', '');
    }
    function contentShowForm() {
      els.contentDayListView.setAttribute('hidden', '');
      els.contentFormView.removeAttribute('hidden');
    }
    function contentRenderDayList(dateStr: string) {
      const dayItems = state.contentItems.filter((c: any) => c.scheduled_date === dateStr);
      els.contentDayList.innerHTML = dayItems.length ? dayItems.map((c: any) => `
        <div class="ws-evt-day-item" data-content-id="${c.id}">
          <div class="ws-evt-day-item-main">
            <span class="ws-evt-day-item-title">${escapeHtml(c.title)}</span>
            <span class="ws-evt-day-item-sub">${escapeHtml(c.platform || '—')}${c.content_type ? ' · ' + escapeHtml(c.content_type) : ''}${c.created_by_name ? ' · Added by ' + escapeHtml(c.created_by_name) : ''}</span>
          </div>
          ${contentStatusBadge(c)}
          <div class="ws-evt-day-item-actions">
            <button type="button" class="ws-edit-btn" data-content-day-edit>Edit</button>
          </div>
        </div>
      `).join('') : '<p class="ws-empty" style="padding:1rem 0">Nothing planned this day yet.</p>';
      els.contentDayList.querySelectorAll('[data-content-day-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => contentStartEdit(btn.closest('[data-content-id]').dataset.contentId));
      });
    }
    function contentResetForm() {
      state.editingContentId = null;
      els.contentFormView.reset();
      els.contentDate.value = state.content.currentDay || todayStr();
      updateContentPlatformOptions();
      updateContentTypeOptions();
      els.contentPlatform.value = '';
      els.contentType.value = '';
      els.contentStatus.value = 'idea';
      els.contentAssigned.value = '';
      els.contentFormTitle.textContent = 'New content';
      els.contentDelete.hidden = true;
      contentRenderAttachment(null);
    }
    function contentStartNew() {
      contentResetForm();
      contentShowForm();
    }
    function contentStartEdit(id: string) {
      const c = state.contentItems.find((x: any) => x.id === id);
      if (!c) return;
      state.editingContentId = id;
      els.contentTitle.value = c.title;
      els.contentStatus.value = c.status;
      els.contentDate.value = c.scheduled_date || '';
      els.contentTime.value = c.scheduled_time || '';
      updateContentPlatformOptions();
      updateContentTypeOptions();
      els.contentPlatform.value = c.platform || '';
      els.contentType.value = c.content_type || '';
      els.contentAssigned.value = c.assigned_to || '';
      els.contentLink.value = c.link_url || '';
      els.contentCaption.value = c.caption || '';
      els.contentNotes.value = c.notes || '';
      els.contentFormTitle.textContent = `Editing ${c.title}`;
      els.contentDelete.hidden = false;
      contentRenderAttachment(c);
      contentShowForm();
    }
    async function contentRenderAttachment(c: any) {
      const path = c && c.attachment_path;
      els.contentAttachmentUpload.toggleAttribute('hidden', !!path);
      els.contentAttachmentFile.value = '';
      if (!path) { els.contentAttachmentCurrent.setAttribute('hidden', ''); return; }
      els.contentAttachmentCurrent.removeAttribute('hidden');
      const { data, error } = await db.storage.from('documents').createSignedUrl(path, 3600);
      els.contentAttachmentLink.href = !error && data ? data.signedUrl : '#';
    }
    function bindContentForm() {
      els.contentPrev.addEventListener('click', () => contentStepMonth(-1));
      els.contentNext.addEventListener('click', () => contentStepMonth(1));
      els.contentToday.addEventListener('click', () => { state.content.anchor = new Date(); contentRenderMonth(); });
      els.contentAddBtn.addEventListener('click', () => contentOpenDay(todayStr()));
      document.querySelectorAll('[data-content-view]').forEach((btn: any) => {
        btn.addEventListener('click', () => contentSetView(btn.dataset.contentView));
      });
      els.contentDayClose.addEventListener('click', contentCloseDay);
      els.contentDayAdd.addEventListener('click', contentStartNew);
      els.contentFormBack.addEventListener('click', contentShowList);
      els.contentAttachmentUploadBtn.addEventListener('click', async () => {
        const dateStr = state.content.currentDay;
        const file = els.contentAttachmentFile.files[0];
        if (!file) { showToast('Choose a file first.'); return; }
        if (!state.editingContentId) { showToast('Save the content first, then attach a file.'); return; }
        els.contentAttachmentUploadBtn.disabled = true;
        const path = `${state.activeGroup}/content/${dateStr}-${Date.now()}-${file.name}`;
        const { error: upErr } = await db.storage.from('documents').upload(path, file);
        if (upErr) { console.error(upErr); showToast('Could not upload.'); els.contentAttachmentUploadBtn.disabled = false; return; }
        const { error } = await db.from('content_items').update({ attachment_path: path }).eq('id', state.editingContentId);
        els.contentAttachmentUploadBtn.disabled = false;
        if (error) { showToast('Could not save attachment.'); return; }
        await loadContent();
        contentRenderAttachment(state.contentItems.find((c: any) => c.id === state.editingContentId));
      });
      els.contentAttachmentRemove.addEventListener('click', async () => {
        if (!state.editingContentId) return;
        const c = state.contentItems.find((x: any) => x.id === state.editingContentId);
        if (!c || !c.attachment_path) return;
        const oldPath = c.attachment_path;
        const { error } = await db.from('content_items').update({ attachment_path: null }).eq('id', state.editingContentId);
        if (error) { showToast('Could not remove attachment.'); return; }
        await db.storage.from('documents').remove([oldPath]);
        await loadContent();
        contentRenderAttachment(null);
      });
      els.contentDelete.addEventListener('click', async () => {
        if (!state.editingContentId) return;
        if (!confirm('Delete this content item?')) return;
        const c = state.contentItems.find((x: any) => x.id === state.editingContentId);
        const { error } = await db.from('content_items').delete().eq('id', state.editingContentId);
        if (error) { showToast('Could not delete.'); return; }
        if (c && c.attachment_path) await db.storage.from('documents').remove([c.attachment_path]);
        const dateStr = state.content.currentDay;
        await loadContent();
        contentRenderDayList(dateStr);
        contentShowList();
      });
      els.contentFormView.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const title = els.contentTitle.value.trim();
        const date = els.contentDate.value;
        if (!title || !date) { showToast('Title and date are required.'); return; }
        const payload: any = {
          title, status: els.contentStatus.value, scheduled_date: date, scheduled_time: els.contentTime.value || null,
          platform: els.contentPlatform.value || null, content_type: els.contentType.value || null,
          assigned_to: els.contentAssigned.value || null, link_url: els.contentLink.value.trim() || null,
          caption: els.contentCaption.value.trim() || null, notes: els.contentNotes.value.trim() || null,
        };
        let error;
        if (state.editingContentId) {
          payload.updated_at = new Date().toISOString();
          ({ error } = await db.from('content_items').update(payload).eq('id', state.editingContentId));
        } else {
          payload.group_key = state.activeGroup;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ error } = await db.from('content_items').insert(payload));
        }
        if (error) { console.error(error); showToast('Could not save content.'); return; }
        await loadContent();
        contentRenderDayList(date);
        contentShowList();
      });
    }

    // ---------- Credentials (Social Media only): plain-text login vault,
    // scoped to this group, masked on-screen with a Reveal/Copy toggle --
    function resetCredForm() {
      state.editingCredentialId = null;
      els.credForm.reset();
      els.credFormTitle.textContent = 'Add a login';
      els.credSubmit.textContent = 'Add login';
      els.credCancel.hidden = true;
