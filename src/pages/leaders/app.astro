          <td data-label="URL">${c.url ? `<a href="${escapeHtml(c.url)}" target="_blank" rel="noopener">${escapeHtml(c.url)}</a>` : '—'}</td>
          <td data-label="Notes">${escapeHtml(c.notes || '—')}</td>
          <td data-label="Added">${c.created_at ? new Date(c.created_at).toLocaleDateString(undefined, { timeZone: 'Asia/Amman' }) : '—'}</td>
          <td data-label="Updated by">${escapeHtml(c.updated_by_name || c.created_by_name || '—')}</td>
          <td class="ws-row-actions">
