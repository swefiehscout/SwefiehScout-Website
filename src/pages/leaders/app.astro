    // One event_costs row always mirrors exactly one finance_entries row
    // (event_cost_id is 1:1, same as maintenance_log_id) — created here,
    // kept in sync on edit, removed by the database cascade on delete.
    async function syncEventCostToFinance(cost: any) {
      const ev = state.events.find((e: any) => e.id === cost.event_id);
      const payload = {
        group_key: state.activeGroup, entry_type: 'expense', category: cost.category,
        amount: Number(cost.amount), entry_date: cost.cost_date,
        description: `${ev ? eventClientName(ev) : 'Event'} — ${cost.description || cost.category}`,
        event_cost_id: cost.id, created_by: state.session.user.id, created_by_name: state.profile?.name || null,
      };
      const { data: existing } = await db.from('finance_entries').select('id').eq('event_cost_id', cost.id).maybeSingle();
      if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
      else await db.from('finance_entries').insert(payload);
    }

    // Up to 3 rows per event (income / wages / transport), told apart by
    // event_entry_kind since — unlike fee_payment_id/maintenance_log_id/
    // event_cost_id — event_id alone isn't a 1:1 key here. Whichever of
    // the 3 no longer applies (e.g. amount cleared, or no one took a
    // car anymore) gets its row removed; the rest are upserted in place.
    async function syncEventToFinance(ev: any) {
      const { wages, transport } = eventPayoutTotals(ev);
      const client = eventClientName(ev);
      const kinds: { kind: string; type: string; category: string; amount: number; description: string }[] = [];
      if (ev.amount_received) kinds.push({ kind: 'income', type: 'income', category: ev.event_type, amount: Number(ev.amount_received), description: `${client}, ${ev.event_date}${ev.payment_method ? ` (${ev.payment_method})` : ''}` });
      if (wages) kinds.push({ kind: 'wages', type: 'expense', category: 'Band Payouts', amount: wages, description: `Band payouts — ${client}, ${ev.event_date}` });
      if (transport) kinds.push({ kind: 'transport', type: 'expense', category: 'Transport', amount: transport, description: `Transport — ${client}, ${ev.event_date}` });
      const activeKinds = new Set(kinds.map((k) => k.kind));
      for (const kind of ['income', 'wages', 'transport']) {
        if (!activeKinds.has(kind)) await db.from('finance_entries').delete().eq('event_id', ev.id).eq('event_entry_kind', kind);
      }
      for (const k of kinds) {
        const payload = {
          group_key: state.activeGroup, entry_type: k.type, category: k.category, amount: k.amount,
          entry_date: ev.event_date, description: k.description, event_id: ev.id, event_entry_kind: k.kind,
          created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        };
        const { data: existing } = await db.from('finance_entries').select('id').eq('event_id', ev.id).eq('event_entry_kind', k.kind).maybeSingle();
        if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
        else await db.from('finance_entries').insert(payload);
      }
      if (state.activeTab === 'finance') await loadFinance();
    }
    function bindEventForm() {
      els.evtPrev.addEventListener('click', () => evtStepMonth(-1));
      els.evtNext.addEventListener('click', () => evtStepMonth(1));
      els.evtToday.addEventListener('click', () => { state.evt.anchor = new Date(); evtRenderMonth(); });
      els.evtAddBtn.addEventListener('click', () => evtOpenDay(todayStr()));
      els.evtDayClose.addEventListener('click', evtCloseDay);
      els.evtDayAdd.addEventListener('click', evtStartNew);
      els.evtFormBack.addEventListener('click', evtShowList);
      els.evtLocation.addEventListener('change', evtToggleLocationCustom);
      els.evtPayRate.addEventListener('input', evtUpdateTransportVisibility);
      els.evtTransportRate.addEventListener('input', evtUpdateTransportVisibility);
      els.evtDelete.addEventListener('click', async () => {
        if (!state.editingEventId) return;
        if (!confirm('Delete this event? Its costs and everything it posted to Finance are removed too.')) return;
        const { error } = await db.from('event_bookings').delete().eq('id', state.editingEventId);
        if (error) { showToast('Could not delete.'); return; }
        const dateStr = state.evt.currentDay;
        await loadEvents();
        evtRenderDayList(dateStr);
        evtShowList();
        if (state.activeTab === 'finance') await loadFinance();
      });
      els.evtCostAdd.addEventListener('click', async () => {
        if (!state.editingEventId) return;
        const category = els.evtCostCategory.value;
        const amount = els.evtCostAmount.value;
        const description = els.evtCostDesc.value.trim();
        const costDate = els.evtCostDate.value || state.evt.currentDay;
        if (!category || !amount) { showToast('Category and amount are required.'); return; }
        const payload: any = { category, amount: Number(amount), description: description || null, cost_date: costDate };
        let cost, error;
        if (state.editingEventCostId) {
          ({ data: cost, error } = await db.from('event_costs').update(payload).eq('id', state.editingEventCostId).select().single());
        } else {
          payload.group_key = state.activeGroup;
          payload.event_id = state.editingEventId;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ data: cost, error } = await db.from('event_costs').insert(payload).select().single());
        }
        if (error) { console.error(error); showToast('Could not save cost.'); return; }
        await syncEventCostToFinance(cost);
        resetEventCostForm();
        await loadEvents();
        evtRenderCosts(state.editingEventId);
        if (state.activeTab === 'finance') await loadFinance();
      });
      els.evtFormView.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const firstName = els.evtFirstName.value.trim();
        const lastName = els.evtLastName.value.trim();
        const phone = els.evtPhone.value.trim();
        const email = els.evtEmail.value.trim();
        const date = els.evtDate.value;
        const time = els.evtTime.value;
        const type = els.evtType.value;
        const location = els.evtLocation.value === EVENT_LOCATION_CUSTOM ? els.evtLocationCustom.value.trim() : els.evtLocation.value;
        const notes = els.evtNotes.value.trim();
        const attendees = evtGetAttendeesFromForm();
        if (!firstName || !lastName || !phone || !date || !type) { showToast('First/last name, phone, date, and event type are required.'); return; }
        const amountRaw = els.evtAmount.value;
        const payRateRaw = els.evtPayRate.value;
        const transportRateRaw = els.evtTransportRate.value;
        // Once the event's own date/time is behind us, it can't be saved
        // in limbo any longer — the amount received has to be filled in
        // (closing it out) before any other change to it is accepted.
        if (!amountRaw && eventDateTimeHasPassed(date, time)) {
          showToast('This event has already happened — enter the amount received to close it out before saving.');
          return;
        }
        const payload: any = {
          event_type: type, first_name: firstName, last_name: lastName, phone, email: email || null,
          event_date: date, event_time: time || null, location: location || null, notes: notes || null,
          attendees, amount_received: amountRaw ? Number(amountRaw) : null,
          payment_method: els.evtPaymentMethod.value || null,
          pay_rate_per_member: payRateRaw ? Number(payRateRaw) : null,
          transport_rate_per_member: transportRateRaw ? Number(transportRateRaw) : null,
        };
        // "Completed by/at" is only ever stamped the moment an amount is
        // actually entered for the first time — editing booking details
        // alone shouldn't claim credit for completing it, and clearing
        // the amount back out un-stamps it.
        const priorEvent = state.editingEventId ? state.events.find((x: any) => x.id === state.editingEventId) : null;
        if (payload.amount_received != null && !priorEvent?.amount_received) {
          payload.completed_by = state.session.user.id;
          payload.completed_by_name = state.profile?.name || null;
          payload.completed_at = new Date().toISOString();
        } else if (payload.amount_received == null) {
          payload.completed_by = null; payload.completed_by_name = null; payload.completed_at = null;
        }
        let savedEvent: any, error;
        if (state.editingEventId) {
          payload.updated_at = new Date().toISOString();
          ({ data: savedEvent, error } = await db.from('event_bookings').update(payload).eq('id', state.editingEventId).select().single());
        } else {
          payload.group_key = state.activeGroup;
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ data: savedEvent, error } = await db.from('event_bookings').insert(payload).select().single());
        }
        if (error) { console.error(error); showToast('Could not save event.'); return; }
        await syncEventToFinance(savedEvent);
        await loadEvents();
        evtRenderDayList(savedEvent.event_date);
        evtShowList();
      });
    }

    // ---------- Vendors (every group has its own, plus a read-only
    // Shared Vendors list — same shape as the Library tab's own
    // Documents/Shared Library split).
    async function loadVendors() {
      if (!state.activeGroup) return;
