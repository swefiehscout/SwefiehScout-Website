    function loadActiveTabData() {
      const tab = state.activeTab;
      if (tab === 'dashboard') loadDashboard();
      if (tab === 'roster' || tab === 'archive') loadRoster();
      if (tab === 'admin') { loadOverview(); loadOverviewFinance(); loadOverviewCurriculum(); loadOverviewLibrary(); loadOverviewRoster(); loadAdmin(); }
      if (tab === 'approvals') loadApprovals();
      if (tab === 'attendance') loadAttendance();
      if (tab === 'fees') loadFees();
      if (tab === 'finance') loadFinance();
      if (tab === 'library') loadLibrary();
      if (tab === 'curriculum') currStart();
    }

    function setTab(tab: any) {
      state.activeTab = tab;
      els.tabs.querySelectorAll('.ws-tab').forEach((b: any) => b.classList.toggle('ws-tab--active', b.dataset.tab === tab));
      document.querySelectorAll('.ws-panel').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.panel !== tab));
      loadActiveTabData();
    }
    function bindTabs() {
      els.tabs.querySelectorAll('.ws-tab').forEach((btn: any) => {
        btn.addEventListener('click', () => setTab(btn.dataset.tab));
      });
    }
    // Whatever number of rows the tab bar needs at the current width, every
    // row should have as close to an equal COUNT of tabs as possible (e.g.
    // 6 + 5, never 7 + 4) — a plain CSS grid/flex wrap just greedily packs
    // each row to capacity instead. Measures how many tabs fit per row at
    // their natural (--ws-tab-ideal) width, then sets a fixed column count
    // that divides the *visible* tab count as evenly as possible across
    // that many rows.
    let tabsResizeTimer: any;
    function balanceTabs() {
      const visible = Array.from(els.tabs.querySelectorAll('.ws-tab')).filter((b: any) => !b.hidden);
      const n = visible.length;
      if (!n) return;
      const prevDisplay = els.tabs.style.display;
      const prevWrap = els.tabs.style.flexWrap;
      const ideal = getComputedStyle(els.tabs).getPropertyValue('--ws-tab-ideal').trim() || '9rem';
      els.tabs.style.display = 'flex';
      els.tabs.style.flexWrap = 'wrap';
      visible.forEach((b: any) => { b.style.flex = `0 1 ${ideal}`; });
      const firstTop = (visible[0] as any).offsetTop;
      let natural = 0;
      for (const b of visible) { if ((b as any).offsetTop === firstTop) natural++; else break; }
      visible.forEach((b: any) => { b.style.flex = ''; });
      els.tabs.style.display = prevDisplay;
      els.tabs.style.flexWrap = prevWrap;

      natural = Math.max(1, Math.min(natural, n));
      const rows = Math.ceil(n / natural);
      const perRow = Math.ceil(n / rows);
      els.tabs.style.setProperty('--ws-tab-cols', String(perRow));
    }
    function bindTabsResize() {
      window.addEventListener('resize', () => {
        clearTimeout(tabsResizeTimer);
        tabsResizeTimer = setTimeout(balanceTabs, 150);
      });
    }

    // ---------- Generic sub-tabs (Finance's Ledger/Categories, Library's
    // Documents/Lessons) — same pattern as Curriculum's Plan/Activity Bank,
    // scoped by a "group" name so unrelated sub-tab sets don't collide.
    function setSubtab(group: string, name: string) {
      document.querySelectorAll(`.ws-subtab[data-subtabs="${group}"]`).forEach((b: any) => b.classList.toggle('ws-subtab--active', b.dataset.subtab === name));
      document.querySelectorAll(`[data-subpanel^="${group}:"]`).forEach((p: any) => p.toggleAttribute('hidden', p.dataset.subpanel !== `${group}:${name}`));
    }
    function bindSubtabs() {
      document.querySelectorAll('.ws-subtab').forEach((btn: any) => {
        btn.addEventListener('click', () => setSubtab(btn.dataset.subtabs, btn.dataset.subtab));
      });
    }

    // ---------- Boot ---------------------------------------------------
    // astro:page-load fires on the very first load AND again after every
    // client-side view-transition back to this page (e.g. a leader clicks
    // a site-nav link like Home, then hits the browser Back button — the
    // header/footer are outside the workspace, always in reach). init()
    // has to re-run then (session may have expired, role/groups may have
    // changed) but must NOT re-bind every listener on top of the ones
    // already bound — these two flags gate just the one-time bindings.
    let boundOnce = false;
    let boundPendingOnce = false;
    async function init() {
      cacheEls();
      if (!supabaseConfigured) { showToast('Not connected to the database.'); return; }

      const session = await getSession();
      if (!session) { window.location.replace('/leaders'); return; }
      if (isSessionExpired()) { await signOut(); window.location.replace('/leaders?expired=1'); return; }
      state.session = session;
      // Kick the leader back to sign-in the moment the 3-hour cap hits,
      // even if this tab is just left open and idle — not only on the
      // next reload.
      setTimeout(async () => {
        await signOut();
        window.location.replace('/leaders?expired=1');
      }, msUntilSessionExpiry());

      const profile = await getProfile(session.user.id);
      if (!profile) { await signOut(); window.location.replace('/leaders'); return; }
      state.profile = profile;

      els.shell.removeAttribute('hidden');

      if (profile.role === 'pending') {
        els.pending.removeAttribute('hidden');
        if (!boundPendingOnce) {
          boundPendingOnce = true;
          els.signoutPending.addEventListener('click', async () => { await signOut(); window.location.replace('/leaders'); });
          const checkBtn = el('[data-ws-check-again]');
          checkBtn.addEventListener('click', async () => {
            checkBtn.disabled = true;
            checkBtn.textContent = 'Checking…';
            const fresh = await getProfile(session.user.id);
            if (fresh && fresh.role !== 'pending') {
              window.location.reload();
              return;
            }
            checkBtn.disabled = false;
            checkBtn.textContent = 'Check again';
            showToast('Still pending — ask an admin to approve you.');
          });
        }
        return;
      }

      els.main.removeAttribute('hidden');
      const initials = profile.name.trim().split(/\s+/).map((w: string) => w[0]).slice(0, 2).join('').toUpperCase();
      els.accountBtn.textContent = initials || '?';
      els.who.innerHTML = `<span class="ws-account-name">${escapeHtml(profile.name)}</span><span class="ws-account-role">${profile.role}</span>`;
      if (profile.role === 'admin') {
        document.querySelectorAll('[data-admin-only]').forEach((elm) => elm.removeAttribute('hidden'));
      }
      // Re-measured every load (not just once) since admin-only visibility
      // — and so the tab count itself — can differ between loads.
      balanceTabs();

      // setupGroups()/renderGroupSwitch() rebuild their own innerHTML (and
      // rebind onto those fresh nodes) every call, so they're always safe
      // to re-run — unlike everything below, which binds directly onto
      // static elements that persist across an astro:page-load re-init.
      setupGroups();

      if (!boundOnce) {
        boundOnce = true;
        els.accountBtn.addEventListener('click', () => {
          els.accountMenu.toggleAttribute('hidden');
        });
        document.addEventListener('click', (e: any) => {
          if (els.accountMenu.hidden) return;
          if (e.target.closest('.ws-account')) return;
          els.accountMenu.setAttribute('hidden', '');
        });
        els.signout.addEventListener('click', async () => { await signOut(); window.location.replace('/leaders'); });

        bindTabs();
        bindTabsResize();
        bindSubtabs();
        bindDashboard();
        bindRosterForm();
        bindFinanceForm();
        bindLibraryUpload();
        bindReports();
        bindTableSearch(els.rosterSearch, els.rosterBody);
        bindTableSearch(els.archiveSearch, els.archiveBody);
        bindTableSearch(els.approvalsSearch, els.approvalsBody);
        bindTableSearch(els.attSearch, els.attBody);
        bindTableSearch(els.feeSearch, els.feeBody);
        currBindStatics();
        bindAttendance();
        els.feeMonth.addEventListener('change', loadFees);
        els.feeYear.addEventListener('change', loadFees);
        els.feeDefault.addEventListener('blur', saveDefaultFee);
        bindSettings();
        els.finMonth.addEventListener('change', loadFinance);
        els.finYear.addEventListener('change', loadFinance);
        els.ovFinMonth.addEventListener('change', loadOverviewFinance);
        els.ovFinYear.addEventListener('change', loadOverviewFinance);
        bindOverviewReports();
        els.ovRosterGroup.addEventListener('change', renderOverviewRoster);
        els.ovRosterStatus.addEventListener('change', renderOverviewRoster);
        bindTableSearch(els.ovRosterSearch, els.ovRosterBody);
      }

      refreshApprovalsBadge();
      setTab('dashboard');
    }

    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
