    // ---------- Public Relations (General only): Sponsors, Contacts,
    // a PR-scoped Library, and their 3 editable category lists ----------
    const DEFAULT_SPONSOR_TYPE_CATEGORIES = ['Financial', 'In-Kind', 'Media', 'Venue', 'Other'];
    const DEFAULT_PR_CONTACT_CATEGORIES = ['Church', 'Community', 'School', 'Media', 'Government', 'Other'];
    const DEFAULT_PR_LIBRARY_CATEGORIES = ['Press Release', 'Media Kit / Photos', 'Sponsorship Agreement', 'Promotional Material', 'Other'];
    async function loadPR() {
      if (!state.activeGroup) return;
      await loadGroupSettings();
      renderPRCategories();
      const [sponsorsRes, contactsRes, docsRes] = await Promise.all([
        db.from('sponsors').select('*').eq('group_key', state.activeGroup).order('name', { ascending: true }),
        db.from('pr_contacts').select('*').eq('group_key', state.activeGroup).order('name', { ascending: true }),
        db.from('documents').select('*').eq('group_key', state.activeGroup).order('uploaded_at', { ascending: false }),
      ]);
      if (sponsorsRes.error || contactsRes.error || docsRes.error) {
        console.error(sponsorsRes.error || contactsRes.error || docsRes.error);
        showToast('Could not load Public Relations.');
        return;
      }
      state.sponsors = sponsorsRes.data || [];
      state.prContacts = contactsRes.data || [];
      state.prDocs = docsRes.data || [];
      renderSponsors();
      renderPrContacts();
      renderPRLibrary();
    }

    // ---- Settings subtab: 3 category lists, same shared renderCategoryList
    // pattern as Inventory/Event Calendar's own Settings subtabs. ----
    function renderPRCategories() {
      renderCategoryList(els.sponsorTypeCatList, state.groupSettings.sponsor_type_categories || [], 'sponsor_type_categories', savePRCategoryList);
      renderCategoryList(els.prcCatList, state.groupSettings.pr_contact_categories || [], 'pr_contact_categories', savePRCategoryList);
      renderCategoryList(els.prlibCatList, state.groupSettings.pr_library_categories || [], 'pr_library_categories', savePRCategoryList);
      updateSponsorTypeOptions();
      updatePrcCategoryOptions();
      updatePrlibCategoryOptions();
    }
    async function savePRCategoryList(field: string, updated: string[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, [field]: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save.'); return; }
      state.groupSettings[field] = updated;
      renderPRCategories();
    }
    function updateSponsorTypeOptions() {
      const list = state.groupSettings?.sponsor_type_categories || [];
      const current = els.sponsorType.value;
      els.sponsorType.innerHTML = '<option value="">— None —</option>'
        + list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
      if (list.includes(current)) els.sponsorType.value = current;
    }
    function updatePrcCategoryOptions() {
      const list = state.groupSettings?.pr_contact_categories || [];
