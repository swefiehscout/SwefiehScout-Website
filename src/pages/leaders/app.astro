---
// Leaders Workspace — the shell. Gated by a real Supabase Auth session
// (not the old shared-password localStorage flag). Tabs: Dashboard,
// Roster, Archive, Approvals, Attendance, Fees, Curriculum (links out to
// the dedicated tool), Finance, Library, Lessons, and (admin only) Admin.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { loadPortalData, TOOL_LABELS } from '../../lib/leader-portal';

// Lessons tab reads the same build-time markdown as the old portal did —
// shared, troop-wide Drive links, not per-group data.
const lessonsData = loadPortalData()['Lessons'] ?? {};
const LESSON_LINKS = Object.entries(lessonsData).map(([key, v]) => ({
  label: TOOL_LABELS[key]?.en ?? key,
  url: v.url,
}));
---
<BaseLayout title="Leaders Workspace" bare wide>
  <div class="ws-shell" data-ws-shell hidden>

    <section class="ws-pending" data-ws-pending hidden>
      <div class="ws-pending-card">
        <h2 class="section-h2">Waiting for approval</h2>
        <p class="ws-pending-text">
          Your account is created — an admin needs to approve you and assign your group before you can get in.
        </p>
        <div class="ws-pending-actions">
          <button type="button" class="btn-primary" data-ws-check-again>Check again</button>
          <button type="button" class="curr-nav-today" data-ws-signout-pending>Sign out</button>
        </div>
      </div>
    </section>

    <div class="ws-main" data-ws-main hidden>
      <header class="ws-header">
        <div class="ws-header-left">
          <img class="ws-logo-mark" src="/images/logo.png" alt="" />
          <span class="ws-logo">Leaders Workspace</span>
        </div>
        <div class="ws-header-right">
          <div class="ws-group-switch" data-ws-group-switch></div>
          <div class="ws-account">
            <button type="button" class="ws-account-btn" data-ws-account-btn></button>
            <div class="ws-account-menu" data-ws-account-menu hidden>
              <div class="ws-account-info" data-ws-who></div>
              <button type="button" class="ws-account-signout" data-ws-signout>Sign out</button>
            </div>
          </div>
        </div>
      </header>

      <nav class="ws-tabs" data-ws-tabs>
        <button type="button" class="ws-tab" data-tab="dashboard"><Icon name="compass" size={16} strokeWidth={1.8} /> Dashboard</button>
        <button type="button" class="ws-tab" data-tab="roster"><Icon name="star" size={16} strokeWidth={1.8} /> Roster</button>
        <button type="button" class="ws-tab" data-tab="archive"><Icon name="fleur" size={16} strokeWidth={1.8} /> Archive</button>
        <button type="button" class="ws-tab" data-tab="approvals"><Icon name="plus" size={16} strokeWidth={1.8} /> Approvals<span class="ws-tab-badge" data-approvals-badge hidden></span></button>
        <button type="button" class="ws-tab" data-tab="attendance"><Icon name="calendar" size={16} strokeWidth={1.8} /> Attendance</button>
        <button type="button" class="ws-tab" data-tab="fees"><Icon name="cash" size={16} strokeWidth={1.8} /> Fees</button>
        <button type="button" class="ws-tab" data-tab="curriculum"><Icon name="flag" size={16} strokeWidth={1.8} /> Curriculum</button>
        <button type="button" class="ws-tab" data-tab="finance"><Icon name="bank" size={16} strokeWidth={1.8} /> Finance</button>
        <button type="button" class="ws-tab" data-tab="library"><Icon name="diamond" size={16} strokeWidth={1.8} /> Library</button>
        <button type="button" class="ws-tab" data-tab="reports"><Icon name="envelope" size={16} strokeWidth={1.8} /> Reports</button>
        <button type="button" class="ws-tab" data-tab="admin" data-admin-only hidden><Icon name="pin" size={16} strokeWidth={1.8} /> Admin</button>
      </nav>

      <div class="ws-panels">
        <section class="ws-panel" data-panel="dashboard">
          <div class="ws-stat-row" data-ws-stats></div>
          <p class="ws-soon">Attendance rates, fee-collection %, and curriculum progress will show up here as those tabs go live.</p>
        </section>

        <section class="ws-panel" data-panel="roster" hidden>
          <form class="ws-member-form" data-roster-form>
            <div class="ws-member-form-bar" aria-hidden="true"></div>
            <p class="ws-member-form-title" data-member-form-title>Add a member</p>

            <div class="ws-form-grid ws-form-grid--4">
              <label class="ws-field">
                <span>Full name *</span>
                <input type="text" data-m-name required />
              </label>
              <label class="ws-field">
                <span>Date of birth</span>
                <input type="date" data-m-dob />
              </label>
              <label class="ws-field">
                <span>Guardian 1 relation *</span>
                <select data-m-g1-rel required>
                  <option value="">Select…</option>
                  <option>Mother</option>
                  <option>Father</option>
                  <option>Other</option>
                </select>
              </label>
              <label class="ws-field">
                <span>Guardian 1 phone *</span>
                <input type="tel" data-m-g1-phone required />
              </label>
            </div>

            <div class="ws-form-grid">
              <div class="ws-optional-block" data-g2-block>
                <button type="button" class="ws-add-link" data-g2-add>+ Add second guardian</button>
                <div class="ws-optional-fields" data-g2-fields hidden>
                  <div class="ws-form-grid">
                    <label class="ws-field">
                      <span>Guardian 2 relation</span>
                      <select data-m-g2-rel>
                        <option value="">Select…</option>
                        <option>Mother</option>
                        <option>Father</option>
                        <option>Other</option>
                      </select>
                    </label>
                    <label class="ws-field">
                      <span>Guardian 2 phone</span>
                      <input type="tel" data-m-g2-phone />
                    </label>
                  </div>
                  <button type="button" class="ws-remove-link" data-g2-remove>Remove</button>
                </div>
              </div>

              <div class="ws-optional-block" data-allergy-block>
                <button type="button" class="ws-add-link" data-allergy-add>+ Add allergy info</button>
                <div class="ws-optional-fields" data-allergy-fields hidden>
                  <label class="ws-field">
                    <span>What allergy?</span>
                    <input type="text" data-m-allergy-detail placeholder="e.g. peanuts" />
                  </label>
                  <button type="button" class="ws-remove-link" data-allergy-remove>Remove</button>
                </div>
              </div>
            </div>

            <label class="ws-field ws-field--full">
              <span>Notes</span>
              <textarea data-m-notes rows="1"></textarea>
            </label>

            <div class="ws-form-actions">
              <button type="submit" class="btn-primary" data-member-form-submit>Add member</button>
              <button type="button" class="ws-form-cancel" data-member-form-cancel hidden>Cancel edit</button>
            </div>
          </form>

          <input type="search" class="ws-search" data-roster-search placeholder="Search members…" />
          <div class="ws-table-wrap">
            <table class="ws-table" data-roster-table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Guardian 1</th>
                  <th>Allergies</th>
                  <th></th>
                </tr>
              </thead>
              <tbody data-roster-body></tbody>
            </table>
          </div>
        </section>

        <section class="ws-panel" data-panel="archive" hidden>
          <p class="ws-soon" data-archive-hint>
            Archived members are hidden from Attendance and Fees going forward, but every past record tied to
            them (attendance history, fee payments) stays exactly as it was — nothing is deleted or recalculated.
            Restore someone here any time to bring them back into the active roster. Anyone with no recorded
            attendance for 3+ months gets archived automatically (marked "Auto-archived" below).
          </p>
          <input type="search" class="ws-search" data-archive-search placeholder="Search members…" />
          <div class="ws-table-wrap">
            <table class="ws-table" data-archive-table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Guardian 1</th>
                  <th>Allergies</th>
                  <th></th>
                </tr>
              </thead>
              <tbody data-archive-body></tbody>
            </table>
          </div>
        </section>

        <section class="ws-panel" data-panel="approvals" hidden>
          <p class="ws-soon">
            Anyone can submit a request at <strong>/join</strong> without an account. Approving one adds them
            straight to this group's active roster; rejecting just declines it — nothing is created either way
            until you act.
          </p>
          <input type="search" class="ws-search" data-approvals-search placeholder="Search requests…" />
          <div class="ws-table-wrap">
            <table class="ws-table" data-approvals-table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Guardian 1</th>
                  <th>Allergies</th>
                  <th>Notes</th>
                  <th></th>
                </tr>
              </thead>
              <tbody data-approvals-body></tbody>
            </table>
          </div>
        </section>

        <section class="ws-panel" data-panel="attendance" hidden>
          <div class="ws-att-layout">
            <div class="ws-att-calendar">
              <div class="curr-nav">
                <button type="button" class="curr-nav-btn" data-att-prev aria-label="Previous month">‹</button>
                <button type="button" class="curr-nav-btn" data-att-next aria-label="Next month">›</button>
              </div>
              <p class="curr-nav-label" data-att-month-label></p>
              <div class="curr-weekday-row" data-att-weekday-row></div>
              <div class="curr-month-cells" data-att-calendar></div>
            </div>
            <div class="ws-att-list">
              <div class="ws-att-date-banner">
                <button type="button" class="ws-att-day-nav" data-att-day-prev aria-label="Previous day">‹</button>
                <span class="ws-att-date-banner-text">
                  <span class="ws-att-date-banner-label">Taking attendance for</span>
                  <p class="ws-att-date-banner-value" data-att-date-label></p>
                </span>
                <button type="button" class="ws-att-day-nav" data-att-day-next aria-label="Next day">›</button>
                <span class="ws-inline-summary" data-att-summary></span>
              </div>
              <p class="ws-att-hint">Click any date on the calendar — past or future — to view or edit it.</p>
              <input type="search" class="ws-search" data-att-search placeholder="Search members…" />
              <div class="ws-table-wrap">
                <table class="ws-table" data-att-table>
                  <thead>
                    <tr><th>Name</th><th>Present</th><th>Note</th></tr>
                  </thead>
                  <tbody data-att-body></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="fees" hidden>
          <div class="ws-toolbar-row">
            <label class="ws-field ws-field--inline">
              <span>Month</span>
              <select data-fee-month></select>
            </label>
            <label class="ws-field ws-field--inline">
              <span>Year</span>
              <select data-fee-year></select>
            </label>
            <label class="ws-field ws-field--inline">
              <span>Default fee this month</span>
              <input type="number" step="0.01" min="0" data-fee-default placeholder="0.00" />
            </label>
            <span class="ws-inline-summary" data-fee-summary></span>
          </div>
          <input type="search" class="ws-search" data-fee-search placeholder="Search members…" />
          <div class="ws-table-wrap">
            <table class="ws-table" data-fee-table>
              <thead>
                <tr><th>Name</th><th>Paid</th><th>Amount</th><th>Paid on</th></tr>
              </thead>
              <tbody data-fee-body></tbody>
            </table>
          </div>
        </section>

        <section class="ws-panel" data-panel="curriculum" hidden>
          <div class="curr-subtabs" data-curr-subtabs>
            <button type="button" class="curr-subtab curr-subtab--active" data-subtab="plan">Plan</button>
            <button type="button" class="curr-subtab" data-subtab="bank">Activity Bank</button>
          </div>

          <div data-curr-subpanel="plan">
            <div class="curr-toolbar">
              <div class="curr-toolbar-row">
                <div class="curr-nav">
                  <button type="button" class="curr-nav-btn" data-curr-prev aria-label="Previous month">‹</button>
                  <button type="button" class="curr-nav-today" data-curr-today>Today</button>
                  <button type="button" class="curr-nav-btn" data-curr-next aria-label="Next month">›</button>
                </div>
                <span class="curr-nav-label" data-curr-nav-label></span>
                <span class="ws-save-indicator" data-curr-save-indicator hidden>Saved ✓</span>
                <button type="button" class="btn-primary curr-export" data-curr-export>Export PDF</button>
              </div>
            </div>
            <p class="ws-att-hint">Click any date to plan that meeting.</p>

            <div class="curr-view curr-view--month" data-curr-month>
              <div class="curr-month-grid" data-curr-month-grid></div>
            </div>
          </div>

          <div data-curr-subpanel="bank" hidden>
            <form class="ws-member-form" data-bank-add-form>
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Add to the activity bank</p>
              <label class="ws-field">
                <span>Name *</span>
                <input type="text" data-bank-add-en required />
              </label>
              <div class="ws-form-actions">
                <button type="submit" class="btn-primary">Add to bank</button>
              </div>
            </form>
            <p class="ws-soon">
              These show up as draggable chips for everyone leading this group in the Plan tab. Removing one here
              doesn't change any meeting that already used it.
            </p>
            <div class="curr-bank-list" data-curr-bank-list></div>
          </div>
        </section>

        <section class="ws-panel" data-panel="finance" hidden>
          <div class="ws-subtabs">
            <button type="button" class="ws-subtab ws-subtab--active" data-subtabs="finance" data-subtab="ledger">Ledger</button>
            <button type="button" class="ws-subtab" data-subtabs="finance" data-subtab="categories">Categories</button>
          </div>

          <div data-subpanel="finance:ledger">
            <form class="ws-member-form" data-fin-form>
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Add an entry</p>
              <div class="ws-form-grid ws-form-grid--4">
                <label class="ws-field">
                  <span>Type *</span>
                  <select data-fin-type required>
                    <option value="expense" selected>Expense</option>
                    <option value="income">Income</option>
                  </select>
                </label>
                <label class="ws-field">
                  <span>Category</span>
                  <select data-fin-category></select>
                </label>
                <label class="ws-field">
                  <span>Amount *</span>
                  <input type="number" step="0.01" min="0" data-fin-amount required />
                </label>
                <label class="ws-field">
                  <span>Date *</span>
                  <input type="date" data-fin-date required />
                </label>
              </div>
              <div class="ws-form-grid">
                <label class="ws-field ws-field--full">
                  <span>Description</span>
                  <input type="text" data-fin-description />
                </label>
                <label class="ws-field">
                  <span>Receipt (optional)</span>
                  <input type="file" accept="image/*,.pdf" data-fin-receipt />
                </label>
              </div>
              <div class="ws-form-actions">
                <button type="submit" class="btn-primary" data-fin-submit>Add entry</button>
              </div>
            </form>

            <div class="ws-toolbar-row">
              <label class="ws-field ws-field--inline">
                <span>Month</span>
                <select data-fin-month></select>
              </label>
              <label class="ws-field ws-field--inline">
                <span>Year</span>
                <select data-fin-year></select>
              </label>
            </div>
            <div class="ws-stat-row ws-stat-row--3" data-fin-stats></div>

            <div class="ws-statement" data-fin-statement></div>

            <h3 class="ws-admin-h3">Transactions</h3>
            <div class="ws-table-wrap">
              <table class="ws-table" data-fin-table>
                <thead>
                  <tr><th>Date</th><th>Type</th><th>Category</th><th>Description</th><th>Amount</th><th>Receipt</th><th></th></tr>
                </thead>
                <tbody data-fin-body></tbody>
              </table>
            </div>
          </div>

          <div data-subpanel="finance:categories" hidden>
            <p class="ws-soon">
              The default monthly fee lives on the Fees tab now (it can change month to month) — these lists are
              for things that apply to every month, shared across all groups.
            </p>
            <div class="ws-form-grid">
              <div class="ws-member-form">
                <div class="ws-member-form-bar" aria-hidden="true"></div>
                <p class="ws-member-form-title">Expense categories</p>
                <div class="ws-category-add">
                  <input type="text" data-settings-expense-input placeholder="e.g. Supplies" />
                  <button type="button" class="btn-primary" data-settings-expense-add>Add</button>
                </div>
                <div class="ws-category-list" data-settings-expense-list></div>
              </div>
              <div class="ws-member-form">
                <div class="ws-member-form-bar" aria-hidden="true"></div>
                <p class="ws-member-form-title">Income categories</p>
                <div class="ws-category-add">
                  <input type="text" data-settings-income-input placeholder="e.g. Donations" />
                  <button type="button" class="btn-primary" data-settings-income-add>Add</button>
                </div>
                <div class="ws-category-list" data-settings-income-list></div>
              </div>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="library" hidden>
          <div class="ws-subtabs">
            <button type="button" class="ws-subtab ws-subtab--active" data-subtabs="library" data-subtab="documents">Documents</button>
            <button type="button" class="ws-subtab" data-subtabs="library" data-subtab="lessons">Lessons</button>
          </div>

          <div data-subpanel="library:documents">
            <div class="ws-member-form ws-library-upload">
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Upload a document</p>
              <div class="ws-form-grid">
                <label class="ws-field">
                  <span>File *</span>
                  <input type="file" data-lib-file />
                </label>
                <label class="ws-field">
                  <span>Title (optional)</span>
                  <input type="text" data-lib-title placeholder="Defaults to the file name" />
                </label>
              </div>
              <div class="ws-form-actions">
                <button type="button" class="btn-primary" data-lib-upload>Upload</button>
              </div>
            </div>
            <div class="ws-table-wrap">
              <table class="ws-table" data-lib-table>
                <thead>
                  <tr><th>Title</th><th>Type</th><th>Uploaded</th><th></th></tr>
                </thead>
                <tbody data-lib-body></tbody>
              </table>
            </div>
          </div>

          <div data-subpanel="library:lessons" hidden>
            <div class="ws-table-wrap">
              <table class="ws-table" data-lessons-table>
                <thead><tr><th>Resource</th><th></th></tr></thead>
                <tbody>
                  {LESSON_LINKS.map((l) => (
                    <tr>
                      <td>{l.label}</td>
                      <td class="ws-row-actions">
                        {l.url
                          ? <a class="ws-edit-btn" href={l.url} target="_blank" rel="noopener">Open →</a>
                          : <span class="ws-empty" style="padding:0">Not linked yet</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="reports" hidden>
          <div class="ws-toolbar-row">
            <label class="ws-field ws-field--inline">
              <span>Month</span>
              <select data-report-month></select>
            </label>
            <label class="ws-field ws-field--inline">
              <span>Year</span>
              <select data-report-year></select>
            </label>
          </div>
          <div class="ws-report-grid">
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Income Statement</h3>
              <p class="ws-report-desc">Income and expenses by category, with totals and net income.</p>
              <button type="button" class="btn-primary" data-report-finance>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Monthly Fees</h3>
              <p class="ws-report-desc">Every active member's paid status and amount for the period.</p>
              <button type="button" class="btn-primary" data-report-fees>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Attendance</h3>
              <p class="ws-report-desc">Every active member's attendance count and rate for the period.</p>
              <button type="button" class="btn-primary" data-report-attendance>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Curriculum</h3>
              <p class="ws-report-desc">The meeting plan — theme, notes, and activities for each date in the period.</p>
              <button type="button" class="btn-primary" data-report-curriculum>Download PDF</button>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="admin" hidden>
          <h3 class="ws-admin-h3">Leaders</h3>
          <div class="ws-table-wrap">
            <table class="ws-table" data-admin-table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Role</th>
                  <th>Groups</th>
                  <th></th>
                </tr>
              </thead>
              <tbody data-admin-body></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Curriculum day planner — centered popup, opened by clicking a date -->
  <div class="curr-day-overlay" data-curr-day-overlay hidden>
    <div class="curr-day-panel" data-curr-day-panel>
      <div class="curr-day-banner">
        <button type="button" class="curr-day-nav-btn" data-curr-day-prev aria-label="Previous day">‹</button>
        <span class="curr-day-banner-text">
          <span class="curr-day-banner-label">Planning for</span>
          <p class="curr-day-banner-value" data-curr-day-header></p>
        </span>
        <button type="button" class="curr-day-nav-btn" data-curr-day-next aria-label="Next day">›</button>
      </div>

      <label class="curr-day-field">
        <span>Theme</span>
        <input type="text" data-day-theme placeholder="e.g. First Aid Badge" />
      </label>
      <label class="curr-day-field">
        <span>Notes</span>
        <textarea data-day-notes rows="2" placeholder="Anything to remember for this meeting…"></textarea>
      </label>

      <p class="curr-day-section-label">Select from the activity bank</p>
      <div class="curr-bank-chips" data-curr-bank-chips></div>

      <p class="curr-day-section-label">Or add a custom activity</p>
      <form class="curr-day-custom-add" data-curr-custom-add-form>
        <input type="text" data-custom-en placeholder="Type an activity…" />
        <button type="submit" class="btn-primary">Add</button>
      </form>

      <p class="curr-day-section-label">This meeting</p>
      <div class="curr-day-list" data-curr-day-list></div>

      <div class="curr-day-actions">
        <button type="button" class="ws-form-cancel" data-curr-day-close-cancel>Cancel</button>
        <button type="button" class="btn-primary" data-curr-day-save>Save &amp; close</button>
      </div>
    </div>
  </div>

  <script>
    import { supabase, supabaseConfigured, getSession, getProfile, signOut } from '../../lib/workspace/auth';
    import jsPDF from 'jspdf';
    import autoTable from 'jspdf-autotable';
    import { GROUPS, MONTHS, WEEKDAYS, ACTIVITY_BANK } from '../../lib/curriculum/constants';

    // Loose alias for actual query calls below — supabaseConfigured is
    // checked once in init() before any of this runs, so by the time these
    // are called it's never actually null; this just avoids sprinkling
    // non-null assertions through every single query call.
    const db: any = supabase;

