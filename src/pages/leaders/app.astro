    async function archiveMember(id: string) {
      if (!confirm('Archive this member? They\'ll disappear from Attendance and Fees going forward, but nothing already recorded for them changes. You can restore them any time from the Archive tab.')) return;
      const { error } = await db.from('members').update({ active: false, archived_reason: null }).eq('id', id);
      if (error) { showToast('Could not archive.'); return; }
      if (state.editingMemberId === id) resetMemberForm();
      await loadRoster();
    }
    async function restoreMember(id: string) {
      const { error } = await db.from('members').update({ active: true, archived_reason: null }).eq('id', id);
      if (error) { showToast('Could not restore.'); return; }
      await loadRoster();
    }
    // Anyone active for 3+ months with zero "present" attendance in that
    // window gets archived automatically, tagged so Archive can show why.
    async function autoArchiveInactive() {
      if (!state.activeGroup) return;
      const cutoff = new Date();
      cutoff.setMonth(cutoff.getMonth() - 3);
      const cutoffStr = toDateStr(cutoff);
      const candidates = state.members.filter((m: any) => m.active && (!m.created_at || m.created_at.slice(0, 10) <= cutoffStr));
      if (!candidates.length) return;
      const { data, error } = await db.from('attendance').select('member_id')
        .eq('group_key', state.activeGroup).eq('present', true).gte('date', cutoffStr);
      if (error) { console.error(error); return; }
      const attendedRecently = new Set((data || []).map((r: any) => r.member_id));
      const toArchive = candidates.filter((m: any) => !attendedRecently.has(m.id));
      if (!toArchive.length) return;
      await Promise.all(toArchive.map((m: any) =>
        db.from('members').update({ active: false, archived_reason: 'inactive' }).eq('id', m.id)
      ));
      toArchive.forEach((m: any) => { m.active = false; m.archived_reason = 'inactive'; });
      showToast(`${toArchive.length} member${toArchive.length === 1 ? '' : 's'} auto-archived, no attendance in 3+ months.`);
    }
    async function deleteMemberForever(id: string) {
      if (!confirm('Permanently delete this member? This also deletes their attendance/fee history, this cannot be undone. Archiving is usually what you want instead.')) return;
      const { error } = await db.from('members').delete().eq('id', id);
      if (error) { showToast('Could not delete.'); return; }
      if (state.editingMemberId === id) resetMemberForm();
      await loadRoster();
    }

    function renderRoster() {
      const active = state.members.filter((m: any) => m.active);
      if (!active.length) {
        els.rosterBody.innerHTML = '<tr><td colspan="10" class="ws-empty">No members yet, add the first one below.</td></tr>';
        return;
      }
      els.rosterBody.innerHTML = active.map((m: any) => memberRowHTML(m, `
        <button type="button" class="ws-edit-btn" data-edit-member>Edit</button>
        <button type="button" class="ws-edit-btn" data-archive-member>Archive</button>
        <button type="button" class="ws-row-del" data-del-member title="Delete permanently">×</button>
      `)).join('');

      els.rosterBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.memberId;
        row.querySelector('[data-edit-member]').addEventListener('click', () => startEditMember(id));
        row.querySelector('[data-archive-member]').addEventListener('click', () => archiveMember(id));
        row.querySelector('[data-del-member]').addEventListener('click', () => deleteMemberForever(id));
      });
    }

    function renderArchive() {
      const archived = state.members.filter((m: any) => !m.active);
      if (!archived.length) {
        els.archiveBody.innerHTML = '<tr><td colspan="10" class="ws-empty">No archived members.</td></tr>';
        return;
      }
      els.archiveBody.innerHTML = archived.map((m: any) => memberRowHTML(m, `
        <button type="button" class="ws-edit-btn" data-edit-member>Edit</button>
        <button type="button" class="ws-edit-btn" data-restore-member>Restore</button>
        <button type="button" class="ws-row-del" data-del-member title="Delete permanently">×</button>
      `)).join('');

      els.archiveBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.memberId;
        row.querySelector('[data-edit-member]').addEventListener('click', () => startEditMember(id));
        row.querySelector('[data-restore-member]').addEventListener('click', () => restoreMember(id));
        row.querySelector('[data-del-member]').addEventListener('click', () => deleteMemberForever(id));
      });
    }

