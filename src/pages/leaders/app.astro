    async function approveRequest(id: string) {
      const r = state.approvals.find((x: any) => x.id === id);
      if (!r) return;
      const { error: insertError } = await db.from('members').insert({
        group_key: r.group_key,
        full_name: r.full_name,
        birth_date: r.birth_date,
        guardian1_relation: r.guardian1_relation,
        guardian1_phone: r.guardian1_phone,
        guardian2_relation: r.guardian2_relation,
        guardian2_phone: r.guardian2_phone,
        has_allergies: r.has_allergies,
        allergy_detail: r.allergy_detail,
        notes: r.notes,
        created_by: state.session.user.id,
      });
      if (insertError) { console.error(insertError); showToast('Could not approve — member was not added.'); return; }
      const { error: updateError } = await db.from('join_requests')
        .update({ status: 'approved', reviewed_by: state.session.user.id, reviewed_at: new Date().toISOString() })
        .eq('id', id);
      if (updateError) console.error(updateError);
      showToast(`${r.full_name} added to the roster.`);
      await loadApprovals();
      await refreshApprovalsBadge();
      if (state.activeTab === 'roster') await loadRoster();
