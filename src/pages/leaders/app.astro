    // ---------- Overview (admin-only): every group rolled up together ------
    // One query per table, unfiltered by group — admins already have
    // has_group_access() on every group, so a single unscoped select pulls
    // every group's rows in one round trip instead of five (one per
    // group), then buckets them client-side by group_key.
    async function loadOverview() {
      const now = new Date();
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthEnd = `${period}-${String(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const day30 = toDateStr(addDays(now, -30));
      const day60 = toDateStr(addDays(now, -60));

      const [membersRes, attRes, feeRes, finRes, pendingRes] = await Promise.all([
        db.from('members').select('group_key, active, has_allergies'),
        db.from('attendance').select('group_key, present, date').gte('date', day60),
        db.from('fee_payments').select('group_key, paid, amount').eq('period', period),
        db.from('finance_entries').select('group_key, entry_type, amount, entry_date').gte('entry_date', `${prevPeriod}-01`).lte('entry_date', monthEnd),
        db.from('join_requests').select('id', { count: 'exact', head: true }).eq('status', 'pending'),
      ]);

      const byGroup = new Map<string, any>();
      GROUPS.forEach((g) => byGroup.set(g.key, {
        activeMembers: 0, archivedMembers: 0, allergyMembers: 0,
        attPresent30: 0, attTotal30: 0, attPresent3060: 0, attTotal3060: 0,
        feePaid: 0, feeCollected: 0, netThis: 0, netPrev: 0,
      }));
      (membersRes.data || []).forEach((m: any) => {
        const b = byGroup.get(m.group_key); if (!b) return;
        if (m.active) { b.activeMembers++; if (m.has_allergies) b.allergyMembers++; }
        else b.archivedMembers++;
      });
      (attRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.date >= day30) { b.attTotal30++; if (r.present) b.attPresent30++; }
        else { b.attTotal3060++; if (r.present) b.attPresent3060++; }
      });
      (feeRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.paid) { b.feePaid++; b.feeCollected += Number(r.amount || 0); }
      });
      (finRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        const amt = r.entry_type === 'income' ? Number(r.amount) : -Number(r.amount);
        if (r.entry_date >= `${period}-01`) b.netThis += amt; else b.netPrev += amt;
      });
      renderOverview(byGroup, pendingRes.count || 0);
    }
    function renderOverview(byGroup: Map<string, any>, pendingApprovals: number) {
      const groups = GROUPS.map((g) => ({ ...g, ...byGroup.get(g.key) }));
      const totalActive = groups.reduce((s, g) => s + g.activeMembers, 0);
      const totalArchived = groups.reduce((s, g) => s + g.archivedMembers, 0);
      const totalAllergy = groups.reduce((s, g) => s + g.allergyMembers, 0);
      const attPresent30 = groups.reduce((s, g) => s + g.attPresent30, 0);
      const attTotal30 = groups.reduce((s, g) => s + g.attTotal30, 0);
      const attPresent3060 = groups.reduce((s, g) => s + g.attPresent3060, 0);
      const attTotal3060 = groups.reduce((s, g) => s + g.attTotal3060, 0);
      const rate30 = attTotal30 ? Math.round((attPresent30 / attTotal30) * 100) : null;
      const ratePrev30 = attTotal3060 ? Math.round((attPresent3060 / attTotal3060) * 100) : null;
      const totalFeePaid = groups.reduce((s, g) => s + g.feePaid, 0);
      const totalCollected = groups.reduce((s, g) => s + g.feeCollected, 0);
      const feePct = totalActive ? Math.round((totalFeePaid / totalActive) * 100) : 0;
      const netThis = groups.reduce((s, g) => s + g.netThis, 0);
      const netPrev = groups.reduce((s, g) => s + g.netPrev, 0);
      const retentionPct = (totalActive + totalArchived) ? Math.round((totalActive / (totalActive + totalArchived)) * 100) : null;
      const allergyPct = totalActive ? Math.round((totalAllergy / totalActive) * 100) : 0;
      const groupsFullyPaid = groups.filter((g) => g.activeMembers > 0 && g.feePaid === g.activeMembers).length;
      const largestGroup = groups.reduce((max, g) => (g.activeMembers > max.activeMembers ? g : max), groups[0]);
      const largestSharePct = totalActive ? Math.round((largestGroup.activeMembers / totalActive) * 100) : 0;
      const avgPerGroup = (totalActive / GROUPS.length).toFixed(1);
      const avgFeeAmount = totalFeePaid ? totalCollected / totalFeePaid : 0;

      els.ovRatios.innerHTML = `
        <div class="ws-stat"><span class="ws-stat-icon">#</span><span class="ws-stat-text"><span class="ws-stat-num">${avgPerGroup}</span><span class="ws-stat-label">Avg members / group</span></span></div>
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">▲</span><span class="ws-stat-text"><span class="ws-stat-num">${largestSharePct}%</span><span class="ws-stat-label">Largest group: ${escapeHtml(largestGroup.en)}</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">$</span><span class="ws-stat-text"><span class="ws-stat-num">${avgFeeAmount.toFixed(2)}</span><span class="ws-stat-label">Avg fee collected / member</span></span></div>
      `;

      els.ovKpis.innerHTML = `
        <div class="ws-dash-kpi">
