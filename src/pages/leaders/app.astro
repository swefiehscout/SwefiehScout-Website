    function renderScRequests() {
      const openCount = state.scRequests.filter((r: any) => r.status === 'open').length;
      els.scRequestsBadge.textContent = String(openCount);
      els.scRequestsBadge.toggleAttribute('hidden', !openCount);
      els.scRequestsBody.innerHTML = state.scRequests.length ? state.scRequests.map((r: any) => `
        <tr data-sc-request-id="${r.id}">
          <td data-label="Entry">${escapeHtml(r.shared_calendar_events?.title || '(deleted)')}</td>
          <td data-label="Date">${r.shared_calendar_events?.event_date || '—'}</td>
          <td data-label="Message">${escapeHtml(r.message)}</td>
          <td data-label="Requested by">${escapeHtml(r.requested_by_name || '—')}</td>
          <td data-label="Status">${r.status === 'open' ? '<span class="ws-badge ws-badge--fair">Open</span>' : '<span class="ws-badge ws-badge--good">Resolved</span>'}</td>
          <td class="ws-row-actions">${r.status === 'open' ? '<button type="button" class="ws-edit-btn" data-sc-resolve>Mark resolved</button>' : ''}</td>
        </tr>
      `).join('') : '<tr><td colspan="7" class="ws-empty">No change requests.</td></tr>';
      els.scRequestsBody.querySelectorAll('[data-sc-resolve]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.closest('tr').dataset.scRequestId;
          const { error } = await db.from('shared_calendar_change_requests')
            .update({ status: 'resolved', resolved_at: new Date().toISOString(), resolved_by_name: state.profile?.name || null })
            .eq('id', id);
          if (error) { console.error(error); showToast('Could not resolve the request.'); return; }
          await loadScRequests();
        });
      });
    }
    async function scRequestChange(eventId: string) {
      const message = prompt('What should change about this entry?');
      if (!message || !message.trim()) return;
      const { error } = await db.from('shared_calendar_change_requests').insert({
