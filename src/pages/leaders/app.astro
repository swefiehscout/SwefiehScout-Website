              </div>
              <div class="ws-member-form">
                <div class="ws-member-form-bar" aria-hidden="true"></div>
                <p class="ws-member-form-title">Library categories</p>
                <div class="ws-category-add">
                  <input type="text" data-prlib-cat-input placeholder="e.g. Press Release" />
                  <button type="button" class="btn-primary" data-prlib-cat-add>Add</button>
                </div>
                <div class="ws-category-list" data-prlib-cat-list></div>
              </div>
            </div>
          </div>
        </section>

        <section class="ws-panel" data-panel="content" hidden>
          <div class="ws-subtabs">
            <button type="button" class="ws-subtab ws-subtab--active" data-subtabs="content" data-subtab="items">Content</button>
            <button type="button" class="ws-subtab" data-subtabs="content" data-subtab="settings">Settings</button>
          </div>

          <div data-subpanel="content:items">
            <div class="curr-toolbar">
              <div class="curr-toolbar-row">
