    function bindRosterForm() {
      els.g2Add.addEventListener('click', () => showG2());
      els.g2Remove.addEventListener('click', () => hideG2());
      els.allergyAdd.addEventListener('click', () => showAllergy());
      els.allergyRemove.addEventListener('click', () => hideAllergy());
      els.emailAdd.addEventListener('click', () => showEmail());
      els.emailRemove.addEventListener('click', () => hideEmail());
      els.nidAdd.addEventListener('click', () => showNid());
      els.nidRemove.addEventListener('click', () => hideNid());
      els.formCancel.addEventListener('click', resetMemberForm);
      els.rosterForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const payload = readMemberForm();
        if (!payload) { showToast('Full name is required.'); return; }
        // Belt-and-braces against double submits (a slow connection makes
        // "did that go through?" double-clicks common) — those send two
        // inserts back to back and are the easiest way to reproduce the
        // member_code race below on their own.
        els.formSubmit.disabled = true;
        try {
          if (state.editingMemberId) {
            const { error } = await db.from('members').update(payload).eq('id', state.editingMemberId);
            if (error) { console.error(error); showToast('Could not save, ' + (error.message || 'unknown error') + '.'); return; }
          } else {
            // member_code is auto-assigned server-side (next free "TGOS&G-####"
            // in the shared pool, see member_ids_schema.sql) by picking the
            // smallest number not currently in use — two leaders (or two
            // troops) adding a member within the same instant can both land
            // on that same number before either row is visible to the other,
            // so the insert fails with a 23505 unique_violation on
            // members_member_code_key. That's a transient collision, not a
            // real problem — each retry recomputes against whatever's now
            // committed. A single retry turned out not to be enough during
            // a burst of several leaders adding at once, hence a few
            // attempts with a short random backoff so they don't just
            // re-collide with each other again immediately.
            let error;
            for (let attempt = 0; attempt < 5; attempt++) {
              error = (await db.from('members').insert({ ...payload, created_by: state.session.user.id })).error;
              if (!error || error.code !== '23505' || !(error.message || '').includes('member_code')) break;
              await new Promise((r) => setTimeout(r, 150 + Math.random() * 250));
            }
            if (error) { console.error(error); showToast('Could not add, ' + (error.message || 'unknown error') + '.'); return; }
          }
          resetMemberForm();
          await loadRoster();
        } finally {
          els.formSubmit.disabled = false;
        }
      });
    }

    // ---------- Dashboard ---------------------------------------------------
    function dashGreeting() {
      const h = new Date().getHours();
      const first = (state.profile?.name || '').trim().split(/\s+/)[0];
      const time = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
      return first ? `${time}, ${first}` : time;
    }
    function dashDeltaBadge(val: number | null, suffix = ''): string {
      if (val == null || Number.isNaN(val) || val === 0) {
        return `<span class="ws-dash-delta ws-dash-delta--flat">– steady</span>`;
      }
      const up = val > 0;
      return `<span class="ws-dash-delta ${up ? 'ws-dash-delta--up' : 'ws-dash-delta--down'}">${up ? '↑' : '↓'} ${Math.abs(val)}${suffix} vs last period</span>`;
    }
    async function loadDashboard() {
      if (!state.activeGroup) return;
      await ensureMembersLoaded();
      await loadGroupSettings();

      const g = GROUPS.find((x: any) => x.key === state.activeGroup);
      els.dashGreeting.textContent = dashGreeting();
      els.dashGroup.textContent = g ? `${g.en} workspace` : 'Your workspace';
      els.dashDate.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

      const active = state.members.filter((m: any) => m.active);
      const archivedCount = state.members.length - active.length;
      const allergyCount = active.filter((m: any) => m.has_allergies).length;

      const now = new Date();
      const day30 = toDateStr(addDays(now, -30));
      const day60 = toDateStr(addDays(now, -60));
      const day90 = toDateStr(addDays(now, -90));
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthEnd = `${period}-${String(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const prevMonthEnd = `${prevPeriod}-${String(new Date(prevD.getFullYear(), prevD.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      // Six calendar months ending this month, for the Income vs. expenses
      // chart — pulled in the same query as the KPI's this-month/last-
      // month comparison rather than a second round trip.
      const sixAgoD = new Date(now.getFullYear(), now.getMonth() - 5, 1);
      const sixStart = `${sixAgoD.getFullYear()}-${String(sixAgoD.getMonth() + 1).padStart(2, '0')}-01`;
      const monthKeys: string[] = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        monthKeys.push(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`);
      }

      const [attRes, curRes, feeRes, finRes, pendingRes] = await Promise.all([
        db.from('attendance').select('date, present').eq('group_key', state.activeGroup).gte('date', day90).order('date', { ascending: true }),
        db.from('curriculum_meetings').select('date, theme, activities').eq('group_key', state.activeGroup).gte('date', todayStr()).order('date', { ascending: true }).limit(1),
        db.from('fee_payments').select('paid, amount').eq('group_key', state.activeGroup).eq('period', period),
        db.from('finance_entries').select('entry_type, amount, entry_date, category, description').eq('group_key', state.activeGroup).gte('entry_date', sixStart).lte('entry_date', monthEnd).order('entry_date', { ascending: false }),
        db.from('join_requests').select('id', { count: 'exact', head: true }).eq('group_key', state.activeGroup).eq('status', 'pending'),
      ]);
      const attRows = attRes.data || [];
      const feeRows = feeRes.data || [];
      const finRows = finRes.data || [];
      const nextMeeting = (curRes.data || [])[0] || null;
      const pendingCount = pendingRes.count || 0;

      // Attendance: per-date rollup (chart) + 30-day rate vs the prior 30
      // days (KPI trend).
      const byDate = new Map<string, { present: number; total: number }>();
      attRows.forEach((r: any) => {
        const e = byDate.get(r.date) || { present: 0, total: 0 };
        e.total++; if (r.present) e.present++;
        byDate.set(r.date, e);
      });
      const lastDates = Array.from(byDate.keys()).sort().slice(-8);
      const rateOf = (rows: any[]) => rows.length ? Math.round((rows.filter((r: any) => r.present).length / rows.length) * 100) : null;
      const rate30 = rateOf(attRows.filter((r: any) => r.date >= day30));
      const ratePrev30 = rateOf(attRows.filter((r: any) => r.date >= day60 && r.date < day30));

      // Fees: this period's paid count/amount out of every active member.
      const paidCount = feeRows.filter((r: any) => r.paid).length;
      const collected = feeRows.reduce((s: number, r: any) => s + (r.paid ? Number(r.amount || 0) : 0), 0);
      const feePct = active.length ? Math.round((paidCount / active.length) * 100) : 0;

      // Finance: net income this month vs last month.
      const netFor = (start: string, end: string) => finRows
        .filter((r: any) => r.entry_date >= start && r.entry_date <= end)
        .reduce((s: number, r: any) => s + (r.entry_type === 'income' ? Number(r.amount) : -Number(r.amount)), 0);
      const netThis = netFor(`${period}-01`, monthEnd);
      const netPrev = netFor(`${prevPeriod}-01`, prevMonthEnd);

      // Same finRows, bucketed by month instead of summed — for the
      // Income vs. expenses chart.
      const byMonth = new Map<string, { income: number; expense: number }>();
      monthKeys.forEach((k) => byMonth.set(k, { income: 0, expense: 0 }));
      finRows.forEach((r: any) => {
        const bucket = byMonth.get(String(r.entry_date).slice(0, 7));
        if (!bucket) return;
        if (r.entry_type === 'income') bucket.income += Number(r.amount); else bucket.expense += Number(r.amount);
      });

      renderDashKpis({ activeCount: active.length, archivedCount, rate30, ratePrev30, feePct, paidCount, totalActive: active.length, collected, netThis, netPrev });
      renderDashFinanceChart(monthKeys, byMonth);
      renderDashAttendanceChart(lastDates, byDate);
      renderDashFeesDonut(feePct, paidCount, active.length, collected);
      renderDashNextMeeting(nextMeeting);
      renderDashRecentFinance(finRows.slice(0, 5));
      renderDashAttention({ pendingCount, allergyCount, unpaidCount: active.length - paidCount, hasActiveMembers: active.length > 0 });
    }
    // Eases a KPI number up from 0 to its real value instead of just
    // appearing — small thing, but it's what makes the dashboard feel
    // alive rather than a static readout.
    function animateCountUp(el: any, target: number, format: (v: number) => string, duration = 900) {
      if (!el) return;
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = format(target * eased);
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = format(target);
      }
      requestAnimationFrame(tick);
    }
    function renderDashKpis(d: any) {
      els.dashKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Active members</span></div>
          <span class="ws-dash-kpi-num" data-kpi="active">0</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${d.archivedCount} archived</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Attendance (30d)</span></div>
          <span class="ws-dash-kpi-num" data-kpi="rate">${d.rate30 != null ? '0%' : '—'}</span>
          ${d.rate30 != null ? dashDeltaBadge(d.ratePrev30 != null ? d.rate30 - d.ratePrev30 : null, 'pt') : '<span class="ws-dash-delta ws-dash-delta--flat">No sessions yet</span>'}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">$</span><span class="ws-dash-kpi-label">Fees collected</span></div>
          <span class="ws-dash-kpi-num" data-kpi="fees">0%</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${d.paidCount}/${d.totalActive} paid · ${d.collected.toFixed(0)}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">±</span><span class="ws-dash-kpi-label">Net income (mtd)</span></div>
          <span class="ws-dash-kpi-num" data-kpi="net">${d.netThis >= 0 ? '+0' : '−0'}</span>
          ${dashDeltaBadge(Math.round(d.netThis - d.netPrev))}
        </div>
      `;
      animateCountUp(els.dashKpis.querySelector('[data-kpi="active"]'), d.activeCount, (v) => String(Math.round(v)));
      if (d.rate30 != null) {
        animateCountUp(els.dashKpis.querySelector('[data-kpi="rate"]'), d.rate30, (v) => Math.round(v) + '%');
      }
      animateCountUp(els.dashKpis.querySelector('[data-kpi="fees"]'), d.feePct, (v) => Math.round(v) + '%');
      animateCountUp(els.dashKpis.querySelector('[data-kpi="net"]'), Math.abs(d.netThis), (v) => (d.netThis >= 0 ? '+' : '−') + Math.round(v));
    }
    function renderDashAttendanceChart(lastDates: string[], byDate: Map<string, { present: number; total: number }>) {
      if (!lastDates.length) {
        els.dashAttChart.innerHTML = '<p class="ws-dash-empty-mini">No attendance recorded in the last 90 days.</p>';
        els.dashAttSub.textContent = '';
        return;
      }
      els.dashAttSub.textContent = `Last ${lastDates.length} session${lastDates.length === 1 ? '' : 's'}`;
      els.dashAttChart.innerHTML = `
        <div class="ws-dash-bars">
          ${lastDates.map((dateStr) => {
            const e = byDate.get(dateStr)!;
            const pct = e.total ? Math.round((e.present / e.total) * 100) : 0;
            const d = parseDateStr(dateStr);
            const label = `${MONTHS[d.getMonth()].en.slice(0, 3)} ${d.getDate()}`;
            return `
              <div class="ws-dash-bar-col" title="${label}, ${pct}% present (${e.present}/${e.total})">
                <span class="ws-dash-bar-pct">${pct}%</span>
                <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style="height:${Math.max(pct, 4)}%"></div></div>
                <span class="ws-dash-bar-label">${label}</span>
              </div>`;
          }).join('')}
        </div>
      `;
    }
    function renderDashFinanceChart(monthKeys: string[], byMonth: Map<string, { income: number; expense: number }>) {
      const totalIncome = monthKeys.reduce((s, k) => s + byMonth.get(k)!.income, 0);
      const totalExpense = monthKeys.reduce((s, k) => s + byMonth.get(k)!.expense, 0);
      const net = totalIncome - totalExpense;
      els.dashFinSub.textContent = `Last 6 months · Net ${net >= 0 ? '+' : '−'}${Math.abs(net).toFixed(0)}`;
      if (!totalIncome && !totalExpense) {
        els.dashFinChart.innerHTML = '<p class="ws-dash-empty-mini">No Finance entries in the last 6 months.</p>';
        return;
      }
      const maxVal = Math.max(1, ...monthKeys.map((k) => Math.max(byMonth.get(k)!.income, byMonth.get(k)!.expense)));
      els.dashFinChart.innerHTML = `
        <div class="ws-dash-fin-bars">
          ${monthKeys.map((k) => {
            const b = byMonth.get(k)!;
            const d = new Date(Number(k.slice(0, 4)), Number(k.slice(5, 7)) - 1, 1);
            const label = MONTHS[d.getMonth()].en.slice(0, 3);
            const incPct = Math.round((b.income / maxVal) * 100);
            const expPct = Math.round((b.expense / maxVal) * 100);
            return `
              <div class="ws-dash-fin-col" title="${MONTHS[d.getMonth()].en} ${d.getFullYear()}, Income ${b.income.toFixed(2)}, Expenses ${b.expense.toFixed(2)}">
                <div class="ws-dash-fin-pair">
                  <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--income" style="height:${b.income ? Math.max(incPct, 3) : 0}%"></div></div>
                  <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--expense" style="height:${b.expense ? Math.max(expPct, 3) : 0}%"></div></div>
                </div>
                <span class="ws-dash-fin-label">${label}</span>
              </div>`;
          }).join('')}
        </div>
        <div class="ws-dash-fin-legend">
          <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--income"></i>Income</span>
          <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--expense"></i>Expenses</span>
        </div>
      `;
    }
    function renderDashFeesDonut(pct: number, paidCount: number, total: number, collected: number) {
      if (!total) {
        els.dashFeesDonut.innerHTML = '<p class="ws-dash-empty-mini">No active members yet.</p>';
        return;
      }
      els.dashFeesDonut.innerHTML = `
        <div class="ws-dash-donut" style="--pct:${pct}%">
          <div class="ws-dash-donut-center">
            <span class="ws-dash-donut-num">${pct}%</span>
            <span class="ws-dash-donut-label">Collected</span>
          </div>
        </div>
        <p class="ws-dash-donut-foot">${paidCount} of ${total} paid · ${collected.toFixed(2)} in</p>
      `;
    }
    function renderDashNextMeeting(meeting: any) {
      if (!meeting) {
        els.dashNextMeeting.innerHTML = `
          <p class="ws-dash-empty-mini">Nothing planned yet.</p>
          <button type="button" class="ws-dash-mini-link" data-goto-tab="curriculum">Plan a meeting →</button>
        `;
        return;
      }
      const d = parseDateStr(meeting.date);
      const dateLabel = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}`;
      const count = (meeting.activities || []).length;
      els.dashNextMeeting.innerHTML = `
        <p class="ws-dash-mini-date">${dateLabel}</p>
        <p class="ws-dash-mini-theme">${escapeHtml(meeting.theme || 'Theme not set yet')}</p>
        <p class="ws-dash-mini-sub">${count} ${count === 1 ? 'activity' : 'activities'} planned</p>
      `;
    }
    function renderDashRecentFinance(rows: any[]) {
      if (!rows.length) {
        els.dashRecentFinance.innerHTML = '<p class="ws-dash-empty-mini">No entries yet this month.</p>';
        return;
      }
      els.dashRecentFinance.innerHTML = rows.map((r: any) => `
        <div class="ws-dash-feed-row">
          <span class="ws-dash-feed-dot ws-dash-feed-dot--${r.entry_type}"></span>
          <span class="ws-dash-feed-text">
            <span class="ws-dash-feed-title">${escapeHtml(r.category || (r.entry_type === 'income' ? 'Income' : 'Expense'))}</span>
            <span class="ws-dash-feed-date">${r.entry_date}</span>
          </span>
          <span class="ws-dash-feed-amount ws-dash-feed-amount--${r.entry_type}">${r.entry_type === 'income' ? '+' : '−'}${Number(r.amount).toFixed(2)}</span>
        </div>
      `).join('');
    }
    function renderDashAttention(d: any) {
      const items: { label: string; tab: string }[] = [];
      if (d.pendingCount) items.push({ label: `${d.pendingCount} pending approval${d.pendingCount === 1 ? '' : 's'}`, tab: 'approvals' });
      if (d.hasActiveMembers && d.unpaidCount > 0) items.push({ label: `${d.unpaidCount} unpaid fee${d.unpaidCount === 1 ? '' : 's'} this month`, tab: 'fees' });
      if (d.allergyCount) items.push({ label: `${d.allergyCount} member${d.allergyCount === 1 ? '' : 's'} with allergies on file`, tab: 'roster' });
      if (!items.length) { els.dashAttention.innerHTML = '<p class="ws-dash-empty-mini">All caught up. Nothing needs attention.</p>'; return; }
      els.dashAttention.innerHTML = items.map((it) => `<button type="button" class="ws-dash-attn-row" data-goto-tab="${it.tab}">${escapeHtml(it.label)} <span aria-hidden="true">→</span></button>`).join('');
    }
    function bindDashboard() {
      els.dashRoot.addEventListener('click', (e: any) => {
        const btn = e.target.closest('[data-goto-tab]');
        if (btn) setTab(btn.dataset.gotoTab);
      });
    }

    // ---------- Groups + tabs ---------------------------------------------
    function setupGroups() {
      state.availableGroups = state.profile.role === 'admin'
        ? GROUPS.map((g) => g.key)
        : state.profile.groups;
      if (!state.availableGroups.includes(state.activeGroup)) {
        state.activeGroup = state.availableGroups[0] || null;
      }
      renderGroupSwitch();
    }
    function renderGroupBanner() {
      const g = GROUPS.find((x: any) => x.key === state.activeGroup);
      els.groupBannerName.textContent = g ? g.en : 'Support Leader';
    }
    function renderGroupSwitch() {
      renderGroupBanner();
      updateTabVisibility();
      if (state.availableGroups.length <= 1) {
        const g = GROUPS.find((x) => x.key === state.availableGroups[0]);
        els.groupSwitch.innerHTML = `<span class="ws-single-group">${g ? escapeHtml(g.en) : 'Support Leader'}</span>`;
        return;
      }
      els.groupSwitch.innerHTML = state.availableGroups.map((key: any) => {
        const g = GROUPS.find((x) => x.key === key);
        return `<button type="button" class="curr-tab${key === state.activeGroup ? ' curr-tab--active' : ''}" data-group="${key}">${g ? g.en : key}</button>`;
      }).join('');
      els.groupSwitch.querySelectorAll('[data-group]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          state.activeGroup = btn.dataset.group;
          // Members are cached per-group (see ensureMembersLoaded) — clear
          // it on every switch so Dashboard/Reports re-fetch for the new
          // group instead of reusing the previous group's roster.
          state.members = [];
          // An open "Editing <member>" form is bound to a member id from
          // the group we're leaving; submitting it after a switch would
          // save group_key: <new group> against that id, silently moving
          // the member. Close it out on every switch.
          if (state.editingMemberId) resetMemberForm();
          renderGroupSwitch();
          refreshApprovalsBadge();
          refreshEventsBadge();
          // Locked for the same reason setTab() locks it — see
          // setNavBusy()'s comment. A group switch started mid-load here
          // is exactly the case that used to leave the previous group's
          // data on screen until a manual refresh.
          setNavBusy(true);
          try {
            // Music/General/Leaders only show a cut-down tab set —
            // updateTabVisibility() (called from renderGroupSwitch()) already
            // hid the rest, so a switch that leaves an invalid tab active
            // needs to land somewhere visible instead of just reloading a
            // now-hidden panel. Landing on the new group's own first visible
            // tab (rather than a hardcoded 'finance') matters now that
            // Leaders doesn't have a Finance tab at all — 'finance' would've
            // silently un-hidden that panel's content regardless of its nav
            // button being hidden, since setTab() only ever looks at
            // dataset.panel, never isTabHidden().
            if (isTabHidden(state.activeTab)) {
              const firstVisible = els.tabs.querySelector('.ws-tab:not([hidden]):not([data-admin-only])');
              await setTab(firstVisible ? (firstVisible as any).dataset.tab : 'finance');
            } else {
              await loadActiveTabData();
            }
          } finally {
            setNavBusy(false);
          }
        });
      });
    }
    // Music, General, and Social Media (see MUSIC_GROUP_KEY/
    // GENERAL_GROUP_KEY/SOCIAL_MEDIA_GROUP_KEY) aren't scouting troops —
    // Archive/Approvals/Attendance/Fees/Curriculum/Dashboard don't apply
    // to any of them (each gets its own dashboard-equivalent in the
    // Admin console instead — see loadMusicDashboard()-style tabs
    // there). Music still gets Roster (band members); General and
    // Social Media don't — by request, since neither's "membership" (the
    // board, the social media team) needs a tracked roster the way a
    // troop or the band does. Existing member rows for those two groups
    // aren't deleted (Admin's Full Roster report still lists them), they
    // just have no Workspace tab to add/edit from anymore. Runs on every
    // group switch, not just once, so leaving one restores every other
    // tab.
    const NON_TROOP_GROUP_KEYS = [MUSIC_GROUP_KEY, GENERAL_GROUP_KEY, SOCIAL_MEDIA_GROUP_KEY];
    // Leaders (see LEADERS_GROUP_KEY) is deliberately left out of the
    // list above — it has no `members` roster or fee-collecting members
    // at all (its own Roster/Attendance read from profiles/
    // leader_attendance instead), so copyMemberBlock/feesTabHint never
    // apply to it either way; those live inside panels (roster/fees)
    // that isTabHidden() already hides entirely for Leaders. data-
    // troop-only is the one exception now that Leaders has its own
    // Reports tab (see NON_TROOP_TAB_VISIBILITY below) — those report
    // cards (Monthly Fees, Attendance, Curriculum) live in the one
    // panel Leaders DOES share with troops, so its own toggle below
    // checks for Leaders explicitly instead of using this list.
    const NON_TROOP_TAB_VISIBILITY: Record<string, string[]> = {
      [MUSIC_GROUP_KEY]: ['roster', 'finance', 'inventory', 'events', 'vendors', 'reports', 'sharedcal'],
      [GENERAL_GROUP_KEY]: ['finance', 'vendors', 'pr', 'meetingnotes', 'reports', 'sharedcal'],
      [SOCIAL_MEDIA_GROUP_KEY]: ['finance', 'vendors', 'reports', 'library', 'content', 'credentials', 'sharedcal'],
      [LEADERS_GROUP_KEY]: ['leaderdashboard', 'leaderroster', 'leaderarchive', 'leaderattendance', 'leaderprofile', 'leaderassessment', 'reports', 'sharedcal'],
    };
    // Inventory/Event Calendar are Music-only, Public Relations is
    // General-only, Content Calendar/Credentials are Social-Media-only,
    // the leaderX tabs are Leaders-only — troops aren't in
    // NON_TROOP_TAB_VISIBILITY at all, so each group's own inclusion
    // list above doesn't hide anything for them; this covers that case
    // for all 4. Vendors, unlike those, is universal — every troop gets
    // it too, same as Roster/Finance, so it isn't in this list at all.
    const MUSIC_ONLY_TABS = ['inventory', 'events'];
    const GENERAL_ONLY_TABS = ['pr', 'meetingnotes'];
    const SOCIAL_MEDIA_ONLY_TABS = ['content', 'credentials'];
    const LEADERS_ONLY_TABS = ['leaderdashboard', 'leaderroster', 'leaderarchive', 'leaderattendance', 'leaderprofile', 'leaderassessment'];
    // A leader approved with no group at all (see the People tab's
    // "Support Leader" option): 3 tabs make sense with no group_key to
    // scope to — Shared Calendar (genuinely ungated at the database
    // level, is_approved_leader(), no group_key column on it
    // whatsoever), and 2 read-only, org-wide views built specifically
    // for them: Overview (which already includes a leader-per-group
    // directory, so there's no separate Leaders Roster tab here — see
    // support_leader_overview_schema.sql for why profiles' own RLS still
    // needed opening up regardless, that directory reads from it) and
    // Next Meetings.
    const SUPPORT_LEADER_TABS = ['supportoverview', 'nextmeetings', 'sharedcal'];
    // supportoverview/nextmeetings only ever make sense with no group
    // selected — named here so a real group (troop, Music, General,
    // Social Media) correctly hides them via the *_ONLY_TABS fallback
    // below, same as leaderX is Leaders-only.
    const SUPPORT_ONLY_TABS = ['supportoverview', 'nextmeetings'];
    function isTabHidden(tab: string) {
      // Without this check, a null activeGroup fell through to the
      // *_ONLY_TABS fallback below and — since none of those name troop
      // tabs like Roster/Attendance/Dashboard — wrongly left them all
      // visible, even though nothing in them can load without a real
      // group_key.
      if (!state.activeGroup) return !SUPPORT_LEADER_TABS.includes(tab);
      const visible = NON_TROOP_TAB_VISIBILITY[state.activeGroup];
      if (visible) return !visible.includes(tab);
      return MUSIC_ONLY_TABS.includes(tab) || GENERAL_ONLY_TABS.includes(tab) || SOCIAL_MEDIA_ONLY_TABS.includes(tab) || LEADERS_ONLY_TABS.includes(tab) || SUPPORT_ONLY_TABS.includes(tab);
    }
    function updateTabVisibility() {
      els.tabs.querySelectorAll('.ws-tab:not([data-admin-only])').forEach((btn: any) => {
        btn.toggleAttribute('hidden', isTabHidden(btn.dataset.tab));
      });
      els.copyMemberBlock.toggleAttribute('hidden', !NON_TROOP_GROUP_KEYS.includes(state.activeGroup));
      const g = GROUPS.find((x: any) => x.key === state.activeGroup);
      els.copyMemberBtn.textContent = `Copy selected into ${g ? g.en : 'the'} roster`;
      // The Fees tab (and its per-month default fee) doesn't exist for
      // Music/General — this categories hint references it by name, so it
      // only makes sense for a troop.
      els.feesTabHint.toggleAttribute('hidden', NON_TROOP_GROUP_KEYS.includes(state.activeGroup));
      // Library's own Lessons subtab (troop curriculum resource links)
      // only makes sense for a troop — Social Media sees the rest of
      // Library (Documents/Shared Library) but not this.
      document.querySelectorAll('[data-troop-only]').forEach((el: any) => {
        el.toggleAttribute('hidden', NON_TROOP_GROUP_KEYS.includes(state.activeGroup) || state.activeGroup === LEADERS_GROUP_KEY);
      });
      // Each non-troop group's Reports tab only carries the report cards
      // specific to its own tabs — Music's Inventory/Event Calendar/
      // Maintenance, Social Media's Content Calendar/Credentials,
      // General's Sponsors/Community & Church Contacts.
      document.querySelectorAll('[data-music-only]').forEach((el: any) => {
        el.toggleAttribute('hidden', state.activeGroup !== MUSIC_GROUP_KEY);
      });
      document.querySelectorAll('[data-social-only]').forEach((el: any) => {
        el.toggleAttribute('hidden', state.activeGroup !== SOCIAL_MEDIA_GROUP_KEY);
      });
      document.querySelectorAll('[data-general-only]').forEach((el: any) => {
        el.toggleAttribute('hidden', state.activeGroup !== GENERAL_GROUP_KEY);
      });
      document.querySelectorAll('[data-leaders-only]').forEach((el: any) => {
        el.toggleAttribute('hidden', state.activeGroup !== LEADERS_GROUP_KEY);
      });
      // The Reports tab's own Roster card — hidden in lockstep with the
      // Roster tab itself (General/Social Media no longer get either).
      document.querySelectorAll('[data-roster-report]').forEach((el: any) => {
        el.toggleAttribute('hidden', isTabHidden('roster'));
      });
      // Music and Social Media get their own custom-named finance report
      // instead of the generic Income Statement (Troops/General keep it).
      document.querySelectorAll('[data-generic-finance]').forEach((el: any) => {
        el.toggleAttribute('hidden', state.activeGroup === MUSIC_GROUP_KEY || state.activeGroup === SOCIAL_MEDIA_GROUP_KEY || state.activeGroup === LEADERS_GROUP_KEY);
      });
      // Vendors is otherwise universal (every troop + Music/General/
      // Social Media) — Leaders has no Vendors tab at all, so its own
      // Reports tab shouldn't carry this card either.
      document.querySelectorAll('[data-vendors-report]').forEach((el: any) => {
        el.toggleAttribute('hidden', state.activeGroup === LEADERS_GROUP_KEY);
      });
      balanceTabs();
    }

    // Returns the in-flight loader's promise (rather than firing it and
    // forgetting) so callers can await a tab/group switch fully settling
    // before allowing another one — see setNavBusy(). Without that, a
    // second switch fired while the first is still mid-fetch can have its
    // (earlier-issued, slower) response land AFTER the second one's and
    // overwrite the screen with the wrong tab's/group's data — the fix
    // for "switching tabs/groups doesn't show the right names and data
    // until I refresh".
    function loadActiveTabData() {
      const tab = state.activeTab;
      if (tab === 'dashboard') return loadDashboard();
      if (tab === 'roster' || tab === 'archive') return loadRoster();
      if (tab === 'approvals') return loadApprovals();
      if (tab === 'attendance') return loadAttendance();
      if (tab === 'fees') return loadFees();
      if (tab === 'finance') return loadFinance();
      if (tab === 'inventory') return loadInventory();
      if (tab === 'events') return loadEvents();
      if (tab === 'vendors') return loadVendors();
      if (tab === 'pr') return loadPR();
      if (tab === 'meetingnotes') return loadMeetingNotes();
      if (tab === 'content') return loadContent();
      if (tab === 'credentials') return loadCredentials();
      if (tab === 'library') return loadLibrary();
      if (tab === 'curriculum') return currStart();
      if (tab === 'sharedcal') return loadSharedCal();
      if (tab === 'reports') return loadReportsTabExtras();
      if (tab === 'leaderdashboard') return loadLeaderDashboard();
      if (tab === 'leaderroster' || tab === 'leaderarchive') return loadLeaderRoster();
      if (tab === 'leaderattendance') return loadLeaderAttendance();
      if (tab === 'leaderprofile') return loadLeaderProfileTab();
      if (tab === 'leaderassessment') return loadLeaderAssessmentTab();
      if (tab === 'supportoverview') return loadSupportOverview();
      if (tab === 'nextmeetings') return loadNextMeetings();
      return Promise.resolve();
    }

    // Locks the tab bar + group switcher while a load is in flight, so a
    // second switch can't be started until the first one's data has fully
    // landed and rendered. That serializes every load — the two in-flight
    // requests that used to be able to resolve out of order (see
    // loadActiveTabData()'s comment) can now never overlap.
    function setNavBusy(busy: boolean) {
      els.tabs.style.pointerEvents = busy ? 'none' : '';
      els.tabs.style.opacity = busy ? '0.6' : '';
      if (els.groupSwitch) {
        els.groupSwitch.style.pointerEvents = busy ? 'none' : '';
        els.groupSwitch.style.opacity = busy ? '0.6' : '';
      }
    }
    async function setTab(tab: any) {
      state.activeTab = tab;
      els.tabs.querySelectorAll('.ws-tab').forEach((b: any) => b.classList.toggle('ws-tab--active', b.dataset.tab === tab));
      document.querySelectorAll('.ws-panel').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.panel !== tab));
      setNavBusy(true);
      try {
        await loadActiveTabData();
      } finally {
        setNavBusy(false);
      }
    }
    function bindTabs() {
      els.tabs.querySelectorAll('.ws-tab').forEach((btn: any) => {
        btn.addEventListener('click', () => setTab(btn.dataset.tab));
      });
    }
    // Whatever number of rows the tab bar needs at the current width, every
    // row should have as close to an equal COUNT of tabs as possible (e.g.
    // 6 + 5, never 7 + 4) — a plain CSS grid/flex wrap just greedily packs
    // each row to capacity instead. Measures how many tabs fit per row at
    // their natural (--ws-tab-ideal) width, then sets a fixed column count
    // that divides the *visible* tab count as evenly as possible across
    // that many rows.
    let tabsResizeTimer: any;
    function balanceTabs() {
      const visible = Array.from(els.tabs.querySelectorAll('.ws-tab')).filter((b: any) => !b.hidden);
      const n = visible.length;
      if (!n) return;
      const prevDisplay = els.tabs.style.display;
      const prevWrap = els.tabs.style.flexWrap;
      const ideal = getComputedStyle(els.tabs).getPropertyValue('--ws-tab-ideal').trim() || '9rem';
      els.tabs.style.display = 'flex';
      els.tabs.style.flexWrap = 'wrap';
      visible.forEach((b: any) => { b.style.flex = `0 1 ${ideal}`; });
      const firstTop = (visible[0] as any).offsetTop;
      let natural = 0;
      for (const b of visible) { if ((b as any).offsetTop === firstTop) natural++; else break; }
      visible.forEach((b: any) => { b.style.flex = ''; });
      els.tabs.style.display = prevDisplay;
      els.tabs.style.flexWrap = prevWrap;

      natural = Math.max(1, Math.min(natural, n));
      const rows = Math.ceil(n / natural);
      const perRow = Math.ceil(n / rows);
      els.tabs.style.setProperty('--ws-tab-cols', String(perRow));
    }
    function bindTabsResize() {
      window.addEventListener('resize', () => {
        clearTimeout(tabsResizeTimer);
        tabsResizeTimer = setTimeout(balanceTabs, 150);
      });
    }

    // ---------- Generic sub-tabs (Finance's Ledger/Categories, Library's
    // Documents/Lessons) — same pattern as Curriculum's Plan/Activity Bank,
    // scoped by a "group" name so unrelated sub-tab sets don't collide.
    function setSubtab(group: string, name: string) {
      document.querySelectorAll(`.ws-subtab[data-subtabs="${group}"]`).forEach((b: any) => b.classList.toggle('ws-subtab--active', b.dataset.subtab === name));
      document.querySelectorAll(`[data-subpanel^="${group}:"]`).forEach((p: any) => p.toggleAttribute('hidden', p.dataset.subpanel !== `${group}:${name}`));
    }
    function bindSubtabs() {
      document.querySelectorAll('.ws-subtab').forEach((btn: any) => {
        btn.addEventListener('click', () => setSubtab(btn.dataset.subtabs, btn.dataset.subtab));
      });
    }

    // ---------- Boot ---------------------------------------------------
    // astro:page-load fires on the very first load AND again after every
    // client-side view-transition back to this page (e.g. a leader clicks
    // a site-nav link like Home, then hits the browser Back button — the
    // header/footer are outside the workspace, always in reach). init()
    // has to re-run then (session may have expired, role/groups may have
    // changed) but must NOT re-bind every listener on top of the ones
    // already bound — these two flags gate just the one-time bindings.
    let boundOnce = false;
    let boundPendingOnce = false;
    async function init() {
      cacheEls();
      initRowNumbering();
      initCollapsibleRows();
      if (!supabaseConfigured) { showToast('Not connected to the database.'); return; }

      const session = await getSession();
      if (!session) { window.location.replace('/leaders'); return; }
      if (isSessionExpired()) { await signOut(); window.location.replace('/leaders?expired=1'); return; }
      state.session = session;
      // Kick the leader back to sign-in the moment the 3-hour cap hits,
      // even if this tab is just left open and idle — not only on the
      // next reload.
      setTimeout(async () => {
        await signOut();
        window.location.replace('/leaders?expired=1');
      }, msUntilSessionExpiry());

      const profile = await getProfile(session.user.id);
      if (!profile) { await signOut(); window.location.replace('/leaders'); return; }
      state.profile = profile;

      els.shell.removeAttribute('hidden');

      if (profile.role === 'pending') {
        els.pending.removeAttribute('hidden');
        if (!boundPendingOnce) {
          boundPendingOnce = true;
          els.signoutPending.addEventListener('click', async () => { await signOut(); window.location.replace('/leaders'); });
          const checkBtn = el('[data-ws-check-again]');
          checkBtn.addEventListener('click', async () => {
            checkBtn.disabled = true;
            checkBtn.textContent = 'Checking…';
            const fresh = await getProfile(session.user.id);
            if (fresh && fresh.role !== 'pending') {
              window.location.reload();
              return;
            }
            checkBtn.disabled = false;
            checkBtn.textContent = 'Check again';
            showToast('Still pending, ask an admin to approve you.');
          });
        }
        return;
      }

      els.main.removeAttribute('hidden');
      const initials = profile.name.trim().split(/\s+/).map((w: string) => w[0]).slice(0, 2).join('').toUpperCase();
      els.accountBtn.textContent = initials || '?';
      els.who.innerHTML = `<span class="ws-account-name">${escapeHtml(profile.name)}</span><span class="ws-account-role">${profile.role}</span>`;
      registerDeviceSession();
      if (profile.role === 'admin') {
        document.querySelectorAll('[data-admin-only]').forEach((elm) => elm.removeAttribute('hidden'));
      }
      if (!canEditSharedCal()) {
        els.scAddBtn.hidden = true;
        els.scDayAdd.hidden = true;
        // Nothing they filed and nothing they own — this subtab would
        // only ever be empty for them.
        el('[data-sc-requests-tab]')?.setAttribute('hidden', '');
      }
      // Re-measured every load (not just once) since admin-only visibility
      // — and so the tab count itself — can differ between loads.
      balanceTabs();

      // setupGroups()/renderGroupSwitch() rebuild their own innerHTML (and
      // rebind onto those fresh nodes) every call, so they're always safe
      // to re-run — unlike everything below, which binds directly onto
      // static elements that persist across an astro:page-load re-init.
      setupGroups();

      if (!boundOnce) {
        boundOnce = true;
        bindOverlayScrollLock();
        bindDeviceKicks();
        els.accountBtn.addEventListener('click', () => {
          const opening = els.accountMenu.hidden;
          els.accountMenu.toggleAttribute('hidden');
          if (opening) renderDevices();
        });
        document.addEventListener('click', (e: any) => {
          if (els.accountMenu.hidden) return;
          if (e.target.closest('.ws-account')) return;
          els.accountMenu.setAttribute('hidden', '');
        });
        els.signout.addEventListener('click', async () => { await signOut(); window.location.replace('/leaders'); });
        els.signoutOthers.addEventListener('click', async () => {
          els.signoutOthers.disabled = true;
          els.signoutOthers.textContent = 'Signing out other devices…';
          await signOutOtherDevices();
          await renderDevices();
          els.signoutOthers.disabled = false;
          els.signoutOthers.textContent = 'Sign out of all other devices';
        });
        els.signoutEverywhere.addEventListener('click', async () => { await signOutEverywhere(); window.location.replace('/leaders'); });
        // Catches this device having been signed out from elsewhere —
        // checked in the background so it doesn't wait for a reload.
        setInterval(async () => {
          if (!(await checkThisDeviceStillActive())) window.location.replace('/leaders?revoked=1');
        }, 45000);
        document.addEventListener('visibilitychange', async () => {
          if (document.visibilityState !== 'visible') return;
          if (!(await checkThisDeviceStillActive())) window.location.replace('/leaders?revoked=1');
        });
        bindEnglishOnlyInputs();
        bindTitleCaseInputs();

        bindTabs();
        bindTabsResize();
        bindSubtabs();
        bindDashboard();
        bindRosterForm();
        bindCopyPicker();
        bindFinanceForm();
        bindInventoryForm();
        bindInventoryCategories();
        bindAdjustmentsForm();
        bindMaintenanceForm();
        bindEventForm();
        bindEventCategories();
        bindVendorForm();
        bindSponsorForm();
        bindPrContactForm();
        bindPRLibraryUpload();
        bindPRCategories();
        bindMeetingNoteForm();
        bindContentForm();
        bindContentCategories();
        bindCredForm();
        bindLibraryUpload();
        bindReports();
        bindSharedCalForm();
        bindTableSearch(els.rosterSearch, els.rosterBody);
        bindTableSearch(els.archiveSearch, els.archiveBody);
        bindTableSearch(els.approvalsSearch, els.approvalsBody);
        bindTableSearch(els.attSearch, els.attBody);
        bindTableSearch(els.feeSearch, els.feeBody);
        bindTableSearch(els.invSearch, els.invBody);
        bindTableSearch(els.vendorSearch, els.vendorBody);
        bindTableSearch(els.sponsorSearch, els.sponsorBody);
        bindTableSearch(els.prcSearch, els.prcBody);
        bindTableSearch(els.mnSearch, els.mnBody);
        bindTableSearch(els.credSearch, els.credBody);
        bindTableSearch(els.lrosterSearch, els.lrosterBody);
        bindTableSearch(els.larchiveSearch, els.larchiveBody);
        bindTableSearch(els.lattSearch, els.lattBody);
        currBindStatics();
        bindAttendance();
        bindLeaderAttendance();
        bindLeaderDashboardRange();
        bindLeaderRosterForm();
        bindSupportOverview();
        bindLeaderProfile();
        bindLeaderAssessment();
        bindLeaderFunctionForm();
        els.feeMonth.addEventListener('change', loadFees);
        els.feeYear.addEventListener('change', loadFees);
        els.feeDefault.addEventListener('blur', saveDefaultFee);
        bindSettings();
        els.finMonth.addEventListener('change', loadFinance);
        els.finYear.addEventListener('change', loadFinance);
      }

      refreshApprovalsBadge();
      refreshEventsBadge();
      {
        // A groupless leader has no Dashboard to land on — Overview
        // (see SUPPORT_LEADER_TABS) is their landing spot instead now.
        const visible = NON_TROOP_TAB_VISIBILITY[state.activeGroup];
        const landing = !state.activeGroup ? 'supportoverview' : (visible && !visible.includes('dashboard') ? visible[0] : 'dashboard');
        setTab(landing);
      }
    }

    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
