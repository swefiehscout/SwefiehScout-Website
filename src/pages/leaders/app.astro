    async function rejectRequest(id: string) {
      if (!confirm('Reject this request? No member will be added.')) return;
      const { error } = await db.from('join_requests')
        .update({ status: 'rejected', reviewed_by: state.session.user.id, reviewed_at: new Date().toISOString() })
        .eq('id', id);
      if (error) { showToast('Could not reject.'); return; }
      await loadApprovals();
      await refreshApprovalsBadge();
    }

    // ---------- Shared date helpers --------------------------------------
    function todayStr() {
      return toDateStr(new Date());
    }
    function toDateStr(d: Date) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function parseDateStr(s: string) {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function addDays(d: Date, n: number) {
      const c = new Date(d);
      c.setDate(c.getDate() + n);
      return c;
    }
    function startOfWeek(d: Date) {
      const c = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      c.setDate(c.getDate() - c.getDay());
      return c;
    }
    // Month/Year dropdown pair used by both Fees and Finance instead of a
    // native <input type="month">.
    function populatePeriodSelects(monthSel: any, yearSel: any, withYearOption = false) {
      if (monthSel.options.length) return; // already populated
      let opts = MONTHS.map((m, i) => `<option value="${String(i + 1).padStart(2, '0')}">${m.en}</option>`).join('');
      if (withYearOption) opts = `<option value="ALL">Whole Year</option>` + opts;
      monthSel.innerHTML = opts;
      const nowYear = new Date().getFullYear();
      const years: number[] = [];
      for (let y = nowYear - 3; y <= nowYear + 1; y++) years.push(y);
      yearSel.innerHTML = years.map((y) => `<option value="${y}">${y}</option>`).join('');
      const now = new Date();
      monthSel.value = String(now.getMonth() + 1).padStart(2, '0');
      yearSel.value = String(now.getFullYear());
    }
    function getPeriod(monthSel: any, yearSel: any) {
      return `${yearSel.value}-${monthSel.value}`;
    }
    // Shared by Finance and Reports: resolves a month+year select pair
    // (where the month select may have a "Whole Year" option) into a
    // concrete date range plus a display label.
    function periodRange(monthSel: any, yearSel: any) {
      const year = Number(yearSel.value);
      if (monthSel.value === 'ALL') {
        return { start: `${year}-01-01`, end: `${year}-12-31`, label: String(year), isYear: true, period: String(year) };
      }
      const month = monthSel.value;
      const period = `${year}-${month}`;
      const lastDay = new Date(year, Number(month), 0).getDate();
      const label = `${monthSel.selectedOptions[0]?.textContent} ${year}`;
      return { start: `${period}-01`, end: `${period}-${String(lastDay).padStart(2, '0')}`, label, isYear: false, period };
    }

    // ---------- Attendance (calendar date-picker) ---------------------------
    async function loadAttendance() {
      if (!state.activeGroup) return;
      if (!els.attWeekdayRow.children.length) {
        els.attWeekdayRow.innerHTML = WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('');
      }
      const first = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth(), 1);
      const last = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth() + 1, 0);
      const gridStart = startOfWeek(first);
      const gridEnd = addDays(startOfWeek(last), 6);
      const { data, error } = await db.from('attendance').select('date, present')
        .eq('group_key', state.activeGroup).gte('date', toDateStr(gridStart)).lte('date', toDateStr(gridEnd));
      if (error) { console.error(error); showToast('Could not load attendance.'); return; }
      state.attDatesWithRecords = new Set((data || []).map((r: any) => r.date));
      renderAttCalendar();
      await loadAttDay();
    }
    function renderAttCalendar() {
      const anchor = state.attAnchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      els.attMonthLabel.textContent = `${MONTHS[mo].en} ${y}`;

      let html = '';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const cls = [
          'curr-day-cell',
          !inMonth && 'curr-day-cell--out',
          dateStr === today && 'curr-day-cell--today',
          dateStr === state.attSelected && 'curr-day-cell--selected',
          state.attDatesWithRecords?.has(dateStr) && 'curr-day-cell--has',
        ].filter(Boolean).join(' ');
        const hasRecords = state.attDatesWithRecords?.has(dateStr);
        html += `<div class="${cls}" data-date="${dateStr}" style="min-height:auto;cursor:pointer;">
          <span class="curr-day-num">${d.getDate()}</span>
          ${hasRecords ? '<span class="ws-att-dot" aria-hidden="true"></span>' : ''}
        </div>`;
        d = addDays(d, 1);
      }
      els.attCalendar.innerHTML = html;
      els.attCalendar.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => {
          state.attSelected = cell.dataset.date;
          renderAttCalendar();
          loadAttDay();
        });
      });
    }
    async function loadAttDay() {
      const date = state.attSelected;
      const d = parseDateStr(date);
      els.attDateLabel.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      const active = state.members.filter((m: any) => m.active);
      const { data, error } = await db.from('attendance').select('*').eq('group_key', state.activeGroup).eq('date', date);
      if (error) { console.error(error); showToast('Could not load attendance.'); return; }
      const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
      renderAttendance(active, map, date);
    }
    function renderAttendance(active: any[], map: Map<string, any>, date: string) {
      if (!active.length) {
        els.attBody.innerHTML = '<tr><td colspan="2" class="ws-empty">No active members in this group yet.</td></tr>';
        els.attSummary.textContent = '';
        return;
      }
      let presentCount = 0;
      els.attBody.innerHTML = active.map((m: any) => {
        const rec: any = map.get(m.id);
        if (rec && rec.present) presentCount++;
        return `
          <tr data-member-id="${m.id}">
            <td data-label="Name">${escapeHtml(m.full_name)}</td>
            <td data-label="Present"><input type="checkbox" data-att-present ${rec && rec.present ? 'checked' : ''} /></td>
          </tr>`;
      }).join('');
      els.attSummary.textContent = `${presentCount} of ${active.length} present`;

      // Ticking the box saves immediately — no separate save step.
      els.attBody.querySelectorAll('tr').forEach((row: any) => {
        const memberId = row.dataset.memberId;
        row.querySelector('[data-att-present]').addEventListener('change', () => {
          saveAttendance(memberId, date, row.querySelector('[data-att-present]').checked);
        });
      });
    }
    // note isn't left in the payload here (not just set to null) so any
    // note recorded before the Notes column was removed from this table
    // stays intact in the database instead of getting silently wiped.
    async function saveAttendance(memberId: string, date: string, present: boolean) {
      const { error } = await db.from('attendance').upsert({
        group_key: state.activeGroup, date, member_id: memberId, present,
        updated_by: state.session.user.id,
      }, { onConflict: 'group_key,date,member_id' });
      if (error) { console.error(error); showToast('Could not save attendance.'); return; }
      if (!state.attDatesWithRecords) state.attDatesWithRecords = new Set();
      state.attDatesWithRecords.add(date);
      renderAttCalendar();
      await loadAttDay();
    }
    function bindAttendance() {
      els.attPrev.addEventListener('click', () => {
        state.attAnchor = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth() - 1, 1);
        loadAttendance();
      });
      els.attNext.addEventListener('click', () => {
        state.attAnchor = new Date(state.attAnchor.getFullYear(), state.attAnchor.getMonth() + 1, 1);
        loadAttendance();
      });
      const stepDay = (n: number) => {
        const next = addDays(parseDateStr(state.attSelected), n);
        state.attSelected = toDateStr(next);
        // Crossing into a different visible month reloads the whole
        // calendar; staying within it just re-renders in place.
        if (next.getMonth() !== state.attAnchor.getMonth() || next.getFullYear() !== state.attAnchor.getFullYear()) {
          state.attAnchor = new Date(next.getFullYear(), next.getMonth(), 1);
          loadAttendance();
        } else {
          renderAttCalendar();
          loadAttDay();
        }
      };
      els.attDayPrev.addEventListener('click', () => stepDay(-1));
      els.attDayNext.addEventListener('click', () => stepDay(1));
    }

    // ---------- Fees ---------------------------------------------------
    const DEFAULT_EXPENSE_CATEGORIES = [
      'Supplies', 'Uniforms', 'Badges & Awards', 'Camping & Trips', 'Food & Refreshments',
      'Transportation', 'Equipment', 'Events & Ceremonies', 'Printing & Materials', 'Maintenance', 'Other',
    ];
    const DEFAULT_INCOME_CATEGORIES = [
      'Monthly Fees', 'Donations', 'Fundraising', 'Event Tickets', 'Sponsorships', 'Troop Store Sales', 'Other',
    ];
    async function loadGroupSettings() {
      if (!state.activeGroup) return;
      const { data } = await db.from('group_settings').select('*').eq('group_key', state.activeGroup).maybeSingle();
      state.groupSettings = data || {
        group_key: state.activeGroup, monthly_fee_defaults: {}, expense_categories: [], income_categories: [], activity_bank: [],
      };
      // Every group starts with the same sensible defaults — a leader
      // editing the list (add/remove) is what actually persists a custom
      // one; until then this just fills the dropdown/bank usefully.
      if (!state.groupSettings.expense_categories?.length) state.groupSettings.expense_categories = [...DEFAULT_EXPENSE_CATEGORIES];
      if (!state.groupSettings.income_categories?.length) state.groupSettings.income_categories = [...DEFAULT_INCOME_CATEGORIES];
      if (!state.groupSettings.activity_bank?.length) {
        state.groupSettings.activity_bank = ACTIVITY_BANK.map((a) => ({ id: a.type, en: a.en }));
      }
    }
    async function loadFees() {
      if (!state.activeGroup) return;
      populatePeriodSelects(els.feeMonth, els.feeYear);
      const period = getPeriod(els.feeMonth, els.feeYear);
      await loadGroupSettings();
      const defaults = state.groupSettings.monthly_fee_defaults || {};
      els.feeDefault.value = defaults[period] != null ? defaults[period] : '';

      const active = state.members.filter((m: any) => m.active);
      const { data, error } = await db.from('fee_payments').select('*').eq('group_key', state.activeGroup).eq('period', period);
      if (error) { console.error(error); showToast('Could not load fees.'); return; }
      const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
      renderFees(active, map, period);
    }
    function renderFees(active: any[], map: Map<string, any>, period: string) {
      const defaultAmount = els.feeDefault.value ? Number(els.feeDefault.value) : null;
      if (!active.length) {
        els.feeBody.innerHTML = '<tr><td colspan="4" class="ws-empty">No active members in this group yet.</td></tr>';
        els.feeSummary.textContent = '';
        return;
      }
      let paidCount = 0, collected = 0;
      els.feeBody.innerHTML = active.map((m: any) => {
        const rec: any = map.get(m.id);
        if (rec && rec.paid) { paidCount++; collected += Number(rec.amount || 0); }
        const amount = rec && rec.amount != null ? rec.amount : (defaultAmount != null ? defaultAmount : '');
        const paidOn = rec && rec.paid_on ? rec.paid_on : '';
        return `
          <tr data-member-id="${m.id}" data-paid-on="${paidOn}">
            <td data-label="Name">${escapeHtml(m.full_name)}</td>
            <td data-label="Paid"><input type="checkbox" data-fee-paid ${rec && rec.paid ? 'checked' : ''} /></td>
            <td data-label="Amount"><input type="number" step="0.01" min="0" class="ws-inline-amount" data-fee-amount value="${amount}" /></td>
            <td data-label="Paid on">${paidOn ? escapeHtml(paidOn) : '—'}</td>
          </tr>`;
      }).join('');
      els.feeSummary.textContent = `${paidCount} of ${active.length} paid — ${collected.toFixed(2)} collected`;

      // "Paid on" isn't an editable field — with a whole group usually
      // paying on the same day, picking a date per row was pure repetition.
      // It's just stamped with today's date the moment a member is first
      // marked paid, and cleared if unmarked; re-saving an already-paid
      // row (e.g. fixing the amount) keeps whatever date it already has.
      els.feeBody.querySelectorAll('tr').forEach((row: any) => {
        const memberId = row.dataset.memberId;
        const commit = () => {
          const paid = row.querySelector('[data-fee-paid]').checked;
          const amountVal = row.querySelector('[data-fee-amount]').value;
          let paidOn = row.dataset.paidOn || '';
          if (paid && !paidOn) paidOn = todayStr();
          saveFee(memberId, period, paid, amountVal ? Number(amountVal) : null, paid ? paidOn : null);
        };
        row.querySelector('[data-fee-paid]').addEventListener('change', commit);
        row.querySelector('[data-fee-amount]').addEventListener('blur', commit);
      });
    }
    async function saveFee(memberId: string, period: string, paid: boolean, amount: number | null, paidOn: string | null) {
      const { data: feeRow, error } = await db.from('fee_payments').upsert({
        group_key: state.activeGroup, member_id: memberId, period, paid, amount, paid_on: paidOn,
        updated_by: state.session.user.id,
      }, { onConflict: 'group_key,member_id,period' }).select().single();
      if (error) { console.error(error); showToast('Could not save.'); return; }
      await syncFeeToFinance(feeRow);
      await loadFees();
    }
    // Keeps a fee payment mirrored into the Finance ledger as an income
    // line — created/updated while paid, removed the moment it's unmarked
    // — so leaders never have to log the same collection twice.
    async function syncFeeToFinance(feeRow: any) {
      if (feeRow.paid && feeRow.amount) {
        const member = state.members.find((m: any) => m.id === feeRow.member_id);
        const payload = {
          group_key: state.activeGroup, entry_type: 'income', category: 'Monthly Fees',
          amount: feeRow.amount, entry_date: feeRow.paid_on || (feeRow.period + '-01'),
          description: `${member ? member.full_name : 'Member'} — ${feeRow.period}`,
          fee_payment_id: feeRow.id, created_by: state.session.user.id,
        };
        const { data: existing } = await db.from('finance_entries').select('id').eq('fee_payment_id', feeRow.id).maybeSingle();
        if (existing) await db.from('finance_entries').update(payload).eq('id', existing.id);
        else await db.from('finance_entries').insert(payload);
      } else {
        await db.from('finance_entries').delete().eq('fee_payment_id', feeRow.id);
      }
      if (state.activeTab === 'finance') await loadFinance();
    }
    async function saveDefaultFee() {
      if (!state.activeGroup) return;
      const period = getPeriod(els.feeMonth, els.feeYear);
      const current = state.groupSettings.monthly_fee_defaults || {};
      const val = els.feeDefault.value ? Number(els.feeDefault.value) : null;
      const updated = { ...current, [period]: val };
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, monthly_fee_defaults: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save default fee.'); return; }
      await loadFees();
    }

    // ---------- Settings (per-group config: Finance category lists) ------
    async function loadSettings() {
      if (!state.activeGroup) return;
      await loadGroupSettings();
      renderSettings();
    }
    function renderSettings() {
      renderCategoryList(els.settingsExpenseList, state.groupSettings.expense_categories || [], 'expense_categories');
      renderCategoryList(els.settingsIncomeList, state.groupSettings.income_categories || [], 'income_categories');
    }
    function renderCategoryList(container: any, list: string[], field: string) {
      container.innerHTML = list.length
        ? list.map((c) => `<span class="ws-category-chip">${escapeHtml(c)}<button type="button" data-remove-cat="${escapeHtml(c)}">×</button></span>`).join('')
        : '<p class="ws-empty" style="padding:0.5rem 0">None yet</p>';
      container.querySelectorAll('[data-remove-cat]').forEach((btn: any) => {
        btn.addEventListener('click', () => saveCategoryList(field, list.filter((c) => c !== btn.dataset.removeCat)));
      });
    }
    async function saveCategoryList(field: string, updated: string[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, [field]: updated }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save.'); return; }
      await loadSettings();
    }
    function bindSettings() {
      els.settingsExpenseAdd.addEventListener('click', () => {
        const val = els.settingsExpenseInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.expense_categories || [];
        if (current.includes(val)) { els.settingsExpenseInput.value = ''; return; }
        saveCategoryList('expense_categories', [...current, val]);
        els.settingsExpenseInput.value = '';
      });
      els.settingsIncomeAdd.addEventListener('click', () => {
        const val = els.settingsIncomeInput.value.trim();
        if (!val) return;
        const current = state.groupSettings?.income_categories || [];
        if (current.includes(val)) { els.settingsIncomeInput.value = ''; return; }
        saveCategoryList('income_categories', [...current, val]);
        els.settingsIncomeInput.value = '';
      });
    }

    // ---------- Finance ---------------------------------------------------
    async function loadFinance() {
      if (!state.activeGroup) return;
      populatePeriodSelects(els.finMonth, els.finYear, true);
      await loadGroupSettings();
      updateFinCategoryOptions();
      renderSettings();
      const { start, end, label } = periodRange(els.finMonth, els.finYear);
      state.finLabel = label;
      const { data, error } = await db.from('finance_entries').select('*')
        .eq('group_key', state.activeGroup).gte('entry_date', start).lte('entry_date', end)
        .order('entry_date', { ascending: false });
      if (error) { console.error(error); showToast('Could not load finance entries.'); return; }
      state.finEntries = data || [];
      renderFinance();
    }
    function categoryTotals(type: string) {
      const map = new Map<string, number>();
      state.finEntries.filter((e: any) => e.entry_type === type).forEach((e: any) => {
        const cat = e.category || 'Uncategorized';
        map.set(cat, (map.get(cat) || 0) + Number(e.amount));
      });
      return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
    }
    function renderFinance() {
      const incomeRows = categoryTotals('income');
      const expenseRows = categoryTotals('expense');
      const income = incomeRows.reduce((s, [, v]) => s + v, 0);
      const expense = expenseRows.reduce((s, [, v]) => s + v, 0);

      els.finStats.innerHTML = `
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">↑</span><span class="ws-stat-text"><span class="ws-stat-num">${income.toFixed(2)}</span><span class="ws-stat-label">Income</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">↓</span><span class="ws-stat-text"><span class="ws-stat-num">${expense.toFixed(2)}</span><span class="ws-stat-label">Expenses</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">=</span><span class="ws-stat-text"><span class="ws-stat-num">${(income - expense).toFixed(2)}</span><span class="ws-stat-label">Net</span></span></div>
      `;

      const rowsHtml = (rows: [string, number][]) => rows.length
        ? rows.map(([cat, amt]) => `<tr><td>${escapeHtml(cat)}</td><td>${amt.toFixed(2)}</td></tr>`).join('')
        : '<tr><td class="ws-empty" colspan="2">None</td></tr>';
      els.finStatement.innerHTML = `
        <h3 class="ws-admin-h3">Income Statement — ${escapeHtml(state.finLabel)}</h3>
        <table class="ws-statement-table">
          <tbody>
            <tr class="ws-statement-section"><td colspan="2">Income</td></tr>
            ${rowsHtml(incomeRows)}
            <tr class="ws-statement-total"><td>Total Income</td><td>${income.toFixed(2)}</td></tr>
            <tr class="ws-statement-section"><td colspan="2">Expenses</td></tr>
            ${rowsHtml(expenseRows)}
            <tr class="ws-statement-total"><td>Total Expenses</td><td>${expense.toFixed(2)}</td></tr>
            <tr class="ws-statement-net"><td>Net Income</td><td>${(income - expense).toFixed(2)}</td></tr>
          </tbody>
        </table>
      `;

      if (!state.finEntries.length) {
        els.finBody.innerHTML = '<tr><td colspan="7" class="ws-empty">No entries this month.</td></tr>';
        return;
      }
      els.finBody.innerHTML = state.finEntries.map((e: any) => `
        <tr data-entry-id="${e.id}" data-receipt-path="${escapeHtml(e.receipt_path || '')}">
          <td data-label="Date">${e.entry_date}</td>
          <td data-label="Type">${e.entry_type === 'income' ? 'Income' : 'Expense'}</td>
          <td data-label="Category">${escapeHtml(e.category || '—')}${e.fee_payment_id ? ' <span class="ws-allergy-badge" title="Synced from the Fees tab — unmark it paid there to remove this">Auto</span>' : ''}</td>
          <td data-label="Description">${escapeHtml(e.description || '—')}</td>
          <td data-label="Amount">${Number(e.amount).toFixed(2)}</td>
          <td data-label="Receipt">${e.receipt_path ? '<button type="button" class="ws-edit-btn" data-fin-receipt-view>View</button>' : '—'}</td>
          <td class="ws-row-actions">${e.fee_payment_id ? '' : '<button type="button" class="ws-row-del" data-fin-del>×</button>'}</td>
        </tr>
      `).join('');
      els.finBody.querySelectorAll('[data-fin-receipt-view]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const path = btn.closest('tr').dataset.receiptPath;
          const { data, error } = await db.storage.from('documents').createSignedUrl(path, 60);
          if (error || !data) { showToast('Could not open receipt.'); return; }
          window.open(data.signedUrl, '_blank');
        });
      });
      els.finBody.querySelectorAll('[data-fin-del]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const row = btn.closest('tr');
          const id = row.dataset.entryId;
          if (!confirm('Delete this entry?')) return;
          const { error } = await db.from('finance_entries').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          await loadFinance();
        });
      });
    }
    function updateFinCategoryOptions() {
      const list = els.finType.value === 'income'
        ? (state.groupSettings?.income_categories || [])
        : (state.groupSettings?.expense_categories || []);
      els.finCategory.innerHTML = list.length
        ? list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : '<option value="">No categories yet — add some in the Categories tab</option>';
    }
    function bindFinanceForm() {
      els.finType.addEventListener('change', updateFinCategoryOptions);
      els.finForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const type = els.finType.value;
        const category = els.finCategory.value.trim();
        const amount = el('[data-fin-amount]').value;
        const date = el('[data-fin-date]').value;
        const description = el('[data-fin-description]').value.trim();
        if (!amount || !date) { showToast('Amount and date are required.'); return; }
        els.finSubmit.disabled = true;

        let receiptPath: string | null = null;
        const file = els.finReceipt.files[0];
        if (file) {
          const path = `${state.activeGroup}/receipts/${Date.now()}-${file.name}`;
          const { error: upErr } = await db.storage.from('documents').upload(path, file);
          if (upErr) { console.error(upErr); showToast('Could not upload receipt.'); els.finSubmit.disabled = false; return; }
          receiptPath = path;
        }

        const { error } = await db.from('finance_entries').insert({
          group_key: state.activeGroup, entry_type: type, category: category || null,
          amount: Number(amount), entry_date: date, description: description || null,
          receipt_path: receiptPath, created_by: state.session.user.id,
        });
        els.finSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not add entry.'); return; }
        els.finForm.reset();
        updateFinCategoryOptions();
        await loadFinance();
      });
    }

    // ---------- Library (document storage, per group — no shared/troop-
    // wide documents) -------------------------------------------------------
    async function loadLibrary() {
      if (!state.activeGroup) return;
      const { data, error } = await db.from('documents').select('*')
        .eq('group_key', state.activeGroup)
        .order('uploaded_at', { ascending: false });
      if (error) { console.error(error); showToast('Could not load documents.'); return; }
      state.docs = data || [];
      renderLibrary();
    }
    function renderLibrary() {
      if (!state.docs.length) {
        els.libBody.innerHTML = '<tr><td colspan="4" class="ws-empty">No documents yet.</td></tr>';
        return;
      }
      els.libBody.innerHTML = state.docs.map((d: any) => `
        <tr data-doc-id="${d.id}" data-doc-path="${escapeHtml(d.file_path)}">
          <td data-label="Title">${escapeHtml(d.title)}</td>
          <td data-label="Type">${escapeHtml(d.file_type || '—')}</td>
          <td data-label="Uploaded">${new Date(d.uploaded_at).toLocaleDateString()}</td>
          <td class="ws-row-actions">
            <button type="button" class="ws-edit-btn" data-doc-download>Download</button>
            <button type="button" class="ws-row-del" data-doc-del>×</button>
          </td>
        </tr>
      `).join('');
      els.libBody.querySelectorAll('tr').forEach((row: any) => {
        const path = row.dataset.docPath;
        const id = row.dataset.docId;
        row.querySelector('[data-doc-download]').addEventListener('click', async () => {
          const { data, error } = await db.storage.from('documents').createSignedUrl(path, 60);
          if (error || !data) { showToast('Could not open file.'); return; }
          window.open(data.signedUrl, '_blank');
        });
        row.querySelector('[data-doc-del]').addEventListener('click', async () => {
          if (!confirm('Delete this document?')) return;
          await db.storage.from('documents').remove([path]);
          const { error } = await db.from('documents').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          await loadLibrary();
        });
      });
    }
    function bindLibraryUpload() {
      els.libUpload.addEventListener('click', async () => {
        const file = els.libFile.files[0];
        if (!file) { showToast('Choose a file first.'); return; }
        els.libUpload.disabled = true;
        const path = `${state.activeGroup}/${Date.now()}-${file.name}`;
        const { error: upErr } = await db.storage.from('documents').upload(path, file);
        if (upErr) { console.error(upErr); showToast('Could not upload.'); els.libUpload.disabled = false; return; }
        const title = els.libTitle.value.trim() || file.name;
        const { error } = await db.from('documents').insert({
          group_key: state.activeGroup, category: 'general', title, file_path: path,
          file_type: file.type || null, size_bytes: file.size, uploaded_by: state.session.user.id,
        });
        els.libUpload.disabled = false;
        if (error) { console.error(error); showToast('Could not save document.'); return; }
        els.libFile.value = '';
        els.libTitle.value = '';
        await loadLibrary();
      });
    }

    // ---------- Reports (PDF export via print) -----------------------------
    // Reports can be the very first tab someone opens after signing in, so
    // the roster may never have loaded yet — fetch it on demand instead of
    // silently reporting zero members.
    async function ensureMembersLoaded() {
      if (state.members.length || !state.activeGroup) return;
      const { data } = await db.from('members').select('*').eq('group_key', state.activeGroup).order('full_name', { ascending: true });
      state.members = data || [];
    }
    // Real PDF generation (not the browser print dialog) — Reports and
    // Curriculum are English-only now, so jsPDF's limited RTL support is
    // no longer a concern, and this gives a genuine one-click download.
    const PDF_BRAND: [number, number, number] = [87, 22, 7];
    const PDF_ACCENT: [number, number, number] = [20, 56, 34];
    const PDF_FOOT_BG: [number, number, number] = [250, 243, 232];
    function pdfHeader(doc: any, title: string, rangeLabel: string, groupNameOverride?: string): number {
      const g = GROUPS.find((x) => x.key === state.activeGroup);
      const groupName = groupNameOverride || (g ? g.en : (state.activeGroup || ''));
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9);
      doc.setTextColor(...PDF_BRAND);
      doc.text('GREEK ORTHODOX SCOUTS & GUIDES — SWEFIEH', 14, 15);
      doc.setFontSize(17);
      doc.text(`${groupName} — ${title}`, 14, 25);
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.setTextColor(90, 90, 90);
      doc.text(rangeLabel, 14, 32);
      doc.setDrawColor(...PDF_BRAND);
      doc.setLineWidth(0.6);
      doc.line(14, 36, 196, 36);
      doc.setFontSize(8);
      doc.setTextColor(150, 150, 150);
      doc.text(`Generated by ${state.profile?.name || ''} on ${new Date().toLocaleDateString()}`, 14, 41);
      return 48;
    }
    function pdfNextY(doc: any, fallback: number): number {
      return (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 10 : fallback;
    }
    function pdfFilename(title: string, label: string, groupNameOverride?: string): string {
      const g = GROUPS.find((x) => x.key === state.activeGroup);
      const groupName = groupNameOverride || (g ? g.en : (state.activeGroup || ''));
      return `${groupName}-${title}-${label}`.replace(/[^a-z0-9]+/gi, '-').toLowerCase().replace(/^-+|-+$/g, '') + '.pdf';
    }
    async function downloadFinanceReport() {
      try {
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const { data, error } = await db.from('finance_entries').select('*')
          .eq('group_key', state.activeGroup).gte('entry_date', start).lte('entry_date', end);
        if (error) throw error;
        const entries = data || [];
        const totals = (type: string) => {
          const map = new Map<string, number>();
          entries.filter((e: any) => e.entry_type === type).forEach((e: any) => {
            const cat = e.category || 'Uncategorized';
            map.set(cat, (map.get(cat) || 0) + Number(e.amount));
          });
          return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
        };
        const incomeRows = totals('income'), expenseRows = totals('expense');
        const income = incomeRows.reduce((s, [, v]) => s + v, 0);
        const expense = expenseRows.reduce((s, [, v]) => s + v, 0);

        const doc = new jsPDF();
        let y = pdfHeader(doc, 'Income Statement', label);
        const tableOpts = {
          theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          footStyles: { fillColor: PDF_FOOT_BG, textColor: PDF_BRAND, fontStyle: 'bold' },
          columnStyles: { 1: { halign: 'right' } },
        };
        autoTable(doc, { ...tableOpts, startY: y, head: [['Income', '']],
          body: incomeRows.length ? incomeRows.map(([c, v]) => [c, v.toFixed(2)]) : [['No data available', '']],
          foot: [['Total Income', income.toFixed(2)]] });
        y = pdfNextY(doc, y);
        autoTable(doc, { ...tableOpts, startY: y, head: [['Expenses', '']],
          body: expenseRows.length ? expenseRows.map(([c, v]) => [c, v.toFixed(2)]) : [['No data available', '']],
          foot: [['Total Expenses', expense.toFixed(2)]] });
        y = pdfNextY(doc, y);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(13);
        doc.setTextColor(...PDF_ACCENT);
        doc.text(`Net Income: ${(income - expense).toFixed(2)}`, 14, y);
        doc.save(pdfFilename('Income-Statement', label));
      } catch (err) {
        console.error('finance report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    async function downloadFeesReport() {
      try {
        await ensureMembersLoaded();
        const { period, label, isYear } = periodRange(els.reportMonth, els.reportYear);
        const active = state.members.filter((m: any) => m.active);
        const doc = new jsPDF();
        if (!isYear) {
          const { data, error } = await db.from('fee_payments').select('*').eq('group_key', state.activeGroup).eq('period', period);
          if (error) throw error;
          const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
          let collected = 0, paidCount = 0;
          const rows = active.map((m: any) => {
            const rec = map.get(m.id);
            if (rec && rec.paid) { collected += Number(rec.amount || 0); paidCount++; }
            return [m.full_name, rec && rec.paid ? 'Paid' : 'Unpaid', rec && rec.amount != null ? Number(rec.amount).toFixed(2) : '—'];
          });
          const y = pdfHeader(doc, 'Monthly Fees', `${label} — ${paidCount} of ${active.length} paid, ${collected.toFixed(2)} collected`);
          autoTable(doc, { startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            head: [['Member', 'Status', 'Amount']], body: rows.length ? rows : [['No data available', '', '']] });
          doc.save(pdfFilename('Monthly-Fees', label));
        } else {
          const year = els.reportYear.value;
          const { data, error } = await db.from('fee_payments').select('*').eq('group_key', state.activeGroup).like('period', `${year}-%`);
          if (error) throw error;
          const byMember = new Map<string, { months: number; total: number }>();
          (data || []).forEach((r: any) => {
            if (!r.paid) return;
            const cur = byMember.get(r.member_id) || { months: 0, total: 0 };
            cur.months++; cur.total += Number(r.amount || 0);
            byMember.set(r.member_id, cur);
          });
          const rows = active.map((m: any) => {
            const s = byMember.get(m.id) || { months: 0, total: 0 };
            return [m.full_name, `${s.months} / 12`, s.total.toFixed(2)];
          });
          const grandTotal = active.reduce((sum: number, m: any) => sum + (byMember.get(m.id)?.total || 0), 0);
          const y = pdfHeader(doc, 'Yearly Fees Summary', `${label} — ${grandTotal.toFixed(2)} collected total`);
          autoTable(doc, { startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            head: [['Member', 'Months Paid', 'Total']], body: rows.length ? rows : [['No data available', '', '']] });
          doc.save(pdfFilename('Yearly-Fees', label));
        }
      } catch (err) {
        console.error('fees report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    async function downloadAttendanceReport() {
      try {
        await ensureMembersLoaded();
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const active = state.members.filter((m: any) => m.active);
        const { data, error } = await db.from('attendance').select('*').eq('group_key', state.activeGroup).gte('date', start).lte('date', end);
        if (error) throw error;
        const rows = data || [];
        const totalSessions = new Set(rows.map((r: any) => r.date)).size;
        const presentByMember = new Map<string, number>();
        rows.forEach((r: any) => { if (r.present) presentByMember.set(r.member_id, (presentByMember.get(r.member_id) || 0) + 1); });
        const bodyRows = active.map((m: any) => {
          const present = presentByMember.get(m.id) || 0;
          const rate = totalSessions ? Math.round((present / totalSessions) * 100) : 0;
          return [m.full_name, `${present} / ${totalSessions}`, `${rate}%`];
        });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Attendance', `${label} — ${totalSessions} meeting${totalSessions === 1 ? '' : 's'} held`);
        autoTable(doc, { startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          head: [['Member', 'Present', 'Rate']], body: bodyRows.length ? bodyRows : [['No data available', '', '']] });
        doc.save(pdfFilename('Attendance', label));
      } catch (err) {
        console.error('attendance report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    async function downloadCurriculumReport() {
      try {
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const { data, error } = await db.from('curriculum_meetings').select('*')
          .eq('group_key', state.activeGroup).gte('date', start).lte('date', end)
          .order('date', { ascending: true });
        if (error) throw error;
        const rows = (data || [])
          .filter((m: any) => (m.activities && m.activities.length) || m.theme || m.notes)
          .map((m: any) => {
            const d = new Date(m.date + 'T00:00:00');
            const dateLabel = `${WEEKDAYS[d.getDay()].en} ${d.getDate()} ${MONTHS[d.getMonth()].en}`;
            const activitiesText = (m.activities || []).map((a: any) => a.en + (a.duration ? ` (${a.duration} min)` : '')).join('\n');
            return [dateLabel, m.theme || '—', activitiesText || '—', m.notes || '—'];
          });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Curriculum', label);
        autoTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9, valign: 'top' },
          columnStyles: { 0: { cellWidth: 30 }, 1: { cellWidth: 32 } },
          head: [['Date', 'Theme', 'Activities', 'Notes']],
          body: rows.length ? rows : [['No meetings planned in this range yet.', '', '', '']],
        });
        doc.save(pdfFilename('Curriculum', label));
      } catch (err) {
        console.error('curriculum report failed', err);
        showToast('Could not generate the report — check your connection and try again.');
      }
    }
    function bindReports() {
      populatePeriodSelects(els.reportMonth, els.reportYear, true);
      el('[data-report-finance]').addEventListener('click', downloadFinanceReport);
      el('[data-report-fees]').addEventListener('click', downloadFeesReport);
      el('[data-report-attendance]').addEventListener('click', downloadAttendanceReport);
      el('[data-report-curriculum]').addEventListener('click', downloadCurriculumReport);
    }

    // ---------- Curriculum (embedded, shared per group; month view only,
    // click-to-plan instead of drag-and-drop) ------------------------------
    function currComputeRange() {
      const first = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth(), 1);
      const last = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() + 1, 0);
      return { start: startOfWeek(first), end: addDays(startOfWeek(last), 6) };
    }
    async function currLoadMeetings() {
      const { start, end } = currComputeRange();
      const { data, error } = await db.from('curriculum_meetings').select('*')
        .eq('group_key', state.activeGroup).gte('date', toDateStr(start)).lte('date', toDateStr(end));
      if (error) { console.error(error); showToast('Could not load the curriculum.'); return; }
      state.curr.meetings = new Map((data || []).map((row: any) => [row.date, row]));
    }
    function currGetOrCreateMeeting(dateStr: string) {
      let m = state.curr.meetings.get(dateStr);
      if (!m) {
        m = { group_key: state.activeGroup, date: dateStr, theme: null, notes: null, activities: [], created_by: state.profile?.name || null };
        state.curr.meetings.set(dateStr, m);
      }
      return m;
    }
    async function currPersistMeeting(dateStr: string) {
      const m = state.curr.meetings.get(dateStr);
      if (!m) return;
      const isEmpty = (!m.activities || m.activities.length === 0) && !m.theme && !m.notes;
      try {
        if (isEmpty) {
          if (m.id) await db.from('curriculum_meetings').delete().eq('id', m.id);
          else await db.from('curriculum_meetings').delete().eq('group_key', state.activeGroup).eq('date', dateStr);
          state.curr.meetings.delete(dateStr);
          return;
        }
        const payload: any = {
          group_key: m.group_key, date: m.date, theme: m.theme || null, notes: m.notes || null,
          activities: m.activities, updated_by: state.profile?.name || null,
        };
        if (!m.id) payload.created_by = m.created_by || state.profile?.name || null;
        const { data, error } = await db.from('curriculum_meetings').upsert(payload, { onConflict: 'group_key,date' }).select().single();
        if (error) throw error;
        state.curr.meetings.set(dateStr, data);
        flashSaved();
      } catch (err) {
        console.error('curriculum save failed', err);
        showToast('Could not save — check your connection.');
      }
    }
    function currSubscribeRealtime(groupKey: string) {
      if (state.curr.channel) { db.removeChannel(state.curr.channel); state.curr.channel = null; }
      state.curr.channel = db.channel('curriculum-' + groupKey)
        .on('postgres_changes', {
          event: '*', schema: 'public', table: 'curriculum_meetings', filter: 'group_key=eq.' + groupKey,
        }, (payload: any) => {
          const row = payload.eventType === 'DELETE' ? payload.old : payload.new;
          if (!row || !row.date) return;
          if (payload.eventType === 'DELETE') state.curr.meetings.delete(row.date);
          else state.curr.meetings.set(row.date, row);
          currRefreshUI();
        })
        .subscribe();
    }
    function currRefreshUI() {
      currRenderMonth();
      if (state.curr.currentDay && els.currDayOverlay && !els.currDayOverlay.hidden) {
        currRenderActivityList(els.currDayList, state.curr.currentDay);
      }
    }
    function currActivityRowHTML(a: any) {
      return `
        <div class="curr-item" data-activity-id="${a.id}">
          <span class="curr-item-text"><span class="curr-item-en">${escapeHtml(a.en)}</span></span>
          <input type="number" min="0" step="5" class="curr-item-duration" placeholder="min"
                 value="${a.duration != null ? a.duration : ''}" data-duration="${a.id}" />
          <button type="button" class="curr-item-del" data-del="${a.id}" aria-label="Remove">×</button>
        </div>`;
    }
    function currRenderActivityList(container: any, dateStr: string) {
      if (!container) return;
      const m = state.curr.meetings.get(dateStr);
      const activities = m ? m.activities : [];
      container.innerHTML = activities.length
        ? activities.map(currActivityRowHTML).join('')
        : '<p class="curr-empty">No activities yet — pick one from the bank or add a custom one below.</p>';
      container.querySelectorAll('[data-del]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          mm.activities = mm.activities.filter((a: any) => a.id !== btn.dataset.del);
          currRefreshUI();
          currPersistMeeting(dateStr);
        });
      });
      container.querySelectorAll('[data-duration]').forEach((inp: any) => {
        inp.addEventListener('change', () => {
          const mm = state.curr.meetings.get(dateStr);
          if (!mm) return;
          const act = mm.activities.find((a: any) => a.id === inp.dataset.duration);
          if (!act) return;
          act.duration = inp.value ? Number(inp.value) : null;
          currPersistMeeting(dateStr);
        });
      });
    }
    function currAddActivity(dateStr: string, en: string) {
      const activity = { id: cryptoRandomId(), en, duration: null };
      const m = currGetOrCreateMeeting(dateStr);
      m.activities.push(activity);
      currRefreshUI();
      currPersistMeeting(dateStr);
    }
    function currRenderMonth() {
      const anchor = state.curr.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) =>
        `<div class="curr-weekday">${w.en}</div>`
      ).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const meeting = state.curr.meetings.get(dateStr);
        const acts = meeting ? meeting.activities : [];
        const shown = acts.slice(0, 3);
        const extra = acts.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${acts.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          ${meeting && meeting.theme ? `<span class="curr-day-theme">${escapeHtml(meeting.theme)}</span>` : ''}
          <div class="curr-day-mini">
            ${shown.map((a: any) => `<span class="curr-mini-chip">${escapeHtml(a.en)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.currMonthGrid.innerHTML = html;
      els.currMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => currOpenDayPanel(cell.dataset.date));
      });
    }
    function currOpenDayPanel(dateStr: string) {
      state.curr.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      const m = state.curr.meetings.get(dateStr);
      els.currDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      els.currDayTheme.value = (m && m.theme) || '';
      els.currDayNotes.value = (m && m.notes) || '';
      currRenderActivityList(els.currDayList, dateStr);
      els.currDayOverlay.removeAttribute('hidden');
      // Lock background scroll while the modal is open — otherwise the
      // page can scroll behind it and the sticky header/footer end up
      // looking like they're overlapping the popup.
      document.documentElement.style.overflow = 'hidden';
    }
    function currCloseDayPanel() {
      els.currDayOverlay.setAttribute('hidden', '');
      state.curr.currentDay = null;
      document.documentElement.style.overflow = '';
    }
    // Theme/Notes only commit when Save is pressed — activities (bank
    // picks, custom adds, removes) still save instantly, same as
    // everywhere else in the workspace.
    function currSaveDay() {
      if (!state.curr.currentDay) return;
      const m = currGetOrCreateMeeting(state.curr.currentDay);
      m.theme = els.currDayTheme.value.trim() || null;
      m.notes = els.currDayNotes.value.trim() || null;
      currPersistMeeting(state.curr.currentDay);
      currRenderMonth();
      currCloseDayPanel();
    }
    function currCancelDay() {
      currCloseDayPanel();
    }
    // Steps to the next/previous day, pulling in a different month's data
    // first if that date falls outside what's currently loaded.
    async function currStepDay(n: number) {
      if (!state.curr.currentDay) return;
      const next = addDays(parseDateStr(state.curr.currentDay), n);
      const nextStr = toDateStr(next);
      const { start, end } = currComputeRange();
      if (next < start || next > end) {
        state.curr.anchor = next;
        await currReload();
      }
      currOpenDayPanel(nextStr);
    }
    function currUpdateNavLabel() {
      const a = state.curr.anchor;
      els.currNavLabel.textContent = `${MONTHS[a.getMonth()].en} ${a.getFullYear()}`;
    }
    async function currReload() {
      currUpdateNavLabel();
      await currLoadMeetings();
      currRenderMonth();
      currRenderListView();
    }
    // Plain list of every meeting planned this month — the same rows
    // Export PDF produces, rendered on the page instead of downloaded.
    // Kept in sync alongside the calendar (not only when List is the
    // active view) so switching to it never shows stale data.
    function currRenderListView() {
      const { start, end } = currComputeRange();
      const rows: any[] = [];
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.curr.meetings.get(dateStr);
        if (m && ((m.activities && m.activities.length) || m.theme || m.notes)) {
          rows.push({
            dateLabel: `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}`,
            theme: m.theme,
            activities: m.activities || [],
            notes: m.notes,
          });
        }
        d = addDays(d, 1);
      }
      els.currListBody.innerHTML = rows.length
        ? rows.map((r: any) => `
            <tr>
              <td data-label="Date">${escapeHtml(r.dateLabel)}</td>
              <td data-label="Theme">${escapeHtml(r.theme || '—')}</td>
              <td data-label="Activities">${r.activities.length
                ? r.activities.map((a: any) => escapeHtml(a.en) + (a.duration ? ` (${a.duration} min)` : '')).join('<br>')
                : '—'}</td>
              <td data-label="Notes">${escapeHtml(r.notes || '—')}</td>
            </tr>
          `).join('')
        : '<tr><td colspan="4" class="ws-empty">Nothing planned yet this month.</td></tr>';
    }
    function currSetPlanView(view: string) {
      document.querySelectorAll('[data-plan-view]').forEach((b: any) => b.classList.toggle('curr-view-btn--active', b.dataset.planView === view));
      document.querySelectorAll('[data-curr-plan-view]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.currPlanView !== view));
    }
    function currNavPrev() {
      state.curr.anchor = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() - 1, 1);
      currReload();
    }
    function currNavNext() {
      state.curr.anchor = new Date(state.curr.anchor.getFullYear(), state.curr.anchor.getMonth() + 1, 1);
      currReload();
    }
    function currNavToday() { state.curr.anchor = new Date(); currReload(); }
    function currExportPDF() {
      const { start, end } = currComputeRange();
      const rows: any[] = [];
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.curr.meetings.get(dateStr);
        if (m && m.activities && m.activities.length) {
          const dateLabel = `${WEEKDAYS[d.getDay()].en} ${d.getDate()} ${MONTHS[d.getMonth()].en}`;
          const activitiesText = m.activities.map((a: any) => a.en + (a.duration ? ` (${a.duration} min)` : '')).join('\n');
          rows.push([dateLabel, m.theme || '—', activitiesText, m.notes || '—']);
        }
        d = addDays(d, 1);
      }
      const doc = new jsPDF();
      const y = pdfHeader(doc, 'Curriculum', els.currNavLabel.textContent);
      autoTable(doc, {
        startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9, valign: 'top' },
        columnStyles: { 0: { cellWidth: 30 }, 1: { cellWidth: 32 } },
        head: [['Date', 'Theme', 'Activities', 'Notes']],
        body: rows.length ? rows : [['No meetings planned in this range yet.', '', '', '']],
      });
      doc.save(pdfFilename('Curriculum', els.currNavLabel.textContent));
    }

    // ---------- Activity Bank (per-group, editable) -----------------------
    // A dropdown rather than a wall of chips — chips stop being scannable
    // once a group has more than a handful of activities in their bank,
    // a <select> stays efficient no matter how long the list gets.
    function currRenderBankOptions() {
      const items = state.groupSettings?.activity_bank || [];
      if (!items.length) {
        els.currBankSelect.innerHTML = '<option value="">No activities yet — add some in the Activity Bank tab</option>';
        els.currBankSelect.disabled = true;
        return;
      }
      els.currBankSelect.disabled = false;
      els.currBankSelect.innerHTML = '<option value="">Choose an activity…</option>' +
        items.map((a: any) => `<option value="${escapeHtml(a.en)}">${escapeHtml(a.en)}</option>`).join('');
    }
    function currRenderBankList() {
      const items = state.groupSettings?.activity_bank || [];
      els.currBankList.innerHTML = items.length
        ? items.map((a: any) => `
            <span class="curr-bank-item">${escapeHtml(a.en)}<button type="button" data-remove-bank="${escapeHtml(a.id)}" aria-label="Remove">×</button></span>
          `).join('')
        : '<p class="ws-empty" style="padding:0.5rem 0">No activities in the bank yet — add one above.</p>';
      els.currBankList.querySelectorAll('[data-remove-bank]').forEach((btn: any) => {
        btn.addEventListener('click', () => currRemoveBankItem(btn.dataset.removeBank));
      });
    }
    async function currSaveBank(items: any[]) {
      const { error } = await db.from('group_settings').upsert({ group_key: state.activeGroup, activity_bank: items }, { onConflict: 'group_key' });
      if (error) { console.error(error); showToast('Could not save the activity bank.'); return; }
      state.groupSettings.activity_bank = items;
      currRenderBankOptions();
      currRenderBankList();
    }
    async function currAddBankItem(en: string) {
      if (!en.trim()) return;
      const current = state.groupSettings?.activity_bank || [];
      await currSaveBank([...current, { id: cryptoRandomId(), en: en.trim() }]);
    }
    async function currRemoveBankItem(id: string) {
      const current = state.groupSettings?.activity_bank || [];
      await currSaveBank(current.filter((a: any) => a.id !== id));
    }
    function currSetSubtab(name: string) {
      document.querySelectorAll('.curr-subtab').forEach((b: any) => b.classList.toggle('curr-subtab--active', b.dataset.subtab === name));
      document.querySelectorAll('[data-curr-subpanel]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.currSubpanel !== name));
    }

    function currBindStatics() {
      els.currPrev.addEventListener('click', currNavPrev);
      els.currNext.addEventListener('click', currNavNext);
      els.currToday.addEventListener('click', currNavToday);
      els.currExport.addEventListener('click', currExportPDF);
      document.querySelectorAll('[data-plan-view]').forEach((btn: any) => {
        btn.addEventListener('click', () => currSetPlanView(btn.dataset.planView));
      });
      els.currDaySave.addEventListener('click', currSaveDay);
      els.currDayCancel.addEventListener('click', currCancelDay);
      els.currDayPrev.addEventListener('click', () => currStepDay(-1));
      els.currDayNext.addEventListener('click', () => currStepDay(1));
      document.addEventListener('click', (e: any) => {
        if (els.currDayOverlay.hidden) return;
        if (e.target.closest('[data-curr-day-panel]')) return;
        if (e.target.closest('.curr-day-cell')) return;
        currCancelDay();
      });
      els.currBankSelectForm.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        const val = els.currBankSelect.value;
        if (!val || !state.curr.currentDay) return;
        currAddActivity(state.curr.currentDay, val);
        els.currBankSelect.value = '';
      });
      els.currCustomAddForm.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        const en = els.currCustomEn.value.trim();
        if (!en || !state.curr.currentDay) return;
        currAddActivity(state.curr.currentDay, en);
        els.currCustomEn.value = '';
      });
      document.querySelectorAll('.curr-subtab').forEach((btn: any) => {
        btn.addEventListener('click', () => currSetSubtab(btn.dataset.subtab));
      });
      els.currBankAddForm.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        currAddBankItem(els.currBankAddEn.value);
        els.currBankAddForm.reset();
      });
    }
    async function currStart() {
      await loadGroupSettings();
      currRenderBankOptions();
      currRenderBankList();
      currSubscribeRealtime(state.activeGroup);
      await currReload();
    }

    function showG2(focus = true) {
      els.g2Fields.hidden = false;
      els.g2Add.hidden = true;
      if (focus) els.mG2Rel.focus();
    }
    function hideG2() {
      els.g2Fields.hidden = true;
      els.g2Add.hidden = false;
      els.mG2Rel.value = '';
      els.mG2Phone.value = '';
    }
    function showAllergy(focus = true) {
      els.allergyFields.hidden = false;
      els.allergyAdd.hidden = true;
      if (focus) els.mAllergyDetail.focus();
    }
    function hideAllergy() {
      els.allergyFields.hidden = true;
      els.allergyAdd.hidden = false;
      els.mAllergyDetail.value = '';
    }
    function readMemberForm() {
      const name = els.mName.value.trim();
      const g1Rel = els.mG1Rel.value;
      const g1Phone = els.mG1Phone.value.trim();
      if (!name || !g1Rel || !g1Phone) return null;
      const hasAllergies = !els.allergyFields.hidden;
      return {
        group_key: state.activeGroup,
        full_name: name,
        birth_date: els.mDob.value || null,
        guardian1_relation: g1Rel,
        guardian1_phone: g1Phone,
        guardian2_relation: !els.g2Fields.hidden ? (els.mG2Rel.value || null) : null,
        guardian2_phone: !els.g2Fields.hidden ? (els.mG2Phone.value.trim() || null) : null,
        has_allergies: hasAllergies,
        allergy_detail: hasAllergies ? els.mAllergyDetail.value.trim() || null : null,
        notes: els.mNotes.value.trim() || null,
      };
    }
    function resetMemberForm() {
      els.rosterForm.reset();
      hideG2();
      hideAllergy();
      state.editingMemberId = null;
      els.formTitle.textContent = 'Add a member';
      els.formSubmit.textContent = 'Add member';
      els.formCancel.hidden = true;
    }
    function startEditMember(id: string) {
      const m = state.members.find((x: any) => x.id === id);
      if (!m) return;
      if (state.activeTab !== 'roster') setTab('roster');
      state.editingMemberId = id;
      els.mName.value = m.full_name || '';
      els.mDob.value = m.birth_date || '';
      els.mG1Rel.value = m.guardian1_relation || '';
      els.mG1Phone.value = m.guardian1_phone || '';
      if (m.guardian2_relation || m.guardian2_phone) {
        showG2(false);
        els.mG2Rel.value = m.guardian2_relation || '';
        els.mG2Phone.value = m.guardian2_phone || '';
      } else {
        hideG2();
      }
      if (m.has_allergies) {
        showAllergy(false);
        els.mAllergyDetail.value = m.allergy_detail || '';
      } else {
        hideAllergy();
      }
      els.mNotes.value = m.notes || '';
      els.formTitle.textContent = `Editing ${m.full_name}`;
      els.formSubmit.textContent = 'Save changes';
      els.formCancel.hidden = false;
      els.rosterForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function bindRosterForm() {
      bindTitleCase(els.mName);
      els.g2Add.addEventListener('click', () => showG2());
      els.g2Remove.addEventListener('click', () => hideG2());
      els.allergyAdd.addEventListener('click', () => showAllergy());
      els.allergyRemove.addEventListener('click', () => hideAllergy());
      els.formCancel.addEventListener('click', resetMemberForm);
      els.rosterForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const payload = readMemberForm();
        if (!payload) { showToast('Full name, Guardian 1 relation, and Guardian 1 phone are required.'); return; }
        if (state.editingMemberId) {
          const { error } = await db.from('members').update(payload).eq('id', state.editingMemberId);
          if (error) { console.error(error); showToast('Could not save member.'); return; }
        } else {
          const { error } = await db.from('members').insert({ ...payload, created_by: state.session.user.id });
          if (error) { console.error(error); showToast('Could not add member.'); return; }
        }
        resetMemberForm();
        await loadRoster();
      });
    }

    // ---------- Dashboard ---------------------------------------------------
    function dashGreeting() {
      const h = new Date().getHours();
      const first = (state.profile?.name || '').trim().split(/\s+/)[0];
      const time = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
      return first ? `${time}, ${first}` : time;
    }
    function dashDeltaBadge(val: number | null, suffix = ''): string {
      if (val == null || Number.isNaN(val) || val === 0) {
        return `<span class="ws-dash-delta ws-dash-delta--flat">– steady</span>`;
      }
      const up = val > 0;
      return `<span class="ws-dash-delta ${up ? 'ws-dash-delta--up' : 'ws-dash-delta--down'}">${up ? '↑' : '↓'} ${Math.abs(val)}${suffix} vs last period</span>`;
    }
    async function loadDashboard() {
      if (!state.activeGroup) return;
      await ensureMembersLoaded();
      await loadGroupSettings();

      const g = GROUPS.find((x: any) => x.key === state.activeGroup);
      els.dashGreeting.textContent = dashGreeting();
      els.dashGroup.textContent = g ? `${g.en} workspace` : 'Your workspace';
      els.dashDate.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

      const active = state.members.filter((m: any) => m.active);
      const archivedCount = state.members.length - active.length;
      const allergyCount = active.filter((m: any) => m.has_allergies).length;

      const now = new Date();
      const day30 = toDateStr(addDays(now, -30));
      const day60 = toDateStr(addDays(now, -60));
      const day90 = toDateStr(addDays(now, -90));
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthEnd = `${period}-${String(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const prevMonthEnd = `${prevPeriod}-${String(new Date(prevD.getFullYear(), prevD.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      // Six calendar months ending this month, for the Income vs. expenses
      // chart — pulled in the same query as the KPI's this-month/last-
      // month comparison rather than a second round trip.
      const sixAgoD = new Date(now.getFullYear(), now.getMonth() - 5, 1);
      const sixStart = `${sixAgoD.getFullYear()}-${String(sixAgoD.getMonth() + 1).padStart(2, '0')}-01`;
      const monthKeys: string[] = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        monthKeys.push(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`);
      }

      const [attRes, curRes, feeRes, finRes, pendingRes] = await Promise.all([
        db.from('attendance').select('date, present').eq('group_key', state.activeGroup).gte('date', day90).order('date', { ascending: true }),
        db.from('curriculum_meetings').select('date, theme, activities').eq('group_key', state.activeGroup).gte('date', todayStr()).order('date', { ascending: true }).limit(1),
        db.from('fee_payments').select('paid, amount').eq('group_key', state.activeGroup).eq('period', period),
        db.from('finance_entries').select('entry_type, amount, entry_date, category, description').eq('group_key', state.activeGroup).gte('entry_date', sixStart).lte('entry_date', monthEnd).order('entry_date', { ascending: false }),
        db.from('join_requests').select('id', { count: 'exact', head: true }).eq('group_key', state.activeGroup).eq('status', 'pending'),
      ]);
      const attRows = attRes.data || [];
      const feeRows = feeRes.data || [];
      const finRows = finRes.data || [];
      const nextMeeting = (curRes.data || [])[0] || null;
      const pendingCount = pendingRes.count || 0;

      // Attendance: per-date rollup (chart) + 30-day rate vs the prior 30
      // days (KPI trend).
      const byDate = new Map<string, { present: number; total: number }>();
      attRows.forEach((r: any) => {
        const e = byDate.get(r.date) || { present: 0, total: 0 };
        e.total++; if (r.present) e.present++;
        byDate.set(r.date, e);
      });
      const lastDates = Array.from(byDate.keys()).sort().slice(-8);
      const rateOf = (rows: any[]) => rows.length ? Math.round((rows.filter((r: any) => r.present).length / rows.length) * 100) : null;
      const rate30 = rateOf(attRows.filter((r: any) => r.date >= day30));
      const ratePrev30 = rateOf(attRows.filter((r: any) => r.date >= day60 && r.date < day30));

      // Fees: this period's paid count/amount out of every active member.
      const paidCount = feeRows.filter((r: any) => r.paid).length;
      const collected = feeRows.reduce((s: number, r: any) => s + (r.paid ? Number(r.amount || 0) : 0), 0);
      const feePct = active.length ? Math.round((paidCount / active.length) * 100) : 0;

      // Finance: net income this month vs last month.
      const netFor = (start: string, end: string) => finRows
        .filter((r: any) => r.entry_date >= start && r.entry_date <= end)
        .reduce((s: number, r: any) => s + (r.entry_type === 'income' ? Number(r.amount) : -Number(r.amount)), 0);
      const netThis = netFor(`${period}-01`, monthEnd);
      const netPrev = netFor(`${prevPeriod}-01`, prevMonthEnd);

      // Same finRows, bucketed by month instead of summed — for the
      // Income vs. expenses chart.
      const byMonth = new Map<string, { income: number; expense: number }>();
      monthKeys.forEach((k) => byMonth.set(k, { income: 0, expense: 0 }));
      finRows.forEach((r: any) => {
        const bucket = byMonth.get(String(r.entry_date).slice(0, 7));
        if (!bucket) return;
        if (r.entry_type === 'income') bucket.income += Number(r.amount); else bucket.expense += Number(r.amount);
      });

      renderDashKpis({ activeCount: active.length, archivedCount, rate30, ratePrev30, feePct, paidCount, totalActive: active.length, collected, netThis, netPrev });
      renderDashFinanceChart(monthKeys, byMonth);
      renderDashAttendanceChart(lastDates, byDate);
      renderDashFeesDonut(feePct, paidCount, active.length, collected);
      renderDashNextMeeting(nextMeeting);
      renderDashRecentFinance(finRows.slice(0, 5));
      renderDashAttention({ pendingCount, allergyCount, unpaidCount: active.length - paidCount, hasActiveMembers: active.length > 0 });
    }
    // Eases a KPI number up from 0 to its real value instead of just
    // appearing — small thing, but it's what makes the dashboard feel
    // alive rather than a static readout.
    function animateCountUp(el: any, target: number, format: (v: number) => string, duration = 900) {
      if (!el) return;
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = format(target * eased);
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = format(target);
      }
      requestAnimationFrame(tick);
    }
    function renderDashKpis(d: any) {
      els.dashKpis.innerHTML = `
        <div class="ws-dash-kpi">
