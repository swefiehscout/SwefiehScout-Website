              <div class="ws-dash-kpi">
                <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">!</span><span class="ws-dash-kpi-label">Pending approvals</span></div>
                <span class="ws-dash-kpi-num">{overview.pendingApprovals}</span>
                <span class="ws-dash-delta ws-dash-delta--flat">{overview.pendingApprovals ? 'waiting for review' : 'all caught up'}</span>
              </div>
              <div class="ws-dash-kpi">
                <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Groups fully paid</span></div>
                <span class="ws-dash-kpi-num">{overview.groupsFullyPaid} / {demoGroups.length}</span>
                <span class="ws-dash-delta ws-dash-delta--flat">100% collected this month</span>
              </div>
            </div>

            <div class="ws-stat-row ws-stat-row--3">
              <div class="ws-stat"><span class="ws-stat-icon">#</span><span class="ws-stat-text"><span class="ws-stat-num">{overview.avgPerGroup}</span><span class="ws-stat-label">Avg members / group</span></span></div>
              <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">▲</span><span class="ws-stat-text"><span class="ws-stat-num">{overview.largestSharePct}%</span><span class="ws-stat-label">Largest group: {overview.largestGroup}</span></span></div>
              <div class="ws-stat"><span class="ws-stat-icon">$</span><span class="ws-stat-text"><span class="ws-stat-num">{overview.avgFeeAmount}</span><span class="ws-stat-label">Avg fee collected / member</span></span></div>
            </div>

            <div class="ws-dash-grid ws-dash-grid--2">
              <div class="ws-dash-card">
                <div class="ws-dash-card-head"><h3>Active members by group</h3></div>
                <div class="ws-dash-bars">
                  {overview.byGroup.map((g) => {
                    const maxActive = Math.max(1, ...overview.byGroup.map((x) => x.active));
                    const pct = Math.round((g.active / maxActive) * 100);
                    return (
                      <div class="ws-dash-bar-col" title={`${g.en} — ${g.active} active (${g.sharePct}% of troop)`}>
                        <span class="ws-dash-bar-pct">{g.active}</span>
                        <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style={`height:${g.active ? Math.max(pct, 4) : 0}%`}></div></div>
                        <span class="ws-dash-bar-label">{g.en}</span>
                      </div>
                    );
