                                  <td class="ws-row-actions">{r.category !== 'Monthly Fees' && <button type="button" class="ws-row-del" title="Delete">×</button>}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
