                      <label class="ws-field ws-field--full"><span>Description</span><input type="text" /></label>
                      <label class="ws-field"><span>Receipt (optional)</span><input type="file" accept="image/*,.pdf" /></label>
                    </div>
                    <div class="ws-form-actions"><button type="submit" class="btn-primary">Add entry</button></div>
                  </form>

                  <div class="ws-toolbar-row">
                    <label class="ws-field ws-field--inline">
                      <span>Month</span>
                      <select data-demo-fin-month={g.key}>
                        {monthKeys6.map((k) => <option value={k} selected={k === thisMonthKey}>{MONTHS[Number(k.split('-')[1]) - 1].en}</option>)}
                      </select>
                    </label>
