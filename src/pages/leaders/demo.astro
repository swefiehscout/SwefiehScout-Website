  <!-- Curriculum day planner — centered popup, opened by clicking a date.
       Shared/reused across every group, same as the real app's; its
       content is filled in by openDayPanel() from the small
       curriculumData/activityBankData lookup below. -->
  <div class="curr-day-overlay" data-demo-day-overlay hidden>
    <div class="curr-day-panel">
      <div class="curr-day-banner">
        <button type="button" class="curr-day-nav-btn" data-demo-day-prev aria-label="Previous day">‹</button>
        <span class="curr-day-banner-text">
          <span class="curr-day-banner-label">Planning for</span>
          <p class="curr-day-banner-value" data-demo-day-header></p>
        </span>
        <button type="button" class="curr-day-nav-btn" data-demo-day-next aria-label="Next day">›</button>
      </div>

      <div class="curr-day-field-row">
        <label class="curr-day-field"><span>Theme</span><input type="text" data-demo-day-theme placeholder="e.g. First Aid Badge" /></label>
        <label class="curr-day-field"><span>Notes</span><textarea data-demo-day-notes rows="2" placeholder="Anything to remember for this meeting…"></textarea></label>
      </div>

      <p class="curr-day-section-label">Attachment</p>
      <div class="curr-day-attachment" data-demo-day-attachment-current hidden>
        <a class="ws-edit-btn" data-demo-day-attachment-link target="_blank" rel="noopener">View attachment →</a>
        <button type="button" class="ws-row-del" title="Remove">×</button>
      </div>
      <div class="curr-day-custom-add curr-day-custom-add--tight" data-demo-day-attachment-upload>
        <input type="file" accept="image/*,.pdf,.doc,.docx" />
        <button type="button" class="btn-primary">Upload</button>
      </div>

      <p class="curr-day-section-label">Add an activity</p>
      <form class="curr-day-custom-add">
        <select data-demo-day-bank-select><option value="">Choose from the activity bank…</option></select>
        <button type="submit" class="btn-primary">Add</button>
      </form>
      <form class="curr-day-custom-add curr-day-custom-add--tight">
        <input type="text" placeholder="…or type a custom one" />
        <button type="submit" class="btn-primary">Add</button>
      </form>

      <p class="curr-day-section-label">This meeting</p>
      <div class="curr-day-list" data-demo-day-list></div>

      <div class="curr-day-actions">
        <button type="button" class="ws-form-cancel" data-demo-day-close>Cancel</button>
        <button type="button" class="btn-primary" data-demo-day-save>Save &amp; close</button>
      </div>
    </div>
  </div>

  <script define:vars={{
    curriculumData: Object.fromEntries(demoGroups.map((g) => [g.key, Object.fromEntries(g.curriculumMeetings.map((m) => [m.date, { theme: m.theme, notes: m.notes, activities: m.activities, attachmentName: m.attachmentName }]))])),
    activityBankData: Object.fromEntries(demoGroups.map((g) => [g.key, g.activityBank])),
  }}>
    // Pure navigation (tabs/groups/sub-tabs/search/filters/periods) plus
    // one shared "this is a demo" handler for every real button/form on
    // the page that would normally mutate something — see the bottom of
    // this script for exactly what's exempted from that and why.
    const state = { tab: 'dashboard', group: (document.querySelector('[data-demo-group-switch] .curr-tab') || {}).dataset?.group || '' };
    function el(sel) { return document.querySelector(sel); }

    function applyView() {
      document.querySelectorAll('[data-demo-tabs] .ws-tab').forEach((b) => b.classList.toggle('ws-tab--active', b.dataset.tab === state.tab));
      document.querySelectorAll('.ws-panel').forEach((p) => p.toggleAttribute('hidden', p.dataset.panel !== state.tab));
      document.querySelectorAll('[data-demo-group]').forEach((d) => d.toggleAttribute('hidden', d.dataset.demoGroup !== state.group));
    }
    function setTab(tab) {
      state.tab = tab;
      applyView();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function setGroup(group) {
      state.group = group;
      document.querySelectorAll('[data-demo-group-switch] .curr-tab').forEach((b) => b.classList.toggle('curr-tab--active', b.dataset.group === group));
      const activeBtn = el('[data-demo-group-switch] .curr-tab--active');
      const banner = el('[data-demo-group-banner-name]');
      if (banner && activeBtn) banner.textContent = activeBtn.textContent;
      applyView();
    }
    function bindTabs() {
      document.querySelectorAll('[data-demo-tabs] .ws-tab').forEach((btn) => btn.addEventListener('click', () => setTab(btn.dataset.tab)));
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-goto-tab]');
        if (btn) setTab(btn.dataset.gotoTab);
      });
    }
    function bindGroupSwitch() {
      document.querySelectorAll('[data-demo-group-switch] .curr-tab').forEach((btn) => btn.addEventListener('click', () => setGroup(btn.dataset.group)));
    }
    // Curriculum's Plan/Activity Bank pair uses .curr-subtab (matching the
    // real app's own distinct styling there — it predates the generic
    // .ws-subtab system) while Finance/Library/Admin use .ws-subtab; both
    // share the same data-subtabs/data-subtab/data-subpanel wiring, so one
    // handler covers both by toggling whichever "--active" class the
    // clicked button actually has.
    function setSubtab(group, name) {
      document.querySelectorAll(`.ws-subtab[data-subtabs="${group}"], .curr-subtab[data-subtabs="${group}"]`).forEach((b) => {
        b.classList.toggle('ws-subtab--active', b.classList.contains('ws-subtab') && b.dataset.subtab === name);
        b.classList.toggle('curr-subtab--active', b.classList.contains('curr-subtab') && b.dataset.subtab === name);
      });
      document.querySelectorAll(`[data-subpanel^="${group}:"]`).forEach((p) => p.toggleAttribute('hidden', p.dataset.subpanel !== `${group}:${name}`));
    }
    function bindSubtabs() {
      document.querySelectorAll('.ws-subtab, .curr-subtab').forEach((btn) => btn.addEventListener('click', () => setSubtab(btn.dataset.subtabs, btn.dataset.subtab)));
    }
    function bindSearch() {
      document.querySelectorAll('[data-demo-search]').forEach((input) => {
        const scope = input.closest('[data-demo-group]') || input.closest('[data-subpanel]') || input.closest('.ws-panel');
        const tbody = scope && scope.querySelector('tbody');
        if (!tbody) return;
        input.addEventListener('input', () => {
          const term = input.value.trim().toLowerCase();
          tbody.querySelectorAll('tr').forEach((row) => { row.hidden = !!term && !row.textContent.toLowerCase().includes(term); });
        });
      });
    }
    function bindAdminRoster() {
      const groupSel = el('[data-demo-admin-roster-group]');
      const statusSel = el('[data-demo-admin-roster-status]');
      const search = el('[data-demo-admin-roster-search]');
      if (!groupSel || !statusSel || !search) return;
      function apply() {
        const term = search.value.trim().toLowerCase();
        document.querySelectorAll('[data-admin-roster-row]').forEach((row) => {
          const okGroup = !groupSel.value || row.dataset.group === groupSel.value;
          const okStatus = statusSel.value === 'all' || row.dataset.status === statusSel.value;
          const okSearch = !term || row.textContent.toLowerCase().includes(term);
          row.hidden = !(okGroup && okStatus && okSearch);
        });
      }
      groupSel.addEventListener('change', apply);
      statusSel.addEventListener('change', apply);
      search.addEventListener('input', apply);
    }
    function bindAccountMenu() {
      const btn = el('[data-demo-account-btn]');
      const menu = el('[data-demo-account-menu]');
      if (!btn || !menu) return;
      btn.addEventListener('click', () => menu.toggleAttribute('hidden'));
      document.addEventListener('click', (e) => { if (!e.target.closest('.ws-account')) menu.hidden = true; });
    }
    // Curriculum's Calendar/List toggle, per group.
    function bindPlanToggle() {
      document.querySelectorAll('[data-demo-plan-toggle]').forEach((wrap) => {
        const group = wrap.dataset.demoPlanToggle;
        wrap.querySelectorAll('[data-plan-view]').forEach((btn) => {
          btn.addEventListener('click', () => {
            wrap.querySelectorAll('[data-plan-view]').forEach((b) => b.classList.toggle('curr-view-btn--active', b === btn));
            document.querySelectorAll(`[data-demo-plan-view^="${group}:"]`).forEach((p) => p.toggleAttribute('hidden', p.dataset.demoPlanView !== `${group}:${btn.dataset.planView}`));
          });
        });
      });
    }
    // Attendance calendar — clicking a dotted day switches which
    // pre-rendered day's list/banner/summary is shown, per group.
    function bindAttCalendar() {
      document.querySelectorAll('[data-demo-att-cell]').forEach((cell) => {
        cell.addEventListener('click', () => {
          const group = cell.dataset.demoAttCell;
          const date = cell.dataset.date;
          document.querySelectorAll(`[data-demo-att-cell="${group}"]`).forEach((c) => c.classList.toggle('curr-day-cell--selected', c === cell));
          document.querySelectorAll(`[data-demo-att-day="${group}"]`).forEach((t) => t.toggleAttribute('hidden', t.dataset.date !== date));
          const table = document.querySelector(`[data-demo-att-day="${group}"][data-date="${date}"]`);
          const banner = document.querySelector(`[data-demo-att-banner="${group}"]`);
          const summary = document.querySelector(`[data-demo-att-summary="${group}"]`);
          if (table && banner) {
            const [y, m, d] = date.split('-').map(Number);
            const dt = new Date(y, m - 1, d);
            banner.textContent = dt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
          }
          if (table && summary) {
            const total = table.querySelectorAll('tbody tr').length;
            const present = table.querySelectorAll('tbody input[type="checkbox"]:checked').length;
            summary.textContent = `${present} of ${total} present`;
          }
        });
      });
    }
    // Fees/Finance Month pickers — swap which pre-rendered period is
    // shown, per group, and keep every group's picker in sync so
    // switching groups afterward doesn't show a stale selection.
    function bindFeePeriods() {
      document.querySelectorAll('[data-demo-fee-month]').forEach((sel) => {
        sel.addEventListener('change', () => {
          const period = sel.value;
          document.querySelectorAll('[data-demo-fee-month]').forEach((s) => { s.value = period; });
          document.querySelectorAll('[data-demo-fee-period]').forEach((t) => t.toggleAttribute('hidden', t.dataset.period !== period));
        });
      });
    }
    function bindFinPeriods() {
      document.querySelectorAll('[data-demo-fin-month]').forEach((sel) => {
        sel.addEventListener('change', () => {
          const period = sel.value;
          document.querySelectorAll('[data-demo-fin-month]').forEach((s) => { s.value = period; });
          document.querySelectorAll('[data-demo-fin-period]').forEach((t) => t.toggleAttribute('hidden', t.dataset.period !== period));
        });
      });
    }
    // Admin > Leader Management's role select — swapping to Admin hides
    // the group checkboxes (matches the real, purely-client-side
    // behaviour) but never saves anything.
    function bindRoleSelects() {
      document.querySelectorAll('[data-demo-role-select]').forEach((sel) => {
        sel.addEventListener('change', () => {
          const cell = document.querySelector(`[data-demo-role-groups="${sel.dataset.demoRoleSelect}"]`);
          if (!cell) return;
          if (sel.value === 'admin') {
            cell.innerHTML = '<p class="ws-admin-note">All groups (admin)</p>';
          } else if (cell.querySelector('.ws-admin-note')) {
            showDemoToast();
          }
        });
      });
    }
    // Balanced tab bar — same "no orphans" reasoning as the real
    // workspace's balanceTabs().
    let tabsResizeTimer;
    function balanceTabs() {
      const tabs = el('[data-demo-tabs]');
      if (!tabs) return;
      const visible = Array.from(tabs.querySelectorAll('.ws-tab'));
      const n = visible.length;
      if (!n) return;
      const prevDisplay = tabs.style.display;
      const prevWrap = tabs.style.flexWrap;
      const ideal = getComputedStyle(tabs).getPropertyValue('--ws-tab-ideal').trim() || '9rem';
      tabs.style.display = 'flex';
      tabs.style.flexWrap = 'wrap';
      visible.forEach((b) => { b.style.flex = `0 1 ${ideal}`; });
      const firstTop = visible[0].offsetTop;
      let natural = 0;
      for (const b of visible) { if (b.offsetTop === firstTop) natural++; else break; }
      visible.forEach((b) => { b.style.flex = ''; });
      tabs.style.display = prevDisplay;
      tabs.style.flexWrap = prevWrap;
      natural = Math.max(1, Math.min(natural, n));
      const rows = Math.ceil(n / natural);
      const perRow = Math.ceil(n / rows);
      tabs.style.setProperty('--ws-tab-cols', String(perRow));
    }

    // ---------- The one place that decides "does this button do
    // anything real" ----------
    let toastTimer;
    function showDemoToast(msg) {
      let t = document.querySelector('.curr-toast');
      if (!t) { t = document.createElement('div'); t.className = 'curr-toast'; document.body.appendChild(t); }
      t.textContent = msg || 'This is a demo — nothing is saved.';
      t.classList.add('curr-toast--show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.remove('curr-toast--show'), 2600);
    }
    // Every real navigation control carries data-demo-skip (or is one of
    // the specific selectors below) — everything else that's a <button>
    // or a <form> submit is an inert stand-in for a real action.
    function bindInertControls() {
      document.querySelectorAll('form').forEach((f) => f.addEventListener('submit', (e) => { e.preventDefault(); showDemoToast(); f.reset(); }));
      document.querySelectorAll('button').forEach((b) => {
        if (b.dataset.demoSkip !== undefined || b.type === 'submit') return;
        b.addEventListener('click', (e) => { e.preventDefault(); showDemoToast(); });
      });
      document.querySelectorAll('[data-demo-confirm]').forEach((b) => {
        b.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          if (window.confirm(b.dataset.demoConfirm)) showDemoToast();
        }, true);
      });
    }

    // ---------- Curriculum day planner popup — the one place a click
    // opens something instead of just toasting, since "what does the
    // planner look like" is worth showing. Filled from curriculumData/
    // activityBankData (small JSON the frontmatter embedded above via
    // define:vars) rather than a real fetch. Save/remove/add still just
    // toast — nothing here is ever written back into that data. ----------
    let dayPanelState = { group: '', date: '' };
    function activityRowHTML(name) {
      return `<div class="curr-item"><span class="curr-item-text"><span class="curr-item-en">${name}</span></span><input type="number" min="0" step="5" class="curr-item-duration" placeholder="min" /><button type="button" class="curr-item-del" aria-label="Remove">×</button></div>`;
    }
    function openDayPanel(group, dateStr) {
      dayPanelState = { group, date: dateStr };
      const meeting = (curriculumData[group] || {})[dateStr];
      const [y, m, d] = dateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      el('[data-demo-day-header]').textContent = dt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      el('[data-demo-day-theme]').value = meeting ? meeting.theme : '';
      el('[data-demo-day-notes]').value = meeting ? meeting.notes : '';
      const activities = meeting ? meeting.activities : [];
      const list = el('[data-demo-day-list]');
      list.innerHTML = activities.length ? activities.map(activityRowHTML).join('') : '<p class="curr-empty">No activities yet — pick one from the bank or add a custom one below.</p>';
      list.querySelectorAll('.curr-item-del').forEach((btn) => btn.addEventListener('click', () => showDemoToast()));
      const bank = el('[data-demo-day-bank-select]');
      bank.innerHTML = '<option value="">Choose from the activity bank…</option>' + (activityBankData[group] || []).map((a) => `<option>${a}</option>`).join('');
      const attachmentName = meeting && meeting.attachmentName;
      el('[data-demo-day-attachment-current]').toggleAttribute('hidden', !attachmentName);
      el('[data-demo-day-attachment-upload]').toggleAttribute('hidden', !!attachmentName);
      if (attachmentName) el('[data-demo-day-attachment-link]').textContent = `View ${attachmentName} →`;
      el('[data-demo-day-overlay]').removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeDayPanel() {
      el('[data-demo-day-overlay]').setAttribute('hidden', '');
      document.body.style.overflow = '';
    }
    function bindDayPanel() {
      document.querySelectorAll('[data-demo-curr-cell]').forEach((cell) => {
        cell.addEventListener('click', () => openDayPanel(cell.dataset.demoCurrCell, cell.dataset.date));
      });
      el('[data-demo-day-close]').addEventListener('click', closeDayPanel);
      el('[data-demo-day-save]').addEventListener('click', () => { showDemoToast(); closeDayPanel(); });
      el('[data-demo-day-overlay]').addEventListener('click', (e) => { if (e.target === el('[data-demo-day-overlay]')) closeDayPanel(); });
      el('[data-demo-day-prev]').addEventListener('click', () => shiftDayPanel(-1));
      el('[data-demo-day-next]').addEventListener('click', () => shiftDayPanel(1));
      // A plain <a> with no href — the generic button-inert handler
      // doesn't cover anchors, and a href-less link already does
      // nothing on click, but silently is worse than the same toast
      // everything else inert gives.
      el('[data-demo-day-attachment-link]').addEventListener('click', (e) => { e.preventDefault(); showDemoToast(); });
    }
    function shiftDayPanel(n) {
      if (!dayPanelState.date) return;
      const [y, m, d] = dayPanelState.date.split('-').map(Number);
      const next = new Date(y, m - 1, d + n);
      const nextStr = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}-${String(next.getDate()).padStart(2, '0')}`;
      openDayPanel(dayPanelState.group, nextStr);
    }

    function init() {
      if (document.body.dataset.demoBound) return;
      document.body.dataset.demoBound = '1';
      bindTabs();
      bindGroupSwitch();
      bindSubtabs();
      bindSearch();
      bindAdminRoster();
      bindAccountMenu();
      bindPlanToggle();
      bindAttCalendar();
      bindDayPanel();
      bindFeePeriods();
      bindFinPeriods();
      bindRoleSelects();
      bindInertControls();
      balanceTabs();
      window.addEventListener('resize', () => {
        clearTimeout(tabsResizeTimer);
        tabsResizeTimer = setTimeout(balanceTabs, 150);
      });
    }
    document.addEventListener('astro:page-load', init);
    // This script runs as a plain inline <script> (define:vars forces
    // that) sitting at the very end of the body, not the deferred
    // type="module" Astro normally emits — so it executes synchronously,
    // after the DOM around it exists but potentially after the
    // ClientRouter's *first* astro:page-load has already been dispatched
    // from <head>. Relying on the listener alone risks silently missing
    // that first dispatch and never initializing anything; call init()
    // directly too — the demoBound guard above makes the double-call safe.
    init();
  </script>

  <style>
    .demo-shell { display: block; }
    .demo-banner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
      background: var(--color-accent);
      color: #fff;
      font-size: 0.85rem;
      text-align: center;
    }
    .demo-banner a { color: #fff; font-weight: 700; text-decoration: underline; margin-inline-start: 0.4rem; }
  </style>
</BaseLayout>
