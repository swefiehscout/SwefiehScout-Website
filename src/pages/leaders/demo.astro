                    <tr data-admin-roster-row data-group={m.group} data-status={m.active ? 'active' : 'archived'}>
                      <td data-label="Name">{m.full_name}</td>
                      <td data-label="Group">{m.group}</td>
                      <td data-label="Guardian 1">{m.guardian1_relation}: {m.guardian1_phone}</td>
                      <td data-label="Allergies">{m.has_allergies ? <span class="ws-allergy-badge">Yes</span> : '—'}</td>
