                              <tr class="ws-statement-total"><td>Total Income</td><td>{income.toFixed(2)}</td></tr>
                              <tr class="ws-statement-section"><td colspan="2">Expenses</td></tr>
                              {expenseRows.length ? expenseRows.map(([cat, amt]) => <tr><td>{cat}</td><td>{amt.toFixed(2)}</td></tr>) : <tr><td class="ws-empty" colspan="2">None</td></tr>}
                              <tr class="ws-statement-total"><td>Total Expenses</td><td>{expense.toFixed(2)}</td></tr>
                              <tr class="ws-statement-net"><td>Net Income</td><td>{(income - expense).toFixed(2)}</td></tr>
                            </tbody>
                          </table>
                        </div>
                        <h3 class="ws-admin-h3">Transactions</h3>
                        <div class="ws-table-wrap">
                          <table class="ws-table">
                            <thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Description</th><th>Amount</th><th>Receipt</th><th></th></tr></thead>
                            <tbody>
                              {rows.map((r) => (
                                <tr>
                                  <td data-label="Date">{r.date}</td>
                                  <td data-label="Type">{r.type === 'income' ? 'Income' : 'Expense'}</td>
                                  <td data-label="Category">{r.category}{r.category === 'Monthly Fees' && <span class="ws-allergy-badge" title="Synced from the Fees tab">Auto</span>}</td>
