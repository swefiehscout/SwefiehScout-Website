---
// Public, read-only showcase of the Leaders Workspace — sample data only,
// no Supabase calls, no auth. Reuses the real workspace's exact markup
// (same forms, buttons, checkboxes, calendars) so it's identical to the
// real system, but every control that would normally create/update/
// delete something is wired to a shared "this is a demo" toast instead
// of a real handler — see the bindInertControls()/CONFIRM_MSG block in
// the script below for the one place that's decided. Pure navigation
// (tabs, groups, sub-tabs, search, period pickers, the account menu)
// still works since none of it touches data. Never link this from
// inside app.astro itself; it's meant to be shared standalone.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { workspaceMarqueePhotos } from '../../lib/scenic-photos';
import {
  demoGroups, dashboardStats, overview, demoLeaders, MONTHS, WEEKDAYS,
  thisMonthKey, monthKeys6, feesForPeriod, EXPENSE_CATEGORIES, INCOME_CATEGORIES,
} from '../../lib/demo-data';

const dashMarqueePhotos = [...workspaceMarqueePhotos, ...workspaceMarqueePhotos];
const defaultGroupKey = demoGroups[0].key;
const todayD = new Date();

function parseD(dateStr: string) {
  const [y, m, d] = dateStr.split('-').map(Number);
  return new Date(y, m - 1, d);
}
function fmtShort(dateStr: string) {
  const d = parseD(dateStr);
  return `${MONTHS[d.getMonth()].en.slice(0, 3)} ${d.getDate()}`;
}
function fmtLong(dateStr: string) {
  const d = parseD(dateStr);
  return `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}`;
}
function monthLabel(key: string) {
  const [, m] = key.split('-').map(Number);
  return MONTHS[m - 1].en.slice(0, 3);
}
function periodLabel(key: string) {
  const [y, m] = key.split('-').map(Number);
  return `${MONTHS[m - 1].en} ${y}`;
}
// Same shape as app.astro's dashDeltaBadge — a plain HTML string since
// frontmatter helpers can't return JSX, injected via set:html below.
function deltaBadge(val: number | null, suffix = ''): string {
  if (val == null || Number.isNaN(val) || val === 0) return `<span class="ws-dash-delta ws-dash-delta--flat">– steady</span>`;
  const up = val > 0;
  return `<span class="ws-dash-delta ${up ? 'ws-dash-delta--up' : 'ws-dash-delta--down'}">${up ? '↑' : '↓'} ${Math.abs(val)}${suffix} vs last period</span>`;
}
function addDaysLocal(d: Date, n: number) { const c = new Date(d); c.setDate(c.getDate() + n); return c; }
function startOfWeekLocal(d: Date) { const c = new Date(d.getFullYear(), d.getMonth(), d.getDate()); c.setDate(c.getDate() - c.getDay()); return c; }
function monthGrid(anchor: Date) {
  const y = anchor.getFullYear(), mo = anchor.getMonth();
  const first = new Date(y, mo, 1);
  const last = new Date(y, mo + 1, 0);
  const start = startOfWeekLocal(first);
  const end = addDaysLocal(startOfWeekLocal(last), 6);
  const days: Date[] = [];
  let d = new Date(start);
  while (d <= end) { days.push(new Date(d)); d = addDaysLocal(d, 1); }
  return days;
}
const attGrid = monthGrid(todayD);
const currGrid = monthGrid(todayD);
const todayStr = `${todayD.getFullYear()}-${String(todayD.getMonth() + 1).padStart(2, '0')}-${String(todayD.getDate()).padStart(2, '0')}`;
// Standalone Month/Year range for pickers that don't actually switch
// pre-rendered data (Reports, Admin Reports) — matches the real app's
// populatePeriodSelects() range so it looks/behaves the same.
const nowYear = todayD.getFullYear();
const YEARS = Array.from({ length: 5 }, (_, i) => nowYear - 3 + i);
const CURRENT_MONTH_VAL = String(todayD.getMonth() + 1).padStart(2, '0');

// The four real-app confirm() dialogs, verbatim — everything else that's
// inert just shows the plain toast with no confirmation, matching how
// the real buttons behave too (only these four ask first).
const CONFIRM_ARCHIVE = "Archive this member? They'll disappear from Attendance and Fees going forward, but nothing already recorded for them changes. You can restore them any time from the Archive tab.";
const CONFIRM_DELETE = 'Permanently delete this member? This also deletes their attendance/fee history — this cannot be undone. Archiving is usually what you want instead.';
const CONFIRM_REJECT = 'Reject this request? No member will be added.';
const CONFIRM_REMOVE_ACCESS = "Remove this leader's access? They'll be signed out of every group and land back on the \"waiting for approval\" screen — you can re-approve them any time from here. This doesn't delete their account.";
---
<BaseLayout title="Leaders Workspace — Demo" bare wide>
  <div class="ws-shell demo-shell">
    <div class="demo-banner">
      🎭 <strong>Demo mode</strong> — sample data only. Every button here is real to click, but nothing is ever saved, changed, or downloaded.
      <a href="/leaders">Exit demo →</a>
    </div>

    <div class="ws-main">
      <header class="ws-header">
        <div class="ws-header-left">
          <img class="ws-logo-mark" src="/images/logo.png" alt="" />
          <span class="ws-logo">Leaders Workspace</span>
        </div>
        <div class="ws-header-right">
          <div class="ws-group-switch" data-demo-group-switch>
            {demoGroups.map((g) => (
              <button type="button" class={`curr-tab${g.key === defaultGroupKey ? ' curr-tab--active' : ''}`} data-group={g.key} data-demo-skip>{g.en}</button>
            ))}
          </div>
          <div class="ws-account">
            <button type="button" class="ws-account-btn" data-demo-account-btn data-demo-skip>DA</button>
            <div class="ws-account-menu" data-demo-account-menu hidden>
              <div class="ws-account-info">
                <span class="ws-account-name">Demo Admin</span>
                <span class="ws-account-role">admin</span>
              </div>
              <a class="ws-account-signout" href="/leaders">Exit demo</a>
            </div>
          </div>
        </div>
      </header>

      <nav class="ws-tabs" data-demo-tabs>
        <button type="button" class="ws-tab ws-tab--active" data-tab="dashboard" data-demo-skip><Icon name="compass" size={16} strokeWidth={1.8} /> Dashboard</button>
        <button type="button" class="ws-tab" data-tab="roster" data-demo-skip><Icon name="star" size={16} strokeWidth={1.8} /> Roster</button>
        <button type="button" class="ws-tab" data-tab="archive" data-demo-skip><Icon name="fleur" size={16} strokeWidth={1.8} /> Archive</button>
        <button type="button" class="ws-tab" data-tab="approvals" data-demo-skip><Icon name="plus" size={16} strokeWidth={1.8} /> Approvals</button>
        <button type="button" class="ws-tab" data-tab="attendance" data-demo-skip><Icon name="calendar" size={16} strokeWidth={1.8} /> Attendance</button>
        <button type="button" class="ws-tab" data-tab="fees" data-demo-skip><Icon name="cash" size={16} strokeWidth={1.8} /> Fees</button>
        <button type="button" class="ws-tab" data-tab="curriculum" data-demo-skip><Icon name="flag" size={16} strokeWidth={1.8} /> Curriculum</button>
        <button type="button" class="ws-tab" data-tab="finance" data-demo-skip><Icon name="bank" size={16} strokeWidth={1.8} /> Finance</button>
        <button type="button" class="ws-tab" data-tab="library" data-demo-skip><Icon name="diamond" size={16} strokeWidth={1.8} /> Library</button>
        <button type="button" class="ws-tab" data-tab="reports" data-demo-skip><Icon name="envelope" size={16} strokeWidth={1.8} /> Reports</button>
        <button type="button" class="ws-tab" data-tab="admin" data-demo-skip><Icon name="pin" size={16} strokeWidth={1.8} /> Admin</button>
      </nav>

      <div class="ws-group-banner">
        <span class="ws-group-banner-label">Viewing</span>
        <span class="ws-group-banner-name" data-demo-group-banner-name>{demoGroups[0].en}</span>
      </div>

      <div class="ws-panels">

        <!-- ============ Dashboard ============ -->
        <section class="ws-panel" data-panel="dashboard">
          <div class="ws-dash">
            <div class="band-marquee ws-dash-marquee" aria-label="Troop photos">
              <div class="band-marquee-track" style={`--n: ${workspaceMarqueePhotos.length}`}>
                {dashMarqueePhotos.map((src, i) => (
                  <div class="band-marquee-slide"><img src={src} alt="" loading="lazy" aria-hidden={i >= workspaceMarqueePhotos.length} /></div>
                ))}
              </div>
              <div class="band-marquee-fade band-marquee-fade--start" aria-hidden="true"></div>
              <div class="band-marquee-fade band-marquee-fade--end" aria-hidden="true"></div>
            </div>

            {demoGroups.map((g) => {
              const s = dashboardStats(g);
              const netLabel = `${s.netThis >= 0 ? '+' : '−'}${Math.abs(s.netThis).toFixed(0)}`;
              return (
                <div data-demo-group={g.key} hidden={g.key !== defaultGroupKey}>
                  <div class="ws-dash-hero">
                    <div class="ws-dash-hero-text">
                      <span class="ws-dash-eyebrow">{todayD.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}</span>
                      <h2 class="ws-dash-title">Welcome back, Demo Admin</h2>
                      <p class="ws-dash-sub">{g.en} workspace</p>
                    </div>
                  </div>

                  <div class="ws-dash-kpis">
                    <div class="ws-dash-kpi">
                      <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Active members</span></div>
                      <span class="ws-dash-kpi-num">{s.activeCount}</span>
                      <span class="ws-dash-delta ws-dash-delta--flat">{s.archivedCount} archived</span>
                    </div>
                    <div class="ws-dash-kpi">
                      <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Attendance (30d)</span></div>
                      <span class="ws-dash-kpi-num">{s.rate30 != null ? s.rate30 + '%' : '—'}</span>
                      <Fragment set:html={s.rate30 != null ? deltaBadge(s.ratePrev30 != null ? s.rate30 - s.ratePrev30 : null, 'pt') : '<span class="ws-dash-delta ws-dash-delta--flat">No sessions yet</span>'} />
                    </div>
                    <div class="ws-dash-kpi">
                      <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">$</span><span class="ws-dash-kpi-label">Fees collected</span></div>
                      <span class="ws-dash-kpi-num">{s.feePct}%</span>
                      <span class="ws-dash-delta ws-dash-delta--flat">{s.paidCount}/{s.activeCount} paid · {s.collected.toFixed(0)}</span>
                    </div>
                    <div class="ws-dash-kpi">
                      <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">±</span><span class="ws-dash-kpi-label">Net income (mtd)</span></div>
                      <span class="ws-dash-kpi-num">{netLabel}</span>
                      <Fragment set:html={deltaBadge(Math.round(s.netThis - s.netPrev))} />
                    </div>
                  </div>

                  <div class="ws-dash-grid">
                    <div class="ws-dash-card ws-dash-card--wide">
                      <div class="ws-dash-card-head"><h3>Attendance trend</h3><span class="ws-dash-card-sub">Last {s.last8Dates.length} sessions</span></div>
                      <div class="ws-dash-bars">
                        {s.last8Dates.map((d) => (
                          <div class="ws-dash-bar-col" title={`${fmtLong(d.date)} — ${d.pct}% present`}>
                            <span class="ws-dash-bar-pct">{d.pct}%</span>
                            <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style={`height:${Math.max(d.pct, 4)}%`}></div></div>
                            <span class="ws-dash-bar-label">{fmtShort(d.date)}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                    <div class="ws-dash-card">
                      <div class="ws-dash-card-head"><h3>Fees this month</h3></div>
                      <div class="ws-dash-donut" style={`--pct:${s.feePct}%`}>
                        <div class="ws-dash-donut-center"><span class="ws-dash-donut-num">{s.feePct}%</span><span class="ws-dash-donut-label">Collected</span></div>
                      </div>
                      <p class="ws-dash-donut-foot">{s.paidCount} of {s.activeCount} paid · {s.collected.toFixed(2)} in</p>
                    </div>
                  </div>

                  <div class="ws-dash-card ws-dash-card--full">
                    <div class="ws-dash-card-head"><h3>Income vs. expenses</h3><span class="ws-dash-card-sub">Last 6 months</span></div>
                    <div class="ws-dash-fin-bars">
                      {monthKeys6.map((k) => {
                        const b = s.byMonth.get(k)!;
                        const maxVal = Math.max(1, ...monthKeys6.map((kk) => Math.max(s.byMonth.get(kk)!.income, s.byMonth.get(kk)!.expense)));
                        const incPct = Math.round((b.income / maxVal) * 100);
                        const expPct = Math.round((b.expense / maxVal) * 100);
                        return (
                          <div class="ws-dash-fin-col" title={`${monthLabel(k)} — Income ${b.income.toFixed(2)}, Expenses ${b.expense.toFixed(2)}`}>
                            <div class="ws-dash-fin-pair">
                              <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--income" style={`height:${b.income ? Math.max(incPct, 3) : 0}%`}></div></div>
                              <div class="ws-dash-fin-track"><div class="ws-dash-fin-bar ws-dash-fin-bar--expense" style={`height:${b.expense ? Math.max(expPct, 3) : 0}%`}></div></div>
                            </div>
                            <span class="ws-dash-fin-label">{monthLabel(k)}</span>
                          </div>
                        );
                      })}
                    </div>
                    <div class="ws-dash-fin-legend">
                      <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--income"></i>Income</span>
                      <span><i class="ws-dash-fin-swatch ws-dash-fin-swatch--expense"></i>Expenses</span>
                    </div>
                  </div>

                  <div class="ws-dash-grid ws-dash-grid--3">
                    <div class="ws-dash-card">
                      <div class="ws-dash-card-head"><h3>Next meeting</h3></div>
                      {s.nextMeeting ? (
                        <>
                          <p class="ws-dash-mini-date">{fmtLong(s.nextMeeting.date)}</p>
                          <p class="ws-dash-mini-theme">{s.nextMeeting.theme}</p>
                          <p class="ws-dash-mini-sub">{s.nextMeeting.activities.length} activities planned</p>
                        </>
                      ) : <p class="ws-dash-empty-mini">Nothing planned yet.</p>}
                    </div>
                    <div class="ws-dash-card">
                      <div class="ws-dash-card-head"><h3>Recent finance activity</h3></div>
                      {s.recentFinance.map((r) => (
                        <div class="ws-dash-feed-row">
                          <span class={`ws-dash-feed-dot ws-dash-feed-dot--${r.type}`}></span>
                          <span class="ws-dash-feed-text">
                            <span class="ws-dash-feed-title">{r.category}</span>
                            <span class="ws-dash-feed-date">{r.date}</span>
                          </span>
                          <span class={`ws-dash-feed-amount ws-dash-feed-amount--${r.type}`}>{r.type === 'income' ? '+' : '−'}{r.amount.toFixed(2)}</span>
                        </div>
                      ))}
                    </div>
                    <div class="ws-dash-card">
                      <div class="ws-dash-card-head"><h3>Needs attention</h3></div>
                      {s.pendingCount || s.unpaidCount > 0 || s.allergyCount ? (
                        <>
                          {s.pendingCount > 0 && <button type="button" class="ws-dash-attn-row" data-goto-tab="approvals" data-demo-skip>{s.pendingCount} pending approval{s.pendingCount === 1 ? '' : 's'} <span aria-hidden="true">→</span></button>}
                          {s.unpaidCount > 0 && <button type="button" class="ws-dash-attn-row" data-goto-tab="fees" data-demo-skip>{s.unpaidCount} unpaid fee{s.unpaidCount === 1 ? '' : 's'} this month <span aria-hidden="true">→</span></button>}
                          {s.allergyCount > 0 && <button type="button" class="ws-dash-attn-row" data-goto-tab="roster" data-demo-skip>{s.allergyCount} member{s.allergyCount === 1 ? '' : 's'} with allergies on file <span aria-hidden="true">→</span></button>}
                        </>
                      ) : <p class="ws-dash-empty-mini">All caught up. Nothing needs attention.</p>}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        <!-- ============ Roster ============ -->
        <section class="ws-panel" data-panel="roster" hidden>
          <form class="ws-member-form" data-demo-roster-form>
            <div class="ws-member-form-bar" aria-hidden="true"></div>
            <p class="ws-member-form-title">Add a member</p>
            <div class="ws-form-grid ws-form-grid--4">
              <label class="ws-field"><span>Full name *</span><input type="text" placeholder="e.g. Karim Haddad" /></label>
              <label class="ws-field"><span>Date of birth</span><input type="date" /></label>
              <label class="ws-field">
                <span>Guardian 1 relation *</span>
                <select><option value="">Select…</option><option>Mother</option><option>Father</option><option>Other</option></select>
              </label>
              <label class="ws-field"><span>Guardian 1 phone *</span><input type="tel" placeholder="079 123 4567" /></label>
            </div>
            <div class="ws-form-grid">
              <div class="ws-optional-block"><button type="button" class="ws-add-link">+ Add second guardian</button></div>
              <div class="ws-optional-block"><button type="button" class="ws-add-link">+ Add allergy info</button></div>
            </div>
            <label class="ws-field ws-field--full"><span>Notes</span><textarea rows="1"></textarea></label>
            <div class="ws-form-actions"><button type="submit" class="btn-primary">Add member</button></div>
          </form>

          {demoGroups.map((g) => (
            <div data-demo-group={g.key} hidden={g.key !== defaultGroupKey}>
              <input type="search" class="ws-search" placeholder="Search members…" data-demo-search />
              <div class="ws-table-wrap">
                <table class="ws-table">
                  <thead><tr><th>Name</th><th>Guardian 1</th><th>Allergies</th><th></th></tr></thead>
                  <tbody>
                    {g.active.map((m) => (
                      <tr>
                        <td data-label="Name">{m.full_name}</td>
                        <td data-label="Guardian 1">{m.guardian1_relation}: {m.guardian1_phone}</td>
                        <td data-label="Allergies">{m.has_allergies ? <span class="ws-allergy-badge">Yes — {m.allergy_detail}</span> : '—'}</td>
                        <td class="ws-row-actions">
                          <button type="button" class="ws-edit-btn">Edit</button>
                          <button type="button" class="ws-edit-btn" data-demo-confirm={CONFIRM_ARCHIVE}>Archive</button>
                          <button type="button" class="ws-row-del" data-demo-confirm={CONFIRM_DELETE} title="Delete permanently">×</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </section>

        <!-- ============ Archive ============ -->
        <section class="ws-panel" data-panel="archive" hidden>
          <p class="ws-soon">Archived members are hidden from Attendance and Fees going forward, but every past record tied to them stays exactly as it was. Restore someone here any time to bring them back.</p>
          {demoGroups.map((g) => {
            const archived = g.members.filter((m) => !m.active);
            return (
              <div data-demo-group={g.key} hidden={g.key !== defaultGroupKey}>
                <input type="search" class="ws-search" placeholder="Search members…" data-demo-search />
                <div class="ws-table-wrap">
                  <table class="ws-table">
                    <thead><tr><th>Name</th><th>Guardian 1</th><th>Allergies</th><th></th></tr></thead>
                    <tbody>
                      {archived.length ? archived.map((m) => (
                        <tr>
                          <td data-label="Name">{m.full_name}</td>
                          <td data-label="Guardian 1">{m.guardian1_relation}: {m.guardian1_phone}</td>
                          <td data-label="Allergies">{m.has_allergies ? <span class="ws-allergy-badge">Yes — {m.allergy_detail}</span> : '—'}</td>
                          <td class="ws-row-actions">
                            <button type="button" class="ws-edit-btn">Restore</button>
                            <button type="button" class="ws-row-del" data-demo-confirm={CONFIRM_DELETE} title="Delete permanently">×</button>
                          </td>
                        </tr>
                      )) : <tr><td colspan="4" class="ws-empty">No archived members.</td></tr>}
                    </tbody>
                  </table>
                </div>
              </div>
            );
          })}
        </section>

        <!-- ============ Approvals ============ -->
        <section class="ws-panel" data-panel="approvals" hidden>
          <p class="ws-soon">Anyone can submit a request at <strong>/join</strong> without an account. Approving one adds them straight to this group's active roster; rejecting just declines it.</p>
          {demoGroups.map((g) => (
            <div data-demo-group={g.key} hidden={g.key !== defaultGroupKey}>
              <input type="search" class="ws-search" placeholder="Search requests…" data-demo-search />
              <div class="ws-table-wrap">
                <table class="ws-table">
                  <thead><tr><th>Name</th><th>Guardian 1</th><th>Allergies</th><th>Notes</th><th></th></tr></thead>
                  <tbody>
                    {g.joinRequests.length ? g.joinRequests.map((r) => (
                      <tr>
                        <td data-label="Name">{r.name}</td>
                        <td data-label="Guardian 1">{r.guardian}: {r.phone}</td>
                        <td data-label="Allergies">{r.allergies ? <span class="ws-allergy-badge">Yes</span> : '—'}</td>
                        <td data-label="Notes">{r.notes || '—'}</td>
                        <td class="ws-row-actions">
                          <button type="button" class="ws-edit-btn">Approve</button>
                          <button type="button" class="ws-row-del" data-demo-confirm={CONFIRM_REJECT} title="Reject">×</button>
                        </td>
                      </tr>
                    )) : <tr><td colspan="5" class="ws-empty">No pending requests.</td></tr>}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </section>

        <!-- ============ Attendance ============ -->
        <section class="ws-panel" data-panel="attendance" hidden>
          {demoGroups.map((g) => {
            const byDate = new Map(g.attendanceCalendar.map((s) => [s.date, s]));
            const defaultDay = g.attendanceCalendar[g.attendanceCalendar.length - 1].date;
            return (
              <div data-demo-group={g.key} hidden={g.key !== defaultGroupKey}>
                <div class="ws-att-layout">
                  <div class="ws-att-calendar">
                    <div class="curr-nav">
                      <button type="button" class="curr-nav-btn" aria-label="Previous month">‹</button>
                      <button type="button" class="curr-nav-btn" aria-label="Next month">›</button>
                    </div>
                    <p class="curr-nav-label">{MONTHS[todayD.getMonth()].en} {todayD.getFullYear()}</p>
                    <div class="curr-weekday-row">{WEEKDAYS.map((w) => <div class="curr-weekday">{w.en}</div>)}</div>
                    <div class="curr-month-cells">
                      {attGrid.map((d) => {
                        const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                        const inMonth = d.getMonth() === todayD.getMonth();
                        const hasRecord = byDate.has(dateStr);
                        const cls = ['curr-day-cell', !inMonth && 'curr-day-cell--out', dateStr === todayStr && 'curr-day-cell--today', dateStr === defaultDay && 'curr-day-cell--selected', hasRecord && 'curr-day-cell--has'].filter(Boolean).join(' ');
                        return hasRecord ? (
                          <div class={cls} data-demo-att-cell={g.key} data-date={dateStr} style="cursor:pointer;">
                            <span class="curr-day-num">{d.getDate()}</span>
                            <span class="ws-att-dot" aria-hidden="true"></span>
                          </div>
                        ) : (
                          <div class={cls}><span class="curr-day-num">{d.getDate()}</span></div>
                        );
                      })}
                    </div>
                  </div>
                  <div class="ws-att-list">
