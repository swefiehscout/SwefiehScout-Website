            <div class="ws-toolbar-row">
              <label class="ws-field ws-field--inline"><span>Month</span><select>{MONTHS.map((m, i) => <option value={String(i + 1).padStart(2, '0')} selected={String(i + 1).padStart(2, '0') === CURRENT_MONTH_VAL}>{m.en}</option>)}</select></label>
