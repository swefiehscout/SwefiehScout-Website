                        {p.role === 'admin' ? <p class="ws-admin-note">All groups (admin)</p> : demoGroups.map((g) => (
                          <label class="ws-group-check"><input type="checkbox" checked={p.groups.includes(g.key)} />{g.en}</label>
                        ))}
                      </td>
                      <td class="ws-row-actions">
                        <button type="button" class="btn-primary ws-admin-save">Save</button>
                        {!p.self && <button type="button" class="ws-row-del" data-demo-confirm={CONFIRM_REMOVE_ACCESS} title="Remove access">×</button>}
