                <thead><tr><th>Name</th><th>Role</th><th>Groups</th><th></th></tr></thead>
                <tbody>
                  {demoLeaders.map((p) => (
                    <tr>
                      <td data-label="Name">{p.name}</td>
                      <td data-label="Role">
                        <select data-demo-role-select={p.id}>
                          <option value="pending" selected={p.role === 'pending'}>Pending</option>
                          <option value="leader" selected={p.role === 'leader'}>Leader</option>
                          <option value="admin" selected={p.role === 'admin'}>Admin</option>
                        </select>
                      </td>
