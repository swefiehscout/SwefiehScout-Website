              <div class="ws-dash-card">
                <div class="ws-dash-card-head"><h3>Fee collection by group</h3></div>
                <div class="ws-dash-bars">
                  {overview.byGroup.map((g) => (
                    <div class="ws-dash-bar-col" title={`${g.en} — ${g.feePct}% collected`}>
                      <span class="ws-dash-bar-pct">{g.feePct}%</span>
                      <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style={`height:${g.feePct ? Math.max(g.feePct, 4) : 0}%`}></div></div>
