---
// Curriculum Maker — a weekly/monthly/yearly meeting planner for leaders.
// Gated the same way /leaders/portal is (shared password, localStorage
// session). Data lives in Supabase (see src/lib/curriculum/supabase.ts):
// one shared, co-editable plan per group, keyed by (group_key, date).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { PORTAL_TTL_HOURS } from '../../lib/leader-portal-config';
import { GROUPS, ACTIVITY_BANK } from '../../lib/curriculum/constants';

const ttlMs = PORTAL_TTL_HOURS * 60 * 60 * 1000;
---
<BaseLayout title="Curriculum Maker" bare wide>
  <div class="curr-shell" data-curr-shell hidden>

    <section class="portal-hero curr-hero" data-animate>
      <div class="portal-hero-glow" aria-hidden="true"></div>
      <div class="portal-hero-watermark" aria-hidden="true"></div>
      <div class="portal-hero-content">
        <a class="curr-back-link" href="/leaders/portal">
          <span aria-hidden="true">←</span> Back to portal · العودة للبوابة
        </a>
        <span class="portal-badge">
          <span class="portal-badge-dot" aria-hidden="true"></span>
          Curriculum Maker · صانع المنهج
        </span>
        <h1 class="portal-h1">
          Curriculum Maker
          <span class="portal-h1-ar">صانع المنهج</span>
        </h1>
        <p class="portal-welcome">
          Plan what every meeting will do — week by week, month by month.
          <span class="portal-welcome-sep" aria-hidden="true">·</span>
          <span class="portal-welcome-ar">خطط لما سيقوم به كل اجتماع، أسبوعًا بعد أسبوع وشهرًا بعد شهر.</span>
        </p>
      </div>
    </section>

    <div class="curr-warn" data-curr-warn hidden>
      Not connected to the database yet — changes won't be saved.
      <span dir="rtl">غير متصل بقاعدة البيانات بعد، لن يتم حفظ التغييرات.</span>
    </div>

    <!-- Onboarding: name + which groups this leader plans for -->
    <section class="curr-onboard" data-curr-onboard hidden>
      <div class="curr-onboard-card">
        <div class="curr-onboard-bar" aria-hidden="true"></div>
        <h2 class="section-h2">Who's planning?</h2>
        <p class="section-h2-ar">من يخطط؟</p>
        <label class="curr-onboard-name-field">
          <span class="gate-label">Your name · اسمك</span>
          <input type="text" data-onboard-name placeholder="e.g. Fadi" autocomplete="name" />
        </label>
        <p class="curr-onboard-label">
          Which group(s) do you lead?
          <span class="curr-onboard-label-ar">أي مجموعة (مجموعات) تقود؟</span>
        </p>
        <div class="portal-picker-grid curr-onboard-groups" data-onboard-groups>
          {GROUPS.map((g) => (
            <button type="button" class="portal-picker-btn curr-group-toggle" data-onboard-group={g.key}>
              <span class="portal-picker-ar">{g.ar}</span>
              <span class="portal-picker-en">{g.en}</span>
            </button>
          ))}
        </div>
        <button type="button" class="btn-primary curr-onboard-start" data-onboard-start>
          Start planning · ابدأ التخطيط
        </button>
      </div>
    </section>

    <!-- Main tool -->
    <div class="curr-tool" data-curr-tool hidden>

      <div class="curr-toolbar">
        <div class="curr-toolbar-row">
          <div class="curr-group-tabs" data-curr-group-tabs></div>
          <button type="button" class="curr-who" data-curr-who-btn></button>
        </div>
        <div class="curr-toolbar-row">
          <div class="curr-view-toggle" data-curr-view-toggle>
            <button type="button" data-view="week">Week <span>أسبوع</span></button>
            <button type="button" data-view="month">Month <span>شهر</span></button>
            <button type="button" data-view="year">Year <span>سنة</span></button>
          </div>
          <div class="curr-nav">
            <button type="button" class="curr-nav-btn" data-curr-prev aria-label="Previous">‹</button>
            <button type="button" class="curr-nav-today" data-curr-today>Today · اليوم</button>
            <button type="button" class="curr-nav-btn" data-curr-next aria-label="Next">›</button>
          </div>
          <span class="curr-nav-label" data-curr-nav-label></span>
          <button type="button" class="btn-primary curr-export" data-curr-export>
            Export PDF · تصدير
          </button>
        </div>
      </div>

      <div class="curr-bank">
        <span class="curr-bank-label">Drag onto a date, or tap it while a date is open <span>اسحب إلى تاريخ، أو اضغط عليه عند فتح تاريخ</span></span>
        <div class="curr-bank-chips">
          {ACTIVITY_BANK.map((a) => (
            <div
              class="curr-chip"
              draggable="true"
              data-bank-type={a.type}
              data-bank-en={a.en}
              data-bank-ar={a.ar}
            >
              <Icon name={a.icon as any} size={16} strokeWidth={1.8} />
              <span class="curr-chip-text">
                <span class="curr-chip-en">{a.en}</span>
                <span class="curr-chip-ar">{a.ar}</span>
              </span>
            </div>
          ))}
          <div class="curr-chip curr-chip--custom" data-bank-custom>
            <Icon name="plus" size={16} strokeWidth={1.8} />
            <span class="curr-chip-text">
              <span class="curr-chip-en">Custom</span>
              <span class="curr-chip-ar">مخصص</span>
            </span>
          </div>
        </div>
      </div>

      <div class="curr-view curr-view--month" data-curr-month hidden>
        <div class="curr-month-grid" data-curr-month-grid></div>
      </div>
      <div class="curr-view curr-view--week" data-curr-week hidden>
        <div class="curr-week-grid" data-curr-week-grid></div>
      </div>
      <div class="curr-view curr-view--year" data-curr-year hidden>
        <div class="curr-year-grid" data-curr-year-grid></div>
      </div>
    </div>
  </div>

  <!-- Day detail drawer -->
  <div class="curr-day-overlay" data-curr-day-overlay hidden>
    <div class="curr-day-panel" data-curr-day-panel>
      <button type="button" class="curr-day-close" data-curr-day-close aria-label="Close">×</button>
      <div class="curr-day-header" data-curr-day-header></div>
      <label class="curr-day-field">
        <span>Theme · الموضوع</span>
        <input type="text" data-day-theme placeholder="e.g. First Aid Badge" />
      </label>
      <label class="curr-day-field">
        <span>Notes · ملاحظات</span>
        <textarea data-day-notes rows="2" placeholder="Anything to remember for this meeting…"></textarea>
      </label>
      <div class="curr-day-list" data-curr-day-list></div>
      <p class="curr-day-hint">
        Drag activities in from the bank on the left, drag rows to reorder, or drag a row onto another date to move it.
        <span dir="rtl">اسحب الأنشطة من القائمة، اسحب الصفوف لإعادة الترتيب، أو اسحب صفًا إلى تاريخ آخر لنقله.</span>
      </p>
    </div>
  </div>

  <!-- Custom activity mini-form -->
  <div class="curr-custom-overlay" data-curr-custom-overlay hidden>
    <div class="curr-custom-card">
      <h3>Custom activity <span dir="rtl">نشاط مخصص</span></h3>
      <label><span>English</span><input type="text" data-custom-en /></label>
      <label><span>Arabic (optional) · عربي (اختياري)</span><input type="text" data-custom-ar dir="rtl" /></label>
      <div class="curr-custom-actions">
        <button type="button" data-custom-cancel>Cancel · إلغاء</button>
        <button type="button" class="btn-primary" data-custom-add>Add · إضافة</button>
      </div>
    </div>
  </div>

  <!-- Print-only export sheet (invisible on screen, see global.css) -->
  <div class="curr-print" data-curr-print></div>

  <script is:inline define:vars={{ ttlMs }}>
    (function () {
      var STORAGE_KEY = 'leaders_portal_unlocked_at';
      function unlocked() {
        try {
          var ts = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
          return ts > 0 && Date.now() - ts < ttlMs;
        } catch (e) { return false; }
      }
      function gate() {
        var shell = document.querySelector('[data-curr-shell]');
        if (!unlocked()) {
          window.location.replace('/leaders');
          return;
        }
        if (shell) shell.removeAttribute('hidden');
      }
      document.addEventListener('astro:page-load', gate);
      gate();
    })();
  </script>

  <script>
    import { supabase, supabaseConfigured } from '../../lib/curriculum/supabase';
    import { GROUPS, ACTIVITY_BANK, WEEKDAYS, MONTHS } from '../../lib/curriculum/constants';

    const state = {
      leaderName: '',
      leaderGroups: [],
      activeGroup: null,
      view: 'month',
      anchor: new Date(),
      meetings: new Map(),
      currentDay: null,
      customTargetDate: null,
      channel: null,
    };

    const els = {};
    let staticBound = false;
    let toastTimer;
    let themeTimer;
    let notesTimer;

    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
    function toDateStr(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
    function parseDateStr(s) {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function addDays(d, n) { const c = new Date(d); c.setDate(c.getDate() + n); return c; }
    function startOfWeek(d) {
      const c = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      c.setDate(c.getDate() - c.getDay());
      return c;
    }
    function cryptoRandomId() {
      return (typeof crypto !== 'undefined' && crypto.randomUUID)
        ? crypto.randomUUID()
        : 'a' + Math.random().toString(36).slice(2) + Date.now();
    }
    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));
    }
    function showToast(msg) {
      let t = document.querySelector('.curr-toast');
      if (!t) {
        t = document.createElement('div');
        t.className = 'curr-toast';
        document.body.appendChild(t);
      }
      t.textContent = msg;
      t.classList.add('curr-toast--show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.remove('curr-toast--show'), 3500);
    }

    function cacheEls() {
      els.onboard = document.querySelector('[data-curr-onboard]');
      els.onboardName = document.querySelector('[data-onboard-name]');
      els.onboardGroups = document.querySelector('[data-onboard-groups]');
      els.onboardStart = document.querySelector('[data-onboard-start]');
      els.tool = document.querySelector('[data-curr-tool]');
      els.groupTabs = document.querySelector('[data-curr-group-tabs]');
      els.whoBtn = document.querySelector('[data-curr-who-btn]');
      els.viewToggle = document.querySelector('[data-curr-view-toggle]');
      els.prevBtn = document.querySelector('[data-curr-prev]');
      els.nextBtn = document.querySelector('[data-curr-next]');
      els.todayBtn = document.querySelector('[data-curr-today]');
      els.navLabel = document.querySelector('[data-curr-nav-label]');
      els.exportBtn = document.querySelector('[data-curr-export]');
      els.monthView = document.querySelector('[data-curr-month]');
      els.monthGrid = document.querySelector('[data-curr-month-grid]');
      els.weekView = document.querySelector('[data-curr-week]');
      els.weekGrid = document.querySelector('[data-curr-week-grid]');
      els.yearView = document.querySelector('[data-curr-year]');
      els.yearGrid = document.querySelector('[data-curr-year-grid]');
      els.dayOverlay = document.querySelector('[data-curr-day-overlay]');
      els.dayClose = document.querySelector('[data-curr-day-close]');
      els.dayHeader = document.querySelector('[data-curr-day-header]');
      els.dayTheme = document.querySelector('[data-day-theme]');
      els.dayNotes = document.querySelector('[data-day-notes]');
      els.dayList = document.querySelector('[data-curr-day-list]');
      els.customOverlay = document.querySelector('[data-curr-custom-overlay]');
      els.printSheet = document.querySelector('[data-curr-print]');
      els.warn = document.querySelector('[data-curr-warn]');
    }

    // ---------- Identity (name + groups) --------------------------------
    function loadIdentity() {
      try {
        state.leaderName = localStorage.getItem('curriculum_leader_name') || '';
        state.leaderGroups = JSON.parse(localStorage.getItem('curriculum_leader_groups') || '[]');
      } catch (e) { state.leaderName = ''; state.leaderGroups = []; }
    }
    function saveIdentity(name, groups) {
      state.leaderName = name;
      state.leaderGroups = groups;
      try {
        localStorage.setItem('curriculum_leader_name', name);
        localStorage.setItem('curriculum_leader_groups', JSON.stringify(groups));
      } catch (e) {}
    }

    let onboardSelected = new Set();
    function openOnboarding() {
      onboardSelected = new Set(state.leaderGroups);
      els.onboardName.value = state.leaderName || '';
      els.onboardGroups.querySelectorAll('[data-onboard-group]').forEach((btn) => {
        btn.classList.toggle('curr-group-toggle--active', onboardSelected.has(btn.dataset.onboardGroup));
      });
      els.onboard.removeAttribute('hidden');
      els.tool.setAttribute('hidden', '');
    }

    // ---------- Date range + data loading --------------------------------
    function computeRange() {
      if (state.view === 'month') {
        const first = new Date(state.anchor.getFullYear(), state.anchor.getMonth(), 1);
        const last = new Date(state.anchor.getFullYear(), state.anchor.getMonth() + 1, 0);
        return { start: startOfWeek(first), end: addDays(startOfWeek(last), 6) };
      }
      if (state.view === 'week') {
        const s = startOfWeek(state.anchor);
        return { start: s, end: addDays(s, 6) };
      }
      const y = state.anchor.getFullYear();
      return { start: new Date(y, 0, 1), end: new Date(y, 11, 31) };
    }

    async function loadMeetings() {
      if (!supabaseConfigured || !supabase) {
        if (els.warn) els.warn.removeAttribute('hidden');
        return;
      }
      const { start, end } = computeRange();
      const { data, error } = await supabase
        .from('curriculum_meetings')
        .select('*')
        .eq('group_key', state.activeGroup)
        .gte('date', toDateStr(start))
        .lte('date', toDateStr(end));
      if (error) {
        console.error('curriculum load failed', error);
        showToast('Could not load the curriculum. · تعذر تحميل المنهج.');
        return;
      }
      state.meetings = new Map(data.map((row) => [row.date, row]));
    }

    function getOrCreateMeeting(dateStr) {
      let m = state.meetings.get(dateStr);
      if (!m) {
        m = {
          group_key: state.activeGroup, date: dateStr, theme: null, notes: null,
          activities: [], created_by: state.leaderName || null,
        };
        state.meetings.set(dateStr, m);
      }
      return m;
    }

    async function persistMeeting(dateStr) {
      const m = state.meetings.get(dateStr);
      if (!supabaseConfigured || !supabase || !m) return;
      const isEmpty = (!m.activities || m.activities.length === 0) && !m.theme && !m.notes;
      try {
        if (isEmpty) {
          if (m.id) {
            await supabase.from('curriculum_meetings').delete().eq('id', m.id);
          } else {
            await supabase.from('curriculum_meetings').delete()
              .eq('group_key', state.activeGroup).eq('date', dateStr);
          }
          state.meetings.delete(dateStr);
          return;
        }
        const payload = {
          group_key: m.group_key, date: m.date,
          theme: m.theme || null, notes: m.notes || null,
          activities: m.activities, updated_by: state.leaderName || null,
        };
        if (!m.id) payload.created_by = m.created_by || state.leaderName || null;
        const { data, error } = await supabase
          .from('curriculum_meetings')
          .upsert(payload, { onConflict: 'group_key,date' })
          .select().single();
        if (error) throw error;
        state.meetings.set(dateStr, data);
      } catch (err) {
        console.error('curriculum save failed', err);
        showToast('Could not save — check your connection. · تعذر الحفظ، تحقق من الاتصال.');
      }
    }

    function subscribeRealtime(groupKey) {
      if (!supabaseConfigured || !supabase) return;
      if (state.channel) { supabase.removeChannel(state.channel); state.channel = null; }
      state.channel = supabase
        .channel('curriculum-' + groupKey)
        .on('postgres_changes', {
          event: '*', schema: 'public', table: 'curriculum_meetings',
          filter: 'group_key=eq.' + groupKey,
        }, (payload) => {
          const row = payload.eventType === 'DELETE' ? payload.old : payload.new;
          if (!row || !row.date) return;
          if (payload.eventType === 'DELETE') state.meetings.delete(row.date);
          else state.meetings.set(row.date, row);
          refreshUI();
        })
        .subscribe();
    }

    // ---------- Rendering --------------------------------------------------
    function renderCurrentView() {
      if (state.view === 'month') renderMonth();
      else if (state.view === 'week') renderWeek();
      else renderYear();
    }
    function refreshUI() {
      renderCurrentView();
      if (state.currentDay && els.dayOverlay && !els.dayOverlay.hidden) {
        renderActivityList(els.dayList, state.currentDay);
      }
    }

    function activityRowHTML(a) {
      return `
        <div class="curr-item" data-activity-id="${a.id}">
          <span class="curr-item-handle" aria-hidden="true">⋮⋮</span>
          <span class="curr-item-text">
            <span class="curr-item-en">${escapeHtml(a.en)}</span>
            <span class="curr-item-ar">${escapeHtml(a.ar || '')}</span>
          </span>
          <input type="number" min="0" step="5" class="curr-item-duration" placeholder="min"
                 value="${a.duration != null ? a.duration : ''}" data-duration="${a.id}" />
          <button type="button" class="curr-item-del" data-del="${a.id}" aria-label="Remove">×</button>
        </div>`;
    }

    function setupItemRow(row, dateStr) {
      const activityId = row.dataset.activityId;
      row.draggable = true;
      row.addEventListener('dragstart', (e) => {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', JSON.stringify({ source: 'existing', fromDate: dateStr, activityId }));
      });
      row.addEventListener('dragover', (e) => { e.preventDefault(); row.classList.add('curr-item--over'); });
      row.addEventListener('dragleave', () => row.classList.remove('curr-item--over'));
      row.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        row.classList.remove('curr-item--over');
        const raw = e.dataTransfer.getData('text/plain');
        let payload;
        try { payload = JSON.parse(raw); } catch (err) { return; }
        if (payload.source !== 'existing') { handleDropData(raw, dateStr); return; }
        if (payload.activityId === activityId) return;
        const rect = row.getBoundingClientRect();
        const before = (e.clientY - rect.top) < rect.height / 2;
        const src = state.meetings.get(payload.fromDate);
        if (!src) return;
        const idx = src.activities.findIndex((a) => a.id === payload.activityId);
        if (idx === -1) return;
        const [moved] = src.activities.splice(idx, 1);
        const dst = getOrCreateMeeting(dateStr);
        let targetIdx = dst.activities.findIndex((a) => a.id === activityId);
        if (targetIdx === -1) targetIdx = dst.activities.length;
        dst.activities.splice(before ? targetIdx : targetIdx + 1, 0, moved);
        refreshUI();
        if (payload.fromDate !== dateStr) persistMeeting(payload.fromDate);
        persistMeeting(dateStr);
      });
    }

    function renderActivityList(container, dateStr) {
      if (!container) return;
      const m = state.meetings.get(dateStr);
      const activities = m ? m.activities : [];
      container.innerHTML = activities.length
        ? activities.map(activityRowHTML).join('')
        : '<p class="curr-empty">No activities yet · لا أنشطة بعد</p>';

      container.querySelectorAll('.curr-item').forEach((row) => setupItemRow(row, dateStr));
      container.querySelectorAll('[data-del]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mm = state.meetings.get(dateStr);
          if (!mm) return;
          mm.activities = mm.activities.filter((a) => a.id !== btn.dataset.del);
          refreshUI();
          persistMeeting(dateStr);
        });
      });
      container.querySelectorAll('[data-duration]').forEach((inp) => {
        inp.addEventListener('change', () => {
          const mm = state.meetings.get(dateStr);
          if (!mm) return;
          const act = mm.activities.find((a) => a.id === inp.dataset.duration);
          if (!act) return;
          act.duration = inp.value ? Number(inp.value) : null;
          persistMeeting(dateStr);
        });
      });

      container.addEventListener('dragover', (e) => { e.preventDefault(); container.classList.add('curr-list--over'); });
      container.addEventListener('dragleave', () => container.classList.remove('curr-list--over'));
      container.addEventListener('drop', (e) => {
        e.preventDefault();
        container.classList.remove('curr-list--over');
        handleDropData(e.dataTransfer.getData('text/plain'), dateStr);
      });
    }

    function handleDropData(raw, targetDateStr) {
      let payload;
      try { payload = JSON.parse(raw); } catch (e) { return; }
      if (payload.source === 'bank') {
        const activity = { id: cryptoRandomId(), type: payload.type, en: payload.en, ar: payload.ar, duration: null };
        const m = getOrCreateMeeting(targetDateStr);
        m.activities.push(activity);
        refreshUI();
        persistMeeting(targetDateStr);
      } else if (payload.source === 'custom-prompt') {
        state.customTargetDate = targetDateStr;
        openCustomOverlay();
      } else if (payload.source === 'existing') {
        if (payload.fromDate === targetDateStr) return; // same-date drops are handled per-row
        const src = state.meetings.get(payload.fromDate);
        if (!src) return;
        const idx = src.activities.findIndex((a) => a.id === payload.activityId);
        if (idx === -1) return;
        const [moved] = src.activities.splice(idx, 1);
        const dst = getOrCreateMeeting(targetDateStr);
        dst.activities.push(moved);
        refreshUI();
        persistMeeting(payload.fromDate);
        persistMeeting(targetDateStr);
      }
    }

    function bindDropTarget(el, dateStr) {
      el.addEventListener('dragover', (e) => { e.preventDefault(); el.classList.add('curr-list--over'); });
      el.addEventListener('dragleave', () => el.classList.remove('curr-list--over'));
      el.addEventListener('drop', (e) => {
        e.preventDefault();
        el.classList.remove('curr-list--over');
        handleDropData(e.dataTransfer.getData('text/plain'), dateStr);
      });
    }

    function renderMonth() {
      const anchor = state.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const todayStr = toDateStr(new Date());

      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) =>
        `<div class="curr-weekday"><span>${w.en}</span><span class="curr-weekday-ar">${w.ar}</span></div>`
      ).join('') + '</div><div class="curr-month-cells">';

      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const meeting = state.meetings.get(dateStr);
        const acts = meeting ? meeting.activities : [];
        const shown = acts.slice(0, 3);
        const extra = acts.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === todayStr ? ' curr-day-cell--today' : ''}${acts.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          ${meeting && meeting.theme ? `<span class="curr-day-theme">${escapeHtml(meeting.theme)}</span>` : ''}
          <div class="curr-day-mini">
            ${shown.map((a) => `<span class="curr-mini-chip">${escapeHtml(a.en)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.monthGrid.innerHTML = html;
      els.monthGrid.querySelectorAll('.curr-day-cell').forEach((cell) => {
        const dateStr = cell.dataset.date;
        cell.addEventListener('click', () => openDayPanel(dateStr));
        bindDropTarget(cell, dateStr);
      });
    }

    function renderWeek() {
      const start = startOfWeek(state.anchor);
      let cols = '';
      for (let i = 0; i < 7; i++) {
        const d = addDays(start, i);
        const dateStr = toDateStr(d);
        const isToday = dateStr === toDateStr(new Date());
        cols += `<div class="curr-week-col${isToday ? ' curr-week-col--today' : ''}">
          <button type="button" class="curr-week-head" data-open="${dateStr}">
            <span class="curr-week-day">${WEEKDAYS[i].en} <span class="curr-week-day-ar">${WEEKDAYS[i].ar}</span></span>
            <span class="curr-week-date">${d.getDate()} ${MONTHS[d.getMonth()].en}</span>
          </button>
          <div class="curr-week-list" data-list="${dateStr}"></div>
        </div>`;
      }
      els.weekGrid.innerHTML = cols;
      els.weekGrid.querySelectorAll('[data-open]').forEach((btn) => {
        btn.addEventListener('click', () => openDayPanel(btn.dataset.open));
      });
      els.weekGrid.querySelectorAll('[data-list]').forEach((list) => {
        renderActivityList(list, list.dataset.list);
      });
    }

    function renderYear() {
      const year = state.anchor.getFullYear();
      let html = '';
      for (let mo = 0; mo < 12; mo++) {
        const first = new Date(year, mo, 1);
        const last = new Date(year, mo + 1, 0);
        const gridStart = startOfWeek(first);
        const gridEnd = addDays(startOfWeek(last), 6);
        let count = 0;
        let cells = '';
        let d = new Date(gridStart);
        while (d <= gridEnd) {
          const dateStr = toDateStr(d);
          const inMonth = d.getMonth() === mo;
          const meeting = state.meetings.get(dateStr);
          const has = inMonth && meeting && meeting.activities.length;
          if (has) count++;
          cells += `<span class="curr-yr-cell${inMonth ? '' : ' curr-yr-cell--out'}${has ? ' curr-yr-cell--has' : ''}">${inMonth ? d.getDate() : ''}</span>`;
          d = addDays(d, 1);
        }
        html += `<button type="button" class="curr-yr-month" data-month="${mo}">
          <span class="curr-yr-month-head">${MONTHS[mo].en}${count ? `<span class="curr-yr-month-count">${count} planned</span>` : ''}</span>
          <span class="curr-yr-month-ar">${MONTHS[mo].ar}</span>
          <div class="curr-yr-cells">${cells}</div>
        </button>`;
      }
      els.yearGrid.innerHTML = html;
      els.yearGrid.querySelectorAll('[data-month]').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.anchor = new Date(year, Number(btn.dataset.month), 1);
          setView('month');
        });
      });
    }

    // ---------- Day drawer ---------------------------------------------
    function openDayPanel(dateStr) {
      state.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      const m = state.meetings.get(dateStr);
      els.dayHeader.innerHTML = `
        <span class="curr-day-h-en">${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}</span>
        <span class="curr-day-h-ar">${WEEKDAYS[d.getDay()].ar} ${d.getDate()} ${MONTHS[d.getMonth()].ar} ${d.getFullYear()}</span>`;
      els.dayTheme.value = (m && m.theme) || '';
      els.dayNotes.value = (m && m.notes) || '';
      renderActivityList(els.dayList, dateStr);
      els.dayOverlay.removeAttribute('hidden');
    }
    function closeDayPanel() {
      els.dayOverlay.setAttribute('hidden', '');
      state.currentDay = null;
    }

    // ---------- Custom activity overlay ---------------------------------
    function openCustomOverlay() {
      document.querySelector('[data-custom-en]').value = '';
      document.querySelector('[data-custom-ar]').value = '';
      els.customOverlay.removeAttribute('hidden');
    }
    function closeCustomOverlay() { els.customOverlay.setAttribute('hidden', ''); }

    // ---------- Navigation ------------------------------------------------
    function updateNavLabel() {
      const a = state.anchor;
      if (state.view === 'month') {
        els.navLabel.textContent = `${MONTHS[a.getMonth()].en} ${a.getFullYear()} · ${MONTHS[a.getMonth()].ar} ${a.getFullYear()}`;
      } else if (state.view === 'week') {
        const s = startOfWeek(a), e = addDays(s, 6);
        const sameMonth = s.getMonth() === e.getMonth();
        els.navLabel.textContent = sameMonth
          ? `${MONTHS[s.getMonth()].en} ${s.getDate()}–${e.getDate()}, ${e.getFullYear()}`
          : `${MONTHS[s.getMonth()].en} ${s.getDate()} – ${MONTHS[e.getMonth()].en} ${e.getDate()}, ${e.getFullYear()}`;
      } else {
        els.navLabel.textContent = String(a.getFullYear());
      }
    }
    async function reload() {
      updateNavLabel();
      await loadMeetings();
      renderCurrentView();
    }
    function navPrev() {
      if (state.view === 'month') state.anchor = new Date(state.anchor.getFullYear(), state.anchor.getMonth() - 1, 1);
      else if (state.view === 'week') state.anchor = addDays(state.anchor, -7);
      else state.anchor = new Date(state.anchor.getFullYear() - 1, 0, 1);
      reload();
    }
    function navNext() {
      if (state.view === 'month') state.anchor = new Date(state.anchor.getFullYear(), state.anchor.getMonth() + 1, 1);
      else if (state.view === 'week') state.anchor = addDays(state.anchor, 7);
      else state.anchor = new Date(state.anchor.getFullYear() + 1, 0, 1);
      reload();
    }
    function navToday() { state.anchor = new Date(); reload(); }

    function setView(view) {
      state.view = view;
      try { localStorage.setItem('curriculum_view_mode', view); } catch (e) {}
      els.viewToggle.querySelectorAll('button').forEach((b) => {
        b.classList.toggle('curr-view-btn--active', b.dataset.view === view);
      });
      els.monthView.toggleAttribute('hidden', view !== 'month');
      els.weekView.toggleAttribute('hidden', view !== 'week');
      els.yearView.toggleAttribute('hidden', view !== 'year');
      reload();
    }

    function setActiveGroup(key) {
      state.activeGroup = key;
      try { localStorage.setItem('curriculum_active_group', key); } catch (e) {}
      renderGroupTabs();
      subscribeRealtime(key);
      reload();
    }
    function renderGroupTabs() {
      if (state.leaderGroups.length <= 1) { els.groupTabs.innerHTML = ''; return; }
      els.groupTabs.innerHTML = state.leaderGroups.map((key) => {
        const g = GROUPS.find((x) => x.key === key);
        return `<button type="button" class="curr-tab${key === state.activeGroup ? ' curr-tab--active' : ''}" data-tab="${key}">
          <span class="curr-tab-ar">${g.ar}</span><span class="curr-tab-en">${g.en}</span>
        </button>`;
      }).join('');
      els.groupTabs.querySelectorAll('[data-tab]').forEach((btn) => {
        btn.addEventListener('click', () => setActiveGroup(btn.dataset.tab));
      });
    }

    // ---------- Export PDF (print) --------------------------------------
    function exportPDF() {
      const { start, end } = computeRange();
      const g = GROUPS.find((x) => x.key === state.activeGroup);
      let html = `<h1>${escapeHtml(g.en)} — Curriculum <span dir="rtl">${escapeHtml(g.ar)} — المنهج</span></h1>
        <p class="curr-print-range">${escapeHtml(els.navLabel.textContent)}</p>`;
      let any = false;
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const m = state.meetings.get(dateStr);
        if (m && m.activities && m.activities.length) {
          any = true;
          html += `<div class="curr-print-day">
            <h3>${WEEKDAYS[d.getDay()].en} · ${d.getDate()} ${MONTHS[d.getMonth()].en} ${d.getFullYear()}
              <span dir="rtl">${WEEKDAYS[d.getDay()].ar} ${d.getDate()} ${MONTHS[d.getMonth()].ar}</span></h3>
            ${m.theme ? `<p class="curr-print-theme">${escapeHtml(m.theme)}</p>` : ''}
            <ol>${m.activities.map((a) => `<li>${escapeHtml(a.en)} <span dir="rtl">${escapeHtml(a.ar || '')}</span>${a.duration ? ` — ${a.duration} min` : ''}</li>`).join('')}</ol>
            ${m.notes ? `<p class="curr-print-notes">${escapeHtml(m.notes)}</p>` : ''}
          </div>`;
        }
        d = addDays(d, 1);
      }
      if (!any) html += '<p>No meetings planned in this range yet. · لا اجتماعات مخططة في هذه الفترة بعد.</p>';
      els.printSheet.innerHTML = html;
      window.print();
    }

    // ---------- Static listeners (bound once per module load) -----------
    function bindStaticListeners() {
      if (staticBound) return;
      staticBound = true;

      document.querySelectorAll('.curr-chip[data-bank-type]').forEach((chip) => {
        chip.addEventListener('dragstart', (e) => {
          e.dataTransfer.effectAllowed = 'copy';
          e.dataTransfer.setData('text/plain', JSON.stringify({
            source: 'bank', type: chip.dataset.bankType, en: chip.dataset.bankEn, ar: chip.dataset.bankAr,
          }));
        });
        chip.addEventListener('click', () => {
          if (!state.currentDay || els.dayOverlay.hidden) {
            showToast('Open a date first, then tap an activity. · افتح تاريخًا أولاً، ثم اضغط على نشاط.');
            return;
          }
          const activity = { id: cryptoRandomId(), type: chip.dataset.bankType, en: chip.dataset.bankEn, ar: chip.dataset.bankAr, duration: null };
          const m = getOrCreateMeeting(state.currentDay);
          m.activities.push(activity);
          refreshUI();
          persistMeeting(state.currentDay);
        });
      });

      const customChip = document.querySelector('[data-bank-custom]');
      customChip.draggable = true;
      customChip.addEventListener('dragstart', (e) => {
        e.dataTransfer.effectAllowed = 'copy';
        e.dataTransfer.setData('text/plain', JSON.stringify({ source: 'custom-prompt' }));
      });
      customChip.addEventListener('click', () => {
        state.customTargetDate = (!els.dayOverlay.hidden && state.currentDay) ? state.currentDay : null;
        if (!state.customTargetDate) { showToast('Open a date first. · افتح تاريخًا أولاً.'); return; }
        openCustomOverlay();
      });

      els.onboardGroups.querySelectorAll('[data-onboard-group]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.onboardGroup;
          if (onboardSelected.has(key)) onboardSelected.delete(key); else onboardSelected.add(key);
          btn.classList.toggle('curr-group-toggle--active');
        });
      });
      els.onboardStart.addEventListener('click', () => {
        const name = els.onboardName.value.trim();
        if (!name || onboardSelected.size === 0) {
          showToast('Enter your name and pick at least one group. · أدخل اسمك واختر مجموعة واحدة على الأقل.');
          return;
        }
        const groups = GROUPS.filter((g) => onboardSelected.has(g.key)).map((g) => g.key);
        saveIdentity(name, groups);
        if (!groups.includes(state.activeGroup)) state.activeGroup = groups[0];
        startTool();
      });
      els.whoBtn.addEventListener('click', openOnboarding);

      els.viewToggle.querySelectorAll('button[data-view]').forEach((btn) => {
        btn.addEventListener('click', () => setView(btn.dataset.view));
      });
      els.prevBtn.addEventListener('click', navPrev);
      els.nextBtn.addEventListener('click', navNext);
      els.todayBtn.addEventListener('click', navToday);
      els.exportBtn.addEventListener('click', exportPDF);

      els.dayClose.addEventListener('click', closeDayPanel);
      document.addEventListener('click', (e) => {
        if (els.dayOverlay.hidden) return;
        if (e.target.closest('[data-curr-day-panel]')) return;
        if (e.target.closest('.curr-day-cell') || e.target.closest('[data-open]')) return;
        closeDayPanel();
      });
      els.dayTheme.addEventListener('input', () => {
        clearTimeout(themeTimer);
        themeTimer = setTimeout(() => {
          if (!state.currentDay) return;
          const m = getOrCreateMeeting(state.currentDay);
          m.theme = els.dayTheme.value.trim() || null;
          persistMeeting(state.currentDay);
          renderCurrentView();
        }, 500);
      });
      els.dayNotes.addEventListener('input', () => {
        clearTimeout(notesTimer);
        notesTimer = setTimeout(() => {
          if (!state.currentDay) return;
          const m = getOrCreateMeeting(state.currentDay);
          m.notes = els.dayNotes.value.trim() || null;
          persistMeeting(state.currentDay);
        }, 500);
      });

      document.querySelector('[data-custom-cancel]').addEventListener('click', closeCustomOverlay);
      document.querySelector('[data-custom-add]').addEventListener('click', () => {
        const en = document.querySelector('[data-custom-en]').value.trim();
        const ar = document.querySelector('[data-custom-ar]').value.trim();
        if (!en) { showToast('Enter an activity name. · أدخل اسم النشاط.'); return; }
        const activity = { id: cryptoRandomId(), type: 'custom', en, ar, duration: null };
        const m = getOrCreateMeeting(state.customTargetDate);
        m.activities.push(activity);
        refreshUI();
        persistMeeting(state.customTargetDate);
        closeCustomOverlay();
      });
    }

    function startTool() {
      els.onboard.setAttribute('hidden', '');
      els.tool.removeAttribute('hidden');
      els.whoBtn.innerHTML = `${escapeHtml(state.leaderName)} <span class="curr-who-change">change · تغيير</span>`;
      renderGroupTabs();
      els.viewToggle.querySelectorAll('button').forEach((b) => {
        b.classList.toggle('curr-view-btn--active', b.dataset.view === state.view);
      });
      els.monthView.toggleAttribute('hidden', state.view !== 'month');
      els.weekView.toggleAttribute('hidden', state.view !== 'week');
      els.yearView.toggleAttribute('hidden', state.view !== 'year');
      subscribeRealtime(state.activeGroup);
      reload();
    }

    function init() {
      cacheEls();
      loadIdentity();
      const savedView = (() => { try { return localStorage.getItem('curriculum_view_mode'); } catch (e) { return null; } })();
      state.view = (savedView === 'week' || savedView === 'year') ? savedView : 'month';
      state.anchor = new Date();
      const savedGroup = (() => { try { return localStorage.getItem('curriculum_active_group'); } catch (e) { return null; } })();
      state.activeGroup = (state.leaderGroups.includes(savedGroup)) ? savedGroup : state.leaderGroups[0];

      bindStaticListeners();

      if (state.leaderName && state.leaderGroups.length) startTool();
      else openOnboarding();
    }

    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
