---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { loadPortalData, TOOL_LABELS, GROUP_LABELS } from '../../lib/leader-portal';
import { PORTAL_TTL_HOURS } from '../../lib/leader-portal-config';
import { joinUsMarqueePhotos } from '../../lib/scenic-photos';

// Same scenic strip as the Join Us page; doubled so the track loops seamlessly.
const marqueePhotos = [...joinUsMarqueePhotos, ...joinUsMarqueePhotos];

const data = loadPortalData();
const ttlMs = PORTAL_TTL_HOURS * 60 * 60 * 1000;

const lessons = data['Lessons'] ?? {};
const management = data['Management'] ?? {};

function tool(key: string) {
  return TOOL_LABELS[key] ?? { en: key, ar: '' };
}
function group(key: string) {
  return GROUP_LABELS[key] ?? { en: key, ar: '' };
}

const lessonsList = Object.entries(lessons)
  .map(([k, v]) => ({ key: k, url: v.url }))
  .filter((l) => !!l.url);

const managementList = Object.entries(management).map(([k, v]) => ({
  key: k,
  url: v.url,
  children: v.children
    ? Object.entries(v.children).map(([gk, gv]) => ({ key: gk, url: gv.url }))
    : null,
}));

// Every group that appears under any management tool, in markdown order.
// Drives the "filter by group" switcher.
const groupKeys = [
  ...new Set(managementList.flatMap((t) => (t.children ?? []).map((c) => c.key))),
];

const TOOL_ICONS: Record<string, any> = {
  'Attendance':          'calendar',
  'Monthly Fee Tracker': 'cash',
  'Orthodox Lessons':    'cross',
  'Scout Lessons':       'flag',
};

---
<BaseLayout title="Leaders Portal" bare wide>
  <div class="portal-shell" data-portal-shell hidden>

    <section class="portal-hero" data-animate>
      <div class="portal-hero-glow" aria-hidden="true"></div>
      <div class="portal-hero-watermark" aria-hidden="true"></div>

      <div class="portal-hero-content">
        <span class="portal-badge">
          <span class="portal-badge-dot" aria-hidden="true"></span>
          Leaders Access · دخول القادة
        </span>
        <h1 class="portal-h1">
          Leaders Portal
          <span class="portal-h1-ar">بوابة القادة</span>
        </h1>
        <p class="portal-welcome">
          <span data-portal-day-en>Welcome back, leader.</span>
          <span class="portal-welcome-sep" aria-hidden="true">·</span>
          <span class="portal-welcome-ar" data-portal-day-ar>أهلًا بعودتك أيها القائد.</span>
        </p>
        <div class="portal-hero-actions">
          <button type="button" class="portal-lock" data-portal-lock>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 1 1 8 0v4" />
            </svg>
            Lock session · قفل الجلسة
          </button>
          <span class="portal-session-pill" data-portal-session>
            Session active · الجلسة مفتوحة
          </span>
        </div>
      </div>
    </section>

    <a class="portal-curr-cta" href="/leaders/curriculum" data-animate>
      <div class="portal-curr-cta-watermark" aria-hidden="true"></div>
      <div class="portal-curr-cta-content">
        <div class="portal-curr-cta-text">
          <span class="portal-curr-cta-badge">New · جديد</span>
          <h2 class="portal-curr-cta-h2">
            Curriculum Maker
            <span class="portal-curr-cta-h2-ar">صانع المنهج</span>
          </h2>
          <p class="portal-curr-cta-desc">
            Drag-and-drop a weekly, monthly, or yearly plan for your group's meetings, then export it as a PDF.
            <span class="portal-curr-cta-desc-ar">اسحب وأفلت لتخطيط اجتماعات مجموعتك أسبوعيًا أو شهريًا أو سنويًا، ثم صدّرها كملف PDF.</span>
          </p>
        </div>
        <span class="portal-curr-cta-arrow" aria-hidden="true">→</span>
      </div>
    </a>

    <section class="section-stack" data-animate>
      <h2 class="section-h2">Management</h2>
      <p class="section-h2-ar">الإدارة</p>
    </section>

    {groupKeys.length > 1 && (
      <section class="portal-picker" data-group-picker data-animate>
        <p class="portal-picker-label">
          Choose your group
          <span class="portal-picker-label-ar">اختر مجموعتك</span>
        </p>
        <div class="portal-picker-grid">
          {groupKeys.map((k) => {
            const g = group(k);
            return (
              <button type="button" class="portal-picker-btn" data-group={k}>
                <span class="portal-picker-ar">{g.ar}</span>
                <span class="portal-picker-en">{g.en}</span>
              </button>
            );
          })}
        </div>
        <button type="button" class="portal-picker-all" data-group="all">
          View all groups · عرض كل المجموعات
        </button>
      </section>
    )}

    <div class="portal-groupbar" data-group-bar hidden>
      <button type="button" class="portal-back" data-group-back>
        <span class="portal-back-arrow" aria-hidden="true">←</span>
        Change group · تغيير المجموعة
      </button>
    </div>

    <section class="portal-index" data-portal-index hidden>
      {managementList.map((t) => {
        const labels = tool(t.key);
        const kids = t.children;
        return (
          <div class="portal-row" data-portal-tool-row>
            <span class="portal-row-icon" aria-hidden="true">
              <Icon name={TOOL_ICONS[t.key] ?? 'star'} size={20} strokeWidth={1.6} />
            </span>
            <span class="portal-row-text">
              <span class="portal-row-title">{labels.en}</span>
              <span class="portal-row-title-ar">{labels.ar}</span>
            </span>
            <div class="portal-row-links">
              {kids
                ? kids.map((c) => {
                    const g = group(c.key);
                    return c.url ? (
                      <a
                        class="portal-chip"
                        href={c.url}
                        target="_blank"
                        rel="noopener"
                        data-group={c.key}
                      >
                        <span class="portal-chip-ar">{g.ar}</span>
                        <span class="portal-chip-en">{g.en}</span>
                      </a>
                    ) : (
                      <span
                        class="portal-chip portal-chip--empty"
                        aria-disabled="true"
                        data-group={c.key}
                      >
                        <span class="portal-chip-ar">{g.ar}</span>
                        <span class="portal-chip-en">soon</span>
                      </span>
                    );
                  })
                : t.url ? (
                    <a
                      class="portal-chip"
                      href={t.url}
                      target="_blank"
                      rel="noopener"
                    >
                      <span class="portal-chip-ar">فتح</span>
                      <span class="portal-chip-en">Open</span>
                    </a>
                  ) : (
                    <span class="portal-chip portal-chip--empty" aria-disabled="true">
                      <span class="portal-chip-ar">قريبًا</span>
                      <span class="portal-chip-en">soon</span>
                    </span>
                  )}
            </div>
          </div>
        );
      })}
    </section>

    {lessonsList.length > 0 && (
      <>
        <section class="section-stack" data-animate>
          <h2 class="section-h2">Lessons</h2>
          <p class="section-h2-ar">الدروس</p>
        </section>

        <section class="portal-index" data-animate>
          {lessonsList.map((l) => {
            const labels = tool(l.key);
            return (
              <a
                class="portal-row portal-row--link"
                href={l.url}
                target="_blank"
                rel="noopener"
              >
                <span class="portal-row-icon" aria-hidden="true">
                  <Icon name={TOOL_ICONS[l.key] ?? 'sparkle'} size={20} strokeWidth={1.6} />
                </span>
                <span class="portal-row-text">
                  <span class="portal-row-title">{labels.en}</span>
                  <span class="portal-row-title-ar">{labels.ar}</span>
                </span>
                <span class="portal-row-open">
                  Drive folder
                  <span class="portal-row-arrow" aria-hidden="true">→</span>
                </span>
              </a>
            );
          })}
        </section>
      </>
    )}

    <section class="band-marquee" aria-label="Photos from the troop" data-animate>
      <div class="band-marquee-track" style={`--n: ${joinUsMarqueePhotos.length}`}>
        {marqueePhotos.map((src, i) => (
          <div class="band-marquee-slide">
            <img
              src={src}
              alt=""
              loading="lazy"
              aria-hidden={i >= joinUsMarqueePhotos.length}
            />
          </div>
        ))}
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ ttlMs }}>
    (function () {
      var STORAGE_KEY = 'leaders_portal_unlocked_at';
      function unlocked() {
        try {
          var ts = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
          return ts > 0 && Date.now() - ts < ttlMs;
        } catch (e) { return false; }
      }
      function gate() {
        var shell = document.querySelector('[data-portal-shell]');
        if (!unlocked()) {
          window.location.replace('/leaders');
          return;
        }
        if (shell) shell.removeAttribute('hidden');
      }
      function fillDate() {
        var en = document.querySelector('[data-portal-day-en]');
        var ar = document.querySelector('[data-portal-day-ar]');
        try {
          var now = new Date();
          if (en) {
            en.textContent = now.toLocaleDateString('en-US', {
              weekday: 'long', month: 'long', day: 'numeric'
            });
          }
          if (ar) {
            ar.textContent = now.toLocaleDateString('ar-EG', {
              weekday: 'long', month: 'long', day: 'numeric'
            });
          }
        } catch (e) {}
      }
      function fillSession() {
        var pill = document.querySelector('[data-portal-session]');
        if (!pill) return;
        try {
          var ts = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
          if (!ts) return;
          var remaining = ts + ttlMs - Date.now();
          var hours = Math.floor(remaining / 3600000);
          var minutes = Math.floor((remaining % 3600000) / 60000);
          var label =
            hours > 0
              ? hours + 'h ' + minutes + 'm left'
              : minutes + 'm left';
          var labelAr =
            hours > 0
              ? 'متبقي ' + hours + ' س ' + minutes + ' د'
              : 'متبقي ' + minutes + ' د';
          pill.innerHTML =
            '<span class="portal-session-dot" aria-hidden="true"></span>' +
            label + ' · ' + labelAr;
        } catch (e) {}
      }
      function bindLock() {
        var btn = document.querySelector('[data-portal-lock]');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
          window.location.replace('/leaders');
        });
      }
      /* ---- Group step ---------------------------------------------
         Management is a two-step flow: pick a group, then see only that
         group's links with a back button to switch. The pick is stored,
         so a return visit lands straight on the tools. */
      var GROUP_KEY = 'leaders_portal_group';

      function filterTo(g) {
        var index = document.querySelector('[data-portal-index]');
        if (!index) return;
        var chips = index.querySelectorAll('.portal-chip[data-group]');
        for (var i = 0; i < chips.length; i++) {
          var match = g === 'all' || chips[i].getAttribute('data-group') === g;
          chips[i].classList.toggle('is-filtered', !match);
        }
        var rows = index.querySelectorAll('[data-portal-tool-row]');
        for (var r = 0; r < rows.length; r++) {
          var shown = rows[r].querySelectorAll('.portal-chip:not(.is-filtered)');
          // A row with nothing left to show drops out; a row down to a
          // single link gets a wider, easier target.
          rows[r].classList.toggle('is-filtered', shown.length === 0);
          for (var c = 0; c < shown.length; c++) {
            shown[c].classList.toggle('is-solo', shown.length === 1);
          }
        }
      }

      function showTools(g) {
        var picker = document.querySelector('[data-group-picker]');
        var bar = document.querySelector('[data-group-bar]');
        var index = document.querySelector('[data-portal-index]');
        filterTo(g);
        if (picker) picker.setAttribute('hidden', '');
        if (index) index.removeAttribute('hidden');
        if (bar && picker) bar.removeAttribute('hidden');
        try { localStorage.setItem(GROUP_KEY, g); } catch (err) {}
      }

      function showPicker() {
        var picker = document.querySelector('[data-group-picker]');
        var bar = document.querySelector('[data-group-bar]');
        var index = document.querySelector('[data-portal-index]');
        if (!picker) return;
        picker.removeAttribute('hidden');
        if (bar) bar.setAttribute('hidden', '');
        if (index) index.setAttribute('hidden', '');
        try { localStorage.removeItem(GROUP_KEY); } catch (err) {}
      }

      function bindGroups() {
        var picker = document.querySelector('[data-group-picker]');
        var back = document.querySelector('[data-group-back]');
        var index = document.querySelector('[data-portal-index]');

        // No groups in the markdown at all — nothing to pick, just show
        // the tools.
        if (!picker) {
          if (index) index.removeAttribute('hidden');
          return;
        }

        if (!picker.dataset.bound) {
          picker.dataset.bound = '1';
          picker.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-group]');
            if (btn) showTools(btn.getAttribute('data-group'));
          });
        }
        if (back && !back.dataset.bound) {
          back.dataset.bound = '1';
          back.addEventListener('click', showPicker);
        }

        var saved = null;
        try { saved = localStorage.getItem(GROUP_KEY); } catch (err) {}
        // Ignore a remembered group that is no longer in the markdown.
        if (saved && saved !== 'all' && !picker.querySelector('[data-group="' + saved + '"]')) {
          saved = null;
        }
        if (saved) showTools(saved);
        else showPicker();
      }

      function setup() {
        gate();
        bindLock();
        fillDate();
        fillSession();
        bindGroups();
      }
      document.addEventListener('astro:page-load', setup);
      gate();
    })();
  </script>
</BaseLayout>
