---
// Step-by-step guide for leaders and admins using the Leaders Workspace.
// Linked from a "Guide" button in app.astro's header, next to the account
// avatar. Kept short and plain on purpose — leaders are not technical, so
// each section is one clarifying sentence plus a couple of short bullets,
// no jargon, no raw URLs/paths, no cross-references to chase.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { workspaceMarqueePhotos } from '../../lib/scenic-photos';

const marqueePhotos = [...workspaceMarqueePhotos, ...workspaceMarqueePhotos];

type IconName =
  | 'sparkle' | 'cross' | 'star' | 'heart' | 'flag' | 'music' | 'flower' | 'fleur'
  | 'arrow-right' | 'phone' | 'envelope' | 'pin' | 'bank' | 'cliq' | 'cash'
  | 'calendar' | 'compass' | 'plus' | 'diamond' | 'sun' | 'box' | 'megaphone' | 'lock';

const sections: { id: string; label: string; icon: IconName; intro: string; lines: string[]; numbered?: boolean; adminOnly?: boolean }[] = [
  {
    id: 'getting-started', label: 'Getting started', icon: 'sun', numbered: true,
    intro: 'Every leader signs in with their own account.',
    lines: [
      'Tap Sign up and enter your name, email, and a password.',
      'Check your email and tap the confirmation link.',
      'Come back and sign in.',
      'Wait for an admin to approve you and add you to a group.',
      "Once you're approved, sign in again and you're in.",
    ],
  },
  {
    id: 'groups', label: 'Groups', icon: 'flower',
    intro: 'Everything you do happens inside one group at a time.',
    lines: [
      "Lead one group? That's all you'll see.",
      "Lead more than one? Tap a group's name at the top to switch.",
      "The bar under the tabs always shows which group you're viewing.",
      "The 5 troops (Baraem, Ashbal & Zahrat, Mubtadi, Mutaqaddim, Jawalah) get the full set of tabs below.",
      "Music, Social Media, and General aren't scout troops, so each sees its own smaller, tailored set of tabs instead — no Dashboard, Attendance, Fees, or Curriculum for any of them.",
    ],
  },
  {
    id: 'dashboard', label: 'Dashboard', icon: 'compass',
    intro: "Your troop's story at a glance, the moment you sign in. Troops only.",
    lines: [
      'Member count, attendance, fees, and money in and out.',
      'Your next planned meeting.',
      'Anything that needs attention, unpaid fees, new requests, allergies.',
    ],
  },
  {
    id: 'roster', label: 'Roster', icon: 'star',
    intro: 'Everyone currently in your group.',
    lines: [
      "Add a member, only their name is required, though their own phone and an emergency contact are worth adding too.",
      "In Music, Social Media, or General, check people off from a troop's roster instead of retyping them, most band members, content creators, and board members are already scouts somewhere.",
      'Search to find someone quickly.',
      'Edit to update their details, or Archive when they leave.',
    ],
  },
  {
    id: 'archive', label: 'Archive', icon: 'fleur',
    intro: "Members who've left, kept, not deleted.",
    lines: [
      'Nothing about them is lost, their history stays intact.',
      'Restore brings someone back at any time.',
    ],
  },
  {
    id: 'approvals', label: 'Approvals', icon: 'plus',
    intro: 'New people asking to join your group.',
    lines: [
      'Approve adds them straight to your roster.',
      'Reject just declines the request, nothing is saved.',
    ],
  },
  {
    id: 'attendance', label: 'Attendance', icon: 'calendar',
    intro: 'Mark who showed up, one meeting at a time. Troops only.',
    lines: [
      'Pick a date on the calendar.',
      "Tick who's present, it saves instantly.",
    ],
  },
  {
    id: 'fees', label: 'Fees', icon: 'cash',
    intro: "Track who's paid their dues each month. Troops only.",
    lines: [
      'Pick the month.',
      "Tick who's paid, the date is recorded automatically.",
    ],
  },
  {
    id: 'curriculum', label: 'Curriculum', icon: 'flag',
    intro: 'Plan what happens at each meeting. Troops only.',
    lines: [
      'Tap a date to plan that meeting.',
      'Add a theme and pick or type activities.',
      "Download a PDF of the plan from the Reports tab anytime.",
    ],
  },
  {
    id: 'inventory', label: 'Inventory', icon: 'box',
    intro: "Every instrument and piece of equipment the band owns. Music only.",
    lines: [
      'Add an item, its category, quantity, and condition.',
      "Assign it to a band member, and log maintenance when it needs fixing.",
    ],
  },
  {
    id: 'events', label: 'Event Calendar', icon: 'heart',
    intro: "Every booking the band plays, from first inquiry to getting paid. Music only.",
    lines: [
      'Tap a date to see or add that day\'s bookings.',
      'Pick which band members are playing, their pay, and any transport pay.',
      "Once the event happens, fill in what was actually received, it posts to Finance automatically.",
    ],
  },
  {
    id: 'pr', label: 'Public Relations', icon: 'megaphone',
    intro: "Sponsors, community contacts, and General's own files. General only.",
    lines: [
      'Sponsors: current, past, and prospective, contact info and status.',
      'Community & Church Contacts: clergy, schools, media, government, anyone worth keeping on file.',
      'Library and Settings tabs sit here too, alongside these two.',
    ],
  },
  {
    id: 'content', label: 'Content Calendar', icon: 'sparkle',
    intro: "Plan what gets posted and when. Social Media only.",
    lines: [
      'Calendar view for scheduling by date, Board view for tracking by status (Idea → Drafting → Scheduled → Posted).',
      'Attach a draft image, video, or file, and add the live link once it\'s posted.',
    ],
  },
  {
    id: 'credentials', label: 'Credentials', icon: 'lock',
    intro: "Every login the group's accounts use, in one place. Social Media only.",
    lines: [
      'Passwords are masked by default, tap Reveal to view one, or Copy to grab it without showing it.',
      'Anyone with access to this group can view, add, or edit a login.',
    ],
  },
  {
    id: 'finance', label: 'Finance', icon: 'bank',
    intro: "Keep track of your group's money. Every group has one.",
    lines: [
      'Log money coming in or going out.',
      'See totals for whichever month you pick.',
      'The same ledger Admin sees, nothing here is separate from the org-wide accounting system.',
    ],
  },
  {
    id: 'vendors', label: 'Vendors', icon: 'phone',
    intro: "Suppliers, repair shops, venues, anyone your group deals with. Every group has one.",
    lines: [
      'Add your own, or use one an admin already shared into your group under Shared Vendors.',
    ],
  },
  {
    id: 'library', label: 'Library', icon: 'diamond',
    intro: 'Share files with your group. Troops and Social Media.',
    lines: [
      'Upload documents for your leaders to use.',
      'Find shared lesson resources and anything an admin shared org-wide here too.',
    ],
  },
  {
    id: 'reports', label: 'Reports', icon: 'envelope',
    intro: 'Download a clean PDF summary anytime, tailored to your own group.',
    lines: [
      'Troops: Income Statement, Monthly Fees, Attendance, Curriculum, Roster, Vendors.',
      'Music: Music Finance Report, Inventory, Music Event Report, Maintenance, Roster, Vendors.',
      'Social Media: Social Media Finance Report, Content Calendar, Credentials, Roster, Vendors.',
      'General: Income Statement, Sponsors, Community & Church Contacts, Roster, Vendors.',
      "Pick a single month, a whole year, or a custom range spanning several months, whichever a report needs. Roster and Vendors (and Sponsors/Contacts/Credentials where they apply) aren't tied to a date at all.",
    ],
  },
  {
    id: 'admin', label: 'Admin', icon: 'pin', adminOnly: true,
    intro: 'A separate page for admins, tap Admin in the header to get there.',
    lines: [
      'Overview: the 5 troops rolled up together, at a glance.',
      'Music and Social Media each get their own dashboard here too, since neither is a scouting troop.',
      "Finance: one accounting system for every group, an opening balance, a running balance, logging a transaction to any group, and reconciling against what the bank actually shows.",
      'Reports: every report from every group\'s own Reports tab, combined in one place, with the same single month / whole year / custom range picker.',
      'Roster, Vendors (Shared), and Curriculum roll up every group too.',
      'People: approve leaders and admins, and set which groups each one can access.',
    ],
  },
];
---
<BaseLayout title="Leaders Workspace Guide" bare>
  <div class="guide-wrap">
    <section class="page-hero" data-animate>
      <h1 class="page-h1">Leaders Workspace Guide</h1>
      <p class="page-tag">A quick look at how everything works.</p>
    </section>

    <div class="band-marquee guide-marquee ws-dash-marquee" aria-label="Troop photos">
      <div class="band-marquee-track" style={`--n: ${workspaceMarqueePhotos.length}`}>
        {marqueePhotos.map((src, i) => (
          <div class="band-marquee-slide">
            <img src={src} alt="" loading="lazy" aria-hidden={i >= workspaceMarqueePhotos.length} />
          </div>
        ))}
      </div>
      <div class="band-marquee-fade band-marquee-fade--start" aria-hidden="true"></div>
      <div class="band-marquee-fade band-marquee-fade--end" aria-hidden="true"></div>
    </div>

    <a class="btn-primary guide-back" href="/leaders/app">← Back to the workspace</a>

    {sections.map((s) => (
      <section id={s.id} class={`guide-card${s.adminOnly ? ' guide-card--admin' : ''}`}>
        <div class="guide-card-head">
          <span class="guide-card-icon"><Icon name={s.icon} size={20} strokeWidth={1.8} /></span>
          <div>
            <h2>{s.label}{s.adminOnly && <span class="guide-badge">Admins only</span>}</h2>
            <p class="guide-card-intro">{s.intro}</p>
          </div>
        </div>
        {s.numbered ? (
          <ol class="guide-list guide-list--steps">
            {s.lines.map((line) => <li>{line}</li>)}
          </ol>
        ) : (
          <ul class="guide-list">
            {s.lines.map((line) => <li>{line}</li>)}
          </ul>
        )}
      </section>
    ))}

    <a class="btn-primary guide-back guide-back--bottom" href="/leaders/app">← Back to the workspace</a>
  </div>
</BaseLayout>

<style>
  .guide-wrap { max-width: 44rem; margin: 0 auto; }

  .guide-marquee { margin: 0 auto 1.5rem; }
  .guide-marquee.band-marquee { max-width: 100%; }

  .guide-back { display: inline-flex; margin: 0 0 1.5rem; }
  .guide-back--bottom { margin: 1.5rem 0 0.5rem; }

  .guide-card {
    margin-bottom: 1.1rem;
    padding: 1.25rem 1.4rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .guide-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

  .guide-card--admin {
    border-color: var(--color-brand);
    background: linear-gradient(180deg, #fff 0%, var(--color-bg) 100%);
  }

  .guide-card-head { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.8rem; }
  .guide-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
    color: #fff;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }
  .guide-card-head h2 {
    font-family: var(--font-display);
    color: var(--color-brand-dark);
    font-size: 1.15rem;
    margin: 0 0 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .guide-card-intro { margin: 0; color: var(--color-muted); font-size: 0.88rem; line-height: 1.5; }

  .guide-badge {
    display: inline-block;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .guide-list { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; list-style: disc; }
  .guide-list li { line-height: 1.5; font-size: 0.92rem; }

  /* ----- Getting Started's list only: a small numbered stepper instead
     of plain bullets, since it's the one genuinely sequential section —
     everything else is a feature summary, not a process. ----- */
  .guide-list--steps { list-style: none; padding-left: 0; counter-reset: step; gap: 0; }
  .guide-list--steps li {
    position: relative;
    display: block;
    padding: 0 0 1.05rem 2.35rem;
    counter-increment: step;
  }
  .guide-list--steps li:last-child { padding-bottom: 0; }
  .guide-list--steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.05rem;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .guide-list--steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.77rem;
    top: 1.6rem;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
</style>
