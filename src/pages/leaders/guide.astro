---
// Step-by-step guide for leaders and admins using the Leaders Workspace.
// Linked from a "Guide" button in app.astro's header, next to the account
// avatar. Kept short and plain on purpose — leaders are not technical,
// so this stays scannable (short bullets, no jargon, no raw URLs/paths)
// instead of reading like documentation. Anyone who wants more detail
// still has the workspace itself to poke around in.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

type IconName =
  | 'sparkle' | 'cross' | 'star' | 'heart' | 'flag' | 'music' | 'flower' | 'fleur'
  | 'arrow-right' | 'phone' | 'envelope' | 'pin' | 'bank' | 'cliq' | 'cash'
  | 'calendar' | 'compass' | 'plus' | 'diamond' | 'sun';

const sections: { id: string; label: string; icon: IconName; lines: string[]; adminOnly?: boolean }[] = [
  {
    id: 'getting-started', label: 'Getting started', icon: 'sun',
    lines: [
      'Tap Sign up and enter your name, email, and a password.',
      'Check your email and tap the confirmation link.',
      'Come back and sign in.',
      'Wait for an admin to approve you and add you to a group.',
      "Once you're approved, sign in again and you're in.",
    ],
  },
  {
    id: 'groups', label: 'Groups', icon: 'flower',
    lines: [
      "Lead one group? That's all you'll see — nothing to switch.",
      'Lead more than one? Tap a group\'s name at the top to switch to it.',
      'The bar under the tabs always shows which group you\'re looking at.',
    ],
  },
  {
    id: 'dashboard', label: 'Dashboard', icon: 'compass',
    lines: [
      "A quick snapshot of your group.",
      'Member count, attendance, fees, and money in and out.',
      'Your next planned meeting.',
      "Anything that needs your attention — unpaid fees, new requests, allergies.",
    ],
  },
  {
    id: 'roster', label: 'Roster', icon: 'star',
    lines: [
      "Add a member — their name and a guardian's contact info.",
      'Use search to find someone.',
      'Tap Edit to change their details.',
      'Tap Archive when they leave the group.',
    ],
  },
  {
    id: 'archive', label: 'Archive', icon: 'fleur',
    lines: [
      'Members who left — nothing about them is deleted.',
      'Tap Restore to bring someone back at any time.',
    ],
  },
  {
    id: 'approvals', label: 'Approvals', icon: 'plus',
    lines: [
      'New people who asked to join your group show up here.',
      'Approve adds them to your roster. Reject declines the request.',
    ],
  },
  {
    id: 'attendance', label: 'Attendance', icon: 'calendar',
    lines: [
      'Pick a date on the calendar.',
      "Tick who's present — it saves right away, nothing else to do.",
    ],
  },
  {
    id: 'fees', label: 'Fees', icon: 'cash',
    lines: [
      'Pick the month.',
      "Tick who's paid — the date is recorded for you automatically.",
    ],
  },
  {
    id: 'curriculum', label: 'Curriculum', icon: 'flag',
    lines: [
      'Tap a date to plan that meeting.',
      'Add a theme and pick or type the activities.',
      'Download a PDF of the whole month\'s plan whenever you like.',
    ],
  },
  {
    id: 'finance', label: 'Finance', icon: 'bank',
    lines: [
      'Add money coming in or going out, with an amount and date.',
      'See totals for whichever month you pick.',
    ],
  },
  {
    id: 'library', label: 'Library', icon: 'diamond',
    lines: [
      'Upload documents to share with your group.',
      'Find shared lesson resources here too.',
    ],
  },
  {
    id: 'reports', label: 'Reports', icon: 'envelope',
    lines: [
      'Pick a month, then download a PDF — fees, attendance, money, or the meeting plan.',
    ],
  },
  {
    id: 'admin', label: 'Admin', icon: 'pin', adminOnly: true,
    lines: [
      'Everything below is admin only, and covers every group at once.',
      'Overview, Finance, Reports, Curriculum, Library, Roster — the same information as each group\'s own tabs, just all groups together.',
      'Leader Management — approve new leaders, choose which groups each one can access, or remove someone\'s access.',
    ],
  },
];
---
<BaseLayout title="Leaders Workspace Guide" bare>
  <div class="guide-wrap">
    <section class="page-hero" data-animate>
      <h1 class="page-h1">Leaders Workspace Guide</h1>
      <p class="page-tag">A quick look at how everything works.</p>
      <a class="btn-primary guide-back" href="/leaders/app">← Back to the workspace</a>
    </section>

    <nav class="guide-toc" aria-label="Jump to a section">
      {sections.map((s) => (
        <a class="guide-toc-link" href={`#${s.id}`}>
          <Icon name={s.icon} size={15} strokeWidth={1.8} />
          {s.label}
        </a>
      ))}
    </nav>

    {sections.map((s) => (
      <section id={s.id} class={`ws-dash-card guide-card${s.adminOnly ? ' guide-card--admin' : ''}`}>
        <div class="guide-card-head">
          <span class="guide-card-icon"><Icon name={s.icon} size={20} strokeWidth={1.8} /></span>
          <h2>{s.label}{s.adminOnly && <span class="guide-badge">Admins only</span>}</h2>
        </div>
        <ul class="guide-list">
          {s.lines.map((line) => <li>{line}</li>)}
        </ul>
      </section>
    ))}

    <a class="btn-primary guide-back guide-back--bottom" href="/leaders/app">← Back to the workspace</a>
  </div>
</BaseLayout>

<style>
  .guide-wrap { max-width: 44rem; margin: 0 auto; }
  .guide-back { display: inline-flex; margin-top: 1.25rem; }
  .guide-back--bottom { margin: 1rem 0 0.5rem; }

  /* ----- Quick-jump nav — a wrapping pill row, same "no orphans" spirit
     as the workspace's own tab bar, just simpler since it never needs
     JS-balanced columns (a wrapped last row of 1-2 pills reads fine for
     a left-aligned nav, unlike a centered/stretched tab bar). ----- */
  .guide-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
    padding: 0.6rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .guide-toc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-brand);
    font-weight: 600;
    font-size: 0.8rem;
    text-decoration: none;
  }
  .guide-toc-link:hover { background: var(--color-brand); color: #fff; border-color: var(--color-brand); }
  .guide-toc-link:hover :global(svg) { stroke: #fff; }

  .guide-card { margin-bottom: 1rem; scroll-margin-top: 5.5rem; padding: 1.1rem 1.3rem 1.25rem; }
  .guide-card-head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.6rem; }
  .guide-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-brand);
    flex-shrink: 0;
  }
  .guide-card-head h2 {
    font-family: var(--font-display);
    color: var(--color-brand-dark);
    font-size: 1.15rem;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .guide-badge {
    display: inline-block;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .guide-card--admin { border-color: var(--color-brand); }

  .guide-list { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; list-style: disc; }
  .guide-list li { line-height: 1.5; font-size: 0.92rem; }
</style>
