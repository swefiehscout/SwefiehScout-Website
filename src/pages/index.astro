---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { homeMarqueePhotos } from '../lib/scenic-photos';

const marqueePhotos = [...homeMarqueePhotos, ...homeMarqueePhotos];

// Stat tiles. The "since 2008" group has been active for 18 years (as of
// 2026) and currently has 160+ members per the original site copy.
const yearsActive = new Date().getFullYear() - 2008;

const stats = [
  { num: '160+',           label: 'Active Members' },
  { num: yearsActive + '+', label: 'Years of Service' },
  { num: '2008',           label: 'Established' },
  { num: '1',              label: 'Cathedral Home' },
];

const quickLinks = [
  {
    href: '/about-us',
    icon: 'sparkle',
    title: 'About Us',
    blurb: 'Mission, vision, and what drives us forward.',
  },
  {
    href: '/about-us/our-church',
    icon: 'cross',
    title: 'Our Church',
    blurb: 'The Presentation of the Lord Cathedral in Swefieh.',
  },
  {
    href: '/donate',
    icon: 'heart',
    title: 'Donate',
    blurb: 'Support our scouts, programs, and community work.',
  },
  {
    href: '/about-us/our-team',
    icon: 'star',
    title: 'Our Team',
    blurb: 'The leaders who make every camp, hike, and project happen.',
  },
  {
    href: '/about-us/our-band',
    icon: 'music',
    title: 'Our Band',
    blurb: 'Drums, brass, and tradition. The sound of the scouts.',
  },
  {
    href: '/join-us',
    icon: 'arrow-right',
    title: 'Join Us',
    blurb: 'New scouts, families, and supporters always welcome.',
  },
  {
    href: '/gallery',
    icon: 'diamond',
    title: 'Gallery',
    blurb: 'Moments from camps, parades, and life in the troop.',
  },
  {
    href: '/event-booking',
    icon: 'envelope',
    title: 'Event Booking',
    blurb: 'Invite our band or scouts to perform at your event.',
  },
] as const;
---
<BaseLayout title="Home" bare wide>
  <section class="hero hero-split" data-animate>
    <figure class="hero-split-photo">
      <img src="/images/photos/hero.jpg" alt="The Greek Orthodox Scouts & Guides — Swefieh" />
    </figure>
    <div class="hero-split-content">
      <h1>
        The Greek Orthodox <span class="accent">Scouts &amp; Guides</span>
        <br />Swefieh
      </h1>
      <p class="hero-h1-ar">مجموعة كشافة ومرشدات الروم الأرثوذكس - الصويفية</p>
      <p class="tagline">
        A community of faith, service, and adventure, rooted in the
        Orthodox tradition since 2008.
      </p>
      <p class="tagline-ar">قيادة بالإيمان، خدمة بالقلب، وبناء مجتمع أقوى</p>
      <div class="hero-cta">
        <a href="/join-us" class="btn-primary">Join Us</a>
        <a href="/about-us" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <section class="stats">
    {stats.map((s, i) => (
      <div class="stat-card" data-animate data-animate-delay={String((i % 5) + 1)}>
        <span class="stat-num">{s.num}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </section>

  <section class="band-marquee" aria-label="Photos of the band" data-animate>
    <div class="band-marquee-track" style={`--n: ${homeMarqueePhotos.length}`}>
      {marqueePhotos.map((src, i) => (
        <div class="band-marquee-slide">
          <img src={src} alt="" loading="lazy" aria-hidden={i >= homeMarqueePhotos.length} />
        </div>
      ))}
    </div>
    <div class="band-marquee-fade band-marquee-fade--start" aria-hidden="true"></div>
    <div class="band-marquee-fade band-marquee-fade--end" aria-hidden="true"></div>
  </section>

  <section class="section">
    <h2 class="section-heading" data-animate>Welcome · أهلًا بكم</h2>
    <article class="prose" style="text-align: center; max-width: 720px; margin: 0 auto;">
      <p data-animate>
        Based at the Presentation of the Lord Cathedral in Swefieh, we are a
        scouting family of <strong>160+ active members</strong> united by
        faith, service, and adventure.
      </p>
      <p data-animate data-animate-delay="1">
        مجموعة كشافة ومرشدات الروم الأرثوذكس – الصويفية: عائلة من أكثر من ١٦٠ عضوًا نشطًا، مجتمعةٌ على الإيمان، الخدمة، والمغامرة.
      </p>
    </article>
  </section>

  <div class="section-divider" aria-hidden="true" data-animate>
    <span>✦</span>
  </div>

  <section class="mission-banner" data-animate>
    <span class="mission-eyebrow">Our Mission · رسالتنا</span>
    <p class="mission-quote">
      "Empowering scouts to lead with faith, serve with heart, and build a stronger community rooted in the Orthodox spirit."
    </p>
    <p class="mission-quote-ar">
      "تمكين الكشافة من القيادة بالإيمان، والخدمة بقلبٍ مخلص، وبناء مجتمع أقوى متجذر في الروح الأرثوذكسية."
    </p>
  </section>

  <section class="section">
    <h2 class="section-heading" data-animate>Explore Our Community</h2>
    <div class="cards-grid">
      {quickLinks.map((link, i) => (
        <a class="card" href={link.href} data-animate data-animate-delay={String((i % 5) + 1)}>
          <span class="card-icon" aria-hidden="true">
            <Icon name={link.icon} size={26} />
          </span>
          <h3 class="card-title">{link.title}</h3>
          <p class="card-blurb">{link.blurb}</p>
          <span class="card-arrow">Read more →</span>
        </a>
      ))}
    </div>
  </section>

  <div class="section-divider" aria-hidden="true" data-animate>
    <span>✦</span>
  </div>

  <section class="join-cta home-cta" data-animate>
    <h2 class="join-cta-title">Ready to join the journey?</h2>
    <p class="join-cta-title-ar">جاهز للانضمام إلى الرحلة؟</p>
    <p class="join-cta-tag">
      Whether you want to join, support us, or simply learn more, your involvement makes a difference.
    </p>
    <p class="join-cta-tag-ar">
      سواء أردت الانضمام، الدعم، أو معرفة المزيد، مشاركتك تصنع فرقًا.
    </p>
    <div class="join-cta-buttons">
      <a class="btn-primary" href="/join-us">Join Us</a>
      <a class="btn-secondary" href="/donate">Donate</a>
      <a class="btn-secondary" href="/contact-us">Contact Us</a>
    </div>
  </section>
</BaseLayout>
