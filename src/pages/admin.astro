    // ---------- Shared Library: one upload, ticked into any group(s) -------
    async function loadSharedDocs() {
      const { data, error } = await db.from('shared_documents')
        .select('*, shared_document_groups(group_key)')
        .order('uploaded_at', { ascending: false });
      if (error) { console.error(error); showToast('Could not load the shared library.'); return; }
      renderSharedDocs(data || []);
    }
    function renderSharedDocs(docs: any[]) {
      if (!docs.length) { els.libBody.innerHTML = '<tr><td colspan="7" class="ws-empty">Nothing uploaded yet.</td></tr>'; return; }
      els.libBody.innerHTML = docs.map((d: any) => {
        const checked = new Set((d.shared_document_groups || []).map((r: any) => r.group_key));
        const groupChecks = TROOP_GROUPS.map((g) => `
          <label class="ws-group-check">
            <input type="checkbox" data-doc-group value="${g.key}" ${checked.has(g.key) ? 'checked' : ''} />
            ${escapeHtml(g.en)}
          </label>
        `).join('');
        return `
          <tr data-doc-id="${d.id}" data-doc-path="${escapeHtml(d.file_path)}">
            <td data-label="Title">${escapeHtml(d.title)}</td>
            <td class="ws-admin-groups" data-label="Groups">${groupChecks}</td>
            <td data-label="Type">${escapeHtml(d.file_type || '—')}</td>
            <td data-label="Uploaded">${new Date(d.uploaded_at).toLocaleDateString()}</td>
            <td data-label="Uploaded by">${escapeHtml(d.uploaded_by_name || '—')}</td>
            <td class="ws-row-actions">
              <button type="button" class="ws-edit-btn" data-doc-download>Download</button>
              <button type="button" class="ws-row-del" data-doc-del>×</button>
            </td>
          </tr>`;
      }).join('');
      els.libBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.docId;
        const path = row.dataset.docPath;
        row.querySelector('[data-doc-download]').addEventListener('click', async () => {
          const { data, error } = await db.storage.from('documents').createSignedUrl(path, 60);
          if (error || !data) { showToast('Could not open file.'); return; }
          window.open(data.signedUrl, '_blank');
        });
        row.querySelector('[data-doc-del]').addEventListener('click', async () => {
          if (!confirm('Delete this shared document? It disappears from every group it was shared into.')) return;
          await db.storage.from('documents').remove([path]);
          const { error } = await db.from('shared_documents').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          await loadSharedDocs();
        });
        row.querySelectorAll('[data-doc-group]').forEach((cb: any) => {
          cb.addEventListener('change', async () => {
            cb.disabled = true;
            const { error } = cb.checked
              ? await db.from('shared_document_groups').upsert({ shared_document_id: id, group_key: cb.value }, { onConflict: 'shared_document_id,group_key' })
              : await db.from('shared_document_groups').delete().eq('shared_document_id', id).eq('group_key', cb.value);
            cb.disabled = false;
            if (error) { showToast('Could not update, ' + (error.message || 'unknown error') + '.'); cb.checked = !cb.checked; return; }
          });
        });
      });
    }
    function bindLibraryUpload() {
      els.libGroups.innerHTML = TROOP_GROUPS.map((g) => `
        <label class="ws-group-check"><input type="checkbox" data-lib-group value="${g.key}" /> ${escapeHtml(g.en)}</label>
      `).join('');
      els.libUpload.addEventListener('click', async () => {
        const file = els.libFile.files[0];
        const groupKeys = Array.from(els.libGroups.querySelectorAll('[data-lib-group]:checked')).map((i: any) => i.value);
        if (!file) { showToast('Choose a file first.'); return; }
        if (!groupKeys.length) { showToast('Tick at least one group.'); return; }
        els.libUpload.disabled = true;
        const path = `shared/${Date.now()}-${file.name}`;
        const { error: upErr } = await db.storage.from('documents').upload(path, file);
        if (upErr) { console.error(upErr); showToast('Could not upload.'); els.libUpload.disabled = false; return; }
        const title = els.libTitle.value.trim() || file.name;
        const { data: inserted, error } = await db.from('shared_documents').insert({
          title, file_path: path, file_type: file.type || null, size_bytes: file.size,
          uploaded_by: state.session.user.id, uploaded_by_name: state.profile?.name || null,
        }).select().single();
        if (error) { console.error(error); showToast('Could not save document.'); els.libUpload.disabled = false; return; }
        const { error: groupsError } = await db.from('shared_document_groups').insert(
          groupKeys.map((group_key: string) => ({ shared_document_id: inserted.id, group_key })),
        );
        els.libUpload.disabled = false;
        if (groupsError) { console.error(groupsError); showToast('Uploaded, but could not save which groups.'); return; }
        els.libFile.value = '';
        els.libTitle.value = '';
        els.libGroups.querySelectorAll('[data-lib-group]').forEach((cb: any) => { cb.checked = false; });
        showToast('Uploaded.');
        await loadSharedDocs();
      });
    }

    // ---------- Vendors (Shared): one vendor, ticked into any group(s) -----
    async function loadSharedVendorsAdmin() {
      const { data, error } = await db.from('shared_vendors')
        .select('*, shared_vendor_groups(group_key)')
        .order('name', { ascending: true });
      if (error) { console.error(error); showToast('Could not load vendors.'); return; }
      renderSharedVendorsAdmin(data || []);
    }
    function resetSharedVendorForm() {
      state.editingSharedVendorId = null;
      els.svendorForm.reset();
      els.svendorGroups.querySelectorAll('[data-svendor-group]').forEach((cb: any) => { cb.checked = false; });
      els.svendorFormTitle.textContent = 'Add a shared vendor';
      els.svendorSubmit.textContent = 'Add vendor';
      els.svendorCancel.hidden = true;
    }
    function startEditSharedVendor(v: any) {
      state.editingSharedVendorId = v.id;
      els.svendorName.value = v.name;
      els.svendorCategory.value = v.category || '';
      els.svendorPhone.value = v.phone;
      els.svendorEmail.value = v.email || '';
      els.svendorLocation.value = v.location || '';
      els.svendorNotes.value = v.notes || '';
      const checked = new Set((v.shared_vendor_groups || []).map((r: any) => r.group_key));
      els.svendorGroups.querySelectorAll('[data-svendor-group]').forEach((cb: any) => { cb.checked = checked.has(cb.value); });
      els.svendorFormTitle.textContent = `Editing ${v.name}`;
      els.svendorSubmit.textContent = 'Save changes';
      els.svendorCancel.hidden = false;
      els.svendorForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function renderSharedVendorsAdmin(vendors: any[]) {
      if (!vendors.length) { els.svendorBody.innerHTML = '<tr><td colspan="7" class="ws-empty">No shared vendors yet.</td></tr>'; return; }
      els.svendorBody.innerHTML = vendors.map((v: any) => {
        const checked = new Set((v.shared_vendor_groups || []).map((r: any) => r.group_key));
        const groupChecks = GROUPS.map((g) => `
          <label class="ws-group-check">
            <input type="checkbox" data-svendor-row-group value="${g.key}" ${checked.has(g.key) ? 'checked' : ''} />
            ${escapeHtml(g.en)}
          </label>
        `).join('');
        return `
          <tr data-vendor-id="${v.id}">
            <td data-label="Name">${escapeHtml(v.name)}</td>
            <td data-label="Category">${escapeHtml(v.category || '—')}</td>
            <td data-label="Phone">${escapeHtml(v.phone)}</td>
            <td class="ws-admin-groups" data-label="Groups">${groupChecks}</td>
            <td data-label="Added by">${escapeHtml(v.created_by_name || '—')}</td>
            <td class="ws-row-actions">
              <button type="button" class="ws-edit-btn" data-svendor-edit>Edit</button>
              <button type="button" class="ws-row-del" data-svendor-del>×</button>
            </td>
          </tr>`;
      }).join('');
      els.svendorBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.vendorId;
        const vendor = vendors.find((v: any) => v.id === id);
        row.querySelector('[data-svendor-edit]').addEventListener('click', () => startEditSharedVendor(vendor));
        row.querySelector('[data-svendor-del]').addEventListener('click', async () => {
          if (!confirm('Delete this vendor? It disappears from every group it was shared into.')) return;
          const { error } = await db.from('shared_vendors').delete().eq('id', id);
          if (error) { showToast('Could not delete.'); return; }
          if (state.editingSharedVendorId === id) resetSharedVendorForm();
          await loadSharedVendorsAdmin();
        });
        row.querySelectorAll('[data-svendor-row-group]').forEach((cb: any) => {
          cb.addEventListener('change', async () => {
            cb.disabled = true;
            const { error } = cb.checked
              ? await db.from('shared_vendor_groups').upsert({ shared_vendor_id: id, group_key: cb.value }, { onConflict: 'shared_vendor_id,group_key' })
              : await db.from('shared_vendor_groups').delete().eq('shared_vendor_id', id).eq('group_key', cb.value);
            cb.disabled = false;
            if (error) { showToast('Could not update, ' + (error.message || 'unknown error') + '.'); cb.checked = !cb.checked; }
          });
        });
      });
    }
    function bindSharedVendorForm() {
      els.svendorGroups.innerHTML = GROUPS.map((g) => `
        <label class="ws-group-check"><input type="checkbox" data-svendor-group value="${g.key}" /> ${escapeHtml(g.en)}</label>
      `).join('');
      els.svendorCancel.addEventListener('click', resetSharedVendorForm);
      els.svendorForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const name = els.svendorName.value.trim();
        const phone = els.svendorPhone.value.trim();
        const groupKeys = Array.from(els.svendorGroups.querySelectorAll('[data-svendor-group]:checked')).map((i: any) => i.value);
        if (!name || !phone) { showToast('Name and phone are required.'); return; }
        if (!groupKeys.length) { showToast('Tick at least one group.'); return; }
        els.svendorSubmit.disabled = true;
        const payload: any = {
          name, category: els.svendorCategory.value || null, phone,
          email: els.svendorEmail.value.trim() || null, location: els.svendorLocation.value.trim() || null,
          notes: els.svendorNotes.value.trim() || null,
        };
        let vendorId = state.editingSharedVendorId;
        let error;
        if (vendorId) {
          ({ error } = await db.from('shared_vendors').update(payload).eq('id', vendorId));
        } else {
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          const { data: inserted, error: insertErr } = await db.from('shared_vendors').insert(payload).select().single();
          error = insertErr;
          vendorId = inserted?.id;
        }
        if (error) { console.error(error); showToast('Could not save vendor.'); els.svendorSubmit.disabled = false; return; }
        // Simplest correct way to sync the group list on every save
        // (add or edit) is to just replace it outright, same idea as
        // Inventory's category lists — far less code than diffing.
        await db.from('shared_vendor_groups').delete().eq('shared_vendor_id', vendorId);
        const { error: groupsError } = await db.from('shared_vendor_groups').insert(
          groupKeys.map((group_key: string) => ({ shared_vendor_id: vendorId, group_key })),
        );
        els.svendorSubmit.disabled = false;
        if (groupsError) { console.error(groupsError); showToast('Saved, but could not save which groups.'); return; }
        resetSharedVendorForm();
        showToast('Saved.');
        await loadSharedVendorsAdmin();
      });
    }

    // ---------- People: approve leaders/admins, assign groups ---------------
    async function loadPeople() {
      const { data, error } = await db.from('profiles').select('*').order('created_at', { ascending: true });
      if (error) { console.error(error); showToast('Could not load people.'); return; }
      renderPeople(data || []);
    }
    function peopleGroupsCellHTML(groups: string[], isAdmin: boolean) {
      if (isAdmin) return '<p class="ws-admin-note">All groups (admin)</p>';
      return GROUPS.map((g) => `
        <label class="ws-group-check">
          <input type="checkbox" value="${g.key}" ${groups.includes(g.key) ? 'checked' : ''} />
          ${escapeHtml(g.en)}
        </label>
      `).join('');
    }
    function renderPeople(profiles: any) {
      els.peopleBody.innerHTML = profiles.map((p: any) => `
        <tr data-profile-id="${p.id}" class="${p.role === 'pending' ? 'ws-row--pending' : ''}">
          <td data-label="Name">${escapeHtml(p.name)}</td>
          <td data-label="Role">
            <select data-people-role>
              <option value="pending" ${p.role === 'pending' ? 'selected' : ''}>Pending</option>
              <option value="leader" ${p.role === 'leader' ? 'selected' : ''}>Leader</option>
              <option value="admin" ${p.role === 'admin' ? 'selected' : ''}>Admin</option>
            </select>
          </td>
          <td class="ws-admin-groups" data-label="Groups" data-groups="${p.groups.join(',')}">
            ${peopleGroupsCellHTML(p.groups, p.role === 'admin')}
          </td>
          <td class="ws-row-actions">
            <button type="button" class="btn-primary" data-people-save>Save</button>
            ${p.id !== state.session.user.id ? '<button type="button" class="ws-row-del" data-people-remove title="Remove access">×</button>' : ''}
          </td>
        </tr>
      `).join('');

      els.peopleBody.querySelectorAll('tr').forEach((row: any) => {
        const id = row.dataset.profileId;
        const name = row.querySelector('[data-label="Name"]').textContent;
        const groupsCell = row.querySelector('.ws-admin-groups');
        row.querySelector('[data-people-role]').addEventListener('change', (e: any) => {
          const savedGroups = (groupsCell.dataset.groups || '').split(',').filter(Boolean);
          groupsCell.innerHTML = peopleGroupsCellHTML(savedGroups, e.target.value === 'admin');
        });
        row.querySelector('[data-people-save]').addEventListener('click', async () => {
          const role = row.querySelector('[data-people-role]').value;
          const groups = role === 'admin'
            ? []
            : Array.from(row.querySelectorAll('.ws-group-check input:checked')).map((i: any) => i.value);
          const { error } = await db.from('profiles').update({ role, groups }).eq('id', id);
          if (error) { console.error(error); showToast('Could not save, ' + (error.message || 'unknown error') + '.'); return; }
          showToast('Saved.');
          if (id === state.session.user.id && role !== 'admin') {
            // Demoted themselves out of admin — this console isn't reachable
            // any more, so land back on the Leaders Workspace instead of a
            // page that will just show "Admin access only" on next load.
            window.location.replace('/leaders');
          }
        });
        row.querySelector('[data-people-remove]')?.addEventListener('click', async () => {
          if (!confirm(`Remove ${name}'s access? They'll be signed out of every group and land back on the "waiting for approval" screen, you can re-approve them any time from here. This doesn't delete their account.`)) return;
          const { error } = await db.from('profiles').update({ role: 'pending', groups: [] }).eq('id', id);
          if (error) { console.error(error); showToast('Could not remove access, ' + (error.message || 'unknown error') + '.'); return; }
          showToast(`${name}'s access removed.`);
          await loadPeople();
        });
      });
    }

    // ---------- Tabs -------------------------------------------------------
    function loadActiveTabData() {
      const tab = state.activeTab;
      if (tab === 'overview') loadOverview();
      if (tab === 'sharedcal') loadSharedCal();
      if (tab === 'finance') { loadFinanceKpis(); loadFinancePeriod(); compareReconcile(); loadReconcileHistory(); loadAdjustmentEntries(); }
      if (tab === 'curriculum') loadCurriculum();
      if (tab === 'music') loadMusicDashboard();
      if (tab === 'socialmedia') loadSocialMediaDashboard();
      if (tab === 'general') loadGeneralDashboard();
      if (tab === 'roster') loadRoster();
      if (tab === 'library') loadSharedDocs();
      if (tab === 'vendors') loadSharedVendorsAdmin();
      if (tab === 'people') loadPeople();
    }
    function setTab(tab: string) {
      state.activeTab = tab;
      els.tabs.querySelectorAll('.ws-tab').forEach((b: any) => b.classList.toggle('ws-tab--active', b.dataset.tab === tab));
      document.querySelectorAll('.ws-panel').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.panel !== tab));
      loadActiveTabData();
    }
    function bindTabs() {
      els.tabs.querySelectorAll('.ws-tab').forEach((btn: any) => {
        btn.addEventListener('click', () => setTab(btn.dataset.tab));
      });
    }
    // Generic sub-tabs (Finance's Balances/Ledger/Reconcile/Adjustments) —
    // scoped by a "group" name so unrelated sub-tab sets don't collide.
    function setSubtab(group: string, name: string) {
      document.querySelectorAll(`.ws-subtab[data-subtabs="${group}"]`).forEach((b: any) => b.classList.toggle('ws-subtab--active', b.dataset.subtab === name));
      document.querySelectorAll(`[data-subpanel^="${group}:"]`).forEach((p: any) => p.toggleAttribute('hidden', p.dataset.subpanel !== `${group}:${name}`));
    }
    function bindSubtabs() {
      document.querySelectorAll('.ws-subtab').forEach((btn: any) => {
        btn.addEventListener('click', () => setSubtab(btn.dataset.subtabs, btn.dataset.subtab));
      });
    }

    // ---------- Boot -------------------------------------------------------
    let boundOnce = false;
    async function init() {
      cacheEls();
      initRowNumbering();
      initCollapsibleRows();
      if (!supabaseConfigured) { showToast('Not connected to the database.'); return; }

      const session = await getSession();
      if (!session) { window.location.replace('/leaders'); return; }
      if (isSessionExpired()) { await signOut(); window.location.replace('/leaders?expired=1'); return; }
      state.session = session;
      setTimeout(async () => {
        await signOut();
        window.location.replace('/leaders?expired=1');
      }, msUntilSessionExpiry());

      const { data: profile } = await db.from('profiles').select('*').eq('id', session.user.id).maybeSingle();
      state.profile = profile;
      state.isAdmin = profile?.role === 'admin';

      els.shell.removeAttribute('hidden');

      if (!state.isAdmin) {
        els.denied.removeAttribute('hidden');
        els.signoutDenied.addEventListener('click', async () => { await signOut(); window.location.replace('/leaders'); });
        return;
      }

      els.main.removeAttribute('hidden');
      const initials = (profile.name || '?').trim().split(/\s+/).map((w: string) => w[0]).slice(0, 2).join('').toUpperCase();
      els.accountBtn.textContent = initials || '?';
      els.who.innerHTML = `<span class="ws-account-name">${escapeHtml(profile.name)}</span><span class="ws-account-role">admin</span>`;
      registerDeviceSession();

      if (!boundOnce) {
        boundOnce = true;
        bindOverlayScrollLock();
        bindDeviceKicks();
        els.accountBtn.addEventListener('click', () => {
          const opening = els.accountMenu.hidden;
          els.accountMenu.toggleAttribute('hidden');
          if (opening) renderDevices();
        });
        document.addEventListener('click', (e: any) => {
          if (els.accountMenu.hidden) return;
          if (e.target.closest('.ws-account')) return;
          els.accountMenu.setAttribute('hidden', '');
        });
        els.signout.addEventListener('click', async () => { await signOut(); window.location.replace('/leaders'); });
        els.signoutOthers.addEventListener('click', async () => {
          els.signoutOthers.disabled = true;
          els.signoutOthers.textContent = 'Signing out other devices…';
          await signOutOtherDevices();
          await renderDevices();
          els.signoutOthers.disabled = false;
          els.signoutOthers.textContent = 'Sign out of all other devices';
        });
        els.signoutEverywhere.addEventListener('click', async () => { await signOutEverywhere(); window.location.replace('/leaders'); });
        setInterval(async () => {
          if (!(await checkThisDeviceStillActive())) window.location.replace('/leaders?revoked=1');
        }, 45000);
        document.addEventListener('visibilitychange', async () => {
          if (document.visibilityState !== 'visible') return;
          if (!(await checkThisDeviceStillActive())) window.location.replace('/leaders?revoked=1');
        });
        bindEnglishOnlyInputs();

        bindTabs();
        bindSubtabs();
        bindOpeningBalanceForm();
        bindTransactionForm();
        bindReconcile();
        bindReports();
        bindLibraryUpload();
        bindSharedVendorForm();
        bindSharedCalForm();
        els.finMonth.addEventListener('change', loadFinancePeriod);
        els.finYear.addEventListener('change', loadFinancePeriod);
        els.rosterGroup.innerHTML = '<option value="">All Groups</option>' + GROUPS.map((g) => `<option value="${g.key}">${escapeHtml(g.en)}</option>`).join('');
        els.rosterGroup.addEventListener('change', renderRoster);
        els.rosterStatus.addEventListener('change', renderRoster);
        bindTableSearch(els.rosterSearch, els.rosterBody);
      }

      setTab('overview');
    }

    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
