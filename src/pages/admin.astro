        const { data } = await db.from('content_items').select('*, members(full_name)').eq('group_key', SOCIAL_MEDIA_GROUP_KEY)
          .gte('scheduled_date', start).lte('scheduled_date', end).order('scheduled_date', { ascending: true });
        const rows = data || [];
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Content Calendar Report', `${label}, ${rows.length} item${rows.length === 1 ? '' : 's'}`);
        pdfTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 8 },
          head: [['Date', 'Title', 'Platform', 'Type', 'Status', 'Assigned to']],
          body: rows.length ? rows.map((c: any) => [
            c.scheduled_date || '—', c.title, c.platform || '—', c.content_type || '—',
            smContentStatusLabel(c.status), c.members?.full_name || '—',
          ]) : [['No content this period', '', '', '', '', '']],
        });
        doc.save(pdfFilename('Content-Calendar', label));
      } catch (err) {
        console.error('content calendar report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    async function downloadSocialMediaFinanceReport(monthEl?: any, yearEl?: any) {
      try {
        const { start, end, label } = periodRange(monthEl || els.smReportMonth, yearEl || els.smReportYear);
        const { data } = await db.from('finance_entries').select('*').eq('group_key', SOCIAL_MEDIA_GROUP_KEY).gte('entry_date', start).lte('entry_date', end).order('entry_date', { ascending: true });
        const rows = data || [];
        const income = rows.filter((r: any) => r.entry_type === 'income').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const expense = rows.filter((r: any) => r.entry_type === 'expense').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Social Media Finance Report', `${label}, Income ${income.toFixed(2)}, Expenses ${expense.toFixed(2)}, Net ${(income - expense).toFixed(2)}`);
        pdfTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9 },
          head: [['Date', 'Type', 'Category', 'Description', 'Amount', 'Added by']],
          body: rows.length ? rows.map((r: any) => [r.entry_date, r.entry_type === 'income' ? 'Income' : 'Expense', r.category || '—', r.description || '—', Number(r.amount).toFixed(2), r.created_by_name || '—']) : [['No entries this period', '', '', '', '', '']],
        });
        doc.save(pdfFilename('Social-Media-Finance', label));
      } catch (err) {
        console.error('social media finance report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    async function downloadSocialMediaCredentialsReport() {
      try {
        const { data, error } = await db.from('credentials').select('*').eq('group_key', SOCIAL_MEDIA_GROUP_KEY).order('service_name', { ascending: true });
        if (error) throw error;
        const rows = data || [];
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Credentials', `${rows.length} login${rows.length === 1 ? '' : 's'}`);
        pdfTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9 },
          head: [['Service', 'Username', 'Password', 'URL', 'Notes', 'Added']],
          body: rows.length ? rows.map((c: any) => [c.service_name, c.username || '—', c.password || '—', c.url || '—', c.notes || '—', c.created_at ? new Date(c.created_at).toLocaleDateString() : '—']) : [['No credentials saved yet', '', '', '', '', '']],
        });
        doc.save(pdfFilename('Credentials', new Date().toISOString().slice(0, 10)));
      } catch (err) {
        console.error('credentials report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    // ---------- Roster: the 5 troops' full roster, with filters -------------
    async function loadRoster() {
      const { data, error } = await db.from('members').select('*').order('full_name', { ascending: true });
      if (error) { console.error(error); showToast('Could not load the roster.'); return; }
      state.ovMembers = data || [];
