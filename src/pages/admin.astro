    // ---------- Overview (the 5 troops) -------------------------------------
    async function loadOverview() {
      const now = new Date();
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthEnd = `${period}-${String(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const d30 = new Date(now); d30.setDate(d30.getDate() - 30);
      const d60 = new Date(now); d60.setDate(d60.getDate() - 60);
      const day30Str = `${d30.getFullYear()}-${String(d30.getMonth() + 1).padStart(2, '0')}-${String(d30.getDate()).padStart(2, '0')}`;
      const day60Str = `${d60.getFullYear()}-${String(d60.getMonth() + 1).padStart(2, '0')}-${String(d60.getDate()).padStart(2, '0')}`;

      const troopKeys = TROOP_GROUPS.map((g) => g.key);
      const [membersRes, attRes, feeRes, finRes, pendingRes] = await Promise.all([
        db.from('members').select('group_key, active, has_allergies').in('group_key', troopKeys),
        db.from('attendance').select('group_key, present, date').in('group_key', troopKeys).gte('date', day60Str),
        db.from('fee_payments').select('group_key, paid, amount').in('group_key', troopKeys).eq('period', period),
        db.from('finance_entries').select('group_key, entry_type, amount, entry_date').in('group_key', troopKeys).gte('entry_date', `${prevPeriod}-01`).lte('entry_date', monthEnd),
        db.from('join_requests').select('id', { count: 'exact', head: true }).eq('status', 'pending'),
      ]);

      const byGroup = new Map<string, any>();
      TROOP_GROUPS.forEach((g) => byGroup.set(g.key, {
        activeMembers: 0, archivedMembers: 0, allergyMembers: 0,
        attPresent30: 0, attTotal30: 0, attPresent3060: 0, attTotal3060: 0,
        feePaid: 0, feeCollected: 0, netThis: 0, netPrev: 0,
      }));
      (membersRes.data || []).forEach((m: any) => {
        const b = byGroup.get(m.group_key); if (!b) return;
        if (m.active) { b.activeMembers++; if (m.has_allergies) b.allergyMembers++; }
        else b.archivedMembers++;
      });
      (attRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.date >= day30Str) { b.attTotal30++; if (r.present) b.attPresent30++; }
        else { b.attTotal3060++; if (r.present) b.attPresent3060++; }
      });
      (feeRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.paid) { b.feePaid++; b.feeCollected += Number(r.amount || 0); }
      });
      (finRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        const amt = signedAmount(r);
        if (r.entry_date >= `${period}-01`) b.netThis += amt; else b.netPrev += amt;
      });
      renderOverview(byGroup, pendingRes.count || 0);
    }
    function renderOverview(byGroup: Map<string, any>, pendingApprovals: number) {
      const groups = TROOP_GROUPS.map((g) => ({ ...g, ...byGroup.get(g.key) }));
      const totalActive = groups.reduce((s, g) => s + g.activeMembers, 0);
      const totalArchived = groups.reduce((s, g) => s + g.archivedMembers, 0);
      const totalAllergy = groups.reduce((s, g) => s + g.allergyMembers, 0);
      const attPresent30 = groups.reduce((s, g) => s + g.attPresent30, 0);
      const attTotal30 = groups.reduce((s, g) => s + g.attTotal30, 0);
      const attPresent3060 = groups.reduce((s, g) => s + g.attPresent3060, 0);
      const attTotal3060 = groups.reduce((s, g) => s + g.attTotal3060, 0);
      const rate30 = attTotal30 ? Math.round((attPresent30 / attTotal30) * 100) : null;
      const ratePrev30 = attTotal3060 ? Math.round((attPresent3060 / attTotal3060) * 100) : null;
      const totalFeePaid = groups.reduce((s, g) => s + g.feePaid, 0);
      const totalCollected = groups.reduce((s, g) => s + g.feeCollected, 0);
      const feePct = totalActive ? Math.round((totalFeePaid / totalActive) * 100) : 0;
      const netThis = groups.reduce((s, g) => s + g.netThis, 0);
      const netPrev = groups.reduce((s, g) => s + g.netPrev, 0);
      const retentionPct = (totalActive + totalArchived) ? Math.round((totalActive / (totalActive + totalArchived)) * 100) : null;
      const allergyPct = totalActive ? Math.round((totalAllergy / totalActive) * 100) : 0;
      const groupsFullyPaid = groups.filter((g) => g.activeMembers > 0 && g.feePaid === g.activeMembers).length;
      const largestGroup = groups.reduce((max, g) => (g.activeMembers > max.activeMembers ? g : max), groups[0]);
      const largestSharePct = totalActive ? Math.round((largestGroup.activeMembers / totalActive) * 100) : 0;
      const avgPerGroup = (totalActive / TROOP_GROUPS.length).toFixed(1);
      const avgFeeAmount = totalFeePaid ? totalCollected / totalFeePaid : 0;

      els.ovRatios.innerHTML = `
        <div class="ws-stat"><span class="ws-stat-icon">#</span><span class="ws-stat-text"><span class="ws-stat-num">${avgPerGroup}</span><span class="ws-stat-label">Avg members / group</span></span></div>
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">▲</span><span class="ws-stat-text"><span class="ws-stat-num">${largestSharePct}%</span><span class="ws-stat-label">Largest group: ${escapeHtml(largestGroup.en)}</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">$</span><span class="ws-stat-text"><span class="ws-stat-num">${avgFeeAmount.toFixed(2)}</span><span class="ws-stat-label">Avg fee collected / member</span></span></div>
      `;

      els.ovKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Active members</span></div>
          <span class="ws-dash-kpi-num">${totalActive}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalArchived} archived · across ${TROOP_GROUPS.length} troops</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Attendance (30d)</span></div>
          <span class="ws-dash-kpi-num">${rate30 != null ? rate30 + '%' : '—'}</span>
          ${rate30 != null ? dashDeltaBadge(ratePrev30 != null ? rate30 - ratePrev30 : null, 'pt') : '<span class="ws-dash-delta ws-dash-delta--flat">No sessions yet</span>'}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">$</span><span class="ws-dash-kpi-label">Fees collected (mtd)</span></div>
          <span class="ws-dash-kpi-num">${feePct}%</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalFeePaid}/${totalActive} paid · ${totalCollected.toFixed(0)} in</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">±</span><span class="ws-dash-kpi-label">Net income (mtd)</span></div>
          <span class="ws-dash-kpi-num">${netThis >= 0 ? '+' : '−'}${Math.abs(netThis).toFixed(0)}</span>
          ${dashDeltaBadge(Math.round(netThis - netPrev))}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⟳</span><span class="ws-dash-kpi-label">Retention rate</span></div>
          <span class="ws-dash-kpi-num">${retentionPct != null ? retentionPct + '%' : '—'}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalActive} active of ${totalActive + totalArchived} ever registered</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⚑</span><span class="ws-dash-kpi-label">Allergy awareness</span></div>
          <span class="ws-dash-kpi-num">${allergyPct}%</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalAllergy} of ${totalActive} active members</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">!</span><span class="ws-dash-kpi-label">Pending approvals</span></div>
          <span class="ws-dash-kpi-num">${pendingApprovals}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${pendingApprovals ? 'waiting for review' : 'all caught up'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Groups fully paid</span></div>
          <span class="ws-dash-kpi-num">${groupsFullyPaid} / ${TROOP_GROUPS.length}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">100% collected this month</span>
        </div>
      `;

      const maxActive = Math.max(1, ...groups.map((g) => g.activeMembers));
      els.ovMembersChart.innerHTML = `
        <div class="ws-dash-bars">
          ${groups.map((g) => {
            const pct = Math.round((g.activeMembers / maxActive) * 100);
            const share = totalActive ? Math.round((g.activeMembers / totalActive) * 100) : 0;
            return `
              <div class="ws-dash-bar-col" title="${escapeHtml(g.en)}, ${g.activeMembers} active members (${share}% of troop)">
                <span class="ws-dash-bar-pct">${g.activeMembers}</span>
                <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style="height:${g.activeMembers ? Math.max(pct, 4) : 0}%"></div></div>
                <span class="ws-dash-bar-label">${escapeHtml(g.en)}</span>
              </div>`;
          }).join('')}
        </div>
      `;
      els.ovFeesChart.innerHTML = `
        <div class="ws-dash-bars">
          ${groups.map((g) => {
            const pct = g.activeMembers ? Math.round((g.feePaid / g.activeMembers) * 100) : 0;
            return `
              <div class="ws-dash-bar-col" title="${escapeHtml(g.en)}, ${pct}% collected (${g.feePaid}/${g.activeMembers})">
                <span class="ws-dash-bar-pct">${g.activeMembers ? pct + '%' : '—'}</span>
                <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style="height:${pct ? Math.max(pct, 4) : 0}%"></div></div>
                <span class="ws-dash-bar-label">${escapeHtml(g.en)}</span>
              </div>`;
          }).join('')}
        </div>
      `;

      els.ovBody.innerHTML = groups.map((g) => {
        const rate = g.attTotal30 ? Math.round((g.attPresent30 / g.attTotal30) * 100) : null;
        const share = totalActive ? Math.round((g.activeMembers / totalActive) * 100) : 0;
        const feeRate = g.activeMembers ? Math.round((g.feePaid / g.activeMembers) * 100) : 0;
        return `
          <tr>
            <td data-label="Group">${escapeHtml(g.en)}</td>
            <td data-label="Active">${g.activeMembers}</td>
            <td data-label="% of Troop">${share}%</td>
            <td data-label="Attendance (30d)">${rate != null ? rate + '%' : '—'}</td>
            <td data-label="Fees Collected">${feeRate}% · ${g.feeCollected.toFixed(0)}</td>
            <td data-label="Net Income">${g.netThis >= 0 ? '+' : '−'}${Math.abs(g.netThis).toFixed(0)}</td>
          </tr>`;
      }).join('');
    }

    // ---------- Finance: the accounting system (every group) ---------------
    async function ensureOrgSettings() {
      if (state.settings) return state.settings;
      const { data, error } = await db.from('org_finance_settings').select('*').eq('id', 'org').maybeSingle();
      if (error) { console.error(error); return null; }
      state.settings = data;
      return data;
    }
    async function loadFinanceKpis() {
      await ensureOrgSettings();
      const [entriesRes, lastRecRes] = await Promise.all([
        db.from('finance_entries').select('entry_type, amount, entry_date'),
        db.from('finance_reconciliations').select('*').order('as_of_date', { ascending: false }).limit(1).maybeSingle(),
      ]);
      if (entriesRes.error) { console.error(entriesRes.error); showToast('Could not load finance totals.'); return; }
      const rows = entriesRes.data || [];
      const opening = Number(state.settings?.opening_balance || 0);
      const running = opening + rows.reduce((s: number, r: any) => s + signedAmount(r), 0);
      const lastRec = lastRecRes.data;
      // The confirmed bank balance from the last reconciliation, carried
      // forward by everything logged since — grounded in a real bank
      // check, unlike Running Balance above (which never anchors to the
      // actual bank, just opening balance + every entry ever).
      const actualBalance = lastRec
        ? Number(lastRec.statement_balance) + rows.filter((r: any) => r.entry_date > lastRec.as_of_date).reduce((s: number, r: any) => s + signedAmount(r), 0)
        : running;

      const now = new Date();
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const thisMonthRows = rows.filter((r: any) => String(r.entry_date).startsWith(period));
      const incomeThis = thisMonthRows.filter((r: any) => r.entry_type === 'income').reduce((s: number, r: any) => s + Number(r.amount), 0);
      const expenseThis = thisMonthRows.filter((r: any) => r.entry_type === 'expense').reduce((s: number, r: any) => s + Number(r.amount), 0);
      const netThis = incomeThis - expenseThis;
      const netPrev = rows.filter((r: any) => String(r.entry_date).startsWith(prevPeriod)).reduce((s: number, r: any) => s + signedAmount(r), 0);

      els.finKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">${'\u{1F3E6}'}</span><span class="ws-dash-kpi-label">Running Balance</span></div>
          <span class="ws-dash-kpi-num">${fmt(running)}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">Opening ${fmt(opening)} · every group</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">↑</span><span class="ws-dash-kpi-label">Income (mtd)</span></div>
          <span class="ws-dash-kpi-num">${fmt(incomeThis)}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${MONTHS[now.getMonth()].en} ${now.getFullYear()}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">↓</span><span class="ws-dash-kpi-label">Expenses (mtd)</span></div>
          <span class="ws-dash-kpi-num">${fmt(expenseThis)}</span>
          ${dashDeltaBadge(Math.round(netThis - netPrev))}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Actual Running Balance</span></div>
          <span class="ws-dash-kpi-num">${fmt(actualBalance)}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${lastRec ? `Since ${lastRec.as_of_date}'s reconciliation` : 'Not reconciled yet, same as Running Balance'}</span>
        </div>
      `;
      els.openAmount.value = state.settings?.opening_balance ?? 0;
      els.openDate.value = state.settings?.opening_balance_date || todayStr();
    }
    function bindOpeningBalanceForm() {
      els.openSave.addEventListener('click', async () => {
        const opening_balance = Number(els.openAmount.value || 0);
        const opening_balance_date = els.openDate.value || todayStr();
        const { error } = await db.from('org_finance_settings').update({ opening_balance, opening_balance_date, updated_by: state.session.user.id }).eq('id', 'org');
        if (error) { showToast('Could not save, ' + (error.message || 'unknown error') + '.'); return; }
        state.settings.opening_balance = opening_balance;
        state.settings.opening_balance_date = opening_balance_date;
        showToast('Opening balance saved.');
        await loadFinanceKpis();
      });
    }

    // Same starter lists as loadGroupSettings() in the Leaders Workspace —
    // Music/General aren't scouting troops, so they need their own
    // categories rather than an empty dropdown the first time anyone (here,
    // possibly an admin before any leader has even opened that group's own
    // Finance tab) tries to log something against them.
    const GROUP_DEFAULT_CATEGORIES: Record<string, { expense: string[]; income: string[] }> = {
      [MUSIC_GROUP_KEY]: {
        expense: ['Band Payouts', 'Equipment', 'Transport', 'Repairs', 'Refreshments', 'Miscellaneous'],
        income: ['Wedding', 'Event', 'Donation', 'Miscellaneous'],
      },
      [GENERAL_GROUP_KEY]: {
        expense: ['Venue Maintenance', 'Furniture & Equipment', 'Utilities', 'Repairs', 'Supplies', 'Other'],
        income: ['Donations', 'Fundraising', 'Other'],
      },
    };
    async function updateTxCategoryOptions() {
      const groupKey = els.txGroup.value;
      const { data } = await db.from('group_settings').select('*').eq('group_key', groupKey).maybeSingle();
      const type = els.txType.value === 'income' ? 'income' : 'expense';
      const stored = data ? (type === 'income' ? data.income_categories : data.expense_categories) : null;
      const list = stored?.length ? stored : (GROUP_DEFAULT_CATEGORIES[groupKey]?.[type] || []);
      els.txCategory.innerHTML = list.length
        ? list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : `<option value="">No categories yet, add some in ${escapeHtml(GROUPS.find((g) => g.key === groupKey)?.en || groupKey)}'s Finance › Categories</option>`;
    }
    function bindTransactionForm() {
      els.txGroup.innerHTML = GROUPS.map((g) => `<option value="${g.key}">${escapeHtml(g.en)}</option>`).join('');
      updateTxCategoryOptions();
      els.txGroup.addEventListener('change', updateTxCategoryOptions);
      els.txType.addEventListener('change', updateTxCategoryOptions);
      els.txForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const payload = {
          group_key: els.txGroup.value,
          entry_type: els.txType.value,
          category: els.txCategory.value.trim() || null,
          amount: Number(els.txAmount.value),
          entry_date: els.txDate.value,
          description: els.txDescription.value.trim() || null,
        };
        if (!payload.group_key || !payload.category || !payload.amount || !payload.entry_date || !payload.description) {
          showToast('Everything is required.');
          return;
        }
        els.txSubmit.disabled = true;
        const { error } = await db.from('finance_entries').insert({
          ...payload, created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        });
        els.txSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not add, ' + (error.message || 'unknown error') + '.'); return; }
        showToast('Added.');
        els.txAmount.value = '';
        els.txDescription.value = '';
        await loadFinancePeriod();
        await loadFinanceKpis();
      });
    }

    async function loadFinancePeriod() {
      populatePeriodSelects(els.finMonth, els.finYear, true);
      const { start, end } = periodRange(els.finMonth, els.finYear);
      const { data, error } = await db.from('finance_entries').select('group_key, entry_type, category, amount, entry_date, description, created_by_name')
        .gte('entry_date', start).lte('entry_date', end).order('entry_date', { ascending: false });
      if (error) { console.error(error); showToast('Could not load finance.'); return; }
      renderFinancePeriod(data || []);
    }
    function renderFinancePeriod(rows: any[]) {
      const income = rows.filter((r) => r.entry_type === 'income').reduce((s, r) => s + Number(r.amount), 0);
      const expense = rows.filter((r) => r.entry_type === 'expense').reduce((s, r) => s + Number(r.amount), 0);
      els.finStats.innerHTML = `
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">↑</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(income)}</span><span class="ws-stat-label">Income</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">↓</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(expense)}</span><span class="ws-stat-label">Expenses</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">=</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(income - expense)}</span><span class="ws-stat-label">Net</span></span></div>
      `;
      const byGroup = new Map<string, { income: number; expense: number }>();
      GROUPS.forEach((g) => byGroup.set(g.key, { income: 0, expense: 0 }));
      rows.forEach((r) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.entry_type === 'income') b.income += Number(r.amount); else b.expense += Number(r.amount);
      });
      els.finGroupBody.innerHTML = GROUPS.map((g) => {
        const b = byGroup.get(g.key)!;
        return `<tr><td data-label="Group">${escapeHtml(g.en)}</td><td data-label="Income">${fmt(b.income)}</td><td data-label="Expenses">${fmt(b.expense)}</td><td data-label="Net">${fmt(b.income - b.expense)}</td></tr>`;
      }).join('');
      els.finBody.innerHTML = rows.length
        ? rows.map((r) => {
            const g = GROUPS.find((x) => x.key === r.group_key);
            return `
              <tr>
                <td data-label="Date">${r.entry_date}</td>
                <td data-label="Group">${escapeHtml(g ? g.en : r.group_key)}</td>
                <td data-label="Type">${r.entry_type === 'income' ? 'Income' : 'Expense'}</td>
                <td data-label="Category">${escapeHtml(r.category || '—')}</td>
                <td data-label="Description">${escapeHtml(r.description || '—')}</td>
                <td data-label="Amount">${fmt(r.amount)}</td>
                <td data-label="Added by">${escapeHtml(r.created_by_name || '—')}</td>
              </tr>`;
          }).join('')
        : '<tr><td colspan="7" class="ws-empty">No entries this period.</td></tr>';
    }

    // ---------- Reconcile: compare the system's balance to the real bank
    // balance as of a date, and — since not every entry is a bank
    // transaction (cash, in-hand group funds, etc.) — true up any gap with
    // a single adjustment entry rather than ticking off individual rows. --
    async function compareReconcile() {
      await ensureOrgSettings();
      if (!els.recAsof.value) els.recAsof.value = todayStr();
      const asOf = els.recAsof.value;
      const { data, error } = await db.from('finance_entries').select('entry_type, amount, entry_date').lte('entry_date', asOf);
      if (error) { console.error(error); showToast('Could not load finance totals.'); return; }
      const opening = Number(state.settings?.opening_balance || 0);
      const system = opening + (data || []).reduce((s: number, r: any) => s + signedAmount(r), 0);
      state.recSystemBalance = system;

      const bank = els.recBank.value === '' ? null : Number(els.recBank.value);
      const diff = bank == null ? null : bank - system;
      state.recDiff = diff;
      els.recStats.innerHTML = `
        <div class="ws-stat"><span class="ws-stat-icon">${'\u{1F3E6}'}</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(system)}</span><span class="ws-stat-label">System Balance (as of this date)</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">✓</span><span class="ws-stat-text"><span class="ws-stat-num">${bank == null ? '—' : fmt(bank)}</span><span class="ws-stat-label">Actual Bank Balance</span></span></div>
        <div class="ws-stat ${diff != null && Math.abs(diff) < 0.005 ? 'ws-stat--accent' : ''}"><span class="ws-stat-icon">${diff == null ? '?' : (Math.abs(diff) < 0.005 ? '✓' : '⚠')}</span><span class="ws-stat-text"><span class="ws-stat-num">${diff == null ? '—' : fmt(diff)}</span><span class="ws-stat-label">Difference</span></span></div>
      `;
      const matches = diff != null && Math.abs(diff) < 0.005;
      els.recAdjustBlock.toggleAttribute('hidden', diff == null || matches);
      els.recMatchBlock.toggleAttribute('hidden', !matches);
    }
    async function saveReconciliation(adjustmentEntryId: string | null, note: string | null) {
      const asOf = els.recAsof.value;
      const bank = Number(els.recBank.value);
      const { error } = await db.from('finance_reconciliations').insert({
        as_of_date: asOf, statement_balance: bank, system_balance: state.recSystemBalance,
        difference: state.recDiff, notes: note, adjustment_entry_id: adjustmentEntryId,
        created_by: state.session.user.id, created_by_name: state.profile?.name || null,
      });
      if (error) { showToast('Could not save, ' + (error.message || 'unknown error') + '.'); return false; }
      return true;
    }
    function renderReconcileHistory(rows: any[]) {
      if (!rows.length) { els.recHistoryBody.innerHTML = '<tr><td colspan="6" class="ws-empty">No reconciliations saved yet.</td></tr>'; return; }
      els.recHistoryBody.innerHTML = rows.map((r: any) => `
        <tr>
          <td data-label="As of">${r.as_of_date}</td>
          <td data-label="Bank Balance">${fmt(r.statement_balance)}</td>
          <td data-label="System Balance">${fmt(r.system_balance)}</td>
          <td data-label="Adjustment">${r.adjustment_entry_id ? fmt(r.difference) : '—'}</td>
          <td data-label="Saved">${new Date(r.created_at).toLocaleDateString()}</td>
          <td data-label="By">${escapeHtml(r.created_by_name || '—')}</td>
        </tr>
      `).join('');
    }
    async function loadReconcileHistory() {
      const { data, error } = await db.from('finance_reconciliations').select('*').order('as_of_date', { ascending: false }).limit(12);
      if (error) { console.error(error); return; }
      renderReconcileHistory(data || []);
    }
    async function loadAdjustmentEntries() {
      const { data, error } = await db.from('finance_entries').select('*').eq('is_adjustment', true).order('entry_date', { ascending: false });
      if (error) { console.error(error); return; }
      renderAdjustmentEntries(data || []);
    }
    function renderAdjustmentEntries(rows: any[]) {
      if (!rows.length) { els.adjBody.innerHTML = '<tr><td colspan="6" class="ws-empty">No adjustments posted yet.</td></tr>'; return; }
      els.adjBody.innerHTML = rows.map((r: any) => {
        const g = GROUPS.find((x) => x.key === r.group_key);
        return `
          <tr>
            <td data-label="Date">${r.entry_date}</td>
            <td data-label="Group">${escapeHtml(g ? g.en : r.group_key)}</td>
            <td data-label="Type">${r.entry_type === 'income' ? 'Income' : 'Expense'}</td>
            <td data-label="Amount">${fmt(r.amount)}</td>
            <td data-label="Note">${escapeHtml(r.description || '—')}</td>
            <td data-label="Posted by">${escapeHtml(r.created_by_name || '—')}</td>
          </tr>`;
      }).join('');
    }
    function bindReconcile() {
      els.recAdjustGroup.innerHTML = GROUPS.map((g) => `<option value="${g.key}">${escapeHtml(g.en)}</option>`).join('');
      els.recLoad.addEventListener('click', compareReconcile);
      els.recBank.addEventListener('input', compareReconcile);

      els.recSave.addEventListener('click', async () => {
        const diff = state.recDiff;
        if (diff == null) return;
        const note = els.recAdjustNote.value.trim() || null;
        if (!els.recAdjustGroup.value) { showToast('Pick which group this belongs to.'); return; }
        els.recSave.disabled = true;
        const { data: inserted, error } = await db.from('finance_entries').insert({
          group_key: els.recAdjustGroup.value,
          entry_type: diff >= 0 ? 'income' : 'expense',
          category: 'Reconciliation Adjustment',
          is_adjustment: true,
          amount: Math.abs(diff),
          entry_date: els.recAsof.value,
          description: note || `Reconciliation adjustment as of ${els.recAsof.value}`,
          created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        }).select().single();
        if (error) { showToast('Could not post the adjustment, ' + (error.message || 'unknown error') + '.'); els.recSave.disabled = false; return; }
        const ok = await saveReconciliation(inserted?.id || null, note);
        els.recSave.disabled = false;
        if (!ok) return;
        showToast(`Adjustment posted to ${GROUPS.find((g) => g.key === els.recAdjustGroup.value)?.en} and reconciliation saved.`);
        els.recAdjustNote.value = '';
        await compareReconcile();
        await loadFinanceKpis();
        await loadFinancePeriod();
        await loadReconcileHistory();
        await loadAdjustmentEntries();
      });

      els.recSaveMatch.addEventListener('click', async () => {
        els.recSaveMatch.disabled = true;
        const ok = await saveReconciliation(null, null);
        els.recSaveMatch.disabled = false;
        if (!ok) return;
        showToast('Saved, balances match.');
        await loadReconcileHistory();
      });
    }

    // ---------- Reports (Fees/Attendance stay troop-only) --------------------
    async function downloadFeesReport() {
      try {
        const { period, label, isYear } = periodRange(els.reportMonth, els.reportYear);
        const troopKeys = TROOP_GROUPS.map((g) => g.key);
        const membersRes = await db.from('members').select('id, full_name, group_key').eq('active', true).in('group_key', troopKeys);
        const members = membersRes.data || [];
        const doc = new jsPDF();
        if (!isYear) {
          const { data } = await db.from('fee_payments').select('member_id, paid, amount').eq('period', period);
          const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
          let paidCount = 0, collected = 0;
          const rows = members.map((m: any) => {
            const rec = map.get(m.id);
            const g = GROUPS.find((x) => x.key === m.group_key);
            if (rec && rec.paid) { paidCount++; collected += Number(rec.amount || 0); }
            return [m.full_name, g ? g.en : m.group_key, rec && rec.paid ? 'Paid' : 'Unpaid', rec && rec.amount != null ? Number(rec.amount).toFixed(2) : '—'];
          });
          const y = pdfHeader(doc, 'Monthly Fees', `${label}, ${paidCount} of ${members.length} paid, ${collected.toFixed(2)} collected`);
          autoTable(doc, {
            startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            head: [['Member', 'Group', 'Status', 'Amount']], body: rows.length ? rows : [['No data available', '', '', '']],
          });
          doc.save(pdfFilename('Monthly-Fees', label));
        } else {
          const year = els.reportYear.value;
          const { data } = await db.from('fee_payments').select('member_id, paid, amount').like('period', `${year}-%`);
          const byMember = new Map<string, { months: number; total: number }>();
          (data || []).forEach((r: any) => {
            if (!r.paid) return;
            const cur = byMember.get(r.member_id) || { months: 0, total: 0 };
            cur.months++; cur.total += Number(r.amount || 0);
            byMember.set(r.member_id, cur);
          });
          const rows = members.map((m: any) => {
            const g = GROUPS.find((x) => x.key === m.group_key);
            const s = byMember.get(m.id) || { months: 0, total: 0 };
            return [m.full_name, g ? g.en : m.group_key, `${s.months} / 12`, s.total.toFixed(2)];
          });
          const grandTotal = members.reduce((sum: number, m: any) => sum + (byMember.get(m.id)?.total || 0), 0);
          const y = pdfHeader(doc, 'Yearly Fees Summary', `${label}, ${grandTotal.toFixed(2)} collected total`);
          autoTable(doc, {
            startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            head: [['Member', 'Group', 'Months Paid', 'Total']], body: rows.length ? rows : [['No data available', '', '', '']],
          });
          doc.save(pdfFilename('Yearly-Fees', label));
        }
      } catch (err) {
        console.error('fees report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    async function downloadAttendanceReport() {
      try {
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const troopKeys = TROOP_GROUPS.map((g) => g.key);
        const [membersRes, attRes] = await Promise.all([
          db.from('members').select('id, full_name, group_key').eq('active', true).in('group_key', troopKeys),
          db.from('attendance').select('member_id, group_key, present, date').in('group_key', troopKeys).gte('date', start).lte('date', end),
        ]);
        const members = membersRes.data || [];
        const rows = attRes.data || [];
        const byGroupSessions = new Map<string, Set<string>>();
        TROOP_GROUPS.forEach((g) => byGroupSessions.set(g.key, new Set()));
        const presentByMember = new Map<string, number>();
        rows.forEach((r: any) => {
          const set = byGroupSessions.get(r.group_key);
          if (set) set.add(r.date);
          if (r.present) presentByMember.set(r.member_id, (presentByMember.get(r.member_id) || 0) + 1);
        });
        const totalSessions = Array.from(byGroupSessions.values()).reduce((s, set) => s + set.size, 0);
        const bodyRows = members.map((m: any) => {
          const g = GROUPS.find((x) => x.key === m.group_key);
          const sessions = byGroupSessions.get(m.group_key)?.size || 0;
          const present = presentByMember.get(m.id) || 0;
          const rate = sessions ? Math.round((present / sessions) * 100) : 0;
          return [m.full_name, g ? g.en : m.group_key, `${present} / ${sessions}`, `${rate}%`];
        });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Attendance', `${label}, ${totalSessions} meeting${totalSessions === 1 ? '' : 's'} held across the 5 troops`);
        autoTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          head: [['Member', 'Group', 'Present', 'Rate']], body: bodyRows.length ? bodyRows : [['No data available', '', '', '']],
        });
        doc.save(pdfFilename('Attendance', label));
      } catch (err) {
        console.error('attendance report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    // The one report that ties everything together: opening balance,
    // today's running balance, the latest reconciliation (bank vs. system,
    // and when it was last done), net income for the selected period, and
    // the full by-group breakdown — one document instead of piecing it
    // together from the Finance tab.
    async function downloadFullAccountingReport() {
      try {
        await ensureOrgSettings();
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const [allEntriesRes, periodEntriesRes, lastRecRes] = await Promise.all([
          db.from('finance_entries').select('entry_type, amount, entry_date'),
          db.from('finance_entries').select('group_key, entry_type, category, amount').gte('entry_date', start).lte('entry_date', end),
          db.from('finance_reconciliations').select('*').order('as_of_date', { ascending: false }).limit(1).maybeSingle(),
        ]);
        if (allEntriesRes.error) throw allEntriesRes.error;
        const allRows = allEntriesRes.data || [];
        const opening = Number(state.settings?.opening_balance || 0);
        const running = opening + allRows.reduce((s: number, r: any) => s + signedAmount(r), 0);
        const lastRec = lastRecRes.data;
        const actualBalance = lastRec
          ? Number(lastRec.statement_balance) + allRows.filter((r: any) => r.entry_date > lastRec.as_of_date).reduce((s: number, r: any) => s + signedAmount(r), 0)
          : running;

        const periodRows = periodEntriesRes.data || [];

        // A full Income Statement (categories, not just a group total) for
        // one set of rows — reused for every group's own page, and once
        // more for the whole organization combined.
        const renderIncomeStatement = (doc: any, title: string, rows: any[]) => {
          doc.setFont('helvetica', 'bold'); doc.setFontSize(15); doc.setTextColor(...PDF_BRAND);
          doc.text(title, 14, 20);
          doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 90, 90);
          doc.text(label, 14, 27);
          doc.setDrawColor(...PDF_BRAND); doc.setLineWidth(0.4);
          doc.line(14, 31, 196, 31);

          const byCategory = (type: string) => {
            const map = new Map<string, number>();
            rows.filter((r: any) => r.entry_type === type).forEach((r: any) => {
              const cat = r.category || 'Uncategorized';
              map.set(cat, (map.get(cat) || 0) + Number(r.amount));
            });
            return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
          };
          const incomeRows = byCategory('income'), expenseRows = byCategory('expense');
          const income = incomeRows.reduce((s, [, v]) => s + v, 0);
          const expense = expenseRows.reduce((s, [, v]) => s + v, 0);
          const tableOpts = {
            theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            footStyles: { fillColor: PDF_FOOT_BG, textColor: PDF_BRAND, fontStyle: 'bold' },
            columnStyles: { 1: { halign: 'right' } },
          };
          let sy = 38;
          autoTable(doc, {
            ...tableOpts, startY: sy, head: [['Income', '']],
            body: incomeRows.length ? incomeRows.map(([c, v]) => [c, fmt(v)]) : [['No data', '']],
            foot: [['Total Income', fmt(income)]],
          });
          sy = pdfNextY(doc, sy);
          autoTable(doc, {
            ...tableOpts, startY: sy, head: [['Expenses', '']],
            body: expenseRows.length ? expenseRows.map(([c, v]) => [c, fmt(v)]) : [['No data', '']],
            foot: [['Total Expenses', fmt(expense)]],
          });
          sy = pdfNextY(doc, sy);
          doc.setFont('helvetica', 'bold'); doc.setFontSize(13); doc.setTextColor(...PDF_ACCENT);
          doc.text(`Net Income: ${fmt(income - expense)}`, 14, sy);
        };

        const doc = new jsPDF();
        let y = pdfHeader(doc, 'Full Accounting Report', `${label} · generated ${new Date().toLocaleString()}`);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(90, 90, 90);
        const introLines = doc.splitTextToSize(
          `Summary below is where things stand right now, as of today, followed by a quick Net Income by Group table for ${label}. After that, a full Net Income Statement, one page per group, ending with one combined statement for the whole scout group.`,
          182,
        );
        doc.text(introLines, 14, y);
        y += introLines.length * 4.2 + 6;

        doc.setFont('helvetica', 'bold'); doc.setFontSize(12); doc.setTextColor(...PDF_BRAND);
        doc.text('Summary', 14, y);
        autoTable(doc, {
          startY: y + 4, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9, cellPadding: 2.5 },
          columnStyles: { 0: { fontStyle: 'bold', cellWidth: 44 }, 1: { cellWidth: 100 }, 2: { halign: 'right', fontStyle: 'bold', cellWidth: 38 } },
          head: [['', 'What this means', 'Amount']],
          body: [
            ['Opening Balance', `The starting balance before any recorded transaction, set as of ${state.settings?.opening_balance_date || '—'}.`, fmt(opening)],
            ['Running Balance', "Opening balance plus every transaction ever logged, across every group. The system's live total.", fmt(running)],
            ['Actual Running Balance', 'The last confirmed bank balance, carried forward by everything logged since. Grounded in a real bank check.', fmt(actualBalance)],
            ['Last Reconciled', 'The most recent date the books were checked against the real bank statement.', lastRec ? lastRec.as_of_date : 'Never reconciled'],
            ['Bank Balance', 'What the bank statement actually showed, as of the last reconciliation.', lastRec ? fmt(lastRec.statement_balance) : '—'],
            ['System Balance', 'What our own records showed on that same date, before any correction.', lastRec ? fmt(lastRec.system_balance) : '—'],
            ['Adjustment Posted', "The correcting entry made to true the two up, if the balances didn't already match.", lastRec && lastRec.adjustment_entry_id ? fmt(lastRec.difference) : (lastRec ? 'None needed, already matched' : '—')],
          ],
        });

        y = pdfNextY(doc, y);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(12); doc.setTextColor(...PDF_BRAND);
        doc.text(`Net Income by Group, ${label}`, 14, y);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); doc.setTextColor(120, 120, 120);
        doc.text('At a glance, the full statement for each one follows on its own page.', 14, y + 5);
        const periodIncome = periodRows.filter((r: any) => r.entry_type === 'income').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const periodExpense = periodRows.filter((r: any) => r.entry_type === 'expense').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const byGroup = new Map<string, { income: number; expense: number }>();
        GROUPS.forEach((g) => byGroup.set(g.key, { income: 0, expense: 0 }));
        periodRows.forEach((r: any) => {
          const b = byGroup.get(r.group_key); if (!b) return;
          if (r.entry_type === 'income') b.income += Number(r.amount); else b.expense += Number(r.amount);
        });
        autoTable(doc, {
          startY: y + 9, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          footStyles: { fillColor: PDF_FOOT_BG, textColor: PDF_BRAND, fontStyle: 'bold' },
          columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
          head: [['Group', 'Income', 'Expenses', 'Net']],
          body: GROUPS.map((g) => {
            const b = byGroup.get(g.key)!;
            return [g.en, fmt(b.income), fmt(b.expense), fmt(b.income - b.expense)];
          }),
          foot: [['All Groups Combined', fmt(periodIncome), fmt(periodExpense), fmt(periodIncome - periodExpense)]],
        });

        // One full Income Statement per group, each starting on its own
        // page, then one more combining every group for the whole
        // organization, also its own page.
        GROUPS.forEach((g) => {
          doc.addPage();
          renderIncomeStatement(doc, `Net Income Statement, ${g.en}`, periodRows.filter((r: any) => r.group_key === g.key));
        });
        doc.addPage();
        renderIncomeStatement(doc, 'Net Income Statement, Whole Scout Group', periodRows);

        doc.save(pdfFilename('Full-Accounting-Report', label));
      } catch (err) {
        console.error('full accounting report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    async function downloadCurriculumReport() {
      try {
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const troopKeys = TROOP_GROUPS.map((g) => g.key);
