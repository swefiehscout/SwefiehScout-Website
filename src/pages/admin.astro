  <script>
    import {
      supabase, supabaseConfigured, getSession, isSessionExpired, msUntilSessionExpiry, signOut, signOutEverywhere,
      registerDeviceSession, listMyDeviceSessions, currentDeviceSessionId, signOutDevice, signOutOtherDevices,
      checkThisDeviceStillActive, formatRelativeTime,
    } from '../lib/workspace/auth';
    import jsPDF from 'jspdf';
    import autoTable from 'jspdf-autotable';
    import { GROUPS, TROOP_GROUPS, MONTHS, WEEKDAYS, MUSIC_GROUP_KEY, GENERAL_GROUP_KEY, SOCIAL_MEDIA_GROUP_KEY } from '../lib/curriculum/constants';
    import { initRowNumbering, initCollapsibleRows } from '../lib/workspace/row-numbers';

    const db: any = supabase;

    const state: any = {
      session: null,
      profile: null,
      isAdmin: false,
      activeTab: 'overview',
      settings: null,
      ovMembers: [],
      recSystemBalance: 0,
      recDiff: null,
      editingSharedVendorId: null,
      sc: { view: 'month', anchor: new Date(), currentDay: null },
      scEvents: [], scMusicEvents: [], editingScId: null, editingScOccurrenceDate: null, scRequests: [],
    };
    const els: any = {};

    function el(sel: string): any { return document.querySelector(sel); }
    function escapeHtml(s: any) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]
      ));
    }
    // Renders the "Signed in on" device list inside the account menu, and
    // wires each row's Sign out button (delegation, since the rows get
    // rebuilt every time this runs). Called when the menu opens rather
    // than on a timer — it's a DB read, no reason to poll it.
    async function renderDevices() {
      const mine = currentDeviceSessionId();
      const sessions = await listMyDeviceSessions();
      if (!sessions.length) {
        els.devices.innerHTML = '<p class="ws-devices-empty">This device only.</p>';
        return;
      }
      els.devices.innerHTML = sessions.map((d: any) => `
        <div class="ws-device-row" data-device-id="${d.id}">
          <div class="ws-device-info">
            <div class="ws-device-label">${escapeHtml(d.device_label)}</div>
            <div class="ws-device-meta">${formatRelativeTime(d.last_seen_at)}</div>
            ${d.id === mine ? '<span class="ws-device-badge">This device</span>' : ''}
          </div>
          <button type="button" class="ws-device-kick" data-kick-device="${d.id}">Sign out</button>
        </div>
      `).join('');
    }
    function bindDeviceKicks() {
      els.devices.addEventListener('click', async (e: any) => {
        const btn = e.target.closest('[data-kick-device]');
        if (!btn) return;
        const id = btn.dataset.kickDevice;
        const wasThisDevice = id === currentDeviceSessionId();
        btn.disabled = true;
        btn.textContent = '…';
        await signOutDevice(id);
        if (wasThisDevice) { window.location.replace('/leaders'); return; }
        await renderDevices();
      });
    }

    let toastTimer: any;
    function showToast(msg: any) {
      let t = document.querySelector('.curr-toast');
      if (!t) { t = document.createElement('div'); t.className = 'curr-toast'; document.body.appendChild(t); }
      t.textContent = msg;
      t.classList.add('curr-toast--show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.remove('curr-toast--show'), 3500);
    }
    function todayStr() {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }
    function parseDateStr(s: string) {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function toDateStr(d: Date) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function addDays(d: Date, n: number) {
      const c = new Date(d);
      c.setDate(c.getDate() + n);
      return c;
    }
    function startOfWeek(d: Date) {
      const c = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      c.setDate(c.getDate() - c.getDay());
      return c;
    }
    function bindTableSearch(input: any, tbody: any) {
      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        tbody.querySelectorAll('tr').forEach((row: any) => {
          row.hidden = !!term && !row.textContent.toLowerCase().includes(term);
        });
      });
    }
    // Every popup here (Shared Calendar's day view/Custom recurrence/
    // Delete choice) is built from the same .curr-day-overlay shell,
    // opened and closed by toggling its `hidden` attribute — so a
    // single MutationObserver watching all of them covers every popup
    // without each one's own open/close code needing to know about
    // scroll locking. Without this the background page scrolls freely
    // behind an open popup and the footer ends up visible mid-scroll.
    function bindOverlayScrollLock() {
      const overlays = Array.from(document.querySelectorAll('.curr-day-overlay'));
      const update = () => {
        document.body.classList.toggle('ws-scroll-locked', overlays.some((el: any) => !el.hasAttribute('hidden')));
      };
      const observer = new MutationObserver(update);
      overlays.forEach((el) => observer.observe(el, { attributes: true, attributeFilter: ['hidden'] }));
      update();
    }
    function dashDeltaBadge(val: number | null, suffix = ''): string {
      if (val == null || Number.isNaN(val) || val === 0) {
        return `<span class="ws-dash-delta ws-dash-delta--flat">– steady</span>`;
      }
      const up = val > 0;
      return `<span class="ws-dash-delta ${up ? 'ws-dash-delta--up' : 'ws-dash-delta--down'}">${up ? '↑' : '↓'} ${Math.abs(val)}${suffix} vs last period</span>`;
    }
    function populatePeriodSelects(monthSel: any, yearSel: any, withYearOption = false) {
      if (monthSel.options.length) return;
      let opts = MONTHS.map((m, i) => `<option value="${String(i + 1).padStart(2, '0')}">${m.en}</option>`).join('');
      if (withYearOption) opts = `<option value="ALL">Whole Year</option>` + opts;
      monthSel.innerHTML = opts;
      const nowYear = new Date().getFullYear();
      const years: number[] = [];
      for (let y = nowYear - 3; y <= nowYear + 1; y++) years.push(y);
      yearSel.innerHTML = years.map((y) => `<option value="${y}">${y}</option>`).join('');
      const now = new Date();
      monthSel.value = String(now.getMonth() + 1).padStart(2, '0');
      yearSel.value = String(now.getFullYear());
    }
    // 'RANGE' is only ever a value on the main Reports tab's own month
    // select (els.reportMonth) — a custom month-to-month span, read
    // straight from its 4 From/To selects rather than monthSel/yearSel.
    function periodRange(monthSel: any, yearSel: any) {
      if (monthSel.value === 'RANGE') {
        const fromYear = Number(els.reportFromYear.value), fromMonth = els.reportFromMonth.value;
        const toYear = Number(els.reportToYear.value), toMonth = els.reportToMonth.value;
        const lastDay = new Date(toYear, Number(toMonth), 0).getDate();
        const fromLabel = `${els.reportFromMonth.selectedOptions[0]?.textContent} ${fromYear}`;
        const toLabel = `${els.reportToMonth.selectedOptions[0]?.textContent} ${toYear}`;
        return {
          start: `${fromYear}-${fromMonth}-01`,
          end: `${toYear}-${toMonth}-${String(lastDay).padStart(2, '0')}`,
          label: fromLabel === toLabel ? fromLabel : `${fromLabel} – ${toLabel}`,
          period: `${fromYear}-${fromMonth}_${toYear}-${toMonth}`,
          isYear: false,
          isRange: true,
          periodFrom: `${fromYear}-${fromMonth}`,
          periodTo: `${toYear}-${toMonth}`,
        };
      }
      const year = Number(yearSel.value);
      if (monthSel.value === 'ALL') {
        return { start: `${year}-01-01`, end: `${year}-12-31`, label: String(year), period: String(year), isYear: true };
      }
      const month = monthSel.value;
      const period = `${year}-${month}`;
      const lastDay = new Date(year, Number(month), 0).getDate();
      const label = `${monthSel.selectedOptions[0]?.textContent} ${year}`;
      return { start: `${period}-01`, end: `${period}-${String(lastDay).padStart(2, '0')}`, label, period, isYear: false };
    }
    function signedAmount(e: any) { return e.entry_type === 'income' ? Number(e.amount) : -Number(e.amount); }
    function fmt(n: number) { return Number(n || 0).toFixed(2); }

    // ---------- PDF helpers (simplified — always "All Groups", no active
    // group concept here like the per-group Reports tab has) -------------
    const PDF_BRAND: [number, number, number] = [87, 22, 7];
    const PDF_ACCENT: [number, number, number] = [20, 56, 34];
    const PDF_FOOT_BG: [number, number, number] = [250, 243, 232];
    function pdfHeader(doc: any, title: string, rangeLabel: string): number {
      doc.setFont('helvetica', 'bold');
