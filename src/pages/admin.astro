    // ---------- Shared Calendar (org-wide — the exact same rows every
    // group's own Shared Calendar tab shows). Music's own Event Calendar
    // bookings are pulled in read-only via shared_calendar_music_events(),
    // a SECURITY DEFINER function (see shared_calendar_schema.sql). An
    // admin can manage any entry here regardless of who created it, so
    // scCanManage() is really just documentation of that in this file —
    // it always evaluates true on this page. -----------------------------
    function scCanManage(item: any) {
      return item.created_by === state.session.user.id || state.profile?.role === 'admin';
    }
    // Recurrence is never materialized as rows — one event row is the
    // whole series, and occurrences are computed on the fly for
    // whatever range is currently on screen. 'never'/'on_date' end
    // conditions are answered analytically (O(1)); 'after_count' is the
    // one case that needs an actual occurrence count, so it walks
    // day-by-day from the series' own start (not from today, and only
    // for that one end-type) — see scOccurrenceCountUpTo.
    function scDateMatchesRecurrence(event: any, dateStr: string): boolean {
      if (!event.recurrence_unit) return dateStr === event.event_date;
      if (event.recurrence_exceptions && event.recurrence_exceptions.includes(dateStr)) return false;
      const startDate = parseDateStr(event.event_date);
      const d = parseDateStr(dateStr);
      if (d < startDate) return false;
      if (event.recurrence_end_type === 'on_date' && event.recurrence_end_date && dateStr > event.recurrence_end_date) return false;
      const interval = Math.max(1, event.recurrence_interval || 1);
      const days = (event.recurrence_days && event.recurrence_days.length) ? event.recurrence_days : [startDate.getDay()];
      let periodIndex: number, matchesShape: boolean;
      if (event.recurrence_unit === 'day') {
        periodIndex = Math.round((d.getTime() - startDate.getTime()) / 86400000);
        matchesShape = true;
      } else if (event.recurrence_unit === 'week') {
        periodIndex = Math.floor((startOfWeek(d).getTime() - startOfWeek(startDate).getTime()) / (7 * 86400000));
        matchesShape = days.includes(d.getDay());
      } else if (event.recurrence_unit === 'month') {
        periodIndex = (d.getFullYear() - startDate.getFullYear()) * 12 + (d.getMonth() - startDate.getMonth());
        matchesShape = d.getDate() === startDate.getDate();
      } else {
        periodIndex = d.getFullYear() - startDate.getFullYear();
        matchesShape = d.getMonth() === startDate.getMonth() && d.getDate() === startDate.getDate();
      }
      if (!matchesShape || periodIndex < 0 || periodIndex % interval !== 0) return false;
      if (event.recurrence_end_type === 'after_count' && event.recurrence_end_count) {
        if (scOccurrenceCountUpTo(event, d) > event.recurrence_end_count) return false;
      }
      return true;
    }
    function scOccurrenceCountUpTo(event: any, d: Date): number {
      const startDate = parseDateStr(event.event_date);
      const interval = Math.max(1, event.recurrence_interval || 1);
      const days = (event.recurrence_days && event.recurrence_days.length) ? event.recurrence_days : [startDate.getDay()];
      let cursor = new Date(startDate);
      let count = 0, guard = 0;
      while (cursor <= d && guard < 5000) {
        guard++;
        let occurs = false;
        if (event.recurrence_unit === 'day') {
          occurs = Math.round((cursor.getTime() - startDate.getTime()) / 86400000) % interval === 0;
        } else if (event.recurrence_unit === 'week') {
          const weeksSince = Math.floor((startOfWeek(cursor).getTime() - startOfWeek(startDate).getTime()) / (7 * 86400000));
          occurs = weeksSince % interval === 0 && days.includes(cursor.getDay());
        } else if (event.recurrence_unit === 'month') {
          const monthsSince = (cursor.getFullYear() - startDate.getFullYear()) * 12 + (cursor.getMonth() - startDate.getMonth());
          occurs = monthsSince % interval === 0 && cursor.getDate() === startDate.getDate();
        } else {
          const yearsSince = cursor.getFullYear() - startDate.getFullYear();
          occurs = yearsSince % interval === 0 && cursor.getMonth() === startDate.getMonth() && cursor.getDate() === startDate.getDate();
        }
        if (occurs) count++;
        cursor = addDays(cursor, 1);
      }
      return count;
    }
    function scOccurrenceDatesInRange(event: any, rangeStart: Date, rangeEnd: Date): string[] {
      const results: string[] = [];
      let d = new Date(rangeStart);
      while (d <= rangeEnd) {
        const dateStr = toDateStr(d);
        if (scDateMatchesRecurrence(event, dateStr)) results.push(dateStr);
        d = addDays(d, 1);
      }
      return results;
    }
    // One pass over every event for the whole visible range, instead of
    // re-checking every event for every single day — the difference
    // between O(events) and O(events × days) once Year view (365+ days
    // × every month card) is in the mix.
    function scBuildOccurrenceIndex(rangeStart: Date, rangeEnd: Date): Map<string, any[]> {
      const map = new Map<string, any[]>();
      const add = (dateStr: string, item: any) => {
        if (!map.has(dateStr)) map.set(dateStr, []);
        map.get(dateStr)!.push(item);
      };
      state.scEvents.forEach((e: any) => {
        scOccurrenceDatesInRange(e, rangeStart, rangeEnd).forEach((dateStr) => add(dateStr, { ...e, kind: 'own', occurrence_date: dateStr }));
      });
      const rangeStartStr = toDateStr(rangeStart), rangeEndStr = toDateStr(rangeEnd);
      state.scMusicEvents.forEach((e: any) => {
        if (e.event_date >= rangeStartStr && e.event_date <= rangeEndStr) {
          add(e.event_date, { ...e, kind: 'music', title: e.event_type ? `${e.event_type} — ${e.client_name}` : e.client_name });
        }
      });
      map.forEach((items) => items.sort((a, b) => (a.event_time || '99:99').localeCompare(b.event_time || '99:99')));
      return map;
    }
    function scItemsForDate(dateStr: string): any[] {
      const d = parseDateStr(dateStr);
      return scBuildOccurrenceIndex(d, d).get(dateStr) || [];
    }
    async function loadSharedCal() {
      // Render the grid regardless of how the fetch goes — otherwise a
      // failed/slow load leaves the tab looking entirely blank until
      // something else (like clicking Today) happens to call
      // scRenderView() on its own.
      try {
        const [ownRes, musicRes] = await Promise.all([
          db.from('shared_calendar_events').select('*').order('event_date', { ascending: true }),
          db.rpc('shared_calendar_music_events'),
        ]);
        if (ownRes.error) { console.error(ownRes.error); showToast('Could not load the Shared Calendar.'); }
        else state.scEvents = ownRes.data || [];
        if (musicRes.error) console.error(musicRes.error);
        else state.scMusicEvents = musicRes.data || [];
        await loadScRequests();
      } catch (err) {
        console.error('shared calendar load failed', err);
        showToast('Could not load the Shared Calendar.');
      }
      scRenderView();
    }
    async function loadScRequests() {
      const { data, error } = await db.from('shared_calendar_change_requests')
        .select('*, shared_calendar_events(title, event_date)').order('created_at', { ascending: false });
      if (error) { console.error(error); return; }
      state.scRequests = data || [];
      renderScRequests();
    }
    function renderScRequests() {
      const openCount = state.scRequests.filter((r: any) => r.status === 'open').length;
      els.scRequestsBadge.textContent = String(openCount);
      els.scRequestsBadge.toggleAttribute('hidden', !openCount);
      els.scRequestsBody.innerHTML = state.scRequests.length ? state.scRequests.map((r: any) => `
        <tr data-sc-request-id="${r.id}">
          <td data-label="Entry">${escapeHtml(r.shared_calendar_events?.title || '(deleted)')}</td>
          <td data-label="Date">${r.shared_calendar_events?.event_date || '—'}</td>
          <td data-label="Message">${escapeHtml(r.message)}</td>
          <td data-label="Requested by">${escapeHtml(r.requested_by_name || '—')}</td>
          <td data-label="Status">${r.status === 'open' ? '<span class="ws-badge ws-badge--fair">Open</span>' : '<span class="ws-badge ws-badge--good">Resolved</span>'}</td>
          <td class="ws-row-actions">${r.status === 'open' ? '<button type="button" class="ws-edit-btn" data-sc-resolve>Mark resolved</button>' : ''}</td>
        </tr>
      `).join('') : '<tr><td colspan="7" class="ws-empty">No change requests.</td></tr>';
      els.scRequestsBody.querySelectorAll('[data-sc-resolve]').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.closest('tr').dataset.scRequestId;
          const { error } = await db.from('shared_calendar_change_requests')
            .update({ status: 'resolved', resolved_at: new Date().toISOString(), resolved_by_name: state.profile?.name || null })
            .eq('id', id);
          if (error) { console.error(error); showToast('Could not resolve the request.'); return; }
          await loadScRequests();
        });
      });
    }
    async function scRequestChange(eventId: string) {
      const message = prompt('What should change about this entry?');
      if (!message || !message.trim()) return;
      const { error } = await db.from('shared_calendar_change_requests').insert({
        event_id: eventId, message: message.trim(),
        requested_by: state.session.user.id, requested_by_name: state.profile?.name || null,
      });
      if (error) { console.error(error); showToast('Could not send the request.'); return; }
      showToast('Request sent.');
      await loadScRequests();
    }
    function scNavLabelFor(): string {
      const a = state.sc.anchor;
      if (state.sc.view === 'day') {
        const d = new Date(a);
        return `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      }
      if (state.sc.view === 'week') {
        const start = startOfWeek(a);
        const end = addDays(start, 6);
        return start.getMonth() === end.getMonth()
          ? `${MONTHS[start.getMonth()].en} ${start.getDate()}–${end.getDate()}, ${end.getFullYear()}`
          : `${MONTHS[start.getMonth()].en} ${start.getDate()} – ${MONTHS[end.getMonth()].en} ${end.getDate()}, ${end.getFullYear()}`;
      }
      if (state.sc.view === 'year') return String(a.getFullYear());
      return `${MONTHS[a.getMonth()].en} ${a.getFullYear()}`;
    }
    function scRenderView() {
      els.scNavLabel.textContent = scNavLabelFor();
      document.querySelectorAll('[data-sc-view-pane]').forEach((p: any) => p.toggleAttribute('hidden', p.dataset.scViewPane !== state.sc.view));
      document.querySelectorAll('[data-sc-view]').forEach((btn: any) => btn.classList.toggle('curr-view-btn--active', btn.dataset.scView === state.sc.view));
      if (state.sc.view === 'day') scRenderDay();
      else if (state.sc.view === 'week') scRenderWeek();
      else if (state.sc.view === 'year') scRenderYear();
      else scRenderMonth();
    }
    // "17:00" -> "5 PM", "17:30" -> "5:30 PM"
    function scFormatTime12(t: string): { label: string; period: string } {
      const [h, m] = t.split(':').map(Number);
      const period = h < 12 ? 'AM' : 'PM';
      const h12 = h % 12 === 0 ? 12 : h % 12;
      return { label: m ? `${h12}:${String(m).padStart(2, '0')}` : String(h12), period };
    }
    function scTimeRangeLabel(item: any): string {
      if (!item.event_time) return 'All day';
      const start = scFormatTime12(item.event_time);
      if (!item.event_end_time) return `${start.label} ${start.period}`;
      const end = scFormatTime12(item.event_end_time);
      return start.period === end.period ? `${start.label}–${end.label} ${end.period}` : `${start.label} ${start.period} – ${end.label} ${end.period}`;
    }
    function scDayItemRowHTML(item: any) {
      if (item.kind === 'music') {
        return `
          <div class="ws-evt-day-item ws-evt-day-item--readonly">
            <div class="ws-evt-day-item-main">
              <span class="ws-evt-day-item-title">${escapeHtml(item.title)}</span>
              <span class="ws-evt-day-item-sub">${scTimeRangeLabel(item)} · Music Event Calendar</span>
            </div>
            <span class="ws-badge ws-badge--fair">View only</span>
          </div>`;
      }
      const canManage = scCanManage(item);
      return `
        <div class="ws-evt-day-item" data-sc-event-id="${item.id}" data-sc-occurrence-date="${item.occurrence_date || item.event_date}">
          <div class="ws-evt-day-item-main">
            <span class="ws-evt-day-item-title">${escapeHtml(item.title)}${item.recurrence_unit ? ' <span class="ws-sc-repeat-mark" title="Repeats">↻</span>' : ''}</span>
            <span class="ws-evt-day-item-sub">${scTimeRangeLabel(item)}${item.notes ? ' · ' + escapeHtml(item.notes) : ''} · Added by ${escapeHtml(item.created_by_name || '—')}</span>
          </div>
          <div class="ws-evt-day-item-actions">
            ${canManage
              ? '<button type="button" class="ws-edit-btn" data-sc-day-edit>Edit</button><button type="button" class="ws-row-del" data-sc-day-delete title="Delete">×</button>'
              : '<button type="button" class="ws-edit-btn" data-sc-day-request>Request a change</button>'}
          </div>
        </div>`;
    }
    function bindScDayItemActions(container: any) {
      container.querySelectorAll('[data-sc-day-edit]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('[data-sc-event-id]');
          scStartEdit(row.dataset.scEventId, row.dataset.scOccurrenceDate);
        });
      });
      container.querySelectorAll('[data-sc-day-delete]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('[data-sc-event-id]');
          scDeleteFlow(row.dataset.scEventId, row.dataset.scOccurrenceDate);
        });
      });
      container.querySelectorAll('[data-sc-day-request]').forEach((btn: any) => {
        btn.addEventListener('click', () => scRequestChange(btn.closest('[data-sc-event-id]').dataset.scEventId));
      });
    }
    function scHourLabel(h: number): string {
      if (h === 0) return '12 AM';
      if (h === 12) return '12 PM';
      return h < 12 ? `${h} AM` : `${h - 12} PM`;
    }
    const SC_ROW_H = 3; // rem per hour — kept in sync with --sc-row-h below
    function scTimeToHours(t: string): number {
      const [h, m] = t.split(':').map(Number);
      return h + m / 60;
    }
    // Shared by Day (1 day) and Week (7 days) — a 24-hour grid, always
    // fully drawn even with nothing on it (an empty day should still
    // look like a calendar, not a blank box). Timed events are
    // absolutely positioned by their actual start/end time (a 2-hour
    // block visibly spans 2 hours), not just dropped into whichever
    // hour they start in.
    function scRenderTimelineGrid(container: any, days: Date[]) {
      const dateStrs = days.map(toDateStr);
      const idx = scBuildOccurrenceIndex(days[0], days[days.length - 1]);
      const today = todayStr();
      const multiDay = days.length > 1;
      container.style.setProperty('--sc-days', String(days.length));
      container.style.setProperty('--sc-row-h', `${SC_ROW_H}rem`);

      let html = '';
      if (multiDay) {
        html += '<div class="ws-sc-tl-head-row"><div class="ws-sc-tl-head-spacer"></div>';
        days.forEach((d, i) => {
          html += `<div class="ws-sc-tl-head-day${dateStrs[i] === today ? ' ws-sc-tl-head-day--today' : ''}">
            <span class="ws-sc-tl-head-name">${WEEKDAYS[d.getDay()].en.slice(0, 3)}</span>
            <span class="ws-sc-tl-head-num">${d.getDate()}</span>
          </div>`;
        });
        html += '</div>';
      }
      const anyAllDay = dateStrs.some((ds) => (idx.get(ds) || []).some((it: any) => !it.event_time));
      if (anyAllDay) {
        html += '<div class="ws-sc-tl-allday-row"><div class="ws-sc-tl-head-spacer"></div>';
        dateStrs.forEach((ds) => {
          const items = (idx.get(ds) || []).filter((it: any) => !it.event_time);
          html += `<div class="ws-sc-tl-allday-cell" data-date="${ds}">${items.map((it: any) => scTimelineChipHTML(it, false)).join('')}</div>`;
        });
        html += '</div>';
      }
      html += '<div class="ws-sc-tl-hourgrid"><div class="ws-sc-tl-hourlabelcol">';
      for (let h = 0; h < 24; h++) {
        html += `<div class="ws-sc-tl-hourlabel" style="top:${h * SC_ROW_H}rem">${scHourLabel(h)}</div>`;
      }
      html += '</div>';
      const nowInView = dateStrs.includes(today);
      const nowTop = (new Date().getHours() + new Date().getMinutes() / 60) * SC_ROW_H;
      dateStrs.forEach((ds) => {
        const items = (idx.get(ds) || []).filter((it: any) => it.event_time);
        const nowLine = nowInView && ds === today ? `<div class="ws-sc-tl-now-line" style="top:${nowTop}rem"></div>` : '';
        html += `<div class="ws-sc-tl-daycol" data-date="${ds}">${items.map((it: any) => scTimelineChipHTML(it, true)).join('')}${nowLine}</div>`;
      });
      html += '</div>';
      container.innerHTML = html;
      // Center on now (or a reasonable default when today isn't in
      // view) so opening the timeline never starts scrolled to
      // midnight — every hour is still one scroll away either way.
      // The day-header row is sticky and covers the top of the
      // viewport, so the centering has to leave room for it — otherwise
      // a dead-center target can land right behind the header instead
      // of visibly below it. Using getBoundingClientRect() rather than
      // offsetTop here on purpose: .ws-sc-tl-wrap has no `position` set,
      // so it isn't hourGridEl's offsetParent — offsetTop would measure
      // from whatever positioned ancestor is further up the page, not
      // from the scroll container itself.
      const hourGridEl = container.querySelector('.ws-sc-tl-hourgrid');
      if (hourGridEl) {
        const remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const targetTopRem = nowInView ? nowTop : 8 * SC_ROW_H;
        const headerEl = container.querySelector('.ws-sc-tl-head-row');
        const headerH = headerEl ? headerEl.getBoundingClientRect().height : 0;
        const gridOffsetInContainer = hourGridEl.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop;
        const contentY = gridOffsetInContainer + targetTopRem * remPx;
        container.scrollTop = Math.max(0, contentY - container.clientHeight / 2 - headerH / 2);
      }
      container.querySelectorAll('[data-date]').forEach((cell: any) => {
        cell.addEventListener('click', (e: Event) => {
          if ((e.target as any).closest('[data-sc-chip-id]')) return; // handled below
          scOpenDay(cell.dataset.date);
        });
      });
      container.querySelectorAll('[data-sc-chip-id]').forEach((chip: any) => {
        chip.addEventListener('click', (e: Event) => {
          e.stopPropagation();
          scOpenDay(chip.closest('[data-date]').dataset.date);
        });
      });
    }
    // positioned=true places the chip absolutely by start/end time
    // (the hour grid); false is the plain flow layout used for the
    // all-day strip, which has no time axis to position against.
    function scTimelineChipHTML(item: any, positioned: boolean): string {
      const label = item.event_time ? `${scTimeRangeLabel(item)} ${item.title}` : item.title;
      const cls = `ws-sc-tl-event${item.kind === 'music' ? ' ws-sc-tl-event--music' : ''}`;
      if (!positioned || !item.event_time) {
        return `<div class="${cls}" style="position:static" data-sc-chip-id="${item.id}" title="${escapeHtml(label)}">${escapeHtml(label)}</div>`;
      }
      const startH = scTimeToHours(item.event_time);
      const endH = item.event_end_time ? Math.max(startH + 0.25, scTimeToHours(item.event_end_time)) : startH + 0.75;
      const top = startH * SC_ROW_H;
      const height = (endH - startH) * SC_ROW_H;
      return `<div class="${cls}" style="top:${top}rem;height:${height}rem" data-sc-chip-id="${item.id}" title="${escapeHtml(label)}">${escapeHtml(label)}</div>`;
    }
    function scRenderDay() {
      scRenderTimelineGrid(els.scDayAgenda, [state.sc.anchor]);
    }
    function scRenderWeek() {
      const start = startOfWeek(state.sc.anchor);
      scRenderTimelineGrid(els.scWeekGrid, Array.from({ length: 7 }, (_, i) => addDays(start, i)));
    }
    function scRenderMonth() {
      const anchor = state.sc.anchor;
      const y = anchor.getFullYear(), mo = anchor.getMonth();
      const first = new Date(y, mo, 1);
      const last = new Date(y, mo + 1, 0);
      const start = startOfWeek(first);
      const end = addDays(startOfWeek(last), 6);
      const today = todayStr();
      const idx = scBuildOccurrenceIndex(start, end);
      let html = '<div class="curr-weekday-row">' + WEEKDAYS.map((w) => `<div class="curr-weekday">${w.en}</div>`).join('') + '</div><div class="curr-month-cells">';
      let d = new Date(start);
      while (d <= end) {
        const dateStr = toDateStr(d);
        const inMonth = d.getMonth() === mo;
        const items = idx.get(dateStr) || [];
        const shown = items.slice(0, 3);
        const extra = items.length - shown.length;
        html += `<div class="curr-day-cell${inMonth ? '' : ' curr-day-cell--out'}${dateStr === today ? ' curr-day-cell--today' : ''}${items.length ? ' curr-day-cell--has' : ''}" data-date="${dateStr}">
          <span class="curr-day-num">${d.getDate()}</span>
          <div class="curr-day-mini">
            ${shown.map((it: any) => `<span class="ws-sc-month-chip${it.kind === 'music' ? ' ws-sc-month-chip--music' : ''}">${escapeHtml(it.title)}</span>`).join('')}
            ${extra > 0 ? `<span class="curr-mini-more">+${extra}</span>` : ''}
          </div>
        </div>`;
        d = addDays(d, 1);
      }
      html += '</div>';
      els.scMonthGrid.innerHTML = html;
      els.scMonthGrid.querySelectorAll('.curr-day-cell').forEach((cell: any) => {
        cell.addEventListener('click', () => scOpenDay(cell.dataset.date));
      });
    }
    function scRenderYear() {
      const year = state.sc.anchor.getFullYear();
      const today = todayStr();
      const idx = scBuildOccurrenceIndex(new Date(year, 0, 1), new Date(year, 11, 31));
      let html = '';
      for (let mo = 0; mo < 12; mo++) {
        const first = new Date(year, mo, 1);
        const start = startOfWeek(first);
        let cellsHtml = '';
        let d = new Date(start);
        // Always exactly 6 rows (42 cells) so every month card lines up.
        for (let i = 0; i < 42; i++) {
          const dateStr = toDateStr(d);
          const inMonth = d.getMonth() === mo;
          const has = inMonth && (idx.get(dateStr) || []).length > 0;
          cellsHtml += `<div class="ws-sc-year-cell${inMonth ? '' : ' ws-sc-year-cell--out'}${dateStr === today ? ' ws-sc-year-cell--today' : ''}${has ? ' ws-sc-year-cell--has' : ''}" data-date="${dateStr}">${inMonth ? d.getDate() : ''}</div>`;
          d = addDays(d, 1);
        }
        html += `<div class="ws-sc-year-month"><p class="ws-sc-year-month-head">${MONTHS[mo].en}</p><div class="ws-sc-year-cells">${cellsHtml}</div></div>`;
      }
      els.scYearGrid.innerHTML = html;
      els.scYearGrid.querySelectorAll('.ws-sc-year-cell:not(.ws-sc-year-cell--out)').forEach((cell: any) => {
        cell.addEventListener('click', () => scOpenDay(cell.dataset.date));
      });
    }
    function scSetView(view: string) {
      state.sc.view = view;
      document.querySelectorAll('[data-sc-view]').forEach((btn: any) => btn.classList.toggle('curr-view-btn--active', btn.dataset.scView === view));
      scRenderView();
    }
    function scStep(delta: number) {
      const a = state.sc.anchor;
      if (state.sc.view === 'day') state.sc.anchor = addDays(a, delta);
      else if (state.sc.view === 'week') state.sc.anchor = addDays(a, delta * 7);
      else if (state.sc.view === 'year') state.sc.anchor = new Date(a.getFullYear() + delta, a.getMonth(), 1);
      else state.sc.anchor = new Date(a.getFullYear(), a.getMonth() + delta, 1);
      scRenderView();
    }
    function scShowForm() { els.scDayListView.hidden = true; els.scFormView.hidden = false; }
    function scShowList() { els.scFormView.hidden = true; els.scDayListView.hidden = false; scRenderDayList(state.sc.currentDay); }
    // The weekday toggle (S M T W T F S) only appears for a Custom
    // weekly repeat — its selection lives here rather than as a
    // multi-select form field, and gets read/written alongside the
    // rest of the form.
    function scSetWeekdaySelection(days: number[]) {
      els.scWeekdayToggle.querySelectorAll('button').forEach((btn: any) => {
        btn.classList.toggle('ws-sc-weekday--active', days.includes(Number(btn.dataset.day)));
      });
    }
    function scGetWeekdaySelection(): number[] {
      return Array.from(els.scWeekdayToggle.querySelectorAll('button.ws-sc-weekday--active')).map((btn: any) => Number(btn.dataset.day));
    }
    function scGetEndType(): string {
      const checked = els.scCustomPanel.querySelector('input[name="sc-end"]:checked');
      return checked ? checked.value : 'never';
    }
    function scSetEndType(type: string) {
      const radio = els.scCustomPanel.querySelector(`input[name="sc-end"][value="${type}"]`);
      if (radio) radio.checked = true;
    }
    // Reverse of the preset→fields mapping below, for loading an
    // existing series back into the popup/select.
    function scRepeatPresetFor(item: any): string {
      if (!item.recurrence_unit) return 'none';
      const days = item.recurrence_days || [];
      if (item.recurrence_interval === 1 && item.recurrence_unit === 'week' && days.length === 5 && [1, 2, 3, 4, 5].every((x) => days.includes(x))) return 'weekdays';
      if (item.recurrence_interval === 1 && (item.recurrence_unit !== 'week' || days.length <= 1)) return item.recurrence_unit;
      return 'custom';
    }
    // Fills the Custom recurrence popup's own fields — called both when
    // opening it for an existing custom series, and with sensible
    // defaults the first time someone picks "Custom…" on a fresh entry.
    function scFillCustomPopup(item: any) {
      const isCustomSeries = item.recurrence_unit && scRepeatPresetFor(item) === 'custom';
      els.scRepeatUnit.value = isCustomSeries ? item.recurrence_unit : 'week';
      els.scRepeatInterval.value = isCustomSeries ? String(item.recurrence_interval || 1) : '1';
      scSetWeekdaySelection(isCustomSeries ? (item.recurrence_days || []) : [parseDateStr(els.scDate.value).getDay()]);
      scSetEndType(item.recurrence_end_type || 'never');
      els.scRepeatEndDate.value = item.recurrence_end_date || '';
      els.scRepeatEndCount.value = String(item.recurrence_end_count || 13);
      els.scRepeatDays.toggleAttribute('hidden', els.scRepeatUnit.value !== 'week');
    }
    function scApplyRepeatToForm(item: any) {
      els.scRepeat.value = scRepeatPresetFor(item);
      scFillCustomPopup(item);
    }
    // The "Repeat" select is a handful of friendly presets — this maps
    // whichever one is chosen (plus whatever the Custom recurrence
    // popup was last filled with) to the plain fields actually stored
    // on the row.
    function scRepeatFieldsFromForm(): any {
      const preset = els.scRepeat.value;
      if (preset === 'none') {
        return { recurrence_unit: null, recurrence_interval: 1, recurrence_days: null, recurrence_end_type: 'never', recurrence_end_date: null, recurrence_end_count: null };
      }
      let unit: string, interval = 1, days: number[] | null = null;
      if (preset === 'custom') {
        unit = els.scRepeatUnit.value;
        interval = Math.max(1, Number(els.scRepeatInterval.value) || 1);
        if (unit === 'week') days = scGetWeekdaySelection();
      } else if (preset === 'weekdays') {
        unit = 'week'; days = [1, 2, 3, 4, 5];
      } else {
        unit = preset;
        if (unit === 'week') days = [parseDateStr(els.scDate.value).getDay()];
      }
      const endType = preset === 'custom' ? scGetEndType() : 'never';
      return {
        recurrence_unit: unit, recurrence_interval: interval, recurrence_days: days && days.length ? days : null,
        recurrence_end_type: endType,
        recurrence_end_date: endType === 'on_date' ? (els.scRepeatEndDate.value || null) : null,
        recurrence_end_count: endType === 'after_count' ? (Number(els.scRepeatEndCount.value) || null) : null,
      };
    }
    function scResetForm() {
      state.editingScId = null;
      state.editingScOccurrenceDate = null;
      els.scFormView.reset();
      els.scDate.value = state.sc.currentDay || todayStr();
      els.scFormTitle.textContent = 'New calendar entry';
      els.scDelete.hidden = true;
      scApplyRepeatToForm({});
    }
    function scStartNew() { scResetForm(); scShowForm(); }
    function scStartEdit(id: string, occurrenceDate?: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return;
      state.editingScId = id;
      state.editingScOccurrenceDate = occurrenceDate || item.event_date;
      els.scTitle.value = item.title;
      els.scDate.value = item.event_date;
      els.scTime.value = item.event_time || '';
      els.scTimeEnd.value = item.event_end_time || '';
      els.scNotes.value = item.notes || '';
      els.scFormTitle.textContent = 'Editing entry';
      els.scDelete.hidden = false;
      scApplyRepeatToForm(item);
      scShowForm();
    }
    function scRenderDayList(dateStr: string) {
      const items = scItemsForDate(dateStr);
      els.scDayList.innerHTML = items.length ? items.map(scDayItemRowHTML).join('') : '<p class="ws-empty" style="padding:1rem 0">Nothing on the calendar this day.</p>';
      bindScDayItemActions(els.scDayList);
    }
    function scOpenDay(dateStr: string) {
      state.sc.currentDay = dateStr;
      const d = parseDateStr(dateStr);
      els.scDayHeader.textContent = `${WEEKDAYS[d.getDay()].en}, ${MONTHS[d.getMonth()].en} ${d.getDate()}, ${d.getFullYear()}`;
      scShowList();
      els.scDayOverlay.removeAttribute('hidden');
    }
    function scCloseDay() {
      els.scDayOverlay.setAttribute('hidden', '');
      state.sc.currentDay = null;
    }
    function scOpenCustomPopup() {
      scFillCustomPopup(state.editingScId ? (state.scEvents.find((x: any) => x.id === state.editingScId) || {}) : {});
      els.scCustomOverlay.removeAttribute('hidden');
    }
    async function scDeleteSeries(id: string) {
      const { error } = await db.from('shared_calendar_events').delete().eq('id', id);
      if (error) { console.error(error); showToast('Could not delete.'); return false; }
      return true;
    }
    async function scDeleteOccurrence(id: string, dateStr: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return false;
      const exceptions = Array.from(new Set([...(item.recurrence_exceptions || []), dateStr]));
      const { error } = await db.from('shared_calendar_events').update({ recurrence_exceptions: exceptions }).eq('id', id);
      if (error) { console.error(error); showToast('Could not delete.'); return false; }
      return true;
    }
    // Shared by the list view's own Delete button and the edit form's
    // — recurring entries need the This event/All events choice either
    // way, so both routes funnel through here rather than requiring an
    // Edit click first just to reach Delete.
    function scDeleteFlow(id: string, occurrenceDate: string) {
      const item = state.scEvents.find((x: any) => x.id === id);
      if (!item) return;
      state.editingScId = id;
      state.editingScOccurrenceDate = occurrenceDate;
      if (item.recurrence_unit) {
        els.scDeleteChoiceOverlay.removeAttribute('hidden');
      } else if (confirm('Delete this calendar entry?')) {
        scDeleteSeries(id).then((ok) => { if (ok) { loadSharedCal(); scShowList(); } });
      }
    }
    function bindSharedCalForm() {
      els.scPrev.addEventListener('click', () => scStep(-1));
      els.scNext.addEventListener('click', () => scStep(1));
      els.scToday.addEventListener('click', () => { state.sc.anchor = new Date(); scRenderView(); });
      document.querySelectorAll('[data-sc-view]').forEach((btn: any) => {
        btn.addEventListener('click', () => scSetView(btn.dataset.scView));
      });
      els.scAddBtn.addEventListener('click', () => scOpenDay(todayStr()));
      els.scDayClose.addEventListener('click', scCloseDay);
      els.scDayAdd.addEventListener('click', scStartNew);
      els.scFormBack.addEventListener('click', scShowList);

      // "Custom…" opens its own popup instead of revealing inline
      // fields — Cancel reverts the select to whatever it was before.
      let scRepeatPrevValue = 'none';
      els.scRepeat.addEventListener('focus', () => { scRepeatPrevValue = els.scRepeat.value; });
      els.scRepeat.addEventListener('change', () => {
        if (els.scRepeat.value === 'custom') scOpenCustomPopup();
      });
      els.scWeekdayToggle.querySelectorAll('button').forEach((btn: any) => {
        btn.addEventListener('click', () => btn.classList.toggle('ws-sc-weekday--active'));
      });
      els.scRepeatUnit.addEventListener('change', () => {
        els.scRepeatDays.toggleAttribute('hidden', els.scRepeatUnit.value !== 'week');
      });
      els.scCustomCancel.addEventListener('click', () => {
        els.scRepeat.value = scRepeatPrevValue;
        els.scCustomOverlay.setAttribute('hidden', '');
      });
      els.scCustomDone.addEventListener('click', () => {
        els.scRepeat.value = 'custom';
        els.scCustomOverlay.setAttribute('hidden', '');
      });

      els.scFormView.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const title = els.scTitle.value.trim();
        const date = els.scDate.value;
        if (!title || !date) { showToast('Title and date are required.'); return; }
        const payload: any = {
          title, event_date: date, event_time: els.scTime.value || null, event_end_time: els.scTimeEnd.value || null,
          notes: els.scNotes.value.trim() || null, ...scRepeatFieldsFromForm(),
        };
        let error;
        if (state.editingScId) {
          payload.updated_at = new Date().toISOString();
          ({ error } = await db.from('shared_calendar_events').update(payload).eq('id', state.editingScId));
        } else {
          payload.created_by = state.session.user.id;
          payload.created_by_name = state.profile?.name || null;
          ({ error } = await db.from('shared_calendar_events').insert(payload));
        }
        if (error) { console.error(error); showToast('Could not save.'); return; }
        await loadSharedCal();
        scShowList();
      });
      els.scDelete.addEventListener('click', () => {
        if (!state.editingScId) return;
        scDeleteFlow(state.editingScId, state.editingScOccurrenceDate || els.scDate.value);
      });
      els.scDeleteChoiceCancel.addEventListener('click', () => els.scDeleteChoiceOverlay.setAttribute('hidden', ''));
      els.scDeleteChoiceOk.addEventListener('click', async () => {
        const scope = els.scDeleteChoicePanel.querySelector('input[name="sc-delete-scope"]:checked')?.value || 'this';
        els.scDeleteChoiceOverlay.setAttribute('hidden', '');
        const ok = scope === 'all'
          ? await scDeleteSeries(state.editingScId)
          : await scDeleteOccurrence(state.editingScId, state.editingScOccurrenceDate || els.scDate.value);
        if (ok) { await loadSharedCal(); scShowList(); }
      });
    }

    // ---------- Overview (the 5 troops) -------------------------------------
    async function loadOverview() {
      const now = new Date();
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthEnd = `${period}-${String(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const d30 = new Date(now); d30.setDate(d30.getDate() - 30);
      const d60 = new Date(now); d60.setDate(d60.getDate() - 60);
      const day30Str = `${d30.getFullYear()}-${String(d30.getMonth() + 1).padStart(2, '0')}-${String(d30.getDate()).padStart(2, '0')}`;
      const day60Str = `${d60.getFullYear()}-${String(d60.getMonth() + 1).padStart(2, '0')}-${String(d60.getDate()).padStart(2, '0')}`;

      const troopKeys = TROOP_GROUPS.map((g) => g.key);
      const [membersRes, attRes, feeRes, finRes, pendingRes] = await Promise.all([
        db.from('members').select('group_key, active, has_allergies').in('group_key', troopKeys),
        db.from('attendance').select('group_key, present, date').in('group_key', troopKeys).gte('date', day60Str),
        db.from('fee_payments').select('group_key, paid, amount').in('group_key', troopKeys).eq('period', period),
        db.from('finance_entries').select('group_key, entry_type, amount, entry_date').in('group_key', troopKeys).gte('entry_date', `${prevPeriod}-01`).lte('entry_date', monthEnd),
        db.from('join_requests').select('id', { count: 'exact', head: true }).eq('status', 'pending'),
      ]);

      const byGroup = new Map<string, any>();
      TROOP_GROUPS.forEach((g) => byGroup.set(g.key, {
        activeMembers: 0, archivedMembers: 0, allergyMembers: 0,
        attPresent30: 0, attTotal30: 0, attPresent3060: 0, attTotal3060: 0,
        feePaid: 0, feeCollected: 0, netThis: 0, netPrev: 0,
      }));
      (membersRes.data || []).forEach((m: any) => {
        const b = byGroup.get(m.group_key); if (!b) return;
        if (m.active) { b.activeMembers++; if (m.has_allergies) b.allergyMembers++; }
        else b.archivedMembers++;
      });
      (attRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.date >= day30Str) { b.attTotal30++; if (r.present) b.attPresent30++; }
        else { b.attTotal3060++; if (r.present) b.attPresent3060++; }
      });
      (feeRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.paid) { b.feePaid++; b.feeCollected += Number(r.amount || 0); }
      });
      (finRes.data || []).forEach((r: any) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        const amt = signedAmount(r);
        if (r.entry_date >= `${period}-01`) b.netThis += amt; else b.netPrev += amt;
      });
      renderOverview(byGroup, pendingRes.count || 0);
    }
    function renderOverview(byGroup: Map<string, any>, pendingApprovals: number) {
      const groups = TROOP_GROUPS.map((g) => ({ ...g, ...byGroup.get(g.key) }));
      const totalActive = groups.reduce((s, g) => s + g.activeMembers, 0);
      const totalArchived = groups.reduce((s, g) => s + g.archivedMembers, 0);
      const totalAllergy = groups.reduce((s, g) => s + g.allergyMembers, 0);
      const attPresent30 = groups.reduce((s, g) => s + g.attPresent30, 0);
      const attTotal30 = groups.reduce((s, g) => s + g.attTotal30, 0);
      const attPresent3060 = groups.reduce((s, g) => s + g.attPresent3060, 0);
      const attTotal3060 = groups.reduce((s, g) => s + g.attTotal3060, 0);
      const rate30 = attTotal30 ? Math.round((attPresent30 / attTotal30) * 100) : null;
      const ratePrev30 = attTotal3060 ? Math.round((attPresent3060 / attTotal3060) * 100) : null;
      const totalFeePaid = groups.reduce((s, g) => s + g.feePaid, 0);
      const totalCollected = groups.reduce((s, g) => s + g.feeCollected, 0);
      const feePct = totalActive ? Math.round((totalFeePaid / totalActive) * 100) : 0;
      const netThis = groups.reduce((s, g) => s + g.netThis, 0);
      const netPrev = groups.reduce((s, g) => s + g.netPrev, 0);
      const retentionPct = (totalActive + totalArchived) ? Math.round((totalActive / (totalActive + totalArchived)) * 100) : null;
      const allergyPct = totalActive ? Math.round((totalAllergy / totalActive) * 100) : 0;
      const groupsFullyPaid = groups.filter((g) => g.activeMembers > 0 && g.feePaid === g.activeMembers).length;
      const largestGroup = groups.reduce((max, g) => (g.activeMembers > max.activeMembers ? g : max), groups[0]);
      const largestSharePct = totalActive ? Math.round((largestGroup.activeMembers / totalActive) * 100) : 0;
      const avgPerGroup = (totalActive / TROOP_GROUPS.length).toFixed(1);
      const avgFeeAmount = totalFeePaid ? totalCollected / totalFeePaid : 0;

      els.ovRatios.innerHTML = `
        <div class="ws-stat"><span class="ws-stat-icon">#</span><span class="ws-stat-text"><span class="ws-stat-num">${avgPerGroup}</span><span class="ws-stat-label">Avg members / group</span></span></div>
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">▲</span><span class="ws-stat-text"><span class="ws-stat-num">${largestSharePct}%</span><span class="ws-stat-label">Largest group: ${escapeHtml(largestGroup.en)}</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">$</span><span class="ws-stat-text"><span class="ws-stat-num">${avgFeeAmount.toFixed(2)}</span><span class="ws-stat-label">Avg fee collected / member</span></span></div>
      `;

      els.ovKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">★</span><span class="ws-dash-kpi-label">Active members</span></div>
          <span class="ws-dash-kpi-num">${totalActive}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalArchived} archived · across ${TROOP_GROUPS.length} troops</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Attendance (30d)</span></div>
          <span class="ws-dash-kpi-num">${rate30 != null ? rate30 + '%' : '—'}</span>
          ${rate30 != null ? dashDeltaBadge(ratePrev30 != null ? rate30 - ratePrev30 : null, 'pt') : '<span class="ws-dash-delta ws-dash-delta--flat">No sessions yet</span>'}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">$</span><span class="ws-dash-kpi-label">Fees collected (mtd)</span></div>
          <span class="ws-dash-kpi-num">${feePct}%</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalFeePaid}/${totalActive} paid · ${totalCollected.toFixed(0)} in</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">±</span><span class="ws-dash-kpi-label">Net income (mtd)</span></div>
          <span class="ws-dash-kpi-num">${netThis >= 0 ? '+' : '−'}${Math.abs(netThis).toFixed(0)}</span>
          ${dashDeltaBadge(Math.round(netThis - netPrev))}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⟳</span><span class="ws-dash-kpi-label">Retention rate</span></div>
          <span class="ws-dash-kpi-num">${retentionPct != null ? retentionPct + '%' : '—'}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalActive} active of ${totalActive + totalArchived} ever registered</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">⚑</span><span class="ws-dash-kpi-label">Allergy awareness</span></div>
          <span class="ws-dash-kpi-num">${allergyPct}%</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${totalAllergy} of ${totalActive} active members</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">!</span><span class="ws-dash-kpi-label">Pending approvals</span></div>
          <span class="ws-dash-kpi-num">${pendingApprovals}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${pendingApprovals ? 'waiting for review' : 'all caught up'}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Groups fully paid</span></div>
          <span class="ws-dash-kpi-num">${groupsFullyPaid} / ${TROOP_GROUPS.length}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">100% collected this month</span>
        </div>
      `;

      const maxActive = Math.max(1, ...groups.map((g) => g.activeMembers));
      els.ovMembersChart.innerHTML = `
        <div class="ws-dash-bars">
          ${groups.map((g) => {
            const pct = Math.round((g.activeMembers / maxActive) * 100);
            const share = totalActive ? Math.round((g.activeMembers / totalActive) * 100) : 0;
            return `
              <div class="ws-dash-bar-col" title="${escapeHtml(g.en)}, ${g.activeMembers} active members (${share}% of troop)">
                <span class="ws-dash-bar-pct">${g.activeMembers}</span>
                <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style="height:${g.activeMembers ? Math.max(pct, 4) : 0}%"></div></div>
                <span class="ws-dash-bar-label">${escapeHtml(g.en)}</span>
              </div>`;
          }).join('')}
        </div>
      `;
      els.ovFeesChart.innerHTML = `
        <div class="ws-dash-bars">
          ${groups.map((g) => {
            const pct = g.activeMembers ? Math.round((g.feePaid / g.activeMembers) * 100) : 0;
            return `
              <div class="ws-dash-bar-col" title="${escapeHtml(g.en)}, ${pct}% collected (${g.feePaid}/${g.activeMembers})">
                <span class="ws-dash-bar-pct">${g.activeMembers ? pct + '%' : '—'}</span>
                <div class="ws-dash-bar-track"><div class="ws-dash-bar-fill" style="height:${pct ? Math.max(pct, 4) : 0}%"></div></div>
                <span class="ws-dash-bar-label">${escapeHtml(g.en)}</span>
              </div>`;
          }).join('')}
        </div>
      `;

      els.ovBody.innerHTML = groups.map((g) => {
        const rate = g.attTotal30 ? Math.round((g.attPresent30 / g.attTotal30) * 100) : null;
        const share = totalActive ? Math.round((g.activeMembers / totalActive) * 100) : 0;
        const feeRate = g.activeMembers ? Math.round((g.feePaid / g.activeMembers) * 100) : 0;
        return `
          <tr>
            <td data-label="Group">${escapeHtml(g.en)}</td>
            <td data-label="Active">${g.activeMembers}</td>
            <td data-label="% of Troop">${share}%</td>
            <td data-label="Attendance (30d)">${rate != null ? rate + '%' : '—'}</td>
            <td data-label="Fees Collected">${feeRate}% · ${g.feeCollected.toFixed(0)}</td>
            <td data-label="Net Income">${g.netThis >= 0 ? '+' : '−'}${Math.abs(g.netThis).toFixed(0)}</td>
          </tr>`;
      }).join('');
    }

    // ---------- Finance: the accounting system (every group) ---------------
    async function ensureOrgSettings() {
      if (state.settings) return state.settings;
      const { data, error } = await db.from('org_finance_settings').select('*').eq('id', 'org').maybeSingle();
      if (error) { console.error(error); return null; }
      state.settings = data;
      return data;
    }
    async function loadFinanceKpis() {
      await ensureOrgSettings();
      const [entriesRes, lastRecRes] = await Promise.all([
        db.from('finance_entries').select('entry_type, amount, entry_date'),
        db.from('finance_reconciliations').select('*').order('as_of_date', { ascending: false }).limit(1).maybeSingle(),
      ]);
      if (entriesRes.error) { console.error(entriesRes.error); showToast('Could not load finance totals.'); return; }
      const rows = entriesRes.data || [];
      const opening = Number(state.settings?.opening_balance || 0);
      const running = opening + rows.reduce((s: number, r: any) => s + signedAmount(r), 0);
      const lastRec = lastRecRes.data;
      // The confirmed bank balance from the last reconciliation, carried
      // forward by everything logged since — grounded in a real bank
      // check, unlike Running Balance above (which never anchors to the
      // actual bank, just opening balance + every entry ever).
      const actualBalance = lastRec
        ? Number(lastRec.statement_balance) + rows.filter((r: any) => r.entry_date > lastRec.as_of_date).reduce((s: number, r: any) => s + signedAmount(r), 0)
        : running;

      const now = new Date();
      const period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const prevD = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const prevPeriod = `${prevD.getFullYear()}-${String(prevD.getMonth() + 1).padStart(2, '0')}`;
      const thisMonthRows = rows.filter((r: any) => String(r.entry_date).startsWith(period));
      const incomeThis = thisMonthRows.filter((r: any) => r.entry_type === 'income').reduce((s: number, r: any) => s + Number(r.amount), 0);
      const expenseThis = thisMonthRows.filter((r: any) => r.entry_type === 'expense').reduce((s: number, r: any) => s + Number(r.amount), 0);
      const netThis = incomeThis - expenseThis;
      const netPrev = rows.filter((r: any) => String(r.entry_date).startsWith(prevPeriod)).reduce((s: number, r: any) => s + signedAmount(r), 0);

      els.finKpis.innerHTML = `
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">${'\u{1F3E6}'}</span><span class="ws-dash-kpi-label">Running Balance</span></div>
          <span class="ws-dash-kpi-num">${fmt(running)}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">Opening ${fmt(opening)} · every group</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">↑</span><span class="ws-dash-kpi-label">Income (mtd)</span></div>
          <span class="ws-dash-kpi-num">${fmt(incomeThis)}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${MONTHS[now.getMonth()].en} ${now.getFullYear()}</span>
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">↓</span><span class="ws-dash-kpi-label">Expenses (mtd)</span></div>
          <span class="ws-dash-kpi-num">${fmt(expenseThis)}</span>
          ${dashDeltaBadge(Math.round(netThis - netPrev))}
        </div>
        <div class="ws-dash-kpi">
          <div class="ws-dash-kpi-head"><span class="ws-dash-kpi-icon">✓</span><span class="ws-dash-kpi-label">Actual Running Balance</span></div>
          <span class="ws-dash-kpi-num">${fmt(actualBalance)}</span>
          <span class="ws-dash-delta ws-dash-delta--flat">${lastRec ? `Since ${lastRec.as_of_date}'s reconciliation` : 'Not reconciled yet, same as Running Balance'}</span>
        </div>
      `;
      els.openAmount.value = state.settings?.opening_balance ?? 0;
      els.openDate.value = state.settings?.opening_balance_date || todayStr();
    }
    function bindOpeningBalanceForm() {
      els.openSave.addEventListener('click', async () => {
        const opening_balance = Number(els.openAmount.value || 0);
        const opening_balance_date = els.openDate.value || todayStr();
        const { error } = await db.from('org_finance_settings').update({ opening_balance, opening_balance_date, updated_by: state.session.user.id }).eq('id', 'org');
        if (error) { showToast('Could not save, ' + (error.message || 'unknown error') + '.'); return; }
        state.settings.opening_balance = opening_balance;
        state.settings.opening_balance_date = opening_balance_date;
        showToast('Opening balance saved.');
        await loadFinanceKpis();
      });
    }

    // Same starter lists as loadGroupSettings() in the Leaders Workspace —
    // Music/General/Social Media aren't scouting troops, so they need
    // their own categories rather than an empty dropdown the first time
    // anyone (here, possibly an admin before any leader has even opened
    // that group's own Finance tab) tries to log something against them.
    const GROUP_DEFAULT_CATEGORIES: Record<string, { expense: string[]; income: string[] }> = {
      [MUSIC_GROUP_KEY]: {
        expense: ['Band Payouts', 'Equipment', 'Transport', 'Repairs', 'Refreshments', 'Miscellaneous'],
        income: ['Wedding', 'Event', 'Donation', 'Miscellaneous'],
      },
      [GENERAL_GROUP_KEY]: {
        expense: ['Venue Maintenance', 'Furniture & Equipment', 'Utilities', 'Repairs', 'Supplies', 'Other'],
        income: ['Donations', 'Fundraising', 'Other'],
      },
      [SOCIAL_MEDIA_GROUP_KEY]: {
        expense: ['Content Production', 'Advertising & Boosting', 'Software & Subscriptions', 'Equipment', 'Miscellaneous'],
        income: ['Sponsored Content', 'Donations', 'Miscellaneous'],
      },
    };
    async function updateTxCategoryOptions() {
      const groupKey = els.txGroup.value;
      const { data } = await db.from('group_settings').select('*').eq('group_key', groupKey).maybeSingle();
      const type = els.txType.value === 'income' ? 'income' : 'expense';
      const stored = data ? (type === 'income' ? data.income_categories : data.expense_categories) : null;
      const list = stored?.length ? stored : (GROUP_DEFAULT_CATEGORIES[groupKey]?.[type] || []);
      els.txCategory.innerHTML = list.length
        ? list.map((c: string) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
        : `<option value="">No categories yet, add some in ${escapeHtml(GROUPS.find((g) => g.key === groupKey)?.en || groupKey)}'s Finance › Categories</option>`;
    }
    function bindTransactionForm() {
      els.txGroup.innerHTML = GROUPS.map((g) => `<option value="${g.key}">${escapeHtml(g.en)}</option>`).join('');
      updateTxCategoryOptions();
      els.txGroup.addEventListener('change', updateTxCategoryOptions);
      els.txType.addEventListener('change', updateTxCategoryOptions);
      els.txForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const payload = {
          group_key: els.txGroup.value,
          entry_type: els.txType.value,
          category: els.txCategory.value.trim() || null,
          amount: Number(els.txAmount.value),
          entry_date: els.txDate.value,
          description: els.txDescription.value.trim() || null,
        };
        if (!payload.group_key || !payload.category || !payload.amount || !payload.entry_date || !payload.description) {
          showToast('Everything is required.');
          return;
        }
        els.txSubmit.disabled = true;
        const { error } = await db.from('finance_entries').insert({
          ...payload, created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        });
        els.txSubmit.disabled = false;
        if (error) { console.error(error); showToast('Could not add, ' + (error.message || 'unknown error') + '.'); return; }
        showToast('Added.');
        els.txAmount.value = '';
        els.txDescription.value = '';
        await loadFinancePeriod();
        await loadFinanceKpis();
      });
    }

    async function loadFinancePeriod() {
      populatePeriodSelects(els.finMonth, els.finYear, true);
      const { start, end } = periodRange(els.finMonth, els.finYear);
      const { data, error } = await db.from('finance_entries').select('group_key, entry_type, category, amount, entry_date, description, created_by_name')
        .gte('entry_date', start).lte('entry_date', end).order('entry_date', { ascending: false });
      if (error) { console.error(error); showToast('Could not load finance.'); return; }
      renderFinancePeriod(data || []);
    }
    function renderFinancePeriod(rows: any[]) {
      const income = rows.filter((r) => r.entry_type === 'income').reduce((s, r) => s + Number(r.amount), 0);
      const expense = rows.filter((r) => r.entry_type === 'expense').reduce((s, r) => s + Number(r.amount), 0);
      els.finStats.innerHTML = `
        <div class="ws-stat ws-stat--accent"><span class="ws-stat-icon">↑</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(income)}</span><span class="ws-stat-label">Income</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">↓</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(expense)}</span><span class="ws-stat-label">Expenses</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">=</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(income - expense)}</span><span class="ws-stat-label">Net</span></span></div>
      `;
      const byGroup = new Map<string, { income: number; expense: number }>();
      GROUPS.forEach((g) => byGroup.set(g.key, { income: 0, expense: 0 }));
      rows.forEach((r) => {
        const b = byGroup.get(r.group_key); if (!b) return;
        if (r.entry_type === 'income') b.income += Number(r.amount); else b.expense += Number(r.amount);
      });
      els.finGroupBody.innerHTML = GROUPS.map((g) => {
        const b = byGroup.get(g.key)!;
        return `<tr><td data-label="Group">${escapeHtml(g.en)}</td><td data-label="Income">${fmt(b.income)}</td><td data-label="Expenses">${fmt(b.expense)}</td><td data-label="Net">${fmt(b.income - b.expense)}</td></tr>`;
      }).join('');
      els.finBody.innerHTML = rows.length
        ? rows.map((r) => {
            const g = GROUPS.find((x) => x.key === r.group_key);
            return `
              <tr>
                <td data-label="Date">${r.entry_date}</td>
                <td data-label="Group">${escapeHtml(g ? g.en : r.group_key)}</td>
                <td data-label="Type">${r.entry_type === 'income' ? 'Income' : 'Expense'}</td>
                <td data-label="Category">${escapeHtml(r.category || '—')}</td>
                <td data-label="Description">${escapeHtml(r.description || '—')}</td>
                <td data-label="Amount">${fmt(r.amount)}</td>
                <td data-label="Added by">${escapeHtml(r.created_by_name || '—')}</td>
              </tr>`;
          }).join('')
        : '<tr><td colspan="8" class="ws-empty">No entries this period.</td></tr>';
    }

    // ---------- Reconcile: compare the system's balance to the real bank
    // balance as of a date, and — since not every entry is a bank
    // transaction (cash, in-hand group funds, etc.) — true up any gap with
    // a single adjustment entry rather than ticking off individual rows. --
    async function compareReconcile() {
      await ensureOrgSettings();
      if (!els.recAsof.value) els.recAsof.value = todayStr();
      const asOf = els.recAsof.value;
      const { data, error } = await db.from('finance_entries').select('entry_type, amount, entry_date').lte('entry_date', asOf);
      if (error) { console.error(error); showToast('Could not load finance totals.'); return; }
      const opening = Number(state.settings?.opening_balance || 0);
      const system = opening + (data || []).reduce((s: number, r: any) => s + signedAmount(r), 0);
      state.recSystemBalance = system;

      const bank = els.recBank.value === '' ? null : Number(els.recBank.value);
      const diff = bank == null ? null : bank - system;
      state.recDiff = diff;
      els.recStats.innerHTML = `
        <div class="ws-stat"><span class="ws-stat-icon">${'\u{1F3E6}'}</span><span class="ws-stat-text"><span class="ws-stat-num">${fmt(system)}</span><span class="ws-stat-label">System Balance (as of this date)</span></span></div>
        <div class="ws-stat"><span class="ws-stat-icon">✓</span><span class="ws-stat-text"><span class="ws-stat-num">${bank == null ? '—' : fmt(bank)}</span><span class="ws-stat-label">Actual Bank Balance</span></span></div>
        <div class="ws-stat ${diff != null && Math.abs(diff) < 0.005 ? 'ws-stat--accent' : ''}"><span class="ws-stat-icon">${diff == null ? '?' : (Math.abs(diff) < 0.005 ? '✓' : '⚠')}</span><span class="ws-stat-text"><span class="ws-stat-num">${diff == null ? '—' : fmt(diff)}</span><span class="ws-stat-label">Difference</span></span></div>
      `;
      const matches = diff != null && Math.abs(diff) < 0.005;
      els.recAdjustBlock.toggleAttribute('hidden', diff == null || matches);
      els.recMatchBlock.toggleAttribute('hidden', !matches);
    }
    async function saveReconciliation(adjustmentEntryId: string | null, note: string | null) {
      const asOf = els.recAsof.value;
      const bank = Number(els.recBank.value);
      const { error } = await db.from('finance_reconciliations').insert({
        as_of_date: asOf, statement_balance: bank, system_balance: state.recSystemBalance,
        difference: state.recDiff, notes: note, adjustment_entry_id: adjustmentEntryId,
        created_by: state.session.user.id, created_by_name: state.profile?.name || null,
      });
      if (error) { showToast('Could not save, ' + (error.message || 'unknown error') + '.'); return false; }
      return true;
    }
    function renderReconcileHistory(rows: any[]) {
      if (!rows.length) { els.recHistoryBody.innerHTML = '<tr><td colspan="7" class="ws-empty">No reconciliations saved yet.</td></tr>'; return; }
      els.recHistoryBody.innerHTML = rows.map((r: any) => `
        <tr>
          <td data-label="As of">${r.as_of_date}</td>
          <td data-label="Bank Balance">${fmt(r.statement_balance)}</td>
          <td data-label="System Balance">${fmt(r.system_balance)}</td>
          <td data-label="Adjustment">${r.adjustment_entry_id ? fmt(r.difference) : '—'}</td>
          <td data-label="Saved">${new Date(r.created_at).toLocaleDateString()}</td>
          <td data-label="By">${escapeHtml(r.created_by_name || '—')}</td>
        </tr>
      `).join('');
    }
    async function loadReconcileHistory() {
      const { data, error } = await db.from('finance_reconciliations').select('*').order('as_of_date', { ascending: false }).limit(12);
      if (error) { console.error(error); return; }
      renderReconcileHistory(data || []);
    }
    async function loadAdjustmentEntries() {
      const { data, error } = await db.from('finance_entries').select('*').eq('is_adjustment', true).order('entry_date', { ascending: false });
      if (error) { console.error(error); return; }
      renderAdjustmentEntries(data || []);
    }
    function renderAdjustmentEntries(rows: any[]) {
      if (!rows.length) { els.adjBody.innerHTML = '<tr><td colspan="7" class="ws-empty">No adjustments posted yet.</td></tr>'; return; }
      els.adjBody.innerHTML = rows.map((r: any) => {
        const g = GROUPS.find((x) => x.key === r.group_key);
        return `
          <tr>
            <td data-label="Date">${r.entry_date}</td>
            <td data-label="Group">${escapeHtml(g ? g.en : r.group_key)}</td>
            <td data-label="Type">${r.entry_type === 'income' ? 'Income' : 'Expense'}</td>
            <td data-label="Amount">${fmt(r.amount)}</td>
            <td data-label="Note">${escapeHtml(r.description || '—')}</td>
            <td data-label="Posted by">${escapeHtml(r.created_by_name || '—')}</td>
          </tr>`;
      }).join('');
    }
    function bindReconcile() {
      els.recAdjustGroup.innerHTML = GROUPS.map((g) => `<option value="${g.key}">${escapeHtml(g.en)}</option>`).join('');
      els.recLoad.addEventListener('click', compareReconcile);
      els.recBank.addEventListener('input', compareReconcile);

      els.recSave.addEventListener('click', async () => {
        const diff = state.recDiff;
        if (diff == null) return;
        const note = els.recAdjustNote.value.trim() || null;
        if (!els.recAdjustGroup.value) { showToast('Pick which group this belongs to.'); return; }
        els.recSave.disabled = true;
        const { data: inserted, error } = await db.from('finance_entries').insert({
          group_key: els.recAdjustGroup.value,
          entry_type: diff >= 0 ? 'income' : 'expense',
          category: 'Reconciliation Adjustment',
          is_adjustment: true,
          amount: Math.abs(diff),
          entry_date: els.recAsof.value,
          description: note || `Reconciliation adjustment as of ${els.recAsof.value}`,
          created_by: state.session.user.id, created_by_name: state.profile?.name || null,
        }).select().single();
        if (error) { showToast('Could not post the adjustment, ' + (error.message || 'unknown error') + '.'); els.recSave.disabled = false; return; }
        const ok = await saveReconciliation(inserted?.id || null, note);
        els.recSave.disabled = false;
        if (!ok) return;
        showToast(`Adjustment posted to ${GROUPS.find((g) => g.key === els.recAdjustGroup.value)?.en} and reconciliation saved.`);
        els.recAdjustNote.value = '';
        await compareReconcile();
        await loadFinanceKpis();
        await loadFinancePeriod();
        await loadReconcileHistory();
        await loadAdjustmentEntries();
      });

      els.recSaveMatch.addEventListener('click', async () => {
        els.recSaveMatch.disabled = true;
        const ok = await saveReconciliation(null, null);
        els.recSaveMatch.disabled = false;
        if (!ok) return;
        showToast('Saved, balances match.');
        await loadReconcileHistory();
      });
    }

    // ---------- Reports (Fees/Attendance stay troop-only) --------------------
    async function downloadFeesReport() {
      try {
        const { period, label, isYear, isRange, periodFrom, periodTo } = periodRange(els.reportMonth, els.reportYear);
        const troopKeys = TROOP_GROUPS.map((g) => g.key);
        const membersRes = await db.from('members').select('id, full_name, member_code, group_key').eq('active', true).in('group_key', troopKeys);
        const members = membersRes.data || [];
        const doc = new jsPDF();
        if (isYear || isRange) {
          // Fees are keyed by a plain 'YYYY-MM' period string, not a real
          // date column — a calendar year uses a LIKE prefix match, a
          // custom range needs an inclusive string comparison instead
          // (works fine since 'YYYY-MM' sorts lexicographically).
          const query = db.from('fee_payments').select('member_id, paid, amount');
          const { data } = isYear
            ? await query.like('period', `${els.reportYear.value}-%`)
            : await query.gte('period', periodFrom).lte('period', periodTo);
          const monthCount = isYear ? 12 : (Number(periodTo!.slice(0, 4)) * 12 + Number(periodTo!.slice(5, 7))) - (Number(periodFrom!.slice(0, 4)) * 12 + Number(periodFrom!.slice(5, 7))) + 1;
          const byMember = new Map<string, { months: number; total: number }>();
          (data || []).forEach((r: any) => {
            if (!r.paid) return;
            const cur = byMember.get(r.member_id) || { months: 0, total: 0 };
            cur.months++; cur.total += Number(r.amount || 0);
            byMember.set(r.member_id, cur);
          });
          const rows = members.map((m: any) => {
            const g = GROUPS.find((x) => x.key === m.group_key);
            const s = byMember.get(m.id) || { months: 0, total: 0 };
            return [m.member_code || '—', m.full_name, g ? g.en : m.group_key, `${s.months} / ${monthCount}`, s.total.toFixed(2)];
          });
          const grandTotal = members.reduce((sum: number, m: any) => sum + (byMember.get(m.id)?.total || 0), 0);
          const y = pdfHeader(doc, isYear ? 'Yearly Fees Summary' : 'Fees Summary', `${label}, ${grandTotal.toFixed(2)} collected total`);
          pdfTable(doc, {
            startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            head: [['Member ID', 'Member', 'Group', 'Months Paid', 'Total']], body: rows.length ? rows : [['', 'No data available', '', '', '']],
          });
          doc.save(pdfFilename(isYear ? 'Yearly-Fees' : 'Fees-Summary', label));
        } else {
          const { data } = await db.from('fee_payments').select('member_id, paid, amount').eq('period', period);
          const map: Map<string, any> = new Map((data || []).map((r: any) => [r.member_id, r]));
          let paidCount = 0, collected = 0;
          const rows = members.map((m: any) => {
            const rec = map.get(m.id);
            const g = GROUPS.find((x) => x.key === m.group_key);
            if (rec && rec.paid) { paidCount++; collected += Number(rec.amount || 0); }
            return [m.member_code || '—', m.full_name, g ? g.en : m.group_key, rec && rec.paid ? 'Paid' : 'Unpaid', rec && rec.amount != null ? Number(rec.amount).toFixed(2) : '—'];
          });
          const y = pdfHeader(doc, 'Monthly Fees', `${label}, ${paidCount} of ${members.length} paid, ${collected.toFixed(2)} collected`);
          pdfTable(doc, {
            startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            head: [['Member ID', 'Member', 'Group', 'Status', 'Amount']], body: rows.length ? rows : [['', 'No data available', '', '', '']],
          });
          doc.save(pdfFilename('Monthly-Fees', label));
        }
      } catch (err) {
        console.error('fees report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    async function downloadAttendanceReport() {
      try {
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const troopKeys = TROOP_GROUPS.map((g) => g.key);
        const [membersRes, attRes] = await Promise.all([
          db.from('members').select('id, full_name, member_code, group_key').eq('active', true).in('group_key', troopKeys),
          db.from('attendance').select('member_id, group_key, present, date').in('group_key', troopKeys).gte('date', start).lte('date', end),
        ]);
        const members = membersRes.data || [];
        const rows = attRes.data || [];
        const byGroupSessions = new Map<string, Set<string>>();
        TROOP_GROUPS.forEach((g) => byGroupSessions.set(g.key, new Set()));
        const presentByMember = new Map<string, number>();
        rows.forEach((r: any) => {
          const set = byGroupSessions.get(r.group_key);
          if (set) set.add(r.date);
          if (r.present) presentByMember.set(r.member_id, (presentByMember.get(r.member_id) || 0) + 1);
        });
        const totalSessions = Array.from(byGroupSessions.values()).reduce((s, set) => s + set.size, 0);
        const bodyRows = members.map((m: any) => {
          const g = GROUPS.find((x) => x.key === m.group_key);
          const sessions = byGroupSessions.get(m.group_key)?.size || 0;
          const present = presentByMember.get(m.id) || 0;
          const rate = sessions ? Math.round((present / sessions) * 100) : 0;
          return [m.member_code || '—', m.full_name, g ? g.en : m.group_key, `${present} / ${sessions}`, `${rate}%`];
        });
        const doc = new jsPDF();
        const y = pdfHeader(doc, 'Attendance', `${label}, ${totalSessions} meeting${totalSessions === 1 ? '' : 's'} held across the 5 troops`);
        pdfTable(doc, {
          startY: y, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          head: [['Member ID', 'Member', 'Group', 'Present', 'Rate']], body: bodyRows.length ? bodyRows : [['', 'No data available', '', '', '']],
        });
        doc.save(pdfFilename('Attendance', label));
      } catch (err) {
        console.error('attendance report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    // The one report that ties everything together: opening balance,
    // today's running balance, the latest reconciliation (bank vs. system,
    // and when it was last done), net income for the selected period, and
    // the full by-group breakdown — one document instead of piecing it
    // together from the Finance tab.
    async function downloadFullAccountingReport() {
      try {
        await ensureOrgSettings();
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const [allEntriesRes, periodEntriesRes, lastRecRes] = await Promise.all([
          db.from('finance_entries').select('entry_type, amount, entry_date'),
          db.from('finance_entries').select('group_key, entry_type, category, amount').gte('entry_date', start).lte('entry_date', end),
          db.from('finance_reconciliations').select('*').order('as_of_date', { ascending: false }).limit(1).maybeSingle(),
        ]);
        if (allEntriesRes.error) throw allEntriesRes.error;
        const allRows = allEntriesRes.data || [];
        const opening = Number(state.settings?.opening_balance || 0);
        const running = opening + allRows.reduce((s: number, r: any) => s + signedAmount(r), 0);
        const lastRec = lastRecRes.data;
        const actualBalance = lastRec
          ? Number(lastRec.statement_balance) + allRows.filter((r: any) => r.entry_date > lastRec.as_of_date).reduce((s: number, r: any) => s + signedAmount(r), 0)
          : running;

        const periodRows = periodEntriesRes.data || [];

        // A full Income Statement (categories, not just a group total) for
        // one set of rows — reused for every group's own page, and once
        // more for the whole organization combined.
        const renderIncomeStatement = (doc: any, title: string, rows: any[]) => {
          doc.setFont('helvetica', 'bold'); doc.setFontSize(15); doc.setTextColor(...PDF_BRAND);
          doc.text(title, 14, 20);
          doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 90, 90);
          doc.text(label, 14, 27);
          doc.setDrawColor(...PDF_BRAND); doc.setLineWidth(0.4);
          doc.line(14, 31, 196, 31);

          const byCategory = (type: string) => {
            const map = new Map<string, number>();
            rows.filter((r: any) => r.entry_type === type).forEach((r: any) => {
              const cat = r.category || 'Uncategorized';
              map.set(cat, (map.get(cat) || 0) + Number(r.amount));
            });
            return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
          };
          const incomeRows = byCategory('income'), expenseRows = byCategory('expense');
          const income = incomeRows.reduce((s, [, v]) => s + v, 0);
          const expense = expenseRows.reduce((s, [, v]) => s + v, 0);
          const tableOpts = {
            theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
            footStyles: { fillColor: PDF_FOOT_BG, textColor: PDF_BRAND, fontStyle: 'bold' },
            columnStyles: { 1: { halign: 'right' } },
          };
          let sy = 38;
          pdfTable(doc, {
            ...tableOpts, startY: sy, head: [['Income', '']],
            body: incomeRows.length ? incomeRows.map(([c, v]) => [c, fmt(v)]) : [['No data', '']],
            foot: [['Total Income', fmt(income)]],
          });
          sy = pdfNextY(doc, sy);
          pdfTable(doc, {
            ...tableOpts, startY: sy, head: [['Expenses', '']],
            body: expenseRows.length ? expenseRows.map(([c, v]) => [c, fmt(v)]) : [['No data', '']],
            foot: [['Total Expenses', fmt(expense)]],
          });
          sy = pdfNextY(doc, sy);
          doc.setFont('helvetica', 'bold'); doc.setFontSize(13); doc.setTextColor(...PDF_ACCENT);
          doc.text(`Net Income: ${fmt(income - expense)}`, 14, sy);
        };

        const doc = new jsPDF();
        let y = pdfHeader(doc, 'Full Accounting Report', `${label} · generated ${new Date().toLocaleString()}`);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(90, 90, 90);
        const introLines = doc.splitTextToSize(
          `Summary below is where things stand right now, as of today, followed by a quick Net Income by Group table for ${label}. After that, a full Net Income Statement, one page per group, ending with one combined statement for the whole scout group.`,
          182,
        );
        doc.text(introLines, 14, y);
        y += introLines.length * 4.2 + 6;

        doc.setFont('helvetica', 'bold'); doc.setFontSize(12); doc.setTextColor(...PDF_BRAND);
        doc.text('Summary', 14, y);
        pdfTable(doc, {
          startY: y + 4, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9, cellPadding: 2.5 },
          columnStyles: { 0: { fontStyle: 'bold', cellWidth: 44 }, 1: { cellWidth: 100 }, 2: { halign: 'right', fontStyle: 'bold', cellWidth: 38 } },
          head: [['', 'What this means', 'Amount']],
          body: [
            ['Opening Balance', `The starting balance before any recorded transaction, set as of ${state.settings?.opening_balance_date || '—'}.`, fmt(opening)],
            ['Running Balance', "Opening balance plus every transaction ever logged, across every group. The system's live total.", fmt(running)],
            ['Actual Running Balance', 'The last confirmed bank balance, carried forward by everything logged since. Grounded in a real bank check.', fmt(actualBalance)],
            ['Last Reconciled', 'The most recent date the books were checked against the real bank statement.', lastRec ? lastRec.as_of_date : 'Never reconciled'],
            ['Bank Balance', 'What the bank statement actually showed, as of the last reconciliation.', lastRec ? fmt(lastRec.statement_balance) : '—'],
            ['System Balance', 'What our own records showed on that same date, before any correction.', lastRec ? fmt(lastRec.system_balance) : '—'],
            ['Adjustment Posted', "The correcting entry made to true the two up, if the balances didn't already match.", lastRec && lastRec.adjustment_entry_id ? fmt(lastRec.difference) : (lastRec ? 'None needed, already matched' : '—')],
          ],
        });

        y = pdfNextY(doc, y);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(12); doc.setTextColor(...PDF_BRAND);
        doc.text(`Net Income by Group, ${label}`, 14, y);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); doc.setTextColor(120, 120, 120);
        doc.text('At a glance, the full statement for each one follows on its own page.', 14, y + 5);
        const periodIncome = periodRows.filter((r: any) => r.entry_type === 'income').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const periodExpense = periodRows.filter((r: any) => r.entry_type === 'expense').reduce((s: number, r: any) => s + Number(r.amount), 0);
        const byGroup = new Map<string, { income: number; expense: number }>();
        GROUPS.forEach((g) => byGroup.set(g.key, { income: 0, expense: 0 }));
        periodRows.forEach((r: any) => {
          const b = byGroup.get(r.group_key); if (!b) return;
          if (r.entry_type === 'income') b.income += Number(r.amount); else b.expense += Number(r.amount);
        });
        pdfTable(doc, {
          startY: y + 9, theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 10 },
          footStyles: { fillColor: PDF_FOOT_BG, textColor: PDF_BRAND, fontStyle: 'bold' },
          columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
          head: [['Group', 'Income', 'Expenses', 'Net']],
          body: GROUPS.map((g) => {
            const b = byGroup.get(g.key)!;
            return [g.en, fmt(b.income), fmt(b.expense), fmt(b.income - b.expense)];
          }),
          foot: [['All Groups Combined', fmt(periodIncome), fmt(periodExpense), fmt(periodIncome - periodExpense)]],
        });

        // One full Income Statement per group, each starting on its own
        // page, then one more combining every group for the whole
        // organization, also its own page.
        GROUPS.forEach((g) => {
          doc.addPage();
          renderIncomeStatement(doc, `Net Income Statement, ${g.en}`, periodRows.filter((r: any) => r.group_key === g.key));
        });
        doc.addPage();
        renderIncomeStatement(doc, 'Net Income Statement, Whole Scout Group', periodRows);

        doc.save(pdfFilename('Full-Accounting-Report', label));
      } catch (err) {
        console.error('full accounting report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    async function downloadCurriculumReport() {
      try {
        const { start, end, label } = periodRange(els.reportMonth, els.reportYear);
        const troopKeys = TROOP_GROUPS.map((g) => g.key);
        const { data, error } = await db.from('curriculum_meetings').select('group_key, date, theme, notes, materials_needed, activities, actual_notes')
          .in('group_key', troopKeys).gte('date', start).lte('date', end).order('date', { ascending: true });
        if (error) throw error;
        const rows = data || [];
        const meetingRows = (groupRows: any[]) => groupRows
          .filter((m: any) => (m.activities && m.activities.length) || m.theme || m.notes || m.materials_needed)
          .map((m: any) => {
            const d = new Date(m.date + 'T00:00:00');
            const dateLabel = `${WEEKDAYS[d.getDay()].en} ${d.getDate()} ${MONTHS[d.getMonth()].en} ${d.getFullYear()}`;
            const activities = m.activities || [];
            const activitiesText = activities.map((a: any) => a.en + (a.duration ? ` (${a.duration} min)` : '')).join('\n');
            // Only meaningful once the date has passed — a future meeting's
            // activities are never marked done, same gate as the checkbox
            // itself in the Leaders Workspace (see currActivityRowHTML).
            const donePast = activities.length && m.date <= todayStr();
            const doneLabel = donePast ? `${activities.filter((a: any) => a.done).length}/${activities.length}` : '—';
            return [dateLabel, m.theme || '—', activitiesText || '—', doneLabel, m.materials_needed || '—', m.notes || '—', m.actual_notes || '—'];
          });
        const tableOpts = {
          theme: 'grid', headStyles: { fillColor: PDF_BRAND }, styles: { fontSize: 9, valign: 'top' },
          columnStyles: { 0: { cellWidth: 26 }, 1: { cellWidth: 28 }, 3: { cellWidth: 14, halign: 'center' } },
          head: [['Date', 'Theme', 'Activities', 'Done', 'Materials Needed', 'Notes', 'Actual Notes']],
        };

        const doc = new jsPDF();
        TROOP_GROUPS.forEach((g, i) => {
          let y: number;
          if (i === 0) {
            y = pdfHeader(doc, 'Curriculum', label);
            doc.setFont('helvetica', 'bold'); doc.setFontSize(12); doc.setTextColor(...PDF_BRAND);
            doc.text(g.en, 14, y);
            y += 6;
          } else {
            doc.addPage();
            doc.setFont('helvetica', 'bold'); doc.setFontSize(15); doc.setTextColor(...PDF_BRAND);
            doc.text(g.en, 14, 20);
            doc.setDrawColor(...PDF_BRAND); doc.setLineWidth(0.4);
            doc.line(14, 24, 196, 24);
            y = 31;
          }
