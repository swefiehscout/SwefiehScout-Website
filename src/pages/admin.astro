    }
    function pdfFilename(title: string, label: string): string {
      return `All-Groups-${title}-${label}`.replace(/[^a-z0-9]+/gi, '-').toLowerCase().replace(/^-+|-+$/g, '') + '.pdf';
    }
    function pdfNextY(doc: any, fallback: number): number {
      return (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 10 : fallback;
    }
    // English-only, everywhere in the console — same reasoning as the
    // Leaders Workspace's own bindEnglishOnlyInputs(): Arabic typed into
    // a free-text field is exactly what was turning into mojibake in
    // PDF exports, so it's stripped at entry time instead.
    function bindEnglishOnlyInputs() {
      document.addEventListener('input', (e: any) => {
        const t = e.target;
        if (!(t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)) return;
        if (t instanceof HTMLInputElement && !['text', 'search', 'tel', 'email', 'url', ''].includes(t.type)) return;
        const filtered = t.value.replace(/[^\x00-\x7F]/g, '');
        if (filtered === t.value) return;
        const pos = t.selectionStart ?? t.value.length;
        const posInFiltered = t.value.slice(0, pos).replace(/[^\x00-\x7F]/g, '').length;
        t.value = filtered;
        t.setSelectionRange(posInFiltered, posInFiltered);
      });
    }
    // jsPDF's built-in fonts (Helvetica etc.) can only draw Latin-1 —
    // Arabic, emoji, or anything else outside that range comes out as
    // full mojibake, not just a missing glyph; "smart" typographic
    // characters iOS/Mac autocorrect loves to substitute (curly quotes,
    // en/em dashes, ellipsis) do have a real ASCII equivalent worth
    // keeping, so those get normalized first. Applied to every cell, in
    // every report, rather than chasing down whichever field trips it —
    // Arabic content itself is unaffected anywhere else in the app,
    // this only touches what a PDF cell can actually render.
    function pdfSafe(s: any): any {
      if (typeof s !== 'string') return s;
      return s
        .replace(/[‘’]/g, "'")
        .replace(/[“”]/g, '"')
        .replace(/[–—]/g, '-')
        .replace(/…/g, '...')
        .replace(/[^\x00-\xFF]/g, '')
        .trim();
    }
    function pdfTable(doc: any, opts: any) {
      const clean = (arr: any) => Array.isArray(arr) ? arr.map((row: any) => Array.isArray(row) ? row.map(pdfSafe) : pdfSafe(row)) : arr;
      if (opts.head) opts.head = clean(opts.head);
      if (opts.body) opts.body = clean(opts.body);
      if (opts.foot) opts.foot = clean(opts.foot);
      // A wrapped cell (long notes, an activities list, ...) otherwise
      // gets physically cut at the page boundary — the rest of that
      // row's own cells continuing on the next page instead of the
      // whole row moving down together. Every report gets this by
      // default; an explicit rowPageBreak in opts still wins.
      if (opts.rowPageBreak === undefined) opts.rowPageBreak = 'avoid';
      return autoTable(doc, opts);
    }

