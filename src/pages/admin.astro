    function renderRoster() {
      const groupFilter = els.rosterGroup.value;
      const statusFilter = els.rosterStatus.value;
      let rows = state.ovMembers;
      if (groupFilter) rows = rows.filter((m: any) => m.group_key === groupFilter);
      if (statusFilter === 'active') rows = rows.filter((m: any) => m.active);
      else if (statusFilter === 'archived') rows = rows.filter((m: any) => !m.active);
      if (!rows.length) { els.rosterBody.innerHTML = '<tr><td colspan="13" class="ws-empty">No members match these filters.</td></tr>'; return; }
      els.rosterBody.innerHTML = rows.map((m: any) => {
        const g = GROUPS.find((x) => x.key === m.group_key);
        return `
          <tr>
            <td data-label="Member ID">${escapeHtml(m.member_code || '—')}</td>
            <td data-label="Name">${escapeHtml(m.full_name)}</td>
            <td data-label="Group">${escapeHtml(g ? g.en : m.group_key)}</td>
            <td data-label="Phone">${escapeHtml(m.phone || '—')}</td>
            <td data-label="Email">${escapeHtml(m.email || '—')}</td>
            <td data-label="National ID">${escapeHtml(m.national_id || '—')}</td>
            <td data-label="DOB">${escapeHtml(m.birth_date || '—')}</td>
            <td data-label="Emergency Contact 1">${m.guardian1_relation ? `${escapeHtml(m.guardian1_relation)}: ${escapeHtml(m.guardian1_phone || '—')}` : '—'}</td>
            <td data-label="Emergency Contact 2">${m.guardian2_relation ? `${escapeHtml(m.guardian2_relation)}: ${escapeHtml(m.guardian2_phone || '—')}` : '—'}</td>
            <td data-label="Allergies">${m.has_allergies
                ? `<span class="ws-allergy-badge">${m.allergy_detail ? escapeHtml(m.allergy_detail) : 'Yes'}</span>`
                : '—'}</td>
            <td data-label="Notes">${escapeHtml(m.notes || '—')}</td>
            <td data-label="Status">${m.active ? 'Active' : (m.archived_reason === 'inactive' ? 'Auto-archived' : 'Archived')}</td>
