        });
        doc.save(pdfFilename('Curriculum', label));
      } catch (err) {
        console.error('curriculum report failed', err);
        showToast('Could not generate the report, check your connection and try again.');
      }
    }
    function bindReports() {
      populatePeriodSelects(els.reportMonth, els.reportYear, true);
      el('[data-report-full]').addEventListener('click', downloadFullAccountingReport);
