---
// Admin console — the single control tower for the whole org: org-wide
// oversight across every group, the accounting layer on top of the
// Leaders Workspace's finance_entries (opening balance, running/cleared
// balance across every group combined, bank reconciliation, ad-hoc
// transactions), and approving who gets into the Leaders Workspace and
// which groups (Music included — see MUSIC_GROUP_KEY). Gated by the
// single org admin flag (profiles.role = 'admin'). No separate login
// screen — signs in through the same Supabase session as /leaders, and
// a non-admin lands on a plain "not authorized" message instead of a
// pending-approval flow, since admin isn't something you apply for here.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { workspaceMarqueePhotos } from '../lib/scenic-photos';

const dashMarqueePhotos = [...workspaceMarqueePhotos, ...workspaceMarqueePhotos];
---
<BaseLayout title="Admin" bare wide>
  <div class="ws-shell" data-ws-shell hidden>

    <section class="ws-pending" data-ws-denied hidden>
      <div class="ws-pending-card">
        <h2 class="section-h2">Admin access only</h2>
        <p class="ws-pending-text">
          This console is for org admins. If that should be you, ask an existing admin to set your
          role to Admin from here (People tab), from the Leaders Workspace, not this page.
        </p>
        <div class="ws-pending-actions">
          <a class="btn-primary" href="/leaders">Go to Leaders Workspace</a>
          <button type="button" class="curr-nav-today" data-ws-signout-denied>Sign out</button>
        </div>
      </div>
    </section>

    <div class="ws-main" data-ws-main hidden>
      <header class="ws-header">
        <div class="ws-header-left">
          <img class="ws-logo-mark" src="/images/logo.png" alt="" />
          <span class="ws-logo">Admin</span>
        </div>
        <div class="ws-header-right">
          <a class="ws-guide-link" href="/leaders" title="Leaders Workspace">
            <Icon name="compass" size={14} strokeWidth={1.8} /> Leaders Workspace
          </a>
          <div class="ws-account">
            <button type="button" class="ws-account-btn" data-ws-account-btn></button>
            <div class="ws-account-menu" data-ws-account-menu hidden>
              <div class="ws-account-info" data-ws-who></div>
              <button type="button" class="ws-account-signout" data-ws-signout>Sign out</button>
            </div>
          </div>
        </div>
      </header>

      <nav class="ws-tabs" data-ws-tabs>
        <button type="button" class="ws-tab" data-tab="overview"><Icon name="compass" size={16} strokeWidth={1.8} /> Overview</button>
        <button type="button" class="ws-tab" data-tab="finance"><Icon name="bank" size={16} strokeWidth={1.8} /> Finance</button>
        <button type="button" class="ws-tab" data-tab="reports"><Icon name="envelope" size={16} strokeWidth={1.8} /> Reports</button>
        <button type="button" class="ws-tab" data-tab="curriculum"><Icon name="flag" size={16} strokeWidth={1.8} /> Curriculum</button>
        <button type="button" class="ws-tab" data-tab="roster"><Icon name="star" size={16} strokeWidth={1.8} /> Roster</button>
        <button type="button" class="ws-tab" data-tab="people"><Icon name="pin" size={16} strokeWidth={1.8} /> People</button>
      </nav>

      <div class="ws-panels">
        <!-- ================= Overview (the 5 troops) ================= -->
        <section class="ws-panel" data-panel="overview">
          <div class="ws-dash" data-dash-root>
            <p class="ws-att-hint">The 5 troops together, the same numbers each group's own Dashboard shows, rolled up troop-wide. Music and General aren't scouting troops, their own rosters live on their group pages (and on the Roster tab here too), and their money lives on the Finance tab instead, alongside the full accounting picture.</p>

            <div class="band-marquee ws-dash-marquee" aria-label="Troop photos">
              <div class="band-marquee-track" style={`--n: ${workspaceMarqueePhotos.length}`}>
                {dashMarqueePhotos.map((src, i) => (
                  <div class="band-marquee-slide">
                    <img src={src} alt="" loading="lazy" aria-hidden={i >= workspaceMarqueePhotos.length} />
                  </div>
                ))}
              </div>
              <div class="band-marquee-fade band-marquee-fade--start" aria-hidden="true"></div>
              <div class="band-marquee-fade band-marquee-fade--end" aria-hidden="true"></div>
            </div>

            <div class="ws-dash-kpis" data-ov-kpis></div>
            <div class="ws-stat-row ws-stat-row--3" data-ov-ratios></div>

            <div class="ws-dash-grid ws-dash-grid--2">
              <div class="ws-dash-card">
                <div class="ws-dash-card-head"><h3>Active members by group</h3></div>
                <div data-ov-members-chart></div>
              </div>
              <div class="ws-dash-card">
                <div class="ws-dash-card-head"><h3>Fee collection by group</h3></div>
                <div data-ov-fees-chart></div>
              </div>
            </div>

            <div class="ws-dash-card ws-dash-card--full">
              <div class="ws-dash-card-head"><h3>By group</h3></div>
              <div class="ws-table-wrap">
                <table class="ws-table" data-ov-table>
                  <thead><tr><th>Group</th><th>Active</th><th>% of Troop</th><th>Attendance (30d)</th><th>Fees Collected</th><th>Net Income</th></tr></thead>
                  <tbody data-ov-body></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- ================= Finance (the accounting system) ================= -->
        <section class="ws-panel" data-panel="finance" hidden>
          <p class="ws-att-hint">One accounting system across every group, the 5 troops' own Finance ledgers, plus Music's and General's. Nothing here duplicates a group's own Finance tab; it reads the same finance_entries every group already writes to.</p>

          <div class="ws-subtabs">
            <button type="button" class="ws-subtab ws-subtab--active" data-subtabs="finance" data-subtab="balances">Balances</button>
            <button type="button" class="ws-subtab" data-subtabs="finance" data-subtab="ledger">Ledger</button>
            <button type="button" class="ws-subtab" data-subtabs="finance" data-subtab="reconcile">Reconcile</button>
            <button type="button" class="ws-subtab" data-subtabs="finance" data-subtab="adjustments">Adjustments</button>
          </div>

          <div data-subpanel="finance:balances">
            <div class="ws-dash-kpis" data-fin-kpis style="margin-bottom: 1.75rem"></div>

            <div class="ws-member-form">
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Opening balance</p>
              <div class="ws-form-grid">
                <label class="ws-field"><span>Amount</span><input type="number" step="0.01" data-open-amount /></label>
                <label class="ws-field"><span>As of date</span><input type="date" data-open-date /></label>
              </div>
              <div class="ws-form-actions"><button type="button" class="btn-primary" data-open-save>Save</button></div>
            </div>
          </div>

          <div data-subpanel="finance:ledger" hidden>
            <form class="ws-member-form" data-tx-form>
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Add a transaction</p>
              <div class="ws-form-grid ws-form-grid--4">
                <label class="ws-field"><span>Group *</span><select data-tx-group required></select></label>
                <label class="ws-field">
                  <span>Type *</span>
                  <select data-tx-type required>
                    <option value="expense" selected>Expense</option>
                    <option value="income">Income</option>
                  </select>
                </label>
                <label class="ws-field"><span>Category *</span><select data-tx-category required></select></label>
                <label class="ws-field"><span>Amount *</span><input type="number" step="0.01" min="0" data-tx-amount required /></label>
              </div>
              <div class="ws-form-grid">
                <label class="ws-field"><span>Date *</span><input type="date" data-tx-date required /></label>
                <label class="ws-field ws-field--full"><span>Description *</span><input type="text" data-tx-description required /></label>
              </div>
              <div class="ws-form-actions"><button type="submit" class="btn-primary" data-tx-submit>Add entry</button></div>
            </form>

            <div class="ws-toolbar-row">
              <label class="ws-field ws-field--inline"><span>Month</span><select data-fin-month></select></label>
              <label class="ws-field ws-field--inline"><span>Year</span><select data-fin-year></select></label>
            </div>
            <div class="ws-stat-row ws-stat-row--3" data-fin-stats></div>

            <h3 class="ws-admin-h3">By group</h3>
            <div class="ws-table-wrap">
              <table class="ws-table" data-fin-group-table>
                <thead><tr><th>Group</th><th>Income</th><th>Expenses</th><th>Net</th></tr></thead>
                <tbody data-fin-group-body></tbody>
              </table>
            </div>

            <h3 class="ws-admin-h3">Every transaction</h3>
            <div class="ws-table-wrap">
              <table class="ws-table" data-fin-table>
                <thead><tr><th>Date</th><th>Group</th><th>Type</th><th>Category</th><th>Description</th><th>Amount</th><th>Added by</th></tr></thead>
                <tbody data-fin-body></tbody>
              </table>
            </div>
          </div>

          <div data-subpanel="finance:reconcile" hidden>
            <p class="ws-att-hint">Not every entry ever hits the bank the same way, some are cash, some sit in a group's own hands for a while, so this doesn't tick off individual transactions. It just compares what the system says the balance is, as of a date, against the real bank balance. A mismatch gets posted as a single adjustment entry (attributed to whichever group it belongs to) so the two line back up.</p>
            <div class="ws-toolbar-row">
              <label class="ws-field ws-field--inline"><span>As of</span><input type="date" data-rec-asof /></label>
              <label class="ws-field ws-field--inline"><span>Actual bank balance</span><input type="number" step="0.01" data-rec-bank placeholder="0.00" /></label>
              <button type="button" class="btn-primary" data-rec-load>Compare</button>
            </div>
            <div class="ws-stat-row ws-stat-row--3" data-rec-stats></div>

            <div class="ws-member-form" data-rec-adjust-block hidden>
              <div class="ws-member-form-bar" aria-hidden="true"></div>
              <p class="ws-member-form-title">Post an adjustment for the difference</p>
              <div class="ws-form-grid">
                <label class="ws-field"><span>Belongs to group *</span><select data-rec-adjust-group required></select></label>
                <label class="ws-field ws-field--full"><span>Note</span><input type="text" data-rec-adjust-note placeholder="e.g. cash on hand not yet deposited" /></label>
              </div>
              <div class="ws-form-actions">
                <button type="button" class="btn-primary" data-rec-save>Post adjustment &amp; save</button>
              </div>
            </div>
            <div class="ws-form-actions" data-rec-match-block hidden>
              <button type="button" class="btn-primary" data-rec-save-match>Save reconciliation, balances match</button>
            </div>

            <h3 class="ws-admin-h3">Reconciliation history</h3>
            <p class="ws-att-hint">One row every time you check, even when nothing needed fixing. Proof of when you last looked, and what you found.</p>
            <div class="ws-table-wrap">
              <table class="ws-table" data-rec-history-table>
                <thead><tr><th>As of</th><th>Bank Balance</th><th>System Balance</th><th>Adjustment</th><th>Saved</th><th>By</th></tr></thead>
                <tbody data-rec-history-body></tbody>
              </table>
            </div>
          </div>

          <div data-subpanel="finance:adjustments" hidden>
            <h3 class="ws-admin-h3">Adjustment entries</h3>
            <p class="ws-att-hint">Only the actual correcting transactions, a check on the Reconcile tab only adds a row here when the balances didn't already match. These are real ledger entries (they affect that group's own balance too), pulled out here as a focused audit trail.</p>
            <div class="ws-table-wrap">
              <table class="ws-table" data-adj-table>
                <thead><tr><th>Date</th><th>Group</th><th>Type</th><th>Amount</th><th>Note</th><th>Posted by</th></tr></thead>
                <tbody data-adj-body></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= Reports ================= -->
        <section class="ws-panel" data-panel="reports" hidden>
          <p class="ws-att-hint">Same reports as each group's own Reports tab, except every group is combined into one PDF. The Full Accounting Report already covers income and expenses in full detail; Fees and Attendance stay troop-only (Music and General have neither).</p>
          <div class="ws-toolbar-row">
            <label class="ws-field ws-field--inline"><span>Month</span><select data-report-month></select></label>
            <label class="ws-field ws-field--inline"><span>Year</span><select data-report-year></select></label>
          </div>
          <div class="ws-report-grid">
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Full Accounting Report</h3>
              <p class="ws-report-desc">Everything in one document: opening &amp; running balance, the latest bank reconciliation (bank vs. system, and when), net income, and the full by-group breakdown.</p>
              <button type="button" class="btn-primary" data-report-full>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Monthly Fees</h3>
              <p class="ws-report-desc">Every active member across the 5 troops, with their group, paid status, and amount.</p>
              <button type="button" class="btn-primary" data-report-fees>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Attendance</h3>
              <p class="ws-report-desc">Every active member across the 5 troops, with their group, attendance count, and rate.</p>
              <button type="button" class="btn-primary" data-report-attendance>Download PDF</button>
            </div>
            <div class="ws-report-card">
              <h3 class="ws-admin-h3">Curriculum</h3>
              <p class="ws-report-desc">Every troop's meeting plan for the period, one page per group.</p>
              <button type="button" class="btn-primary" data-report-curriculum>Download PDF</button>
            </div>
          </div>
        </section>

        <!-- ================= Curriculum ================= -->
        <section class="ws-panel" data-panel="curriculum" hidden>
          <p class="ws-att-hint">Every troop's next planned meeting, at a glance.</p>
          <div class="ws-table-wrap">
            <table class="ws-table" data-curr-table>
              <thead><tr><th>Group</th><th>Next Meeting</th><th>Theme</th><th>Activities</th></tr></thead>
              <tbody data-curr-body></tbody>
            </table>
          </div>
        </section>

        <!-- ================= Roster ================= -->
        <section class="ws-panel" data-panel="roster" hidden>
          <p class="ws-att-hint">Every group's roster together, including Music and General, filter down to what you need.</p>
          <div class="ws-toolbar-row">
            <label class="ws-field ws-field--inline">
              <span>Group</span>
              <select data-roster-group><option value="">All Groups</option></select>
            </label>
            <label class="ws-field ws-field--inline">
              <span>Status</span>
              <select data-roster-status>
                <option value="active" selected>Active</option>
                <option value="archived">Archived</option>
                <option value="all">All</option>
              </select>
            </label>
          </div>
          <input type="search" class="ws-search" data-roster-search placeholder="Search members…" />
          <div class="ws-table-wrap">
            <table class="ws-table" data-roster-table>
              <thead><tr><th>Name</th><th>Group</th><th>Phone</th><th>Emergency Contact</th><th>Allergies</th><th>Status</th></tr></thead>
              <tbody data-roster-body></tbody>
            </table>
          </div>
        </section>

        <!-- ================= People ================= -->
        <section class="ws-panel" data-panel="people" hidden>
          <p class="ws-att-hint">Approve who gets into the Leaders Workspace and which groups they can access, Music and General included, same as any troop. Admin is the one flag that also grants full access here and to the accounting system on the Finance tab.</p>
          <h3 class="ws-admin-h3">People</h3>
          <div class="ws-table-wrap">
            <table class="ws-table" data-people-table>
              <thead><tr><th>Name</th><th>Role</th><th>Groups</th><th></th></tr></thead>
              <tbody data-people-body></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script>
    import {
      supabase, supabaseConfigured, getSession, isSessionExpired, msUntilSessionExpiry, signOut,
    } from '../lib/workspace/auth';
    import jsPDF from 'jspdf';
    import autoTable from 'jspdf-autotable';
    import { GROUPS, TROOP_GROUPS, MONTHS, WEEKDAYS, MUSIC_GROUP_KEY, GENERAL_GROUP_KEY } from '../lib/curriculum/constants';

    const db: any = supabase;

    const state: any = {
      session: null,
      profile: null,
      isAdmin: false,
      activeTab: 'overview',
      settings: null,
      ovMembers: [],
      recSystemBalance: 0,
      recDiff: null,
    };
    const els: any = {};

    function el(sel: string): any { return document.querySelector(sel); }
    function escapeHtml(s: any) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]
      ));
    }
    let toastTimer: any;
    function showToast(msg: any) {
      let t = document.querySelector('.curr-toast');
      if (!t) { t = document.createElement('div'); t.className = 'curr-toast'; document.body.appendChild(t); }
      t.textContent = msg;
      t.classList.add('curr-toast--show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.remove('curr-toast--show'), 3500);
    }
    function todayStr() {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }
    function parseDateStr(s: string) {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function bindTableSearch(input: any, tbody: any) {
      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        tbody.querySelectorAll('tr').forEach((row: any) => {
          row.hidden = !!term && !row.textContent.toLowerCase().includes(term);
        });
      });
    }
    function dashDeltaBadge(val: number | null, suffix = ''): string {
      if (val == null || Number.isNaN(val) || val === 0) {
        return `<span class="ws-dash-delta ws-dash-delta--flat">– steady</span>`;
      }
      const up = val > 0;
      return `<span class="ws-dash-delta ${up ? 'ws-dash-delta--up' : 'ws-dash-delta--down'}">${up ? '↑' : '↓'} ${Math.abs(val)}${suffix} vs last period</span>`;
    }
    function populatePeriodSelects(monthSel: any, yearSel: any, withYearOption = false) {
      if (monthSel.options.length) return;
      let opts = MONTHS.map((m, i) => `<option value="${String(i + 1).padStart(2, '0')}">${m.en}</option>`).join('');
      if (withYearOption) opts = `<option value="ALL">Whole Year</option>` + opts;
      monthSel.innerHTML = opts;
      const nowYear = new Date().getFullYear();
      const years: number[] = [];
      for (let y = nowYear - 3; y <= nowYear + 1; y++) years.push(y);
      yearSel.innerHTML = years.map((y) => `<option value="${y}">${y}</option>`).join('');
      const now = new Date();
      monthSel.value = String(now.getMonth() + 1).padStart(2, '0');
      yearSel.value = String(now.getFullYear());
    }
    function periodRange(monthSel: any, yearSel: any) {
      const year = Number(yearSel.value);
      if (monthSel.value === 'ALL') {
        return { start: `${year}-01-01`, end: `${year}-12-31`, label: String(year), period: String(year), isYear: true };
      }
      const month = monthSel.value;
      const period = `${year}-${month}`;
      const lastDay = new Date(year, Number(month), 0).getDate();
      const label = `${monthSel.selectedOptions[0]?.textContent} ${year}`;
      return { start: `${period}-01`, end: `${period}-${String(lastDay).padStart(2, '0')}`, label, period, isYear: false };
    }
    function signedAmount(e: any) { return e.entry_type === 'income' ? Number(e.amount) : -Number(e.amount); }
    function fmt(n: number) { return Number(n || 0).toFixed(2); }

    // ---------- PDF helpers (simplified — always "All Groups", no active
    // group concept here like the per-group Reports tab has) -------------
    const PDF_BRAND: [number, number, number] = [87, 22, 7];
    const PDF_ACCENT: [number, number, number] = [20, 56, 34];
    const PDF_FOOT_BG: [number, number, number] = [250, 243, 232];
    function pdfHeader(doc: any, title: string, rangeLabel: string): number {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9);
      doc.setTextColor(...PDF_BRAND);
      doc.text('GREEK ORTHODOX SCOUTS & GUIDES, SWEFIEH', 14, 15);
      doc.setFontSize(17);
      doc.text(`All Groups, ${title}`, 14, 25);
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.setTextColor(90, 90, 90);
      doc.text(rangeLabel, 14, 32);
      doc.setDrawColor(...PDF_BRAND);
      doc.setLineWidth(0.6);
      doc.line(14, 36, 196, 36);
      doc.setFontSize(8);
      doc.setTextColor(150, 150, 150);
      doc.text(`Generated by ${state.profile?.name || ''} on ${new Date().toLocaleDateString()}`, 14, 41);
      return 48;
    }
    function pdfFilename(title: string, label: string): string {
      return `All-Groups-${title}-${label}`.replace(/[^a-z0-9]+/gi, '-').toLowerCase().replace(/^-+|-+$/g, '') + '.pdf';
    }
    function pdfNextY(doc: any, fallback: number): number {
      return (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 10 : fallback;
    }

    function cacheEls() {
      els.shell = el('[data-ws-shell]');
      els.denied = el('[data-ws-denied]');
      els.main = el('[data-ws-main]');
      els.accountBtn = el('[data-ws-account-btn]');
      els.accountMenu = el('[data-ws-account-menu]');
      els.who = el('[data-ws-who]');
      els.signout = el('[data-ws-signout]');
      els.signoutDenied = el('[data-ws-signout-denied]');
      els.tabs = el('[data-ws-tabs]');

      els.ovKpis = el('[data-ov-kpis]');
      els.ovRatios = el('[data-ov-ratios]');
      els.ovMembersChart = el('[data-ov-members-chart]');
      els.ovFeesChart = el('[data-ov-fees-chart]');
      els.ovBody = el('[data-ov-body]');

      els.finKpis = el('[data-fin-kpis]');
      els.openAmount = el('[data-open-amount]');
      els.openDate = el('[data-open-date]');
      els.openSave = el('[data-open-save]');
      els.txForm = el('[data-tx-form]');
      els.txGroup = el('[data-tx-group]');
      els.txType = el('[data-tx-type]');
      els.txCategory = el('[data-tx-category]');
      els.txAmount = el('[data-tx-amount]');
      els.txDate = el('[data-tx-date]');
      els.txDescription = el('[data-tx-description]');
      els.txSubmit = el('[data-tx-submit]');
      els.finMonth = el('[data-fin-month]');
      els.finYear = el('[data-fin-year]');
      els.finStats = el('[data-fin-stats]');
      els.finGroupBody = el('[data-fin-group-body]');
      els.finBody = el('[data-fin-body]');

      els.recAsof = el('[data-rec-asof]');
      els.recBank = el('[data-rec-bank]');
      els.recLoad = el('[data-rec-load]');
      els.recStats = el('[data-rec-stats]');
      els.recAdjustBlock = el('[data-rec-adjust-block]');
      els.recAdjustGroup = el('[data-rec-adjust-group]');
      els.recAdjustNote = el('[data-rec-adjust-note]');
      els.recSave = el('[data-rec-save]');
      els.recMatchBlock = el('[data-rec-match-block]');
      els.recSaveMatch = el('[data-rec-save-match]');
      els.recHistoryBody = el('[data-rec-history-body]');
