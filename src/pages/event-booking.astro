---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Event Booking" pageTitle="Scout Band Booking Request">
  <p>
    Fill out the form to request the Orthodox Scout band for your event. We'll
    get back to you shortly to confirm details.
  </p>

  <form action="https://submit-form.com/NfRHHxGHu" method="POST" class="form-grid">
    <div class="form-row">
      <label for="name">Your Full Name</label>
      <input type="text" id="name" name="name" required />
    </div>
    <div class="form-row">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>
    <div class="form-row">
      <label for="phone">Phone Number</label>
      <input type="tel" id="phone" name="phone" required />
    </div>
    <div class="form-row">
      <label for="date">Event Date</label>
      <input type="date" id="date" name="date" required />
    </div>
    <div class="form-row">
      <label for="time">Event Time</label>
      <input type="time" id="time" name="time" required />
    </div>
    <div class="form-row">
      <label for="location">Event Location</label>
      <input type="text" id="location" name="location" required />
    </div>
    <div class="form-row">
      <label for="details">Additional Information</label>
      <textarea id="details" name="details"></textarea>
    </div>
    <div>
      <button type="submit" class="btn-primary">Request Booking</button>
    </div>
  </form>
</BaseLayout>
