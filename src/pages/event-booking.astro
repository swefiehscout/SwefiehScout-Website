---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { bandPhotos } from '../data/band-photos';

const marqueePhotos = [...bandPhotos, ...bandPhotos];

const features = [
  {
    icon: 'music',
    title: 'Drums & Bagpipes',
    titleAr: 'إيقاعات وألحان القِرب',
    blurb: 'Traditional bagpipes and classical scout percussion.',
  },
  {
    icon: 'pin',
    title: 'All Around Jordan',
    titleAr: 'في كل أرجاء الأردن',
    blurb: 'Weddings, churches, and community events. Wherever you need us.',
  },
  {
    icon: 'star',
    title: 'Trained Performers',
    titleAr: 'موسيقيون مدرَّبون',
    blurb: 'From our youngest scouts to our seniors, disciplined and rehearsed.',
  },
  {
    icon: 'fleur',
    title: 'Heritage & Tradition',
    titleAr: 'إرث وتقاليد',
    blurb: 'A band rooted in Orthodox heritage and Arab scouting tradition.',
  },
] as const;
---
<BaseLayout title="Event Booking" bare wide>
  <section class="page-hero" data-animate>
    <h1 class="page-h1">
      Book the Scout Band
      <span class="page-h1-ar">حجز الفرقة الموسيقية</span>
    </h1>
    <p class="page-tag">
      Invite our band to perform at your wedding, church celebration, or community event.
    </p>
    <p class="page-tag-ar">
      ادعُ فرقتنا الكشفية لإحياء حفل زفافك، مناسبتك الكنسية، أو فعاليتك المجتمعية.
    </p>
  </section>

  <section class="band-marquee" aria-label="Photos of the band" data-animate>
    <div class="band-marquee-track" style={`--n: ${bandPhotos.length}`}>
      {marqueePhotos.map((src, i) => (
        <div class="band-marquee-slide">
          <img src={src} alt="" loading="lazy" aria-hidden={i >= bandPhotos.length} />
        </div>
      ))}
    </div>
    <div class="band-marquee-fade band-marquee-fade--start" aria-hidden="true"></div>
    <div class="band-marquee-fade band-marquee-fade--end" aria-hidden="true"></div>
  </section>

  <section class="feature-grid">
    {features.map((f, i) => (
      <div class="feature-card" data-animate data-animate-delay={String(i + 1)}>
        <span class="feature-icon" aria-hidden="true"><Icon name={f.icon} size={22} /></span>
        <h3 class="feature-h3">{f.title}</h3>
        <p class="feature-h3-ar">{f.titleAr}</p>
        <p>{f.blurb}</p>
      </div>
    ))}
  </section>

  <a href="/event-booking/christmas-proposal" class="xmas-teaser" data-animate>
    <span class="xmas-teaser-star" aria-hidden="true">★</span>
    <span>
      <strong>Christmas Proposal</strong>
      <small>Bring the band to your venue this Christmas season</small>
    </span>
    <span class="xmas-teaser-go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
  </a>

  <div class="form-card form-card--solo" data-animate>
    <h2 class="form-h2">Booking Request</h2>
    <p class="form-h2-ar">طلب حجز</p>
    <p class="form-help">
      Fill out the form and we'll get back to you shortly to confirm the details.
    </p>
    <form action="https://formsubmit.co/8c4c29c5ea156dc946846467acb02d46" method="POST" class="form-grid" data-astro-reload>
      <input type="hidden" name="_cc" value="fzbatshon@gmail.com" />
      <input type="hidden" name="_subject" value="New band booking request" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="true" />
      <input type="hidden" name="_next" value="https://swefieh-orthodox-scout.com/thank-you" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      <div class="form-row">
        <label for="name">Your Full Name · الاسم الكامل</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div class="form-row">
        <label for="email">Email · البريد الإلكتروني</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div class="form-row">
        <label for="phone">Phone Number · رقم الهاتف</label>
        <input type="tel" id="phone" name="phone" required />
      </div>
      <div class="form-row">
        <label for="date">Event Date · تاريخ الفعالية</label>
        <input type="date" id="date" name="date" required />
      </div>
      <div class="form-row">
        <label for="time">Event Time · وقت الفعالية</label>
        <input type="time" id="time" name="time" required />
      </div>
      <div class="form-row">
        <label for="location">Event Location · موقع الفعالية</label>
        <input type="text" id="location" name="location" required />
      </div>
      <div class="form-row">
        <label for="details">Additional Information · معلومات إضافية</label>
        <textarea id="details" name="details"></textarea>
      </div>
      <div>
        <button type="submit" class="btn-primary">Request Booking</button>
      </div>
    </form>
  </div>
</BaseLayout>

<style>
  .xmas-teaser {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 720px;
    margin: 0 auto 2.5rem;
    padding: 1.1rem 1.4rem;
    border-radius: 18px;
    color: #fff;
    text-decoration: none;
    background:
      radial-gradient(circle at 10% 20%, rgba(232, 196, 106, 0.3), transparent 45%),
      linear-gradient(135deg, #143822, #0b2016 60%, #571607);
    box-shadow: 0 12px 28px -12px rgba(11, 32, 22, 0.6);
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }
  .xmas-teaser:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -12px rgba(11, 32, 22, 0.7);
    text-decoration: none;
  }
  .xmas-teaser strong { display: block; font-family: var(--font-display); font-size: 1.2rem; }
  .xmas-teaser small { display: block; color: rgba(255, 255, 255, 0.8); font-size: 0.9rem; }
  .xmas-teaser-star { font-size: 1.6rem; color: #e8c46a; text-shadow: 0 0 12px rgba(232, 196, 106, 0.8); }
  .xmas-teaser-go {
    margin-inline-start: auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: #e8c46a;
    color: #3a0f04;
  }
</style>
