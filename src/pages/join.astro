---
// Public member sign-up form — no login required. A parent/new member
// picks a group and fills in the same fields the leaders' Roster form
// uses; it lands in `join_requests` for a leader/admin of that group to
// approve (which creates the real roster member) or reject. English
// only, by request — unlike the rest of the public site, this form
// doesn't pair English/Arabic.
import BaseLayout from '../layouts/BaseLayout.astro';
import { JOINABLE_GROUPS } from '../lib/curriculum/constants';
---
<BaseLayout title="Join a Group" bare>
  <section class="page-hero" data-animate>
    <h1 class="page-h1">Join a Group</h1>
    <p class="page-tag">
      New here? Fill this in and a leader will approve you into the group.
    </p>
  </section>

  <div class="join-wrap" data-join-wrap>

    <!-- Step 1: pick a group -->
    <section class="portal-picker" data-join-step-group>
      <p class="portal-picker-label">Which group are you joining?</p>
      <div class="portal-picker-grid">
        {JOINABLE_GROUPS.map((g) => (
          <button type="button" class="portal-picker-btn" data-join-group={g.key}>
            <span class="portal-picker-en">{g.en}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Step 2: the form -->
    <section class="join-form-step" data-join-step-form hidden>
      <button type="button" class="ws-form-cancel" data-join-change-group>← Change group</button>

      <form class="ws-member-form" data-join-form>
        <div class="ws-member-form-bar" aria-hidden="true"></div>
        <p class="ws-member-form-title">Member details</p>

        <div class="ws-form-grid ws-form-grid--4">
          <label class="ws-field">
            <span>Full name *</span>
            <input type="text" data-j-name required />
          </label>
          <label class="ws-field">
            <span>Phone</span>
            <input type="tel" data-j-phone />
          </label>
          <label class="ws-field">
            <span>Date of birth</span>
            <input type="date" data-j-dob />
          </label>
          <label class="ws-field">
            <span>Emergency Contact Relationship 1</span>
            <select data-j-g1-rel>
              <option value="">Select…</option>
              <option>Mother</option>
              <option>Father</option>
              <option>Other</option>
            </select>
          </label>
        </div>

        <label class="ws-field ws-field--full">
          <span>Emergency Contact Phone 1</span>
          <input type="tel" data-j-g1-phone />
        </label>

        <div class="ws-form-grid">
          <div class="ws-optional-block" data-j-g2-block>
            <button type="button" class="ws-add-link" data-j-g2-add>+ Add second emergency contact</button>
            <div class="ws-optional-fields" data-j-g2-fields hidden>
              <div class="ws-form-grid">
                <label class="ws-field">
                  <span>Emergency Contact Relationship 2</span>
                  <select data-j-g2-rel>
                    <option value="">Select…</option>
                    <option>Mother</option>
                    <option>Father</option>
                    <option>Other</option>
                  </select>
                </label>
                <label class="ws-field">
                  <span>Emergency Contact Phone 2</span>
                  <input type="tel" data-j-g2-phone />
                </label>
              </div>
              <button type="button" class="ws-remove-link" data-j-g2-remove>Remove</button>
            </div>
          </div>

          <div class="ws-optional-block" data-j-allergy-block>
            <button type="button" class="ws-add-link" data-j-allergy-add>+ Add allergy info</button>
            <div class="ws-optional-fields" data-j-allergy-fields hidden>
              <label class="ws-field">
                <span>What allergy?</span>
                <input type="text" data-j-allergy-detail placeholder="e.g. peanuts" />
              </label>
              <button type="button" class="ws-remove-link" data-j-allergy-remove>Remove</button>
            </div>
          </div>

          <div class="ws-optional-block" data-j-email-block>
            <button type="button" class="ws-add-link" data-j-email-add>+ Add email</button>
            <div class="ws-optional-fields" data-j-email-fields hidden>
              <label class="ws-field">
                <span>Email</span>
                <input type="email" data-j-email />
              </label>
              <button type="button" class="ws-remove-link" data-j-email-remove>Remove</button>
            </div>
          </div>

          <div class="ws-optional-block" data-j-nid-block>
            <button type="button" class="ws-add-link" data-j-nid-add>+ Add National ID</button>
            <div class="ws-optional-fields" data-j-nid-fields hidden>
              <label class="ws-field">
                <span>National ID (yours or a parent's)</span>
                <input type="text" data-j-national-id />
              </label>
              <button type="button" class="ws-remove-link" data-j-nid-remove>Remove</button>
            </div>
          </div>
        </div>

        <label class="ws-field ws-field--full">
          <span>Notes</span>
          <textarea data-j-notes rows="2"></textarea>
        </label>

        <p class="join-error" data-join-error hidden></p>

        <div class="ws-form-actions">
          <button type="submit" class="btn-primary" data-join-submit>Submit request</button>
        </div>
      </form>
    </section>

    <!-- Step 3: confirmation -->
    <section class="join-done" data-join-step-done hidden>
      <div class="ws-pending-card">
        <h2 class="section-h2">Request sent</h2>
        <p class="ws-pending-text">
          A leader will review it and approve you into the group soon.
        </p>
      </div>
    </section>
  </div>

  <script>
    import { supabase, supabaseConfigured } from '../lib/curriculum/supabase';

    let selectedGroup: string | null = null;
    function el(sel: string): any { return document.querySelector(sel); }
    // "joy blah" / "JOY BLAH" → "Joy Blah" — applied on blur so parents
    // don't have to think about capitalization while typing.
    function titleCase(s: string) {
      return s.trim().replace(/\s+/g, ' ').toLowerCase().replace(/(^|[\s'-])\p{L}/gu, (c) => c.toUpperCase());
    }

    function showG2(focus = true) {
      el('[data-j-g2-fields]').hidden = false;
      el('[data-j-g2-add]').hidden = true;
      if (focus) el('[data-j-g2-rel]').focus();
    }
    function hideG2() {
      el('[data-j-g2-fields]').hidden = true;
      el('[data-j-g2-add]').hidden = false;
      el('[data-j-g2-rel]').value = '';
      el('[data-j-g2-phone]').value = '';
    }
    function showAllergy(focus = true) {
      el('[data-j-allergy-fields]').hidden = false;
      el('[data-j-allergy-add]').hidden = true;
      if (focus) el('[data-j-allergy-detail]').focus();
    }
    function hideAllergy() {
      el('[data-j-allergy-fields]').hidden = true;
      el('[data-j-allergy-add]').hidden = false;
      el('[data-j-allergy-detail]').value = '';
    }
    function showEmail(focus = true) {
      el('[data-j-email-fields]').hidden = false;
      el('[data-j-email-add]').hidden = true;
      if (focus) el('[data-j-email]').focus();
    }
    function hideEmail() {
      el('[data-j-email-fields]').hidden = true;
      el('[data-j-email-add]').hidden = false;
      el('[data-j-email]').value = '';
    }
    function showNid(focus = true) {
      el('[data-j-nid-fields]').hidden = false;
      el('[data-j-nid-add]').hidden = true;
      if (focus) el('[data-j-national-id]').focus();
    }
    function hideNid() {
      el('[data-j-nid-fields]').hidden = true;
      el('[data-j-nid-add]').hidden = false;
      el('[data-j-national-id]').value = '';
    }
    function showError(msg: string) {
      const e = el('[data-join-error]');
      e.textContent = msg;
      e.hidden = false;
    }

    // English-only — this form dropped its Arabic labels already; this
    // keeps what people actually type in step with that too, instead of
    // just the labels around it.
    function bindEnglishOnlyInputs() {
      document.addEventListener('input', (e: any) => {
        const t = e.target;
        if (!(t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)) return;
        if (t instanceof HTMLInputElement && !['text', 'search', 'tel', 'email', 'url', ''].includes(t.type)) return;
        const filtered = t.value.replace(/[^\x00-\x7F]/g, '');
        if (filtered === t.value) return;
        const pos = t.selectionStart ?? t.value.length;
        const posInFiltered = t.value.slice(0, pos).replace(/[^\x00-\x7F]/g, '').length;
        t.value = filtered;
        t.setSelectionRange(posInFiltered, posInFiltered);
      });
    }

    function bind() {
      const form = el('[data-join-form]');
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      bindEnglishOnlyInputs();

      el('[data-j-name]').addEventListener('blur', () => {
        const input = el('[data-j-name]');
        if (input.value.trim()) input.value = titleCase(input.value);
      });
      document.querySelectorAll('[data-join-group]').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          selectedGroup = btn.dataset.joinGroup;
          el('[data-join-step-group]').hidden = true;
          el('[data-join-step-form]').removeAttribute('hidden');
        });
      });
      el('[data-join-change-group]').addEventListener('click', () => {
        selectedGroup = null;
        el('[data-join-step-form]').hidden = true;
        el('[data-join-step-group]').removeAttribute('hidden');
      });

      el('[data-j-g2-add]').addEventListener('click', () => showG2());
      el('[data-j-g2-remove]').addEventListener('click', () => hideG2());
      el('[data-j-allergy-add]').addEventListener('click', () => showAllergy());
      el('[data-j-allergy-remove]').addEventListener('click', () => hideAllergy());
      el('[data-j-email-add]').addEventListener('click', () => showEmail());
      el('[data-j-email-remove]').addEventListener('click', () => hideEmail());
      el('[data-j-nid-add]').addEventListener('click', () => showNid());
      el('[data-j-nid-remove]').addEventListener('click', () => hideNid());

      form.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        el('[data-join-error]').hidden = true;
        if (!supabaseConfigured || !supabase) { showError('Not connected, please try again later.'); return; }
        if (!selectedGroup) { showError('Pick a group first.'); return; }

        const name = el('[data-j-name]').value.trim();
        if (!name) {
          showError('Full name is required.');
          return;
        }
        const hasAllergies = !el('[data-j-allergy-fields]').hidden;
        const submitBtn = el('[data-join-submit]');
        submitBtn.disabled = true;

        const { error } = await supabase.from('join_requests').insert({
          group_key: selectedGroup,
          full_name: name,
          phone: el('[data-j-phone]').value.trim() || null,
          birth_date: el('[data-j-dob]').value || null,
          guardian1_relation: el('[data-j-g1-rel]').value || null,
          guardian1_phone: el('[data-j-g1-phone]').value.trim() || null,
          guardian2_relation: !el('[data-j-g2-fields]').hidden ? (el('[data-j-g2-rel]').value || null) : null,
          guardian2_phone: !el('[data-j-g2-fields]').hidden ? (el('[data-j-g2-phone]').value.trim() || null) : null,
          has_allergies: hasAllergies,
          allergy_detail: hasAllergies ? (el('[data-j-allergy-detail]').value.trim() || null) : null,
          email: !el('[data-j-email-fields]').hidden ? (el('[data-j-email]').value.trim() || null) : null,
          national_id: !el('[data-j-nid-fields]').hidden ? (el('[data-j-national-id]').value.trim() || null) : null,
          notes: el('[data-j-notes]').value.trim() || null,
        });

        submitBtn.disabled = false;
        if (error) {
          console.error(error);
          showError('Could not submit, please try again.');
          return;
        }
        el('[data-join-step-form]').hidden = true;
        el('[data-join-step-done]').removeAttribute('hidden');
      });
    }

    document.addEventListener('astro:page-load', bind);
  </script>
</BaseLayout>
