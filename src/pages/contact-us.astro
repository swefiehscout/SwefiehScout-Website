---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Us" bare wide>
  <section class="page-hero" data-animate>
    <h1 class="page-h1">
      Get in Touch
      <span class="page-h1-ar">تواصل معنا</span>
    </h1>
    <p class="page-tag">
      We're always happy to welcome new members, answer your questions, or
      plan community events together.
    </p>
    <p class="page-tag-ar">
      يسعدنا الترحيب بالأعضاء الجدد، الإجابة عن أسئلتكم، والتخطيط معكم للفعاليات.
    </p>
  </section>

  <div class="contact-layout">
    <aside class="contact-info" data-animate>
      <h2 class="info-h2">Reach Us Directly</h2>
      <div class="info-list">
        <a class="info-item" href="mailto:info@swefieh-orthodox-scout.com">
          <span class="info-icon" aria-hidden="true">✉</span>
          <span class="info-text">
            <span class="info-label">Email</span>
            <span class="info-value">info@swefieh-orthodox-scout.com</span>
          </span>
        </a>
        <a class="info-item" href="tel:+962796441145">
          <span class="info-icon" aria-hidden="true">☏</span>
          <span class="info-text">
            <span class="info-label">Leader Wasan</span>
            <span class="info-value">+962 7 9644 1145</span>
          </span>
        </a>
        <a class="info-item" href="tel:+962798312286">
          <span class="info-icon" aria-hidden="true">☏</span>
          <span class="info-text">
            <span class="info-label">Leader Mina</span>
            <span class="info-value">+962 7 9831 2286</span>
          </span>
        </a>
        <div class="info-item">
          <span class="info-icon" aria-hidden="true">⌖</span>
          <span class="info-text">
            <span class="info-label">Address</span>
            <span class="info-value">Presentation of the Lord Cathedral, Swefieh, Amman</span>
          </span>
        </div>
      </div>
      <div class="info-social">
        <a class="btn-social" href="https://www.instagram.com/theorthodoxscout" target="_blank" rel="noopener">Instagram</a>
        <a class="btn-social" href="https://www.facebook.com/share/1Eh8bqpyn2/" target="_blank" rel="noopener">Facebook</a>
      </div>
    </aside>

    <div class="form-card" data-animate data-animate-delay="1">
      <h2 class="form-h2">Send a Message</h2>
      <p class="form-h2-ar">أرسل رسالة</p>
      <form action="https://submit-form.com/J3IN8aICn" method="POST" class="form-grid">
        <div class="form-row">
          <label for="name">Name · الاسم</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-row">
          <label for="email">Email · البريد الإلكتروني</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-row">
          <label for="phone">Phone Number · رقم الهاتف</label>
          <input type="tel" id="phone" name="phone" required />
        </div>
        <div class="form-row">
          <label for="subject">Subject · الموضوع</label>
          <input type="text" id="subject" name="subject" />
        </div>
        <div class="form-row">
          <label for="message">Message · الرسالة</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <div>
          <button type="submit" class="btn-primary">Send Message</button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>
