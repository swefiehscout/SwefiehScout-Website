---
// Christmas Proposal: the page the PR team shows venues (on a phone or laptop, or as a link)
// to book the Scout Band for Christmas performances.
//
// Design: the same family as the Santa Booking pages: cream page, white cards, Playfair Display
// headings with Inter text, maroon with green highlights, and one deep-red band to close.
//
// Videos live in public/videos/christmas/. After adding new ones run `npm run videos`
// (scripts/prepare-videos.sh) to make web-safe .mp4s and poster images. Every video appears in
// the "on film" row automatically; the hero and the four moments use the hand-picked clips
// below (picked by filename, skipped if the file is missing).
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const VIDEO_DIR = 'videos/christmas';
const videoFiles = (() => {
  try {
    return fs
      .readdirSync(path.join(process.cwd(), 'public', VIDEO_DIR))
      .filter((f) => /\.(mp4|webm)$/i.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
  } catch {
    return [];
  }
})();

type Clip = { src: string; poster?: string };
function clip(file: string): Clip {
  const base = file.replace(/\.[^.]+$/, '');
  const poster = fs.existsSync(path.join(process.cwd(), 'public', VIDEO_DIR, 'posters', `${base}.jpg`))
    ? `/${VIDEO_DIR}/posters/${encodeURIComponent(base)}.jpg`
    : undefined;
  return { src: `/${VIDEO_DIR}/${encodeURIComponent(file)}`, poster };
}
const pick = (base: string): Clip | undefined => {
  const f = videoFiles.find((v) => v.startsWith(base));
  return f ? clip(f) : undefined;
};

const allClips: Clip[] = videoFiles.map((f: string) => clip(f));
const indexOf = (c?: Clip) => (c ? allClips.findIndex((x: Clip) => x.src === c.src) : -1);


// Four moments of the night (text only; the videos are all in the "on film" row).
const moments = [
  { icon: '🥁', title: 'It starts with a drum roll', text: 'You hear us before you see us, and every head in the place turns.' },
  { icon: '🎶', title: 'Then the bagpipes', text: 'A sound you don’t hear every day fills the whole space.' },
  { icon: '👀', title: 'Everyone stops', text: 'Shoppers gather, kids run to the front, and Santa joins in.' },
  { icon: '🎄', title: 'It feels like Christmas', text: 'Trees light up, phones go up, and your venue is in everyone’s stories.' },
];

const reasons = [
  { icon: '👥', title: 'Crowds gather on their own', text: 'A live pipe band pulls people in from every corner of your venue.' },
  { icon: '📱', title: 'Everyone films it', text: 'Your venue ends up on hundreds of phones and Instagram stories.' },
  { icon: '🥁', title: 'Real scout tradition', text: 'Bagpipes and drums in proud Orthodox and Arab scouting heritage.' },
  { icon: '🎁', title: 'We bring everything', text: 'Uniforms, instruments and a plan. You just pick the spot.' },
];

const places = [
  'Madaboun',
  'Golden Gate Mall',
  'Orthodox Club',
  'Sweifieh Village',
  'The Boulevard',
  'Grand Hyatt Amman',
  'Kan Zaman',
];

const PHONE_DISPLAY = '079 202 8785';
const PHONE_TEL = 'tel:+962792028785';
const WHATSAPP = `https://wa.me/962792028785?text=${encodeURIComponent(
  "Hello! We'd like to book the Scout Band for a Christmas performance.",
)}`;
---
<BaseLayout title="Christmas Proposal" bare wide>
  <div class="cp">
    <!-- ================= Hero ================= -->
    <section class="cp-hero" aria-labelledby="cp-title">
      <div class="cp-hero-media">
        <picture>
          <source srcset="/images/proposal/proposal-hero.webp" type="image/webp" />
          <img src="/images/proposal/proposal-hero.jpg" width="1254" height="1254"
            alt="Illustration of the Scout Band with bagpipes and drums, Santa and Mrs. Claus, on a snowy Christmas street" />
        </picture>
      </div>
      <div class="cp-hero-body">
        <p class="cp-eyebrow">The Scout Band · Christmas season</p>
        <h1 id="cp-title">Christmas in Amman <span class="cp-accent">has a soundtrack.</span></h1>
        <p class="cp-lede">
          We’re the Greek Orthodox Scouts &amp; Guides band from Swefieh. Every December we bring bagpipes,
          drums and a whole lot of Christmas spirit to malls, hotels and clubs across Amman.
        </p>
        <ul class="cp-facts">
          <li><b data-cp-days>–</b><span data-cp-days-label>days to Christmas</span></li>
          <li><b>{places.length}+</b><span>venues played</span></li>
          <li><b>{allClips.length}</b><span>videos from last season</span></li>
        </ul>
        <div class="cp-actions">
          <a class="btn-primary" href="#cp-contact">Book the band</a>
          <a class="btn-secondary" href="#cp-videos">Watch the videos</a>
        </div>
      </div>
    </section>

    <!-- ================= Where we've played ================= -->
    <section class="cp-places" aria-label="Where we've played">
      <p class="cp-eyebrow">Where we’ve played</p>
      <div class="cp-marquee">
        <div class="cp-track">
          {[0, 1].map((dup) => (
            <p class="cp-places-list" aria-hidden={dup === 1 ? 'true' : undefined}>
              {places.map((p) => (<><span>{p}</span><span class="cp-star" aria-hidden="true">✦</span></>))}
              <span class="cp-more">and many more</span><span class="cp-star" aria-hidden="true">✦</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= Four moments ================= -->
    {moments.length > 0 && (
      <section class="cp-section" aria-labelledby="cp-moments-title">
        <header class="cp-head">
          <p class="cp-eyebrow">What happens when we walk in</p>
          <h2 id="cp-moments-title">Four moments, <span class="cp-accent">one unforgettable night.</span></h2>
        </header>
        <ol class="cp-moments">
          {moments.map((m, i) => (
            <li class="cp-moment">
              <span class="cp-moment-icon" aria-hidden="true">{m.icon}</span>
              <span class="cp-num">0{i + 1}</span>
              <h3 class="cp-moment-title">{m.title}</h3>
              <p class="cp-moment-text">{m.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- ================= Why venues book us ================= -->
    <section class="cp-section" aria-labelledby="cp-why-title">
      <header class="cp-head">
        <p class="cp-eyebrow">Why venues book us</p>
        <h2 id="cp-why-title">The easiest way to <span class="cp-accent">fill a room</span> in December.</h2>
      </header>
      <ul class="cp-reasons">
        {reasons.map((r) => (
          <li class="cp-reason">
            <span class="cp-reason-icon" aria-hidden="true">{r.icon}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ================= Videos ================= -->
    {allClips.length > 0 && (
      <section class="cp-section" id="cp-videos" aria-labelledby="cp-videos-title">
        <header class="cp-head">
          <p class="cp-eyebrow">Last season, on film</p>
          <h2 id="cp-videos-title">Press play on <span class="cp-accent">Christmas.</span></h2>
          <p class="cp-sub">Tap any video to watch it with sound.</p>
        </header>
        <div class="cp-rail" data-cp-rail>
          {allClips.map((c: Clip, i: number) => (
            <button type="button" class="cp-reel" data-cp-open={i} aria-label={`Play video ${i + 1} of ${allClips.length}`}>
              <video src={c.src} poster={c.poster} muted playsinline preload="none"></video>
              <span class="cp-play" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <div class="cp-rail-nav">
          <button type="button" class="cp-arrow" data-cp-prev aria-label="Previous videos">‹</button>
          <p class="cp-rail-count" data-cp-count aria-live="polite">{allClips.length} videos</p>
          <button type="button" class="cp-arrow" data-cp-next aria-label="Next videos">›</button>
        </div>
      </section>
    )}

    <!-- ================= Let's talk ================= -->
    <section class="cp-contact" id="cp-contact" aria-labelledby="cp-contact-title">
      <p class="cp-eyebrow cp-eyebrow--light">Let’s talk</p>
      <h2 id="cp-contact-title">Let’s make your venue <span class="cp-gold">sound like Christmas.</span></h2>
      <p class="cp-contact-lede">Pricing and availability on request. Call or message us and we’ll plan it with you.</p>
      <a class="cp-phone" href={PHONE_TEL}>{PHONE_DISPLAY}</a>
      <div class="cp-contact-actions">
        <a class="cp-btn-gold" href={WHATSAPP} target="_blank" rel="noopener">WhatsApp us</a>
        <a class="cp-btn-light" href={PHONE_TEL}>Call now</a>
      </div>
    </section>
  </div>

  <!-- ===== Video player ===== -->
  <dialog class="cp-lightbox" data-cp-lightbox aria-label="Video player">
    <button type="button" class="cp-lb-btn cp-lb-close" data-cp-close aria-label="Close">✕</button>
    <button type="button" class="cp-lb-btn cp-lb-prev" data-cp-lb-prev aria-label="Previous video">‹</button>
    <div class="cp-lb-stage" data-cp-stage></div>
    <button type="button" class="cp-lb-btn cp-lb-next" data-cp-lb-next aria-label="Next video">›</button>
    <p class="cp-lb-count" data-cp-lb-count></p>
  </dialog>
  <script type="application/json" data-cp-media set:html={JSON.stringify(allClips)} />
</BaseLayout>

<style is:global>
  /* ======================= Christmas Proposal (cp-) ======================= */
  .cp {
    --cp-brand: #571607;
    --cp-brand-dark: #3a0f04;
    --cp-accent: #143822;
    --cp-gold: #c9a24e;
    --cp-gold-deep: #9a7428;
    --cp-gold-light: #f6e3a1;
    --cp-cream: #faf3e8;
    --cp-border: #e6dfd2;
    --cp-muted: #5b5048;
    --cp-radius: 16px;
    display: grid;
    gap: clamp(56px, 9vh, 104px);
    padding-bottom: 8px;
  }
  .cp-eyebrow {
    margin: 0;
    font: 600 12px var(--font-sans, Inter, sans-serif);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cp-gold-deep);
  }
  .cp-eyebrow--light { color: var(--cp-gold-light); }
  .cp-accent { color: var(--cp-accent); }
  /* Hero buttons jump to a section: stop just below the sticky menu so the whole section shows */
  html:has(.cp) { scroll-behavior: smooth; }
  .cp [id] { scroll-margin-top: 96px; }
  @media (prefers-reduced-motion: reduce) { html:has(.cp) { scroll-behavior: auto; } }
  .cp-gold { color: var(--cp-gold-light); }
  .cp h1, .cp h2, .cp h3 { font-family: var(--font-display); }

  /* ---------- Hero: one card, video left, words right ---------- */
  .cp-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: var(--cp-radius);
    border: 1px solid var(--cp-border);
    background: linear-gradient(135deg, #fff, var(--cp-cream));
    box-shadow: 0 12px 28px -8px rgba(87, 22, 7, 0.18);
  }
  @media (min-width: 900px) { .cp-hero { grid-template-columns: 1fr 1fr; min-height: min(calc(100svh - 160px), 600px); } }
  .cp-hero-media { position: relative; background: #2a0805; aspect-ratio: 1 / 1; }
  @media (min-width: 900px) { .cp-hero-media { aspect-ratio: auto; } }
  .cp-hero-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .cp-hero-body { display: grid; align-content: center; gap: 18px; padding: clamp(28px, 4.5vw, 56px); }
  .cp-hero h1 { margin: 0; font-size: clamp(2.2rem, min(4.4vw, 7vh), 3.5rem); line-height: 1.08; color: var(--cp-brand); }
  .cp-lede { margin: 0; color: var(--cp-muted); font-size: 1.05rem; line-height: 1.7; max-width: 46ch; }
  .cp-facts {
    list-style: none; margin: 4px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--cp-border); border-radius: 10px; background: #fff; overflow: hidden;
  }
  .cp-facts li { padding: 12px 14px; display: grid; gap: 2px; }
  .cp-facts li + li { border-left: 1px solid var(--cp-border); }
  .cp-facts b { font: 700 1.6rem/1.1 var(--font-display); color: var(--cp-brand); }
  .cp-facts span { font-size: 0.78rem; color: var(--cp-muted); line-height: 1.35; }
  @media (max-width: 400px) { .cp-facts li { padding: 10px 6px; } }
  /* a long paragraph runs past the 6 lines that balance handles on tiny phones */
  @media (max-width: 359px) { .cp-lede { text-wrap: pretty; } .cp-facts span { font-size: 0.72rem; } }
  .cp-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  @media (max-width: 899px) {
    .cp-hero-body { text-align: center; justify-items: center; }
    .cp-actions { justify-content: center; }
  }

  /* ---------- Where we've played ---------- */
  .cp-places {
    display: grid; justify-items: center; gap: 14px; text-align: center;
    padding: 26px 16px; border-block: 1px solid rgba(201, 162, 78, 0.45);
    margin-top: calc(-1 * clamp(20px, 4vh, 48px));
  }
  /* a slowly moving band of venue names */
  .cp-marquee {
    width: 100%; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .cp-track { display: flex; width: max-content; animation: cpMarquee 38s linear infinite; }
  .cp-marquee:hover .cp-track { animation-play-state: paused; }
  @keyframes cpMarquee { to { transform: translateX(-50%); } }
  .cp-places-list {
    margin: 0; display: flex; align-items: center; gap: 22px; padding-right: 22px; white-space: nowrap;
    font: 700 clamp(1.3rem, 2.4vw, 1.9rem) var(--font-display); color: var(--cp-brand);
  }
  .cp-star { color: var(--cp-gold); font-size: 0.55em; }
  .cp-more { font: 500 0.95rem var(--font-sans, Inter, sans-serif); color: var(--cp-muted); letter-spacing: 0.04em; }
  @media (prefers-reduced-motion: reduce) {
    .cp-track { animation: none; width: auto; justify-content: center; }
    .cp-track > .cp-places-list[aria-hidden] { display: none; }
    .cp-places-list { flex-wrap: wrap; justify-content: center; white-space: normal; gap: 8px 16px; padding: 0; }
  }

  /* ---------- Section heading (same everywhere) ---------- */
  .cp-section { display: grid; gap: clamp(24px, 4vh, 40px); }
  .cp-head { display: grid; justify-items: center; gap: 10px; text-align: center; max-width: 760px; margin: 0 auto; }
  @media (min-width: 900px) {
    .cp-head { max-width: none; }
    #cp-moments-title { white-space: nowrap; }
  }
  .cp-head h2 { margin: 0; font-size: clamp(1.9rem, min(3.8vw, 6vh), 2.8rem); line-height: 1.15; color: var(--cp-brand); }
  .cp-head h2::after {
    content: ''; display: block; width: 60px; height: 3px; margin: 16px auto 0; border-radius: 2px;
    background: linear-gradient(90deg, var(--cp-brand), var(--cp-accent));
  }
  .cp-sub { margin: 0; color: var(--cp-muted); }

  /* ---------- Four moments: a timeline of the night (numbered steps on a gold line) ---------- */
  .cp-moments {
    list-style: none; margin: 0; padding: 0; position: relative;
    display: grid; gap: 28px; grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .cp-moments::before {
    content: ''; position: absolute; top: 30px; left: 12.5%; right: 12.5%; height: 2px;
    background: linear-gradient(90deg, rgba(201, 162, 78, 0.25), var(--cp-gold) 15%, var(--cp-gold) 85%, rgba(201, 162, 78, 0.25));
  }
  .cp-moment { position: relative; display: grid; justify-items: center; gap: 8px; text-align: center; padding: 0 6px; }
  .cp-moment-icon { display: none; }
  .cp-moment .cp-num {
    position: relative; z-index: 1; width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center;
    font: 700 1.05rem var(--font-display); color: #fff; letter-spacing: 0.04em; background: var(--cp-brand);
    box-shadow: 0 0 0 4px var(--cp-cream), 0 0 0 5px var(--cp-gold); margin-bottom: 10px;
  }
  .cp-moment-title { margin: 0; font: 700 1.2rem/1.25 var(--font-display); color: var(--cp-brand); }
  .cp-moment-text { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--cp-muted); max-width: 26ch; }
  @media (max-width: 760px) {
    .cp-moments { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .cp-moments::before { top: 30px; bottom: 30px; left: 29px; right: auto; width: 2px; height: auto;
      background: linear-gradient(180deg, var(--cp-gold), var(--cp-gold)); }
    .cp-moment { grid-template-columns: 60px 1fr; justify-items: start; text-align: left; column-gap: 18px; row-gap: 2px; padding: 0; }
    .cp-moment .cp-num { grid-row: span 2; margin: 0; }
    .cp-moment-title { align-self: end; }
    .cp-moment-text { max-width: none; }
  }

  /* play badge (videos) */
  .cp-play {
    position: absolute; left: 50%; top: 50%; width: 54px; height: 54px; margin: -27px 0 0 -27px;
    border-radius: 50%; background: rgba(87, 22, 7, 0.82); box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.85);
    transition: transform 0.25s, opacity 0.25s;
  }
  .cp-play::after {
    content: ''; position: absolute; left: 21px; top: 16px;
    border-style: solid; border-width: 11px 0 11px 17px; border-color: transparent transparent transparent #fff;
  }
  .cp-reel:hover .cp-play { transform: scale(1.08); }

  /* ---------- Why venues book us ---------- */
  .cp-reasons { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1000px) { .cp-reasons { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .cp-reasons { grid-template-columns: minmax(0, 1fr); } }
  .cp-reason {
    display: grid; gap: 8px; align-content: start; padding: 24px;
    background: #fff; border: 1px solid var(--cp-border); border-radius: var(--cp-radius);
  }
  .cp-reason-icon {
    width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; font-size: 22px;
    background: var(--cp-cream); box-shadow: inset 0 0 0 1px rgba(201, 162, 78, 0.6); margin-bottom: 6px;
  }
  .cp-reason h3 { margin: 0; font-size: 1.15rem; color: var(--cp-brand); }
  .cp-reason p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--cp-muted); }

  /* ---------- Videos: one sliding row ---------- */
  .cp-rail {
    display: flex; gap: 16px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    padding: 6px 2px 14px; scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 94%, transparent);
            mask-image: linear-gradient(90deg, #000 94%, transparent);
  }
  .cp-rail::-webkit-scrollbar { display: none; }
  .cp-reel {
    all: unset; box-sizing: border-box; position: relative; cursor: pointer; flex: none; scroll-snap-align: start;
    height: clamp(260px, calc(100svh - 470px), 460px); aspect-ratio: 9 / 16; overflow: hidden;
    border-radius: 14px; background: #2a0805; border: 1px solid var(--cp-border);
    box-shadow: 0 12px 26px -16px rgba(87, 22, 7, 0.45); transition: transform 0.3s;
  }
  .cp-reel:hover { transform: translateY(-4px); }
  .cp-reel:focus-visible { outline: 3px solid var(--cp-gold); outline-offset: 3px; }
  .cp-reel video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cp-rail-nav { display: flex; align-items: center; justify-content: center; gap: 18px; }
  .cp-arrow {
    width: 48px; height: 48px; border-radius: 50%; cursor: pointer; display: grid; place-items: center;
    font: 400 28px/1 var(--font-display); padding-bottom: 4px; color: #fff;
    background: var(--cp-brand); border: 0; transition: background 0.2s, opacity 0.2s;
  }
  .cp-arrow:hover:not(:disabled) { background: var(--cp-brand-dark); }
  .cp-arrow:disabled { opacity: 0.3; cursor: default; }
  .cp-arrow:focus-visible { outline: 3px solid var(--cp-gold); outline-offset: 3px; }
  .cp-rail-count { margin: 0; min-width: 12ch; text-align: center; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cp-gold-deep); }

  /* ---------- Let's talk: the one deep-red band ---------- */
  .cp-contact {
    display: grid; justify-items: center; gap: 16px; text-align: center; color: #fdf3dc;
    padding: clamp(48px, 9vh, 88px) clamp(20px, 5vw, 64px);
    border-radius: var(--cp-radius);
    background:
      radial-gradient(circle, rgba(241, 217, 142, 0.22) 1px, transparent 1.6px) 0 0 / 24px 24px,
      radial-gradient(ellipse at 50% 20%, #5c1210 0%, #3f0c09 45%, #1f0604 100%);
    box-shadow: 0 30px 60px -30px rgba(31, 6, 4, 0.7);
  }
  .cp-contact h2 { margin: 0; font-size: clamp(2rem, min(4.4vw, 6.4vh), 3.2rem); line-height: 1.12; color: #fff; text-wrap: balance; }
  .cp-contact-lede { margin: 0; max-width: 46ch; color: #e9d3b0; line-height: 1.65; }
  .cp-phone {
    font: 700 clamp(2.4rem, min(7vw, 9vh), 4.2rem)/1 var(--font-display); color: var(--cp-gold-light);
    text-decoration: none; margin: 6px 0;
  }
  .cp-phone:hover { color: #fff; text-decoration: none; }
  .cp-contact-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .cp-btn-gold, .cp-btn-light {
    display: inline-flex; align-items: center; padding: 0.8rem 1.5rem; border-radius: 999px;
    font-weight: 700; text-decoration: none; transition: transform 0.2s, background 0.2s, color 0.2s;
  }
  .cp-btn-gold { color: #3a0f04; background: linear-gradient(135deg, #f6e3a1 0%, #d4ad57 45%, #f3dc92 70%, #b98d38 100%); }
  .cp-btn-light { color: #fdf3dc; border: 1.5px solid rgba(241, 217, 142, 0.6); }
  .cp-btn-gold:hover, .cp-btn-light:hover { transform: translateY(-2px); text-decoration: none; }
  .cp-btn-light:hover { background: rgba(255, 250, 235, 0.1); color: #fff; }

  /* ---------- Phones: no lone words, no lone buttons, everything centred ---------- */
  /* Every line balances, so no line ends on a lone word (the menu bar stays exactly as on other pages) */
  .cp, body:has(.cp) .site-footer { text-wrap: balance; }
  .cp-num { font-variant-numeric: lining-nums; line-height: 1; }
  @media (max-width: 480px) {
    .cp-reason { justify-items: center; text-align: center; }
  }

  /* ---------- Video player ---------- */
  .cp-lightbox { width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; margin: 0; padding: 0; border: 0; background: transparent; color: #fff; }
  .cp-lightbox[open] { display: grid; place-items: center; }
  .cp-lightbox::backdrop { background: rgba(20, 5, 3, 0.94); backdrop-filter: blur(6px); }
  .cp-lb-stage video { display: block; max-width: 92vw; max-height: 84vh; border-radius: 14px; background: #000; }
  .cp-lb-btn {
    position: fixed; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    font: 400 26px/1 var(--font-sans, Inter, sans-serif); color: #fff;
    background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .cp-lb-btn:hover { background: rgba(255, 255, 255, 0.24); }
  .cp-lb-close { top: 18px; right: 18px; font-size: 20px; }
  .cp-lb-prev { left: 18px; top: 50%; margin-top: -24px; }
  .cp-lb-next { right: 18px; top: 50%; margin-top: -24px; }
  .cp-lb-count { position: fixed; bottom: 14px; left: 0; right: 0; margin: 0; text-align: center; font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); }
  @media (max-width: 560px) { .cp-lb-prev, .cp-lb-next { top: auto; bottom: 46px; margin-top: 0; } }
</style>

<script>
  let cleanup: Array<() => void> = [];

  function initCountdown() {
    const num = document.querySelector<HTMLElement>('[data-cp-days]');
    const label = document.querySelector<HTMLElement>('[data-cp-days-label]');
    if (!num) return;
    // Days until Christmas Day, Amman time (UTC+3).
    const nowAmman = new Date(Date.now() + 3 * 3600e3);
    const y = nowAmman.getUTCFullYear(), m = nowAmman.getUTCMonth(), d = nowAmman.getUTCDate();
    if (m === 11 && d === 25) { num.textContent = '🎄'; if (label) label.textContent = 'Merry Christmas!'; return; }
    let target = Date.UTC(y, 11, 25);
    const today = Date.UTC(y, m, d);
    if (today > target) target = Date.UTC(y + 1, 11, 25);
    const days = Math.round((target - today) / 864e5);
    num.textContent = String(days);
    if (label) label.textContent = days === 1 ? 'day to Christmas' : 'days to Christmas';
  }

  // Play muted videos only while they're on screen.
  function initInView() {
    const vids = document.querySelectorAll<HTMLVideoElement>('[data-cp-inview]');
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.2 });
    vids.forEach((v) => io.observe(v));
    cleanup.push(() => io.disconnect());
  }

  // Video row: arrows and a "1-5 of 16" counter.
  function initRail() {
    const rail = document.querySelector<HTMLElement>('[data-cp-rail]');
    if (!rail) return;
    const reels = rail.querySelectorAll<HTMLElement>('.cp-reel');
    const prev = document.querySelector<HTMLButtonElement>('[data-cp-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-cp-next]');
    const count = document.querySelector<HTMLElement>('[data-cp-count]');
    if (!reels.length) return;
    const step = () => reels[0].getBoundingClientRect().width + 16;
    const update = () => {
      const per = Math.max(1, Math.floor((rail.clientWidth + 8) / step()));
      const first = Math.min(reels.length, Math.round(rail.scrollLeft / step()) + 1);
      const last = Math.min(reels.length, first + per - 1);
      if (count) count.textContent = last > first ? `${first}–${last} of ${reels.length} videos` : `${first} of ${reels.length} videos`;
      if (prev) prev.disabled = rail.scrollLeft <= 2;
      if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    const by = (dir: number) => rail.scrollBy({ left: dir * Math.max(step(), rail.clientWidth - step()), behavior: 'smooth' });
    prev?.addEventListener('click', () => by(-1));
    next?.addEventListener('click', () => by(1));
    const onScroll = () => requestAnimationFrame(update);
    rail.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
    cleanup.push(() => window.removeEventListener('resize', update));
  }

  // Full-screen player with sound.
  function initLightbox() {
    const dlg = document.querySelector<HTMLDialogElement>('[data-cp-lightbox]');
    const stage = dlg?.querySelector<HTMLElement>('[data-cp-stage]');
    const counter = dlg?.querySelector<HTMLElement>('[data-cp-lb-count]');
    const data = document.querySelector('[data-cp-media]');
    if (!dlg || !stage || !data) return;
    const clips: { src: string; poster?: string }[] = JSON.parse(data.textContent || '[]');
    let i = 0;
    const show = (k: number) => {
      i = (k + clips.length) % clips.length;
      const c = clips[i];
      stage.innerHTML = '';
      const v = document.createElement('video');
      v.src = c.src; if (c.poster) v.poster = c.poster;
      v.controls = true; v.autoplay = true; v.playsInline = true; v.loop = true;
      stage.appendChild(v);
      v.play().catch(() => {});
      if (counter) counter.textContent = `${i + 1} / ${clips.length}`;
    };
    const close = () => { stage.innerHTML = ''; dlg.close(); };
    document.querySelectorAll<HTMLElement>('[data-cp-open]').forEach((b) => b.addEventListener('click', () => {
      const k = Number(b.dataset.cpOpen);
      if (k < 0 || !clips.length) return;
      document.querySelectorAll<HTMLVideoElement>('.cp video').forEach((v) => v.pause());
      dlg.showModal(); show(k);
    }));
    dlg.querySelector('[data-cp-close]')?.addEventListener('click', close);
    dlg.querySelector('[data-cp-lb-prev]')?.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-cp-lb-next]')?.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('close', () => { stage.innerHTML = ''; });
    const onKey = (e: KeyboardEvent) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'ArrowLeft') show(i - 1);
    };
    document.addEventListener('keydown', onKey);
    cleanup.push(() => document.removeEventListener('keydown', onKey));
  }

  function init() {
    if (!document.querySelector('.cp')) return;
    initCountdown();
    initInView();
    initRail();
    initLightbox();
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup.forEach((fn) => fn());
    cleanup = [];
  });
</script>
