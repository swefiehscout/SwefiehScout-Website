---
import BaseLayout from '../layouts/BaseLayout.astro';

const albums = [
  {
    title: 'Sabt Al Noor',
    titleAr: 'سبت النور',
    caption: 'Holy Saturday · Light of the Resurrection',
    captionAr: 'سبت النور · نور القيامة',
    cover: '/images/photos/gallery/sabt-al-noor.jpg',
  },
  {
    title: 'Holy Friday - Jonaz',
    titleAr: 'الجمعة العظيمة - الجناز',
    caption: 'Holy Week · The Lamentations',
    captionAr: 'أسبوع الآلام · المراثي',
    cover: '/images/photos/gallery/holy-friday.jpg',
  },
  {
    title: 'Palm Sunday',
    titleAr: 'أحد الشعانين',
    caption: '2026 · Procession & Service',
    captionAr: '٢٠٢٦ · الزياح والقداس',
    cover: '/images/photos/gallery/palm-sunday.jpg',
  },
  {
    title: 'Palm Sunday - Portraits',
    titleAr: 'أحد الشعانين - صور فردية',
    caption: '2026 · Individual scout & guide photos',
    captionAr: '٢٠٢٦ · صور فردية للكشاف والمرشدات',
    cover: '/images/photos/gallery/palm-sunday-portraits.jpg',
  },
] as const;
---
<BaseLayout title="Gallery" bare wide>
  <section class="page-hero" data-animate>
    <h1 class="page-h1">
      Gallery
      <span class="page-h1-ar">معرض الصور</span>
    </h1>
    <p class="page-tag">
      Moments from camps, parades, services, and life in the troop.
    </p>
    <p class="page-tag-ar">لمحات من المخيمات، المسيرات، القداديس، والحياة الكشفية.</p>
  </section>

  <section class={`gallery-grid gallery-grid--${albums.length}`}>
    {albums.map((album, i) => (
      <button
        type="button"
        class="album-card"
        data-animate
        data-animate-delay={String((i % 5) + 1)}
      >
        <div class="album-art">
          <img class="album-cover" src={album.cover} alt={album.title} loading="lazy" />
        </div>
        <div class="album-meta">
          <p class="album-caption">{album.caption}</p>
          <h2 class="album-title">{album.title}</h2>
          <p class="album-title-ar">{album.titleAr}</p>
          <p class="album-caption-ar">{album.captionAr}</p>
          <span class="album-cta">
            Request Access
            <span class="album-cta-arrow" aria-hidden="true">→</span>
          </span>
        </div>
      </button>
    ))}
  </section>

  <p class="gallery-footnote" data-animate>
    Albums are private, please contact a troop leader for access.<br />
    <span dir="rtl">الألبومات خاصة - يرجى التواصل مع أحد القادة للحصول على صلاحية الوصول.</span>
  </p>

  <div class="gallery-modal-overlay" id="gallery-modal" hidden>
    <div class="gallery-modal" role="dialog" aria-modal="true" aria-labelledby="gallery-modal-title">
      <button type="button" class="gallery-modal-close" aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
      <div class="gallery-modal-icon" aria-hidden="true">🔒</div>
      <h2 id="gallery-modal-title" class="gallery-modal-title">Private Album</h2>
      <p class="gallery-modal-title-ar" dir="rtl">ألبوم خاص</p>
      <p class="gallery-modal-text">Please contact a troop leader for access to this album.</p>
      <p class="gallery-modal-text-ar" dir="rtl">
        يرجى التواصل مع أحد القادة للحصول على صلاحية الوصول إلى هذا الألبوم.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Albums aren't public, the Drive links live only in the source, never
  // rendered to the page. Clicking a card opens a centered dialog pointing
  // people to a leader instead of navigating anywhere.
  const modal = document.getElementById('gallery-modal');
  const closeBtn = modal?.querySelector<HTMLButtonElement>('.gallery-modal-close');
  let hideTimer: ReturnType<typeof window.setTimeout> | undefined;

  function openGalleryModal() {
    if (!modal) return;
    window.clearTimeout(hideTimer);
    modal.hidden = false;
    requestAnimationFrame(() => modal.classList.add('gallery-modal-overlay--show'));
    document.body.classList.add('gallery-modal-open');
    closeBtn?.focus();
  }

  function closeGalleryModal() {
    if (!modal) return;
    modal.classList.remove('gallery-modal-overlay--show');
    document.body.classList.remove('gallery-modal-open');
    hideTimer = window.setTimeout(() => { modal.hidden = true; }, 200);
  }

  document.querySelectorAll<HTMLButtonElement>('.album-card').forEach((card) => {
    card.addEventListener('click', openGalleryModal);
  });
  closeBtn?.addEventListener('click', closeGalleryModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeGalleryModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeGalleryModal();
  });
</script>
