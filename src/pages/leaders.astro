---
// Leaders Workspace — sign in / create account. Replaces the old shared-
// password gate now that each leader has a real Supabase Auth account.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Leaders Workspace" bare>
  <section class="page-hero" data-animate>
    <h1 class="page-h1">Leaders Workspace</h1>
    <p class="page-tag">Sign in to your group's workspace.</p>
    <a class="ws-guide-link leaders-demo-link" href="/leaders/demo" target="_blank" rel="noopener">👀 See a live demo — no account needed</a>
  </section>

  <div class="gate-form auth-card">
    <div data-auth-view="form">
      <div class="auth-tabs">
        <button type="button" class="auth-tab auth-tab--active" data-auth-mode="signin">Sign in</button>
        <button type="button" class="auth-tab" data-auth-mode="signup">Create account</button>
      </div>

      <form data-auth-form>
        <label class="form-row" data-field-name hidden>
          <span class="gate-label">Your name</span>
          <input type="text" data-auth-name autocomplete="name" placeholder="e.g. Fadi" />
        </label>
        <label class="form-row">
          <span class="gate-label">Email</span>
          <input type="email" data-auth-email autocomplete="email" required />
        </label>
        <label class="form-row">
          <span class="gate-label">Password</span>
          <span class="auth-password-wrap">
            <input type="password" data-auth-password autocomplete="current-password" required minlength="6" />
            <button type="button" class="auth-password-toggle" data-toggle-password aria-label="Show password">Show</button>
          </span>
          <span class="help" data-auth-password-hint hidden>Minimum 6 characters.</span>
        </label>
        <p class="gate-error" data-auth-error hidden></p>
        <p class="auth-notice" data-auth-notice hidden></p>
        <button type="submit" class="btn-primary" data-auth-submit>Sign in</button>
      </form>
      <button type="button" class="auth-forgot" data-auth-forgot>Forgot password?</button>

      <div class="auth-recovery" data-auth-recovery hidden>
        <p class="gate-label">Set a new password</p>
        <span class="auth-password-wrap">
          <input type="password" data-recovery-password minlength="6" placeholder="New password" />
          <button type="button" class="auth-password-toggle" data-toggle-password aria-label="Show password">Show</button>
        </span>
        <span class="help">Minimum 6 characters.</span>
        <button type="button" class="btn-primary" data-recovery-submit>Save password</button>
      </div>

      <p class="gate-note">
        New leaders: create an account, then wait for an admin to approve you and assign your group.
      </p>
    </div>

    <div data-auth-view="verify" hidden style="text-align: center;">
      <p class="gate-label">Check your email</p>
      <p class="ws-pending-text">
        We sent a verification link to <strong data-verify-email></strong>. It can take a minute or two
        to arrive — check your spam folder if you don't see it. Click it to activate your account, then
        come back here and sign in. An admin still needs to approve you and assign your group after that
        before you can get in.
      </p>
      <p class="auth-notice" data-verify-notice hidden></p>
      <button type="button" class="auth-forgot" data-verify-resend>Didn't get it? Resend the email</button>
      <button type="button" class="btn-primary" data-verify-back>Back to sign in</button>
    </div>
  </div>

  <section class="auth-steps" aria-label="How signing up works">
    <h2 class="auth-steps-h2">How it works</h2>
    <ol class="auth-steps-list">
      <li>Tap Sign up and enter your name, email, and a password.</li>
      <li>Check your email and tap the confirmation link. No email after a few minutes? Come back and tap Resend.</li>
      <li>Come back here and sign in.</li>
      <li>Wait for an admin to approve you and add you to a group.</li>
      <li>Once you're approved, sign in again and you're in.</li>
    </ol>
    <a class="auth-steps-guide" href="/leaders/guide" target="_blank" rel="noopener">More help →</a>
  </section>

  <script>
    import { supabase, supabaseConfigured, signIn, signUp, resetPassword, updatePassword, getSession, isSessionExpired, signOut } from '../lib/workspace/auth';

    let mode = 'signin';

    function el(sel: string): any { return document.querySelector(sel); }
    // "joy blah" / "JOY BLAH" → "Joy Blah" — applied on blur so leaders
    // don't have to think about capitalization while typing.
    function titleCase(s: string) {
      return s.trim().replace(/\s+/g, ' ').toLowerCase().replace(/(^|[\s'-])\p{L}/gu, (c) => c.toUpperCase());
    }
    function showError(msg: string) {
      const e = el('[data-auth-error]');
      e.textContent = msg;
      e.hidden = false;
      el('[data-auth-notice]').hidden = true;
    }
    function showNotice(msg: string) {
      const n = el('[data-auth-notice]');
      n.textContent = msg;
      n.hidden = false;
      el('[data-auth-error]').hidden = true;
    }
    function clearMessages() {
      el('[data-auth-error]').hidden = true;
      el('[data-auth-notice]').hidden = true;
    }

    function setMode(next: string) {
      mode = next;
      document.querySelectorAll('[data-auth-mode]').forEach((b) => {
        b.classList.toggle('auth-tab--active', (b as HTMLElement).dataset.authMode === next);
      });
      el('[data-field-name]').hidden = next !== 'signup';
      el('[data-auth-password-hint]').hidden = next !== 'signup';
      el('[data-auth-submit]').textContent = next === 'signup' ? 'Create account' : 'Sign in';
      clearMessages();
    }
    // Shared by the sign-in/sign-up password field and the recovery
    // "new password" field — toggles that one input between hidden and
    // plain text.
    function bindPasswordToggle(btn: HTMLElement) {
      const input = btn.previousElementSibling as HTMLInputElement;
      btn.addEventListener('click', () => {
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.textContent = showing ? 'Show' : 'Hide';
        btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    }
    // The email itself can take a minute or two to arrive — the Resend
    // button stays disabled with a live countdown for 3 minutes after
    // each send, so nobody fires off a second (or third) email before the
    // first one had a real chance to show up.
    let resendAvailableAt = 0;
    let resendTimer: any = null;
    function updateResendButton() {
      const btn = el('[data-verify-resend]');
      const remaining = resendAvailableAt - Date.now();
      if (remaining <= 0) {
        clearInterval(resendTimer);
        resendTimer = null;
        btn.disabled = false;
        btn.textContent = "Didn't get it? Resend the email";
        return;
      }
      btn.disabled = true;
      const mins = Math.floor(remaining / 60000);
      const secs = Math.floor((remaining % 60000) / 1000);
      btn.textContent = `Resend available in ${mins}:${String(secs).padStart(2, '0')}`;
    }
    function startResendCooldown() {
      resendAvailableAt = Date.now() + 3 * 60 * 1000;
      clearInterval(resendTimer);
      updateResendButton();
      resendTimer = setInterval(updateResendButton, 1000);
    }

    // Swaps the whole card between the sign-in/sign-up form and the
    // "check your email" screen shown right after Create account — a
    // dedicated screen rather than just flipping back to the sign-in tab
    // with a small notice, so it's unmissable.
    function showVerifyView(email: string) {
      el('[data-verify-email]').textContent = email;
      el('[data-verify-notice]').hidden = true;
      el('[data-auth-view="form"]')!.hidden = true;
      el('[data-auth-view="verify"]')!.hidden = false;
      startResendCooldown();
    }
    function showFormView() {
      el('[data-auth-view="verify"]')!.hidden = true;
      el('[data-auth-view="form"]')!.hidden = false;
      setMode('signin');
    }
    async function handleResend() {
      const email = el('[data-verify-email]').textContent;
      if (!email || !supabase || Date.now() < resendAvailableAt) return;
      const notice = el('[data-verify-notice]');
      try {
        const emailRedirectTo = window.location.origin + '/leaders';
        const { error } = await supabase.auth.resend({ type: 'signup', email, options: { emailRedirectTo } });
        if (error) throw error;
        notice.textContent = 'Sent again — check your email.';
        notice.hidden = false;
        startResendCooldown();
      } catch (err: any) {
        notice.textContent = err.message || 'Could not resend — try again in a moment.';
        notice.hidden = false;
      }
    }

    async function handleSubmit(e: Event) {
      e.preventDefault();
      clearMessages();
      if (!supabaseConfigured) { showError('Not connected to the database.'); return; }
      const email = el('[data-auth-email]').value.trim();
      const password = el('[data-auth-password]').value;
      const submitBtn = el('[data-auth-submit]');
      submitBtn.disabled = true;
      try {
        if (mode === 'signup') {
          const name = el('[data-auth-name]').value.trim();
          if (!name) { showError('Enter your name.'); return; }
          const { data, error } = await signUp(name, email, password);
          if (error) throw error;
          if (data.session) {
            window.location.assign('/leaders/app');
          } else {
            showVerifyView(email);
          }
        } else {
          const { error } = await signIn(email, password);
          if (error) throw error;
          window.location.assign('/leaders/app');
        }
      } catch (err: any) {
        showError(err.message || 'Something went wrong.');
      } finally {
        submitBtn.disabled = false;
      }
    }

    async function handleForgot() {
      clearMessages();
      const email = el('[data-auth-email]').value.trim();
      if (!email) { showError('Enter your email above first, then tap this again.'); return; }
      try {
        await resetPassword(email);
        showNotice('Check your email for a password reset link.');
      } catch (err: any) {
        showError(err.message || 'Something went wrong.');
      }
    }

    async function handleRecoverySubmit() {
      const password = el('[data-recovery-password]').value;
      if (!password || password.length < 6) { showError('Password must be at least 6 characters.'); return; }
      try {
        const { error } = await updatePassword(password);
        if (error) throw error;
        showNotice('Password updated — you can sign in now.');
        el('[data-auth-recovery]').hidden = true;
      } catch (err: any) {
        showError(err.message || 'Something went wrong.');
      }
    }

    function bind() {
      const form = el('[data-auth-form]');
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      document.querySelectorAll('[data-auth-mode]').forEach((b) => {
        b.addEventListener('click', () => setMode((b as HTMLElement).dataset.authMode || 'signin'));
      });
      form.addEventListener('submit', handleSubmit);
      el('[data-auth-forgot]').addEventListener('click', handleForgot);
      el('[data-recovery-submit]').addEventListener('click', handleRecoverySubmit);
      el('[data-verify-back]').addEventListener('click', showFormView);
      el('[data-verify-resend]').addEventListener('click', handleResend);
      document.querySelectorAll('[data-toggle-password]').forEach((btn) => bindPasswordToggle(btn as HTMLElement));
      el('[data-auth-name]').addEventListener('blur', () => {
        const input = el('[data-auth-name]');
        if (input.value.trim()) input.value = titleCase(input.value);
      });

      if (window.location.search.includes('expired=1')) {
        showNotice('You were signed out after 3 hours — sign in again to continue.');
      }

      if (supabaseConfigured && supabase) {
        supabase.auth.onAuthStateChange((event) => {
          if (event === 'PASSWORD_RECOVERY') {
            el('[data-auth-recovery]').hidden = false;
          }
        });
        // Clicking the emailed verification link lands back here with the
        // session Supabase just auto-established from it (type=signup in
        // the hash) — sign that straight back out and show the sign-in
        // form instead of continuing into the app, so "verify, then sign
        // in" is an explicit, deliberate step rather than an implicit one.
        const isSignupLanding = window.location.hash.includes('type=signup');
        getSession().then(async (session) => {
          if (!session) return;
          if (isSignupLanding) {
            const email = session.user.email;
            await signOut();
            showFormView();
            if (email) (el('[data-auth-email]') as HTMLInputElement).value = email;
            showNotice('Email confirmed — sign in below to continue.');
            return;
          }
          // Already signed in and this isn't a password-recovery landing —
          // skip straight to the workspace, unless our own 3-hour cap has
          // already passed (Supabase's refresh token would otherwise keep
          // this session alive for much longer than that).
          if (!window.location.hash.includes('type=recovery')) {
            if (isSessionExpired()) { await signOut(); return; }
            window.location.replace('/leaders/app');
          }
        });
      }
    }

    document.addEventListener('astro:page-load', bind);
  </script>

  <style>
    .leaders-demo-link { margin-top: 1.1rem; }

    /* Mirrors .gate-form's width so this reads as the sign-in card's
       companion, not an unrelated block — same reasoning that applies
       to the rest of this page's sizing. */
    .auth-steps {
      max-width: 460px;
      margin: 1.5rem auto 0;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1.5rem 1.75rem;
      box-shadow: var(--shadow-sm);
    }
    .auth-steps-h2 {
      font-family: var(--font-display);
      color: var(--color-brand-dark);
      font-size: 1.1rem;
      margin: 0 0 0.9rem;
    }
    .auth-steps-list { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.6rem; }
    .auth-steps-list li { line-height: 1.55; font-size: 0.9rem; color: var(--color-text); }
    .auth-steps-guide {
      display: inline-block;
      margin-top: 1.1rem;
      color: var(--color-brand);
      font-weight: 600;
      font-size: 0.85rem;
      text-decoration: none;
    }
    .auth-steps-guide:hover { text-decoration: underline; }
  </style>
</BaseLayout>
