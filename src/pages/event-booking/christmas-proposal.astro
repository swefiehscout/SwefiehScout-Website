  .xm-lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }
  .xm-lb-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .xm-lb-close { top: 16px; right: 16px; font-size: 1.1rem; }
  .xm-lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .xm-lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
  .xm-lb-count {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 900px) {
    .xm-hero { padding-top: 5rem; }
    .xm-hero-grid { grid-template-columns: 1fr; text-align: center; }
    .xm-hero-copy { display: flex; flex-direction: column; align-items: center; }
    .xm-hero-lede { margin-inline: auto; }
    .xm-hero-cta { justify-content: center; }
    .xm-stack { height: 420px; }
    .xm-card { width: 180px; }
    .xm-card--0 { --to: translate(-110%, -46%) rotate(-10deg); }
    .xm-card--2 { --to: translate(10%, -46%) rotate(10deg); }
    .xm-scroll-cue { display: none; }

    .xm-story { padding: 4.5rem 0 3.5rem; }
    .xm-story-inner { display: none; }
    .xm-swipe { display: block; }

    .xm-why { padding: 5rem 0 4rem; }
    .xm-why-row { grid-template-columns: 2.5rem 1fr; gap: 0.3rem 1rem; padding: 1.5rem 0.25rem; }
    .xm-why-row:hover { padding-left: 0.25rem; }
    .xm-why-text { grid-column: 2; }
    .xm-why-arrow { display: none; }

    .xm-wall-cols { grid-template-columns: repeat(2, 1fr); gap: 0.7rem; }
    .xm-wall-col { gap: 0.7rem; }
    .xm-wall-col:nth-child(even) { margin-top: 2.5rem; }
    .xm-wall-col:nth-child(n + 3) { margin-top: 0; }
  }
  @media (max-width: 640px) {
    /* Phone: buttons stack full width so nothing wraps awkwardly */
    .xm-hero-cta, .xm-book-cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 340px;
      margin-inline: auto;
    }
    .xm-hero-cta .xm-btn, .xm-book-cta .xm-btn { justify-content: center; }
    /* Snow switch shrinks to a small icon so it never covers text */
    .xm-snow-toggle {
      left: 0.75rem;
      bottom: 0.75rem;
      width: 40px;
      height: 40px;
      padding: 0;
      font-size: 1rem;
      display: grid;
      place-items: center;
    }
    .xm-snow-toggle [data-snow-label] { display: none; }
    .xm-snow-toggle[aria-pressed='false'] { opacity: 0.55; }
    .xm-count-label { letter-spacing: 0.12em; }
  }
  @media (max-width: 480px) {
    .xm-card { width: 150px; }
    .xm-stack { height: 360px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .xm *, .xm *::before, .xm *::after {
      animation-duration: 0.01s !important;
      animation-iteration-count: 1 !important;
      transition: none !important;
    }
  }
</style>

<script>
  type Clip = { src: string; poster?: string };
  let cleanup: (() => void)[] = [];
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = () => window.matchMedia('(hover: hover)').matches;

  /* ---------- Snow across the whole page ---------- */
  function initSnow() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-xm-snow]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-xm-snow-toggle]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !toggle || !ctx) return;
    let on = !reduce();
    let raf = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let flakes: { x: number; y: number; r: number; vy: number; vx: number; p: number; o: number }[] = [];

    function resize() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      canvas!.width = w * dpr;
      canvas!.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(110, Math.round(w / 12));
      flakes = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.8 + Math.random() * 2.4,
        vy: 0.35 + Math.random() * 0.9,
        vx: -0.2 + Math.random() * 0.4,
        p: Math.random() * Math.PI * 2,
        o: 0.35 + Math.random() * 0.5,
      }));
    }
    function frame() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      ctx!.clearRect(0, 0, w, h);
      ctx!.fillStyle = '#fff';
      ctx!.shadowColor = 'rgba(140, 90, 40, 0.55)';
      ctx!.shadowBlur = 4;
      for (const f of flakes) {
        f.p += 0.012;
        f.y += f.vy;
        f.x += f.vx + Math.sin(f.p) * 0.35;
        if (f.y > h + 4) { f.y = -4; f.x = Math.random() * w; }
        if (f.x > w + 4) f.x = -4;
        if (f.x < -4) f.x = w + 4;
        ctx!.globalAlpha = f.o;
        ctx!.beginPath();
        ctx!.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx!.fill();
      }
      raf = requestAnimationFrame(frame);
    }
    function sync() {
      cancelAnimationFrame(raf);
      if (on && !document.hidden) raf = requestAnimationFrame(frame);
      else ctx!.clearRect(0, 0, window.innerWidth, window.innerHeight);
      toggle!.setAttribute('aria-pressed', String(on));
      const l = toggle!.querySelector('[data-snow-label]');
      if (l) l.textContent = on ? 'Snow on' : 'Snow off';
    }
    resize();
    sync();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', sync);
    toggle.addEventListener('click', () => { on = !on; sync(); });
    cleanup.push(() => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', sync);
    });
  }

  /* ---------- Hero: sound, tilt, glow, sparkle trail ---------- */
  function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-xm-hero]');
    if (!hero) return;
    const stack = hero.querySelector<HTMLElement>('[data-xm-stack]');
    const main = hero.querySelector<HTMLVideoElement>('[data-xm-hero-video="main"]');
    const btn = hero.querySelector<HTMLButtonElement>('[data-xm-sound]');
    btn?.addEventListener('click', () => {
      if (!main) return;
      main.muted = !main.muted;
      if (!main.muted) { main.currentTime = 0; main.play().catch(() => {}); }
      btn.setAttribute('aria-pressed', String(!main.muted));
      const l = btn.querySelector('[data-xm-sound-label]');
      if (l) l.textContent = main.muted ? 'Hear it' : 'Sound on';
    });

    let last = 0;
    const colors = ['#e8c46a', '#ffffff', '#ff6b6b', '#fff2c4', '#f5a524'];
    hero.addEventListener('mousemove', (e) => {
      const r = hero.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      hero.style.setProperty('--mx', `${x * 100}%`);
      hero.style.setProperty('--my', `${y * 100}%`);
      if (stack && canHover()) {
        stack.style.setProperty('--ry', `${(x - 0.5) * 10}deg`);
        stack.style.setProperty('--rx', `${(0.5 - y) * 6}deg`);
      }
      const now = performance.now();
      if (reduce() || now - last < 45) return;
      last = now;
      const s = document.createElement('span');
      s.className = 'xm-spark';
      s.textContent = Math.random() > 0.5 ? '✦' : '❄';
      s.style.left = `${e.clientX - r.left}px`;
      s.style.top = `${e.clientY - r.top}px`;
      s.style.setProperty('--c', colors[Math.floor(Math.random() * colors.length)]);
      s.style.setProperty('--s', `${10 + Math.random() * 12}px`);
      s.style.setProperty('--dx', `${-20 + Math.random() * 40}px`);
      hero.appendChild(s);
      s.addEventListener('animationend', () => s.remove());
    });
    hero.addEventListener('mouseleave', () => {
      stack?.style.setProperty('--ry', '0deg');
      stack?.style.setProperty('--rx', '0deg');
    });
  }

  /* ---------- Countdown (flip clock) ---------- */
  function initCountdown() {
    const root = document.querySelector<HTMLElement>('[data-xm-countdown]');
    if (!root) return;
    const title = root.querySelector('[data-cd-title]');
    const set = (k: string, v: number) => {
      const el = root.querySelector<HTMLElement>(`[data-cd="${k}"]`);
      const txt = String(v).padStart(2, '0');
      if (!el || el.textContent === txt) return;
      el.textContent = txt;
      el.classList.remove('is-flip');
      void el.offsetWidth;
      el.classList.add('is-flip');
    };
    function tick() {
      const now = new Date();
      if (now.getMonth() === 11 && now.getDate() === 25) {
        root!.classList.add('is-today');
        if (title) title.innerHTML = 'Merry <em>Christmas!</em>';
        return;
      }
      let target = new Date(now.getFullYear(), 11, 25);
      if (now > target) target = new Date(now.getFullYear() + 1, 11, 25);
      let diff = Math.max(0, Math.floor((target.getTime() - now.getTime()) / 1000));
      set('d', Math.floor(diff / 86400)); diff %= 86400;
      set('h', Math.floor(diff / 3600)); diff %= 3600;
      set('m', Math.floor(diff / 60));
      set('s', diff % 60);
    }
    tick();
    const id = window.setInterval(tick, 1000);
    cleanup.push(() => clearInterval(id));
  }

  /* ---------- Autoplay hero videos only while on screen ---------- */
  function initAutoplay() {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    }, { threshold: 0.1 });
    document.querySelectorAll<HTMLVideoElement>('[data-xm-autoplay]').forEach((v) => io.observe(v));
    cleanup.push(() => io.disconnect());
  }

  const isPhone = () => window.matchMedia('(max-width: 900px)').matches;

  /* ---------- Scroll story (big screens) ---------- */
  function initStory() {
    const section = document.querySelector<HTMLElement>('[data-xm-story]');
    if (!section) return;
    const vids = section.querySelectorAll<HTMLVideoElement>('[data-xm-story-video]');
    const bars = section.querySelectorAll<HTMLElement>('[data-xm-story-bar]');
    const bgs = section.querySelectorAll<HTMLElement>('[data-xm-story-bg]');
    const deck = section.querySelectorAll<HTMLElement>('[data-xm-deck]');
    const chapters = section.querySelectorAll<HTMLElement>('[data-xm-chapter]');
    const posters = Array.from(vids).map((v) => v.poster);
    const n = vids.length;
    let current = -1;
    let inView = false;

    function activate(i: number) {
      if (i === current) return;
      current = i;
      chapters.forEach((c, k) => c.classList.toggle('is-active', k === i));
      bars.forEach((b, k) => b.classList.toggle('is-active', k <= i));
      if (isPhone()) return;
      bgs.forEach((b, k) => b.classList.toggle('is-active', k === i));
      // The fanned cards behind the phone preview the next two clips.
      deck.forEach((d) => {
        const p = posters[(i + Number(d.dataset.xmDeck)) % n];
        d.style.backgroundImage = p ? `url('${p}')` : '';
      });
      vids.forEach((v, k) => {
        v.classList.toggle('is-active', k === i);
        if (k === i && inView) {
          v.preload = 'auto';
          v.play().catch(() => {});
        } else v.pause();
      });
      const next = vids[i + 1];
      if (next && next.preload === 'none') next.preload = 'metadata';
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.xmChapter));
      });
    }, { rootMargin: '-45% 0px -45% 0px' });
    chapters.forEach((c) => io.observe(c));

    const sectionIO = new IntersectionObserver(([e]) => {
      inView = e.isIntersecting && !isPhone();
      if (inView) {
        if (current < 0) activate(0);
        vids[current]?.play().catch(() => {});
      } else vids.forEach((x) => x.pause());
    });
    sectionIO.observe(section);
    activate(0);
    cleanup.push(() => { io.disconnect(); sectionIO.disconnect(); });
  }

  /* ---------- Story swipe cards (phones) ---------- */
  function initSwipe() {
    const root = document.querySelector<HTMLElement>('[data-xm-swipe]');
    const track = root?.querySelector<HTMLElement>('[data-xm-swipe-track]');
    if (!root || !track) return;
    const cards = track.querySelectorAll<HTMLElement>('[data-xm-swipe-card]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-xm-swipe-dot]');
    const bgs = document.querySelectorAll<HTMLElement>('[data-xm-story-bg]');
    let current = 0;
    let inView = false;

    function sync() {
      cards.forEach((c, k) => {
        c.classList.toggle('is-active', k === current);
        const v = c.querySelector('video');
        if (!v) return;
        if (k === current && inView && isPhone()) {
          v.preload = 'auto';
          v.play().catch(() => {});
        } else v.pause();
      });
      dots.forEach((d, k) => d.classList.toggle('is-active', k === current));
      if (isPhone()) bgs.forEach((b, k) => b.classList.toggle('is-active', k === current));
      const next = cards[current + 1]?.querySelector('video');
      if (next && next.preload === 'none') next.preload = 'metadata';
    }

    const cardIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          current = Number((e.target as HTMLElement).dataset.xmSwipeCard);
          sync();
        }
      });
    }, { root: track, threshold: 0.6 });
    cards.forEach((c) => cardIO.observe(c));

    const viewIO = new IntersectionObserver(([e]) => { inView = e.isIntersecting; sync(); }, { threshold: 0.3 });
    viewIO.observe(track);

    dots.forEach((d) => d.addEventListener('click', () => {
      const card = cards[Number(d.dataset.xmSwipeDot)];
      if (card) track.scrollTo({ left: card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2, behavior: 'smooth' });
    }));
    cleanup.push(() => { cardIO.disconnect(); viewIO.disconnect(); });
  }

  /* ---------- Reel wall: drifting columns ---------- */
  function initWall() {
    const wall = document.querySelector<HTMLElement>('[data-xm-wall]');
    if (!wall) return;
    const cols = wall.querySelectorAll<HTMLElement>('[data-xm-col]');
    const speeds = [-70, 60, -50, 80];
    let raf = 0;
    function onScroll() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = wall!.getBoundingClientRect();
        const p = (window.innerHeight - r.top) / (window.innerHeight + r.height) - 0.5;
        cols.forEach((c, i) => c.style.setProperty('--py', `${p * speeds[i % speeds.length]}px`));
      });
    }
    if (!reduce()) {
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      cleanup.push(() => window.removeEventListener('scroll', onScroll));
    }
  }

  /* ---------- Magnetic phone number ---------- */
  function initMagnet() {
    const el = document.querySelector<HTMLElement>('[data-xm-magnet]');
    if (!el || !canHover() || reduce()) return;
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--tx', `${(e.clientX - r.left - r.width / 2) * 0.12}px`);
      el.style.setProperty('--ty', `${(e.clientY - r.top - r.height / 2) * 0.25}px`);
    });
    el.addEventListener('mouseleave', () => {
      el.style.setProperty('--tx', '0px');
      el.style.setProperty('--ty', '0px');
    });
  }

  /* ---------- Lightbox ---------- */
  function initLightbox() {
    const dlg = document.querySelector<HTMLDialogElement>('[data-xm-lightbox]');
    const json = document.querySelector('[data-xm-media]');
    if (!dlg || !json) return;
    const items: Clip[] = JSON.parse(json.textContent || '[]');
    const stage = dlg.querySelector<HTMLElement>('[data-lb-stage]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    let idx = 0;
    function show(i: number) {
      idx = (i + items.length) % items.length;
      stage.innerHTML = '';
      const v = document.createElement('video');
      v.src = items[idx].src;
      if (items[idx].poster) v.poster = items[idx].poster!;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      stage.appendChild(v);
      count.textContent = `${idx + 1} / ${items.length}`;
    }
    document.querySelectorAll<HTMLElement>('[data-xm-open]').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.xm video').forEach((v) => (v as HTMLVideoElement).pause());
        show(Number(b.dataset.xmOpen));
        dlg.showModal();
      });
    });
    dlg.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => {
      stage.innerHTML = '';
      document.querySelectorAll<HTMLVideoElement>('[data-xm-autoplay]').forEach((v) => v.play().catch(() => {}));
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    let sx = 0;
    dlg.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
    });
  }

  function init() {
    if (!document.querySelector('.xm')) return;
    initSnow();
    initHero();
    initCountdown();
    initAutoplay();
    initStory();
    initSwipe();
    initWall();
    initMagnet();
    initLightbox();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup.forEach((fn) => fn());
    cleanup = [];
  });
</script>
