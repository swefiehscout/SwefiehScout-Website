  /* ================= BOOK ================= */
  .xm-book {
    position: relative;
    overflow: hidden;
    padding: 9rem clamp(1rem, 4vw, 3rem) 8rem;
    text-align: center;
    color: #fff;
    background:
      radial-gradient(ellipse 60% 60% at 50% 110%, rgba(232, 196, 106, 0.3), transparent 70%),
      radial-gradient(circle at 15% 30%, rgba(255, 255, 255, 0.08), transparent 30%),
      linear-gradient(160deg, #8f1d17, var(--maroon) 55%, #2a0b02);
  }
  .xm-book-inner { max-width: 860px; margin: 0 auto; }
  .xm-book-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.4vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0 0 1.4rem;
    color: #fff;
  }
  .xm-book-lede { margin: 0 auto 2.4rem; max-width: 520px; color: rgba(255, 255, 255, 0.78); font-size: 1.1rem; }
  .xm-phone-num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 9vw, 6rem);
    font-weight: 700;
    line-height: 1;
    color: var(--gold);
    text-decoration: none;
    text-shadow: 0 0 40px rgba(232, 196, 106, 0.4);
    margin-bottom: 2.4rem;
    transform: translate(var(--tx, 0), var(--ty, 0));
    transition: transform 0.25s var(--ease-out), color 0.2s;
  }
  .xm-phone-num:hover { color: var(--gold-hi); text-decoration: none; }
  .xm-book-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; }

  /* ================= LIGHTBOX ================= */
  .xm-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
