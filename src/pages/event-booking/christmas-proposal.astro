  .xm-reel:hover {
    transform: scale(1.03) rotate(-1deg);
    outline-color: var(--gold);
    box-shadow: 0 30px 50px -20px rgba(87, 22, 7, 0.6), 0 0 0 1px var(--gold), 0 0 40px -8px rgba(232, 196, 106, 0.6);
  }
  .xm-reel:focus-visible { outline: 3px solid var(--gold); }
  .xm-reel video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .xm-reel-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 58px;
    height: 58px;
    margin: -29px 0 0 -29px;
    border-radius: 50%;
    background: rgba(179, 38, 30, 0.85);
