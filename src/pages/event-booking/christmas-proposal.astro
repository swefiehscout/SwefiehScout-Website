  .xm-why-row:hover .xm-why-arrow { opacity: 1; transform: none; }

  /* ================= WALL ================= */
  .xm-wall {
    position: relative;
    overflow: hidden;
    padding: 7rem clamp(1rem, 4vw, 3rem) 6rem;
    color: var(--maroon);
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(232, 196, 106, 0.3), transparent 70%),
      linear-gradient(180deg, var(--beige), var(--cream) 50%, var(--beige));
