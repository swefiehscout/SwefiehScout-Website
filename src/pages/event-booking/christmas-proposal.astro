    color: #fff;
  }
  .xm-lightbox[open] { display: grid; place-items: center; }
  .xm-lightbox::backdrop { background: rgba(26, 5, 3, 0.94); backdrop-filter: blur(8px); }
  .xm-lb-stage video {
    display: block;
    max-width: 92vw;
    max-height: 86vh;
    border-radius: 16px;
    box-shadow: 0 0 0 2px rgba(232, 196, 106, 0.5), 0 30px 80px rgba(0, 0, 0, 0.7);
    animation: scaleIn 0.35s var(--ease-out);
