  .xm-swipe-copy .xm-chapter-tags li { padding: 0.3rem 0.7rem; font-size: 0.75rem; }
  .xm-swipe-dots { display: flex; justify-content: center; gap: 8px; margin-top: 0.6rem; }
  .xm-swipe-dots button {
    width: 8px;
