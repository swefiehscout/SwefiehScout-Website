---
// Christmas Proposal: a festive, video-led pitch page the PR team shows on
// a phone or laptop in meetings with venues, and sends as a link.
//
// Videos live in public/videos/christmas/. After adding new ones run
// `npm run videos` (scripts/prepare-videos.sh) to make web-safe .mp4s and
// poster images. Every video shows up in the "on film" wall automatically;
// the hero, story and hover previews use the hand-picked clips below
// (picked by filename, skipped if the file is missing).
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const VIDEO_DIR = 'videos/christmas';
const videoFiles = (() => {
  try {
    return fs
      .readdirSync(path.join(process.cwd(), 'public', VIDEO_DIR))
      .filter((f) => /\.(mp4|webm)$/i.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
  } catch {
    return [];
  }
})();

type Clip = { src: string; poster?: string };
function clip(file: string): Clip {
  const base = file.replace(/\.[^.]+$/, '');
  const poster = fs.existsSync(path.join(process.cwd(), 'public', VIDEO_DIR, 'posters', `${base}.jpg`))
    ? `/${VIDEO_DIR}/posters/${encodeURIComponent(base)}.jpg`
    : undefined;
  return { src: `/${VIDEO_DIR}/${encodeURIComponent(file)}`, poster };
}
const pick = (base: string): Clip | undefined => {
  const f = videoFiles.find((v) => v.startsWith(base));
  return f ? clip(f) : undefined;
};

const allClips = videoFiles.map(clip);

// Hero: three short, light clips fanned like cards. Centre one carries sound.
const heroClips = [
  pick('6840610da314424f88ec9474e47634f5'), // band in a hotel lobby by the tree
  pick('78cfc74c392840908cd35932f419e83f'), // Santa and the giant tree
  pick('f8a33af78b6e474590c237b250778e55'), // drums and snowman, Grand Hyatt
].filter(Boolean) as Clip[];

// Scroll story: one clip per chapter.
const story = [
  {
    clip: pick('e0e95a3402784802b4dee2b6013ab418'), // drummer close-up
    title: 'It starts with a drum roll.',
    text: 'You hear us before you see us. The drum line marches in, sticks flying, and every head in the place turns.',
    tags: ['Drum line', 'Grand entrance'],
  },
  {
    clip: pick('4ec9d61555554180a9aca78695ef43c6'), // piper in a hotel lobby
    title: 'Then the bagpipes.',
    text: 'A sound you don’t hear every day. It fills the whole space, floor to ceiling, and people come looking for it.',
    tags: ['Bagpipes', 'Festive tunes'],
  },
  {
    clip: pick('8eb7a9a3dfd74537b3b2dbda5524b8a0'), // mall crowd with Santa
    title: 'Everyone stops.',
    text: 'Shoppers put their bags down. Kids run to the front. Santa joins in, and the crowd keeps growing.',
    tags: ['Crowds gather', 'Santa joins in'],
  },
  {
    clip: pick('d486af7d5c994c27b9de4db55f258798'), // Sheraton tree lighting
    title: 'And the whole place feels like Christmas.',
    text: 'Trees light up, phones go up, and your venue ends up in everyone’s stories that night.',
    tags: ['Tree lightings', 'Instagram moments'],
  },
].filter((s) => s.clip);

const reasons = [
  {
    title: 'Crowds gather on their own',
    text: 'A live pipe band pulls people in from every corner of your venue.',
  },
  {
    title: 'Everyone films it',
    text: 'Your venue ends up on hundreds of phones and Instagram stories.',
  },
  {
    title: 'Real scout tradition',
    text: 'Bagpipes and drums in proud Orthodox and Arab scouting heritage.',
  },
  {
    title: 'We bring everything',
    text: 'Uniforms, instruments and a plan. You just pick the spot.',
  },
];

const places = [
  'Madaboun',
  'Golden Gate Mall',
  'Orthodox Club',
  'Sweifieh Village',
  'The Boulevard',
  'Grand Hyatt Amman',
  'Kan Zaman',
];

// Reel wall: round-robin into 4 columns so each column drifts on scroll.
const COLS = 4;
const reelCols: { clip: Clip; i: number }[][] = Array.from({ length: COLS }, () => []);
allClips.forEach((c, i) => reelCols[i % COLS].push({ clip: c, i }));

const PHONE_DISPLAY = '079 202 8785';
const PHONE_TEL = 'tel:+962792028785';
const WHATSAPP = `https://wa.me/962792028785?text=${encodeURIComponent(
  "Hello! We'd like to book the Scout Band for a Christmas performance.",
)}`;

const BULBS = 22;
const bulbColors = ['#ff4d4d', '#ffd166', '#fff4d6', '#f5a524', '#ff8a8a'];
const wirePath = Array.from({ length: BULBS }, (_, i) => {
  const w = 1000 / BULBS;
  const x0 = i * w;
  return `${i === 0 ? 'M0,4' : ''} Q${(x0 + w / 2).toFixed(1)},34 ${(x0 + w).toFixed(1)},4`;
}).join(' ');

const headline = [
  { w: 'Christmas', cls: '' },
  { w: 'in', cls: '' },
  { w: 'Amman', cls: '' },
  { w: 'has', cls: 'xm-br' },
  { w: 'a', cls: '' },
  { w: 'soundtrack.', cls: 'xm-gold xm-br' },
];
---
<BaseLayout title="Christmas Proposal" bare wide>
  <div class="xm">
    <canvas class="xm-snow" data-xm-snow aria-hidden="true"></canvas>

    <!-- ================= HERO ================= -->
    <section class="xm-hero xm-bleed" data-xm-hero>
      <div class="xm-hero-glow" aria-hidden="true"></div>
      <div class="xm-lights" aria-hidden="true">
        <svg viewBox="0 0 1000 40" preserveAspectRatio="none"><path d={wirePath} /></svg>
        {Array.from({ length: BULBS }, (_, i) => (
          <span
            class="xm-bulb"
            style={`left:${(((i + 0.5) / BULBS) * 100).toFixed(2)}%;--bulb:${bulbColors[i % bulbColors.length]};--d:${((i * 0.37) % 1.6).toFixed(2)}s`}
          ></span>
        ))}
      </div>

      <div class="xm-hero-grid">
        <div class="xm-hero-copy">
          <p class="xm-eyebrow">
            <span class="xm-eyebrow-dot" aria-hidden="true"></span>
            The Scout Band · Christmas Season
          </p>
          <h1 class="xm-h1" aria-label="Christmas in Amman has a soundtrack.">
            {headline.map((h, i) => (
              <>
                {h.cls.includes('xm-br') && <br aria-hidden="true" />}
                <span class={`xm-word ${h.cls}`} style={`--i:${i}`} aria-hidden="true">{h.w}</span>{' '}
              </>
            ))}
          </h1>
          <p class="xm-hero-lede">
            We're the Greek Orthodox Scouts &amp; Guides band from Swefieh. Every December we march into
            malls, hotels and clubs across Amman with pipes, drums and a whole lot of Christmas spirit.
          </p>
          <div class="xm-hero-cta">
            <a href="#xm-book" class="xm-btn xm-btn--gold">
              Bring us to your venue <Icon name="arrow-right" size={18} strokeWidth={2} />
            </a>
            {heroClips.length > 1 && (
              <button type="button" class="xm-btn xm-btn--ghost xm-sound" data-xm-sound aria-pressed="false">
                <span class="xm-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <span data-xm-sound-label>Hear it</span>
              </button>
            )}
          </div>
        </div>

        <div class="xm-stack" data-xm-stack aria-hidden="true">
          {heroClips.map((c, i) => (
            <div class={`xm-card xm-card--${i}`}>
              <video
                src={c.src}
                poster={c.poster}
                muted
                loop
                playsinline
                autoplay
                preload="auto"
                data-xm-autoplay
                data-xm-hero-video={i === 1 ? 'main' : undefined}
              ></video>
              <span class="xm-card-shine"></span>
            </div>
          ))}
          <span class="xm-star xm-star--a">✦</span>
          <span class="xm-star xm-star--b">✦</span>
          <span class="xm-star xm-star--c">✧</span>
        </div>
      </div>

      <a href="#xm-places" class="xm-scroll-cue" aria-label="Scroll down">
        <span></span>
      </a>
    </section>

    <!-- ================= PLACES MARQUEE ================= -->
    <section class="xm-ribbons xm-bleed" id="xm-places" aria-label="Places we've performed">
      <h2 class="xm-sr">Places we've performed</h2>
      <div class="xm-ribbon xm-ribbon--red">
        <div class="xm-ribbon-track">
          {[0, 1].map((dup) => (
            <div class="xm-ribbon-set" aria-hidden={dup === 1 ? 'true' : undefined}>
              <span class="xm-ribbon-tag">We've played</span>
              {places.map((p) => (<><span>{p}</span><b>✦</b></>))}
            </div>
          ))}
        </div>
      </div>
      <div class="xm-ribbon xm-ribbon--cream">
        <div class="xm-ribbon-track xm-ribbon-track--rev">
          {[0, 1].map(() => (
            <div class="xm-ribbon-set" aria-hidden="true">
              {[...places].reverse().map((p) => (<><span>{p}</span><b>❄</b></>))}
              <span class="xm-ribbon-tag">and many more</span><b>❄</b>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= COUNTDOWN ================= -->
    <section class="xm-count xm-bleed" data-xm-countdown>
      <div class="xm-lights" aria-hidden="true">
        <svg viewBox="0 0 1000 40" preserveAspectRatio="none"><path d={wirePath} /></svg>
        {Array.from({ length: BULBS }, (_, i) => (
          <span
            class="xm-bulb"
            style={`left:${(((i + 0.5) / BULBS) * 100).toFixed(2)}%;--bulb:${bulbColors[(i + 1) % bulbColors.length]};--d:${((i * 0.29) % 1.6).toFixed(2)}s`}
          ></span>
        ))}
      </div>
      <p class="xm-kicker" data-animate>The countdown is on</p>
      <h2 class="xm-count-title" data-animate data-cd-title>Christmas is <em>coming.</em></h2>
      <div class="xm-count-grid" data-cd-grid role="timer" aria-live="off">
        {[['d', 'Days'], ['h', 'Hours'], ['m', 'Minutes'], ['s', 'Seconds']].map(([k, label], i) => (
          <div class="xm-count-cell" data-animate data-animate-delay={String(i + 1)}>
            <div class="xm-count-card"><span data-cd={k}>00</span></div>
            <p class="xm-count-label">{label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= STORY ================= -->
    {story.length > 0 && (
      <section class="xm-story xm-bleed" data-xm-story>
        <div class="xm-story-bg" aria-hidden="true">
          {story.map((st, i) => (
            <div
              class={`xm-story-bg-img${i === 0 ? ' is-active' : ''}`}
              style={st.clip!.poster ? `background-image:url('${st.clip!.poster}')` : undefined}
              data-xm-story-bg={i}
            ></div>
          ))}
        </div>

        <header class="xm-story-head" data-animate>
          <p class="xm-kicker xm-kicker--gold">What happens when we walk in</p>
          <h2 class="xm-story-h2">Four moments.<br /><em>One unforgettable night.</em></h2>
        </header>

        <div class="xm-story-inner">
          <div class="xm-story-stage">
            <div class="xm-deck" aria-hidden="true">
              <div class="xm-deck-card xm-deck-card--a" data-xm-deck="1"></div>
              <div class="xm-deck-card xm-deck-card--b" data-xm-deck="2"></div>
            </div>
            <div class="xm-phone">
              {story.map((st, i) => (
                <video
                  src={st.clip!.src}
                  poster={st.clip!.poster}
                  muted
                  loop
                  playsinline
                  preload={i === 0 ? 'metadata' : 'none'}
                  class={i === 0 ? 'is-active' : ''}
                  data-xm-story-video={i}
                ></video>
              ))}
              <div class="xm-phone-progress" aria-hidden="true">
                {story.map((_, i) => <span data-xm-story-bar={i} class={i === 0 ? 'is-active' : ''}></span>)}
              </div>
              <div class="xm-phone-live" aria-hidden="true"><span></span> Live</div>
            </div>
          </div>

          <div class="xm-story-chapters">
            {story.map((st, i) => (
              <article class="xm-chapter" data-xm-chapter={i}>
                <p class="xm-chapter-num">0{i + 1} <span>/ 0{story.length}</span></p>
                <h3 class="xm-chapter-title">{st.title}</h3>
                <p class="xm-chapter-text">{st.text}</p>
                <ul class="xm-chapter-tags">
                  {st.tags.map((t) => <li>{t}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>

        <!-- Phones: swipeable story cards instead of the sticky scroll story -->
        <div class="xm-swipe" data-xm-swipe>
          <div class="xm-swipe-track" data-xm-swipe-track>
            {story.map((st, i) => (
              <article class={`xm-swipe-card${i === 0 ? ' is-active' : ''}`} data-xm-swipe-card={i}>
                <video src={st.clip!.src} poster={st.clip!.poster} muted loop playsinline preload="none"></video>
                <div class="xm-swipe-shade" aria-hidden="true"></div>
                <div class="xm-phone-live" aria-hidden="true"><span></span> Live</div>
                <div class="xm-swipe-copy">
                  <p class="xm-chapter-num">0{i + 1} <span>/ 0{story.length}</span></p>
                  <h3 class="xm-swipe-title">{st.title}</h3>
                  <p class="xm-swipe-text">{st.text}</p>
                  <ul class="xm-chapter-tags">
                    {st.tags.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
          <div class="xm-swipe-dots">
            {story.map((st, i) => (
              <button
                type="button"
                class={i === 0 ? 'is-active' : ''}
                data-xm-swipe-dot={i}
                aria-label={`Show moment ${i + 1}: ${st.title}`}
              ></button>
            ))}
          </div>
          <p class="xm-swipe-hint" aria-hidden="true">Swipe for the next moment →</p>
        </div>
      </section>
    )}

    <!-- ================= WHY ================= -->
    <section class="xm-why" data-xm-why>
      <header class="xm-why-head" data-animate>
        <p class="xm-kicker">Why venues call us</p>
        <h2 class="xm-h2">The easiest way to <em>fill a room</em> in December.</h2>
      </header>
      <ol class="xm-why-list">
        {reasons.map((r, i) => (
          <li class="xm-why-row" data-animate data-animate-delay={String(i + 1)}>
            <span class="xm-why-num">0{i + 1}</span>
            <h3 class="xm-why-title">{r.title}</h3>
            <p class="xm-why-text">{r.text}</p>
            <span class="xm-why-arrow" aria-hidden="true"><Icon name="arrow-right" size={22} strokeWidth={1.8} /></span>
          </li>
        ))}
      </ol>
    </section>

    <!-- ================= REEL WALL ================= -->
    {allClips.length > 0 && (
      <section class="xm-wall xm-bleed" data-xm-wall>
        <header class="xm-wall-head" data-animate>
          <p class="xm-kicker">Last season, on film</p>
          <h2 class="xm-h2">Press play on <em>Christmas.</em></h2>
          <p class="xm-wall-sub">Tap any video to watch it with sound.</p>
        </header>
        <div class="xm-wall-cols">
          {reelCols.map((col, c) => (
            <div class="xm-wall-col" data-xm-col={c}>
              {col.map(({ clip: v, i }) => (
                <button type="button" class="xm-reel" data-xm-open={i} aria-label={`Play video ${i + 1}`}>
                  <video src={v.src} poster={v.poster} muted loop playsinline preload="none"></video>
                  <span class="xm-reel-play" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ================= BOOK ================= -->
    <section class="xm-book xm-bleed" id="xm-book">
      <div class="xm-lights" aria-hidden="true">
        <svg viewBox="0 0 1000 40" preserveAspectRatio="none"><path d={wirePath} /></svg>
        {Array.from({ length: BULBS }, (_, i) => (
          <span
            class="xm-bulb"
            style={`left:${(((i + 0.5) / BULBS) * 100).toFixed(2)}%;--bulb:${bulbColors[(i + 2) % bulbColors.length]};--d:${((i * 0.53) % 1.6).toFixed(2)}s`}
          ></span>
        ))}
      </div>
      <div class="xm-book-inner" data-animate>
        <p class="xm-kicker xm-kicker--gold">Let's talk</p>
        <h2 class="xm-book-title">Let's make your venue<br /><em>sound like Christmas.</em></h2>
        <p class="xm-book-lede">Pricing and availability on request. Call or message us and we'll plan it with you.</p>
        <a href={PHONE_TEL} class="xm-phone-num" data-xm-magnet>{PHONE_DISPLAY}</a>
        <div class="xm-book-cta">
          <a href={WHATSAPP} class="xm-btn xm-btn--gold" target="_blank" rel="noopener">WhatsApp us</a>
          <a href={PHONE_TEL} class="xm-btn xm-btn--ghost">Call now</a>
          <a href="/contact-us" class="xm-btn xm-btn--ghost">Contact form</a>
        </div>
      </div>
    </section>

    <button type="button" class="xm-snow-toggle" data-xm-snow-toggle aria-pressed="true" aria-label="Toggle snow">
      <span aria-hidden="true">❄</span> <span data-snow-label>Snow on</span>
    </button>
  </div>

  <!-- ===== Lightbox ===== -->
  <dialog class="xm-lightbox" data-xm-lightbox aria-label="Video viewer">
    <button type="button" class="xm-lb-btn xm-lb-close" data-lb-close aria-label="Close">✕</button>
    <button type="button" class="xm-lb-btn xm-lb-prev" data-lb-prev aria-label="Previous">‹</button>
    <div class="xm-lb-stage" data-lb-stage></div>
    <button type="button" class="xm-lb-btn xm-lb-next" data-lb-next aria-label="Next">›</button>
    <p class="xm-lb-count" data-lb-count></p>
  </dialog>
  <script type="application/json" data-xm-media set:html={JSON.stringify(allClips)} />
</BaseLayout>

<style is:global>
  /* ======================= Christmas Proposal (xm-) ======================= */
  html:has(.xm) body { overflow-x: clip; }
  html:has(.xm) main { margin-top: 0; margin-bottom: 0; }
  html:has(.xm) .site-footer { margin-top: 0; }

  .xm {
    --night: #1f0504;
    --pine: #3a0a07;
    --cream: #fbf5e9;
    --beige: #f1e4cc;
    --green: #143822;
    --red: #b3261e;
    --maroon: #571607;
    --gold: #e8c46a;
    --gold-hi: #fff2c4;
    --gold-lo: #b8862f;
    position: relative;
  }
  .xm-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .xm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- Snow (whole page) ---------- */
  .xm-snow {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 40;
  }
  .xm-snow-toggle {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 45;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(58, 10, 7, 0.75);
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  /* ---------- Buttons & type ---------- */
  .xm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s, background 0.25s;
  }
  .xm-btn:hover { transform: translateY(-2px); text-decoration: none; }
  .xm-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .xm-btn--gold {
    color: #2a0b02;
    background: linear-gradient(120deg, #fff0bd, var(--gold) 40%, var(--gold-lo) 100%);
    box-shadow: 0 10px 30px -10px rgba(232, 196, 106, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .xm-btn--gold:hover { box-shadow: 0 16px 40px -10px rgba(232, 196, 106, 0.95); }
  .xm-btn--ghost {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
  }
  .xm-btn--ghost:hover { background: rgba(255, 255, 255, 0.14); }

  .xm-kicker {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
  }
  .xm-kicker--gold { color: var(--gold); }
  .xm-h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.4vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--maroon);
  }
  .xm-h2 em { font-style: italic; color: var(--red); }
  .xm-h2--light { color: #fff; }
  .xm-h2--light em,
  .xm-book-title em {
    font-style: italic;
    background: linear-gradient(100deg, var(--gold-hi), var(--gold) 30%, var(--gold-lo) 50%, var(--gold) 70%, var(--gold-hi));
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: xmShine 6s linear infinite;
  }

  /* ---------- String lights ---------- */
  .xm-lights {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    pointer-events: none;
    z-index: 3;
  }
  .xm-lights svg { position: absolute; inset: 0 0 auto; width: 100%; height: 40px; }
  .xm-lights path { fill: none; stroke: #1b120b; stroke-width: 2.5; vector-effect: non-scaling-stroke; }
  .xm-bulb {
    position: absolute;
    top: 17px;
    width: 12px;
    height: 18px;
    margin-left: -6px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--bulb);
    box-shadow: 0 0 10px 3px var(--bulb), 0 0 30px 8px color-mix(in srgb, var(--bulb) 40%, transparent);
    animation: xmTwinkle 1.6s ease-in-out infinite;
    animation-delay: var(--d);
  }
  .xm-bulb::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 3px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: #3b3b3b;
  }
  @keyframes xmTwinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; box-shadow: 0 0 4px 1px var(--bulb); }
  }
  @keyframes xmShine {
    from { background-position: 0% 0; }
    to { background-position: -250% 0; }
  }

  /* ================= HERO ================= */
  .xm-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 80px);
    min-height: calc(100svh - 80px);
    display: grid;
    align-items: center;
    padding: 5.5rem clamp(1rem, 5vw, 4rem) 5rem;
    color: #fff;
    background:
      radial-gradient(ellipse 70% 60% at 78% 45%, rgba(232, 196, 106, 0.22), transparent 70%),
      radial-gradient(ellipse 60% 60% at 0% 100%, rgba(255, 255, 255, 0.08), transparent 70%),
      linear-gradient(160deg, #2a0605 0%, #5a0f0b 55%, #7a1712 100%);
    isolation: isolate;
  }
  .xm-hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at var(--mx, 70%) var(--my, 40%), rgba(255, 210, 120, 0.16), transparent 30%);
  }
  .xm-hero-grid {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .xm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0;
    animation: xmFadeUp 0.8s 0.1s var(--ease-out) forwards;
  }
  .xm-eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff4d4d;
    animation: xmLive 1.6s infinite;
  }
  @keyframes xmLive {
    0% { box-shadow: 0 0 0 0 rgba(255, 77, 77, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(255, 77, 77, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 77, 77, 0); }
  }
  .xm-h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 1.6rem;
    color: #fff;
  }
  .xm-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.5em) rotate(4deg);
    filter: blur(10px);
    animation: xmWord 0.9s cubic-bezier(0.2, 0.9, 0.25, 1) forwards;
    animation-delay: calc(0.25s + var(--i) * 0.11s);
  }
  @keyframes xmWord {
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  .xm-gold {
    font-style: italic;
    padding-right: 0.08em;
    background: linear-gradient(100deg, var(--gold-hi), var(--gold) 30%, var(--gold-lo) 50%, var(--gold) 70%, var(--gold-hi));
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      xmWord 0.9s cubic-bezier(0.2, 0.9, 0.25, 1) calc(0.25s + var(--i) * 0.11s) forwards,
      xmShine 6s linear 1.6s infinite;
  }
  .xm-hero-lede {
    max-width: 520px;
    margin: 0 0 2rem;
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    opacity: 0;
    animation: xmFadeUp 0.9s 1s var(--ease-out) forwards;
  }
  .xm-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    opacity: 0;
    animation: xmFadeUp 0.9s 1.15s var(--ease-out) forwards;
  }
  @keyframes xmFadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  .xm-eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; }
  .xm-eq i { width: 3px; height: 4px; border-radius: 2px; background: currentColor; }
  .xm-sound[aria-pressed='true'] { border-color: var(--gold); color: var(--gold); }
  .xm-sound[aria-pressed='true'] .xm-eq i { animation: xmEq 0.9s ease-in-out infinite; }
  .xm-sound[aria-pressed='true'] .xm-eq i:nth-child(2) { animation-delay: 0.2s; }
  .xm-sound[aria-pressed='true'] .xm-eq i:nth-child(3) { animation-delay: 0.4s; }
  .xm-sound[aria-pressed='true'] .xm-eq i:nth-child(4) { animation-delay: 0.1s; }
  @keyframes xmEq {
    0%, 100% { height: 4px; }
    50% { height: 14px; }
  }
  /* Fanned video cards */
  .xm-stack {
    position: relative;
    height: min(72vh, 640px);
    transform: perspective(1200px) rotateY(var(--ry, 0deg)) rotateX(var(--rx, 0deg));
    transition: transform 0.4s var(--ease-out);
  }
  .xm-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(17vw, 250px);
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    overflow: hidden;
    background: #000;
    border: 2px solid rgba(232, 196, 106, 0.55);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.8),
      0 0 50px -10px rgba(232, 196, 106, 0.35);
    opacity: 0;
    animation:
      xmDeal 1.1s cubic-bezier(0.2, 0.9, 0.25, 1.1) forwards,
      xmBob 6s ease-in-out infinite;
  }
  .xm-card video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .xm-card--0 { --to: translate(-122%, -46%) rotate(-10deg); animation-delay: 0.5s, 1.6s; z-index: 1; }
  .xm-card--1 { --to: translate(-50%, -54%) rotate(0deg) scale(1.14); animation-delay: 0.7s, 2.6s; z-index: 2; }
  .xm-card--2 { --to: translate(22%, -46%) rotate(10deg); animation-delay: 0.9s, 3.6s; z-index: 1; }
  @keyframes xmDeal {
    from { opacity: 0; transform: translate(-50%, 20%) rotate(0deg) scale(0.8); }
    to { opacity: 1; transform: var(--to); }
  }
  @keyframes xmBob {
    0%, 100% { opacity: 1; transform: var(--to); }
    50% { opacity: 1; transform: var(--to) translateY(-12px); }
  }
  .xm-card-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.18) 45%, transparent 60%);
    background-size: 300% 100%;
    animation: xmCardShine 5s ease-in-out 2s infinite;
    pointer-events: none;
  }
  @keyframes xmCardShine {
    0% { background-position: 150% 0; }
    40%, 100% { background-position: -150% 0; }
  }
  .xm-star {
    position: absolute;
    color: var(--gold);
    text-shadow: 0 0 18px rgba(232, 196, 106, 0.9);
    animation: xmStar 3s ease-in-out infinite;
    z-index: 3;
  }
  .xm-star--a { top: 4%; left: 14%; font-size: 1.8rem; }
  .xm-star--b { bottom: 6%; right: 8%; font-size: 1.3rem; animation-delay: 1s; }
  .xm-star--c { top: 10%; right: 4%; font-size: 2.2rem; animation-delay: 2s; }
  @keyframes xmStar {
    0%, 100% { transform: scale(0.7) rotate(0); opacity: 0.4; }
    50% { transform: scale(1.15) rotate(25deg); opacity: 1; }
  }
  .xm-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px;
  }
  .xm-scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--gold);
    animation: xmCue 1.8s ease-in-out infinite;
  }
  @keyframes xmCue {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(14px); opacity: 0; }
    100% { opacity: 0; }
  }
  .xm-spark {
    position: absolute;
    pointer-events: none;
    color: var(--c);
    font-size: var(--s);
    text-shadow: 0 0 10px var(--c);
    z-index: 4;
    animation: xmSpark 1s ease-out forwards;
  }
  @keyframes xmSpark {
    from { transform: translate(-50%, -50%) scale(1) rotate(0); opacity: 1; }
    to { transform: translate(calc(-50% + var(--dx)), calc(-50% + 40px)) scale(0.2) rotate(120deg); opacity: 0; }
  }

  /* ================= RIBBONS ================= */
  .xm-ribbons {
    position: relative;
    padding: 4.5rem 0;
    overflow: hidden;
  }
  .xm-ribbon {
    position: relative;
    padding: 1.1rem 0;
    white-space: nowrap;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.45);
  }
  .xm-ribbon--red {
    background: linear-gradient(90deg, #8f1d17, var(--red) 50%, #8f1d17);
    transform: rotate(-3deg) scale(1.06);
    z-index: 2;
  }
  .xm-ribbon--cream {
    background: linear-gradient(90deg, var(--beige), #fffaf0 50%, var(--beige));
    border-block: 2px solid var(--gold);
    transform: rotate(2.5deg) scale(1.06);
    margin-top: -0.6rem;
  }
  .xm-ribbon-track {
    display: flex;
    width: max-content;
    animation: xmMarquee 40s linear infinite;
  }
  .xm-ribbon-track--rev { animation-direction: reverse; animation-duration: 46s; }
  .xm-ribbon-set {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.4vw, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .xm-ribbon--red .xm-ribbon-set > span { color: #fff; }
  .xm-ribbon--cream .xm-ribbon-set > span { color: var(--red); }
  .xm-ribbon-set b { color: var(--gold); font-size: 0.6em; }
  .xm-ribbon--cream .xm-ribbon-set b { color: var(--gold-lo); }
  .xm-ribbon-set > .xm-ribbon-tag {
    font-family: var(--font-sans);
    font-size: 0.32em;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding: 0.5em 1em;
    border-radius: 999px;
    border: 1.5px solid var(--gold);
    color: var(--gold);
    -webkit-text-stroke: 0;
  }
  @keyframes xmMarquee {
    to { transform: translateX(-50%); }
  }

  /* ================= COUNTDOWN ================= */
  .xm-count {
    position: relative;
    overflow: hidden;
    padding: 7rem clamp(1rem, 4vw, 3rem) 6rem;
    text-align: center;
    color: var(--maroon);
    background:
      radial-gradient(ellipse 60% 50% at 50% 100%, rgba(232, 196, 106, 0.35), transparent 70%),
      radial-gradient(ellipse 40% 40% at 50% 20%, rgba(255, 255, 255, 0.8), transparent 70%),
      linear-gradient(180deg, var(--cream), var(--beige));
  }
  .xm-count-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 3.2rem;
    color: var(--maroon);
  }
  .xm-count-title em {
    font-style: italic;
    background: linear-gradient(100deg, var(--red), var(--gold-lo) 30%, var(--red) 55%, var(--gold-lo) 80%, var(--red));
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: xmShine 6s linear infinite;
  }
  .xm-count-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.6rem, 2.4vw, 2rem);
    max-width: 1000px;
    margin: 0 auto;
  }
  .xm-count-card {
    position: relative;
    perspective: 600px;
    padding: clamp(1rem, 3vw, 2rem) 0.25rem;
    border-radius: clamp(14px, 2vw, 24px);
    background: linear-gradient(180deg, #ffffff 0%, #fdf9f0 49.6%, #f4ead6 50.4%, #fbf5e9 100%);
    border: 1.5px solid var(--gold);
    box-shadow:
      0 30px 50px -25px rgba(87, 22, 7, 0.45),
      0 0 40px -12px rgba(232, 196, 106, 0.6),
      inset 0 1px 0 #fff;
  }
  .xm-count-card::after {
    /* the flip-clock hinge */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: rgba(87, 22, 7, 0.14);
  }
  .xm-count-card span {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 8.5rem);
    font-weight: 700;
    line-height: 1.15;
    padding: 0.04em 0 0.08em;
    font-variant-numeric: lining-nums tabular-nums;
    background: linear-gradient(180deg, #d23a30, var(--red) 55%, #7a1712);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 4px 10px rgba(179, 38, 30, 0.2));
  }
  .xm-count-card span.is-flip { animation: xmFlip 0.6s cubic-bezier(0.3, 1.4, 0.5, 1); }
  @keyframes xmFlip {
    0% { transform: rotateX(80deg); opacity: 0.2; }
    100% { transform: rotateX(0); opacity: 1; }
  }
  .xm-count-label {
    margin: 1rem 0 0;
    font-size: clamp(0.68rem, 1.4vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-lo);
  }
  .xm-count.is-today .xm-count-grid { display: none; }

  /* ================= STORY ================= */
  .xm-story {
    position: relative;
    isolation: isolate;
    clip-path: inset(0);
    overflow-x: clip;
    color: #fff;
    background: var(--night);
    padding-top: 7rem;
  }
  /* Blurred glow of the active clip fills the whole section. */
  /* Fixed to the viewport but clipped to this section by the clip-path above. */
  .xm-story-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .xm-story-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 70% at 30% 50%, transparent 0%, rgba(42, 6, 5, 0.6) 70%),
      linear-gradient(180deg, rgba(42, 6, 5, 0.65), rgba(42, 6, 5, 0.3) 40%, rgba(42, 6, 5, 0.75));
  }
  .xm-story-bg-img {
    position: absolute;
    inset: -10%;
    background-size: cover;
    background-position: center;
    filter: blur(50px) saturate(1.6) brightness(0.55);
    opacity: 0;
    transform: scale(1.1);
    transition: opacity 1.2s var(--ease-out), transform 6s ease-out;
  }
  .xm-story-bg-img.is-active { opacity: 1; transform: scale(1); }

  .xm-story-head {
    position: relative;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .xm-story-h2 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    color: #fff;
  }
  .xm-story-h2 em {
    font-style: italic;
    background: linear-gradient(100deg, var(--gold-hi), var(--gold) 30%, var(--gold-lo) 50%, var(--gold) 70%, var(--gold-hi));
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: xmShine 6s linear infinite;
  }
  .xm-story-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .xm-story-stage {
    position: sticky;
    top: 86px;
    height: calc(100vh - 86px);
    display: grid;
    place-items: center;
  }
  .xm-deck { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .xm-deck-card {
    position: absolute;
    height: min(calc(100vh - 190px), 600px);
    aspect-ratio: 9 / 16;
    border-radius: 30px;
    background: #3a0a07 center / cover no-repeat;
    border: 1.5px solid rgba(232, 196, 106, 0.35);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8);
    filter: brightness(0.55) saturate(1.1);
    transition: background-image 0.6s, transform 0.8s var(--ease-out);
  }
  .xm-deck-card--a { transform: translateX(-34%) rotate(-9deg); }
  .xm-deck-card--b { transform: translateX(34%) rotate(9deg); }
  .xm-phone {
    position: relative;
    z-index: 2;
    height: min(calc(100vh - 150px), 660px);
    aspect-ratio: 9 / 16;
    border-radius: 34px;
    overflow: hidden;
    background: #000;
    border: 2px solid rgba(232, 196, 106, 0.7);
    box-shadow:
      0 0 0 10px rgba(255, 255, 255, 0.05),
      0 50px 90px -30px rgba(0, 0, 0, 0.95),
      0 0 90px -10px rgba(232, 196, 106, 0.45);
  }
  .xm-phone video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 0.8s var(--ease-out), transform 1.2s var(--ease-out);
  }
  .xm-phone video.is-active { opacity: 1; transform: scale(1); }
  .xm-phone-progress {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    gap: 4px;
  }
  .xm-phone-progress span {
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.3);
    transition: background 0.4s;
  }
  .xm-phone-progress span.is-active { background: #fff; }
  .xm-phone-live {
    position: absolute;
    top: 26px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: #e11d48;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .xm-phone-live span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: xmTwinkle 1.2s infinite;
  }

  .xm-story-chapters { padding: 12vh 0 30vh; }
  .xm-chapter {
    position: relative;
    isolation: isolate;
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.15;
    transform: translateY(40px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .xm-chapter.is-active { opacity: 1; transform: none; }
  .xm-chapter-num {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.08em;
  }
  .xm-chapter-num span { color: rgba(255, 255, 255, 0.45); }
  .xm-chapter-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 1.2rem;
    color: #fff;
    text-shadow: 0 6px 30px rgba(0, 0, 0, 0.5);
  }
  .xm-chapter-text {
    max-width: 480px;
    margin: 0 0 1.6rem;
    font-size: 1.18rem;
    line-height: 1.6;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }
  .xm-chapter-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .xm-chapter-tags li {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(232, 196, 106, 0.45);
    backdrop-filter: blur(6px);
  }
  .xm-chapter-tags li::before { content: '✦ '; color: var(--gold); }

  /* Phone-only swipe cards */
  .xm-swipe { display: none; }
  .xm-swipe-track {
    --cw: calc(min(70vh, 136vw) * 0.5625);
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 1.5rem calc((100% - var(--cw)) / 2) 1rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .xm-swipe-track::-webkit-scrollbar { display: none; }
  .xm-swipe-card {
    position: relative;
    flex: 0 0 var(--cw);
    aspect-ratio: 9 / 16;
    border-radius: 26px;
    overflow: hidden;
    scroll-snap-align: center;
    background: #3a0a07 center / cover;
    border: 2px solid rgba(232, 196, 106, 0.7);
    box-shadow: 0 30px 50px -25px rgba(0, 0, 0, 0.9), 0 0 50px -15px rgba(232, 196, 106, 0.45);
    transform: scale(0.9);
    opacity: 0.55;
    transition: transform 0.45s var(--ease-out), opacity 0.45s;
  }
  .xm-swipe-card.is-active { transform: none; opacity: 1; }
  .xm-swipe-card video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .xm-swipe-card .xm-phone-live { top: 14px; }
  .xm-swipe-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(42, 6, 5, 0) 40%, rgba(42, 6, 5, 0.75) 68%, rgba(31, 5, 4, 0.96) 100%);
  }
  .xm-swipe-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.2rem 1.1rem 1.3rem;
