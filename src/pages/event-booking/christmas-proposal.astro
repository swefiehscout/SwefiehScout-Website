  }
  .xm-swipe-copy .xm-chapter-num { margin: 0 0 0.35rem; font-size: 0.9rem; }
  .xm-swipe-title {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: 1.65rem;
