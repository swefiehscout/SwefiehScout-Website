  .xm-wall-head { text-align: center; max-width: 760px; margin: 0 auto 4rem; }
  .xm-wall-sub { margin: 1rem 0 0; color: var(--color-muted); }
  .xm-wall-cols {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
    align-items: start;
  }
  .xm-wall-col {
    display: grid;
    gap: 1.1rem;
    transform: translateY(var(--py, 0));
    will-change: transform;
  }
  .xm-wall-col:nth-child(even) { margin-top: 4rem; }
  .xm-reel {
    all: unset;
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 18px;
    overflow: hidden;
    cursor: pointer;
    background: #3a0a07;
    border: 6px solid #fff;
    box-shadow: 0 24px 40px -22px rgba(87, 22, 7, 0.55), 0 0 0 1px rgba(232, 196, 106, 0.5);
    outline: 1.5px solid transparent;
