  /* ================= WHY ================= */
  .xm-why {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 0 6rem;
  }
  .xm-why-head { max-width: 760px; margin-bottom: 3rem; }
  .xm-why-list { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--color-border); }
  .xm-why-row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 4rem 1fr 1.1fr 2.5rem;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0.5rem;
    border-bottom: 1.5px solid var(--color-border);
    transition: padding 0.4s var(--ease-out);
  }
  .xm-why-row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(179, 38, 30, 0.08), rgba(232, 196, 106, 0.14));
