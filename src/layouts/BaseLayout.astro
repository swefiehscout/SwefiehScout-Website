---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  pageTitle?: string;
  // When true, drop the prose <article> wrapper and let pages render their
  // own layout (used by the home landing page so hero/cards are full-width).
  bare?: boolean;
  // When true, widen the main container — use with bare landing pages.
  wide?: boolean;
}

const { title, pageTitle, bare, wide } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Orthodox Scouts Swefieh</title>
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/images/logo-emblem.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Amiri:wght@400;700&display=swap"
    />
  </head>
  <body>
    <SiteHeader currentPath={currentPath} />
    <main class={`page-enter${wide ? ' wide' : ''}`}>
      {pageTitle && <h1 class="page-title" data-animate>{pageTitle}</h1>}
      {bare ? (
        <slot />
      ) : (
        <article class="prose">
          <slot />
        </article>
      )}
    </main>
    <SiteFooter />

    <script is:inline>
      // Scroll-reveal: any element with [data-animate] fades + slides into
      // place when it enters the viewport. Lightweight, no framework, and
      // honors prefers-reduced-motion via the CSS media query.
      (function () {
        if (typeof IntersectionObserver === 'undefined') {
          // Old browsers: just show everything with no animation.
          document.querySelectorAll('[data-animate]').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }

        // Auto-tag every direct child of .prose as animated, so existing
        // markdown pages get scroll-reveal without authoring per-block tags.
        document.querySelectorAll('.prose > *').forEach(function (el, i) {
          if (!el.hasAttribute('data-animate')) {
            el.setAttribute('data-animate', '');
            // Stagger first few elements; cap delay tier at 5.
            if (i < 5) el.setAttribute('data-animate-delay', String(i + 1));
          }
        });

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );

        document
          .querySelectorAll('[data-animate]')
          .forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
