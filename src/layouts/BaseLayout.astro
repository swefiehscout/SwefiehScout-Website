---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  pageTitle?: string;
  // When true, drop the prose <article> wrapper and let pages render their
  // own layout (used by the home landing page so hero/cards are full-width).
  bare?: boolean;
  // When true, widen the main container — use with bare landing pages.
  wide?: boolean;
}

const { title, pageTitle, bare, wide } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Orthodox Scouts Swefieh</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Markazi+Text:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <SiteHeader currentPath={currentPath} />
    <main class={`page-enter${wide ? ' wide' : ''}`}>
      {pageTitle && <h1 class="page-title" data-animate>{pageTitle}</h1>}
      {bare ? (
        <slot />
      ) : (
        <article class="prose">
          <slot />
        </article>
      )}
    </main>
    <SiteFooter />

    <script is:inline>
      // Scroll progress bar at the very top of the viewport. Re-queries
      // the bar on every update so that view-transition swaps don't
      // leave a stale element reference.
      (function () {
        function update() {
          var bar = document.querySelector('[data-scroll-progress]');
          if (!bar) return;
          var doc = document.documentElement;
          var max = (doc.scrollHeight - doc.clientHeight) || 1;
          var pct = (window.scrollY / max) * 100;
          bar.style.width = Math.max(0, Math.min(100, pct)) + '%';
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        document.addEventListener('astro:page-load', update);
      })();

      // Stat counter — animates from 0 to the displayed number when the
      // .stat-num element first enters the viewport, then pulses briefly
      // when finished. Skips animation if prefers-reduced-motion is set.
      (function () {
        if (
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) return;
        function bind() {
          document.querySelectorAll('.stat-num').forEach(function (el) {
            if (el.dataset.counted) return;
            var raw = el.textContent.trim();
            var match = raw.match(/^(\d+)/);
            if (!match) return;
            var target = parseInt(match[1], 10);
            var suffix = raw.slice(match[1].length);
            el.dataset.counted = '1';
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                io.unobserve(entry.target);
                var start = performance.now();
                var duration = 1100;
                function tick(now) {
                  var t = Math.min(1, (now - start) / duration);
                  var eased = 1 - Math.pow(1 - t, 3);
                  var value = Math.round(target * eased);
                  entry.target.textContent = value + suffix;
                  if (t < 1) {
                    requestAnimationFrame(tick);
                  } else {
                    entry.target.classList.add('is-counted');
                  }
                }
                requestAnimationFrame(tick);
              });
            }, { threshold: 0.4 });
            io.observe(el);
          });
        }
        bind();
        document.addEventListener('astro:page-load', bind);
      })();

      // Marquee shuffle — on every page-load, reshuffle each
      // .band-marquee-track's slides and pick a random starting offset
      // for the looping animation so refresh / re-navigation never
      // shows the same opening sequence twice. The track keeps its
      // doubled structure (uniques + uniques) so the seamless loop
      // still works.
      (function () {
        function shuffle(track) {
          var slides = Array.prototype.slice.call(track.children);
          if (slides.length < 2) return;
          var half = Math.floor(slides.length / 2);
          var uniques = slides.slice(0, half);
          // Fisher-Yates
          for (var i = uniques.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var t = uniques[i];
            uniques[i] = uniques[j];
            uniques[j] = t;
          }
          // Replace track contents with shuffled + cloned-shuffled.
          while (track.firstChild) track.removeChild(track.firstChild);
          uniques.forEach(function (s) { track.appendChild(s); });
          uniques.forEach(function (s) {
            var clone = s.cloneNode(true);
            // Originals are visible to AT, clones are hidden.
            var img = clone.querySelector && clone.querySelector('img');
            if (img) img.setAttribute('aria-hidden', 'true');
            track.appendChild(clone);
          });
          // Random starting offset within one loop duration.
          var cs = getComputedStyle(track);
          var dur = parseFloat(cs.animationDuration);
          if (!isNaN(dur) && dur > 0) {
            track.style.animationDelay = '-' + (Math.random() * dur).toFixed(2) + 's';
          }
        }
        function bind() {
          document.querySelectorAll('.band-marquee-track').forEach(function (t) {
            if (t.dataset.shuffled) return;
            t.dataset.shuffled = '1';
            shuffle(t);
          });
        }
        document.addEventListener('astro:page-load', bind);
      })();

      // Mouse-tracking card spotlight — sets --x and --y custom props
      // on each .card so its ::after radial highlight follows the cursor.
      (function () {
        function bind() {
          document.querySelectorAll('.card').forEach(function (card) {
            if (card.dataset.spotlight) return;
            card.dataset.spotlight = '1';
            card.addEventListener('mousemove', function (e) {
              var rect = card.getBoundingClientRect();
              var x = ((e.clientX - rect.left) / rect.width) * 100;
              var y = ((e.clientY - rect.top) / rect.height) * 100;
              card.style.setProperty('--x', x + '%');
              card.style.setProperty('--y', y + '%');
            });
          });
        }
        bind();
        document.addEventListener('astro:page-load', bind);
      })();
    </script>
    <script is:inline>
      function setupProseAndReveal() {
        // Bilingual paired-row layout: in each <article class="prose">,
        // split content into sections at every <h2> boundary, label each
        // section by language (from its first element), then pair the i-th
        // English section with the i-th Arabic section. Each pair becomes
        // its own .bp-row — a 2-column grid — so corresponding section
        // headings always sit across from each other regardless of how
        // much content each section carries. Pre-<h2> content forms an
        // implicit first section.
        document.querySelectorAll('.prose').forEach(function (prose) {
          var items = Array.prototype.slice.call(prose.children);
          if (items.length < 2) return;

          var keep = [];
          var content = [];
          items.forEach(function (c) {
            if (c.classList && c.classList.contains('page-cta')) keep.push(c);
            else content.push(c);
          });
          if (content.length < 2) return;

          // Build sections. A new section starts on every <h2>, on the
          // very first content block, AND whenever the language flips
          // mid-flow (so an English-then-Arabic block sequence without
          // an explicit h2 between them still pairs correctly).
          var sections = [];
          var current = null;
          content.forEach(function (c) {
            var langOf = c.matches(':dir(rtl)') ? 'ar' : 'en';
            var startNew =
              c.tagName === 'H2' ||
              !current ||
              current.lang !== langOf;
            if (startNew) {
              if (current) sections.push(current);
              current = { lang: langOf, els: [c] };
            } else {
              current.els.push(c);
            }
          });
          if (current) sections.push(current);

          var enSections = sections.filter(function (s) { return s.lang === 'en'; });
          var arSections = sections.filter(function (s) { return s.lang === 'ar'; });
          if (!enSections.length || !arSections.length) return;

          // Pair by index. If counts differ, surplus sections sit alone
          // on their side with the other column empty.
          var max = Math.max(enSections.length, arSections.length);
          for (var i = 0; i < max; i++) {
            var en = enSections[i] || null;
            var ar = arSections[i] || null;
            var row = document.createElement('div');
            row.className = 'bp-row';
            var enWrap = document.createElement('div');
            enWrap.className = 'lang-en';
            var arWrap = document.createElement('div');
            arWrap.className = 'lang-ar';
            if (en) en.els.forEach(function (e) { enWrap.appendChild(e); });
            if (ar) ar.els.forEach(function (e) { arWrap.appendChild(e); });
            row.appendChild(enWrap);
            row.appendChild(arWrap);
            prose.appendChild(row);
          }
          keep.forEach(function (c) { prose.appendChild(c); });
          prose.classList.add('bilingual');
        });

        // Scroll-reveal: any element with [data-animate] fades + slides into
        // place when it enters the viewport. Lightweight, no framework, and
        // honors prefers-reduced-motion via the CSS media query.
        if (typeof IntersectionObserver === 'undefined') {
          document.querySelectorAll('[data-animate]').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }

        // Auto-tag prose content blocks. For a bilingual paired-row prose,
        // walk inside each row's column wrappers; otherwise direct children.
        document.querySelectorAll('.prose').forEach(function (prose) {
          var blocks = prose.classList.contains('bilingual')
            ? prose.querySelectorAll(':scope > .bp-row > .lang-en > *, :scope > .bp-row > .lang-ar > *')
            : prose.children;
          Array.prototype.slice.call(blocks).forEach(function (el, i) {
            if (!el.hasAttribute('data-animate')) {
              el.setAttribute('data-animate', '');
              if (i < 5) el.setAttribute('data-animate-delay', String(i + 1));
            }
          });
        });

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );

        document
          .querySelectorAll('[data-animate]')
          .forEach(function (el) { io.observe(el); });
      }
      // astro:page-load fires on initial load and after every view
      // transition. Calling setup directly *and* on the event would
      // double-tag elements with data-animate.
      document.addEventListener('astro:page-load', setupProseAndReveal);
    </script>
  </body>
</html>
